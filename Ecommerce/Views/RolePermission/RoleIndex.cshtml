@model EcommerceWebApplication.Models.ViewModels.RolePermissionForm
@using EcommerceWebApplication.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Role Permission";
}

<div class="main-content">
    <div class="card alert">
        <div class="card-header">
            <h4><i class="ti-lock" aria-hidden="true"></i> @_localizer["Role Permission"]</h4>
            <div class="card-header-right-icon">
                <a asp-action="PermissionList" class="btn btn-primary"><i class="ti-list" aria-hidden="true"></i> @_localizer["Permission List"]</a>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="RoleIndex" method="get" class="mb-3">
                <div class="form-group">
                    <label for="roleId">@_localizer["Role"]</label>
                    <select id="roleId" name="roleId" asp-items="ViewBag.RoleList" class="form-control" required>
                        <option value="">-- @_localizer["Select Role"] --</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">@_localizer["List"]</button>
            </form>

            @if (Model.RoleId > 0 && Model.Rows.Count > 0)
            {
                <p>@(Model.PortalScope == "Vendor" ? _localizer["Vendor Portal"] : _localizer["Admin Panel"])</p>
                @if (Model.PortalScope == "Vendor")
                {
                    <p class="text-muted">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar" ? "تتطلب صلاحية المخزون عرض المنتجات. تتطلب الإضافة والتعديل صلاحية العرض." : "Stock requires listing access. Create and edit require view access.")</p>
                }
                <form asp-action="CreateOrUpdatePermission" method="post">
                    <input type="hidden" asp-for="RoleId" />
                    <div class="admin-table-scroll">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">@_localizer["Pages"]</th>
                                    <th scope="col" class="text-center">@_localizer["List"]</th>
                                    <th scope="col" class="text-center">@_localizer["Create"]</th>
                                    <th scope="col" class="text-center">@_localizer["Edit"]</th>
                                    <th scope="col" class="text-center">@_localizer["Delete"]</th>
                                    <th scope="col" class="text-center">@_localizer["Report View"]</th>
                                    <th scope="col" class="text-center">@_localizer["Report Print"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Rows.Count; i++)
                                {
                                    var name = Model.Rows[i].PageName;
                                    var vendor = Model.PortalScope == "Vendor";
                                    var code = Model.Rows[i].PageCode;
                                    <tr>
                                        <th scope="row">
                                            <input type="hidden" asp-for="Rows[i].PageId" />
                                            @name
                                        </th>
                                        <td class="text-center">@if (!vendor || code != VendorPermissionPages.Finance || Model.IsVendorOwner) { <input asp-for="Rows[i].ListPage" aria-label="@($"{name}: {_localizer["List"].Value}")" /> } else { <span>—</span> }</td>
                                        <td class="text-center">@if (!vendor || VendorPermissionPages.SupportsCreate(code)) { <input asp-for="Rows[i].CreatePage" aria-label="@($"{name}: {_localizer["Create"].Value}")" /> } else { <span>—</span> }</td>
                                        <td class="text-center">@if (!vendor || VendorPermissionPages.SupportsUpdate(code)) { <input asp-for="Rows[i].UpdatePage" aria-label="@($"{name}: {_localizer["Edit"].Value}")" /> } else { <span>—</span> }</td>
                                        <td class="text-center">@if (!vendor) { <input asp-for="Rows[i].DeletePage" aria-label="@($"{name}: {_localizer["Delete"].Value}")" /> } else { <span>—</span> }</td>
                                        <td class="text-center">@if (!vendor) { <input asp-for="Rows[i].ReportView" aria-label="@($"{name}: {_localizer["Report View"].Value}")" /> } else { <span>—</span> }</td>
                                        <td class="text-center">@if (!vendor) { <input asp-for="Rows[i].ReportPrint" aria-label="@($"{name}: {_localizer["Report Print"].Value}")" /> } else { <span>—</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" class="btn btn-primary">@_localizer["Save"]</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const permissionRole = document.getElementById("roleId");
        permissionRole.value = "@(Model.RoleId > 0 ? Model.RoleId.ToString() : "")";
        permissionRole.addEventListener("change", () => {
            if (permissionRole.value) permissionRole.form.requestSubmit();
        });
    </script>
}
