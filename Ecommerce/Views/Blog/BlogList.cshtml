@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.BlogViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@inject EcommerceWebApplication.Helper.AdminStaffAccess StaffAccess
@{
    var rights = await StaffAccess.RightsAsync(User, EcommerceWebApplication.Helper.AdminStaffAccess.Blog, Context.RequestAborted);
    ViewData["Title"] = "Blog List";
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4> @_localizer["BlogList"]</h4>
                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                @if(rights.Create){<a asp-action="Add_Blog" class="btn btn-primary">
                                    <i class="fas fa-list"></i> @_localizer["Add Blog"]
                                </a>}
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">
                            <div class="card-body admin-register-body">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <div class="admin-table-scroll"><table class="table table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white; color: #000; direction: ltr;">
                                        <tr>
                                            <th class="text-center">@_localizer["SN"]</th>
                                            <th class="text-center">@_localizer["ID"]</th>
                                            <th class="text-center">@_localizer["Title"]</th>
                                            <th class="text-center">@_localizer["Status"]</th>
                                            <th class="text-center">@_localizer["Created Date"]</th>
                                            <th class="text-center">@_localizer["Image"]</th>
                                            <th class="text-center">@_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.BlogId</td>
                                                <td class="text-start">@item.Title</td>
                                                <td class="text-center">
                                                    @if (item.IsActive == 1)
                                                    {
                                                        <span class="badge bg-success">@_localizer["Active"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@_localizer["Inactive"]</span>
                                                    }
                                                </td>
                                                <td class="text-center">@item.CreatedAt?.ToString("dd-MM-yyyy")</td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.BlogImageBase64))
                                                    {
                                                        <img src="@item.BlogImageBase64" style="width:50px;height:40px;border-radius:4px;" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                   
                                             
                                                    @if(rights.Edit){<a asp-action="Add_Blog" asp-controller="Blog" asp-route-id="@item.BlogId" class="btn btn-sm btn-primary me-1">
                                                        <i class="ti-pencil"></i>
                                                    </a>}
                                                    @if(rights.Delete){<button type="button" class="btn btn-sm btn-danger delete-btn" onclick="deleteblog(@item.BlogId)">
                                                        <i class="ti-trash"></i>
                                                    </button>}
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table></div>
<nav class="order-pagination">
@if(Model.PageNumber>1){<a asp-action="BlogList" asp-route-page="@(Model.PageNumber-1)" asp-route-pageSize="@Model.PageSize" class="btn btn-default">@_localizer["Previous"]</a>}
<span>@Model.PageNumber / @Math.Max(1,Model.TotalPages)</span>
@if(Model.PageNumber<Model.TotalPages){<a asp-action="BlogList" asp-route-page="@(Model.PageNumber+1)" asp-route-pageSize="@Model.PageSize" class="btn btn-default">@_localizer["Next"]</a>}
</nav>

                              
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

   
</div>


@Html.AntiForgeryToken()
@section Scripts {
    <script>
        function deleteblog(id) {
            return AdminFeedback.remove("/Blog/Delete/" + encodeURIComponent(id));
        }
    </script>
}
