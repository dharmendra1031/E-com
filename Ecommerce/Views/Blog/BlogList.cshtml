@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.BlogViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Blog List";
    var blogJson = System.Text.Json.JsonSerializer.Serialize(Model);
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4> @_localizer["BlogList"]</h4>
                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                <a asp-action="Add_Blog" class="btn btn-primary">
                                    <i class="fas fa-list"></i> @_localizer["Add Blog"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">
                            <div class="card-body" style="overflow-y:auto; height:70vh">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <table class="table table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white; color: #000; direction: ltr;">
                                        <tr>
                                            <th class="text-center">@_localizer["SN"]</th>
                                            <th class="text-center">@_localizer["ID"]</th>
                                            <th class="text-center">@_localizer["Title"]</th>
                                            <th class="text-center">@_localizer["Status"]</th>
                                            <th class="text-center">@_localizer["Created Date"]</th>
                                            <th class="text-center">@_localizer["Image"]</th>
                                            <th class="text-center">@_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.BlogId</td>
                                                <td class="text-start">@item.Title</td>
                                                <td class="text-center">
                                                    @if (item.IsActive == 1)
                                                    {
                                                        <span class="badge bg-success">@_localizer["Active"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@_localizer["Inactive"]</span>
                                                    }
                                                </td>
                                                <td class="text-center">@item.CreatedAt?.ToString("dd-MM-yyyy")</td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.BlogImageBase64))
                                                    {
                                                        <img src="@item.BlogImageBase64" style="width:50px;height:40px;border-radius:4px;" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                   
                                             
                                                    <a asp-action="Add_Blog" asp-controller="Blog" asp-route-id="@item.BlogId" class="btn btn-sm btn-primary me-1">
                                                        <i class="ti-pencil"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-danger delete-btn" onclick="deleteblog(@item.BlogId)">
                                                        <i class="ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table>

                              
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

   
</div>


@section Scripts {
  
    <script>
        function deleteblog(id) {
            if (!confirm("Are you sure you want to delete this blog?")) return;

            $.ajax({
                url: '/Blog/Delete/' + id,
                type: 'POST',
                success: function () {
                    alert("blog deleted successfully!");
                    location.reload();
                },
                error: function () {
                    alert("Failed to delete blog.");
                }
            });
        }
    </script>
       

