@model EcommerceWebApplication.Models.BannerModel

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert" style="min-height: calc(100vh - 160px);">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4>@(Model.BannerId == 0 ? "Add New Banner" : "Edit Banner")</h4>
                </div>

                <div class="card-body" id="NavigationKey">

                    <form asp-action="AddBanner" method="post" enctype="multipart/form-data" id="bannerForm">

                        <input type="hidden" asp-for="BannerId" />

                        <div class="row">

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="fw-bold">Title (AR)  <span style="color:red;"> * </span></label>
                                    <input asp-for="TitleArabic" class="form-control" />
                                    <span id="errTitleAr" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="fw-bold">Title (EN)  <span style="color:red;"> * </span></label>
                                    <input asp-for="Title" class="form-control" />
                                    <span id="errTitleEn" class="text-danger small"></span>
                                </div>
                            </div>


                            <div class="col-md-3">
                                <div class="form-group">
                                    <label class="fw-bold">Banner Image  <span style="color:red;"> * </span></label>
                                    <input type="file" name="BannerFile" class="form-control" accept="image/*" onchange="loadPreview(event)" />
                                    <span id="errImage" class="text-danger small"></span>
                                    @if (Model.BannerImage != null)
                                    {
                                        var base64 = Convert.ToBase64String(Model.BannerImage);
                                        <img id="previewImg" src="data:image/png;base64,@base64"
                                             style="width:200px;border:1px solid #ccc;border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <img id="previewImg" src="#" style="width:200px; display:none; border:1px solid #ddd; border-radius:6px;" />
                                    }
                                </div>
                            </div>

                            <!-- OLD IMAGE + PREVIEW -->
                            <div class="col-md-12 mt-2">
                               
                            </div>
                            <div class="col-md-12 mt-3">

                                @* 🔴 ADD MODE: hide Save button if 3 banners already exist *@
                                @if (Model.BannerId == 0)
                                {
                                    if (ViewBag.BannerCount < 3)
                                    {
                                        <button class="btn btn-primary">Save Banner</button>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">
                                            Maximum 3 banners allowed. Please edit existing banner.
                                        </span>
                                    }
                                }
                                else
                                {
                                    @* 🟢 UPDATE MODE *@
                                    <button class="btn btn-primary">Update Banner</button>

                                    <a href="/Banner/AddBanner" class="btn btn-secondary ms-2">Cancel</a>
                                }

                            </div>

                        </div>
                    </form>

                   @*  @if (TempData["msg"] != null)
                    {
                        <div class="alert alert-success mt-3">@TempData["msg"]</div>
                    } *@

                </div>

                <hr />

                <h4 class="ms-3">All Banners</h4>

                <div class="card-body" style="overflow-y:auto; height:60vh">

                    <table class="table table-hover">
                        <thead class="table-light" style="position: sticky; top: 0;">
                            <tr>
                                <th class="text-center">Title</th>
                                <th class="text-center">Image</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in ViewBag.BannerList)
                            {
                                <tr>

                                    <td class="text-center">@item.Title</td>

                                    <td class="text-center">
                                        @if (item.BannerImage != null)
                                        {
                                            var base64 = Convert.ToBase64String(item.BannerImage);
                                            <img src="data:image/png;base64,@base64" style="width:100px;height:50px;object-fit:cover;border-radius:6px;" />
                                        }
                                        else
                                        {
                                            <span>No Image</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <a class="btn btn-sm btn-primary" href="/Banner/AddBanner/@item.BannerId">
                                            <i class="ti-pencil"></i>
                                        </a>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function loadPreview(event) {
        var output = document.getElementById('previewImg');
        output.src = URL.createObjectURL(event.target.files[0]);
        output.style.display = "block";
    }


   
</script>
<script>
    document.getElementById("bannerForm").addEventListener("submit", function (e) {

        let isValid = true;

        // Clear old messages
        document.getElementById("errTitleAr").innerText = "";
        document.getElementById("errTitleEn").innerText = "";
       
        document.getElementById("errImage").innerText = "";

        let titleAr = document.getElementById("TitleArabic").value.trim();
        let titleEn = document.getElementById("Title").value.trim();
    
        let imageInput = document.querySelector("input[name='BannerFile']");
        let bannerId = document.getElementById("BannerId").value; // 0 = Add Mode

        if (titleAr === "") {
            document.getElementById("errTitleAr").innerText = "Title (AR) is required";
            isValid = false;
        }

        if (titleEn === "") {
            document.getElementById("errTitleEn").innerText = "Title (EN) is required";
            isValid = false;
        }


        // 🔥 Image required only when BannerId = 0 (Add Mode)
        if (bannerId == "0" && imageInput.files.length === 0) {
            document.getElementById("errImage").innerText = "Banner image is required";
            isValid = false;
        }

        if (!isValid) {
            e.preventDefault();
        }
    });
</script>
