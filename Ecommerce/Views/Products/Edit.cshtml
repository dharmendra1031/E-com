@using EcommerceWebApplication.Models.ViewModels
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EditProductViewModel

@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en, string arabic) => ar ? arabic : en;
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content admin-product-editor">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4>@_localizer["Edit Product"]</h4>
                    <div class="card-header-right-icon ">
                        <ul><li> <a asp-controller="Products" asp-action="ProductList" class="btn btn-primary"><i class="ti-bar-chart-alt bg-info"></i>@_localizer["Product List"]</a></li> </ul>
                    </div><hr />
                </div>

                <div class="card-body">
                    @* @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    } *@

                    <form asp-action="Edit" id="NavigationKey" data-subcategories-url="@Url.Action("GetSubCategories","Products")" data-delete-image-url="@Url.Action("DeleteProductImage","Products")" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProductId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>@_localizer["Product Name (AR)"] <span style="color:red">*</span></label>
                                    <input asp-for="NameArb" dir="rtl" class="form-control" placeholder="أدخل اسم المنتج" />
                                    <span asp-validation-for="NameArb" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>@_localizer["Product Name (EN)"] <span style="color:red">*</span></label>
                                    <input asp-for="Name" dir="ltr" class="form-control" placeholder="Enter Name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Category & SubCategory -->
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Category"] <span style="color:red">*</span></label>
                                    <select asp-for="CategoryId" class="form-control" id="CategoryDropdown">
                                        <option value="">@T("Select category","اختر الفئة")</option>
                                        @foreach (var cat in ViewBag.Categories)
                                        {
                                            <option value="@cat.CategoryId" selected="@(cat.CategoryId == Model.CategoryId)">
                                                @cat.CName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Sub-Category"] <span style="color:red">*</span></label>
                                    <select asp-for="SubCategoryId" class="form-control" id="SubCategoryDropdown">
                                        <option value="">@T("Select subcategory","اختر الفئة الفرعية")</option>
                                        @foreach (var sub in ViewBag.SubCategories)
                                        {
                                            <option value="@sub.SubCategoryId" selected="@(sub.SubCategoryId == Model.SubCategoryId)">
                                                @sub.SCName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Barcode"]</label>
                                    <input asp-for="Ds_Barcode" class="form-control" maxlength="20" placeholder="Enter Barcode" />
                                    <span asp-validation-for="Ds_Barcode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Item Code"]</label>
                                    <input asp-for="Ds_ProdID" class="form-control" maxlength="20" placeholder="Enter Product ID" />
                                    <span asp-validation-for="Ds_ProdID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                       


                        <!-- Price, Stock, Weight -->
                        <div class="row mt-3">
                            <!-- Cost Price -->
                            
                            <div class="col-md-3">
                                <label>@_localizer["Cost Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="CoastPriceStr"
                                       id="CoastPrice"
                                       class="form-control"
                                       maxlength="8"
                                       value="@(Model.CoastPrice.ToString("F3", CultureInfo.InvariantCulture))"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div>

                            <div class="col-md-3">
                                <label>@_localizer["Sale Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="PriceStr"
                                       id="Price"
                                       class="form-control"
                                       maxlength="8"
                                       value="@(Model.Price.ToString("F3", CultureInfo.InvariantCulture))"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div>


                            <!-- Stock -->
                            <div class="col-md-3">
                                <label>@_localizer["Available Stock"] <span style="color:red">*</span></label>
                                <input asp-for="Stock" class="form-control" type="text" readonly onkeypress="return numeric(event)" maxlength="10" />
                            </div>

                            <div class="col-md-3">
                                <label>@_localizer["Weight (grams)"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="Weight"
                                       asp-for="Weight"
                                       class="form-control"
                                       value="@Convert.ToDecimal(Model.Weight).ToString("F2", CultureInfo.InvariantCulture)"
                                       onkeypress="return numeric(event)"
                                       maxlength="20" />
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-2">
                                    <label>@_localizer["Units"] </label>
                                    <input asp-for="Units" class="form-control" onkeypress="return numeric(event)" maxlength="8" />
                                </div>
                                <!-- Barcode -->
                                <!-- brand -->
                                <div class="col-md-2">
                                    <label>@_localizer["brand"]</label>
                                    <select asp-for="brandid" class="form-control" id="BrandDropdown">
                                        <option value="">@T("Select brand","اختر العلامة التجارية")</option>
                                        @foreach (var cat in ViewBag.brand1)
                                        {
                                            <option value="@cat.BrandId">@cat.BrandNameAEn</option>
                                        }
                                    </select>
                                </div>
                                <!-- Product Name -->
                                <div class="col-md-2">
                                    <label>@_localizer["SKU ID"] </label>
                                    <input asp-for="SKUId" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Model"]</label>
                                    <input asp-for="ProductsModel" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Warranty"] </label>
                                    <input asp-for="Warranty" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Features"] </label>
                                    <input asp-for="Features" class="form-control" />
                                </div>


                            </div>
                        </div>

                        <div class="row mt-3">
                            <!-- Description AR -->
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>@_localizer["Description[AR]"] </label>
                                    <textarea asp-for="DescriptionArb" dir="rtl" class="form-control" rows="3"></textarea>
                                </div>
                            </div>

                            <!-- Description EN -->
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>@_localizer["Description[EN]"]</label>
                                    <textarea asp-for="Description" dir="ltr" class="form-control" rows="3"></textarea>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>@_localizer["Status"] </label>
                                    <select asp-for="IsActive" class="form-control">
                                        <option value="true" selected="@(Model.IsActive)">@_localizer["Active"]</option>
                                        <option value="false" selected="@(Model.IsActive == false)">@_localizer["Inactive"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        
                        <!-- Existing Images -->
                        <div class="form-group">
                            <label>@_localizer["Images"] <span class="text-danger">*</span></label>

                            <div class="admin-image-gallery">
                                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                                {
                                    foreach (var img in Model.ExistingImages)
                                    {
                                        <div data-product-image="@img.ImageId" class="admin-image-tile">

                                            <img src="@img.Base64Image" alt="" loading="lazy" />

                                            <!-- Delete Button ON IMAGE -->
                                            <button type="button"
                                                    aria-label="@(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "حذف الصورة" : "Delete image")"
                                                    data-delete-image="@img.ImageId" class="btn btn-danger admin-image-remove">
                                                ✖
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">@_localizer["No images uploaded"]</span>
                                }
                            </div>
                        </div>



                        <!-- Upload New Images -->
                        <div class="form-group">
                            <label>@_localizer["Upload New Images (Optional)"]</label>
                            <input type="file" name="NewImages" id="ProductImages" class="form-control" accept="image/*" multiple />
                            <div id="imagePreview" class="admin-image-gallery"></div>
                            <small class="form-text text-muted">@_localizer["Multiple Images"]</small>
                        </div>
                        <h5 class="mt-4 mb-2">
                            @T("Specifications","المواصفات")
                            <button type="button" id="addSpecRow" class="btn btn-sm btn-outline-primary admin-spec-add" aria-label="@T("Add specification","إضافة مواصفة")">
                                <i class="fa fa-plus"></i>
                            </button>
                        </h5>

                        <!-- Heading Row -->
                        <div class="row mb-1 admin-spec-head">
                            <div class="col-md-2"><label><b>@T("Spec Name (Ar)","اسم المواصفة (عربي)")</b></label></div>
                            <div class="col-md-4"><label><b>@T("Spec Value (Ar)","قيمة المواصفة (عربي)")</b></label></div>
                            <div class="col-md-2"><label><b>@T("Spec Name (En)","اسم المواصفة (إنجليزي)")</b></label></div>
                            <div class="col-md-3"><label><b>@T("Spec Value (En)","قيمة المواصفة (إنجليزي)")</b></label></div>
                            <div class="col-md-1"></div>
                        </div>

                        <div id="specContainer">
                            @if (Model.Specifications != null && Model.Specifications.Count > 0)
                            {
                                for (int i = 0; i < Model.Specifications.Count; i++)
                                {
                                    <div class="row specRow mb-2">
                                        <div class="col-md-2">
                                            <input type="text" name="Specifications[@i].SpeciNameAr" value="@Model.Specifications[i].SpeciNameAr" class="form-control" placeholder="@T("Arabic Name","الاسم بالعربية")" aria-label="@T("Arabic Name","الاسم بالعربية")" />
                                        </div>
                                        <div class="col-md-4">
                                            <input type="text" name="Specifications[@i].SpecivalueAr" value="@Model.Specifications[i].SpecivalueAr" class="form-control" placeholder="@T("Arabic Value","القيمة بالعربية")" aria-label="@T("Arabic Value","القيمة بالعربية")" />
                                        </div>
                                        <div class="col-md-2">
                                            <input type="text" name="Specifications[@i].SpeciNameEn" value="@Model.Specifications[i].SpeciNameEn" class="form-control" placeholder="@T("English Name","الاسم بالإنجليزية")" aria-label="@T("English Name","الاسم بالإنجليزية")" />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" name="Specifications[@i].SpecivalueEn" value="@Model.Specifications[i].SpecivalueEn" class="form-control" placeholder="@T("English Value","القيمة بالإنجليزية")" aria-label="@T("English Value","القيمة بالإنجليزية")" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-center">
                                            <button type="button" class="btn btn-danger removeSpecRow" aria-label="@T("Remove specification","حذف مواصفة")"><i class="ti-trash"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Default empty row if no specs -->
                                <div class="row specRow mb-2">
                                    <div class="col-md-2">
                                        <input type="text" name="Specifications[0].SpeciNameAr" class="form-control" placeholder="@T("Arabic Name","الاسم بالعربية")" aria-label="@T("Arabic Name","الاسم بالعربية")" />
                                    </div>
                                    <div class="col-md-4">
                                        <input type="text" name="Specifications[0].SpecivalueAr" class="form-control" placeholder="@T("Arabic Value","القيمة بالعربية")" aria-label="@T("Arabic Value","القيمة بالعربية")" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="Specifications[0].SpeciNameEn" class="form-control" placeholder="@T("English Name","الاسم بالإنجليزية")" aria-label="@T("English Name","الاسم بالإنجليزية")" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="text" name="Specifications[0].SpecivalueEn" class="form-control" placeholder="@T("English Value","القيمة بالإنجليزية")" aria-label="@T("English Value","القيمة بالإنجليزية")" />
                                    </div>
                                    <div class="col-md-1 d-flex align-items-center">
                                        <button type="button" class="btn btn-danger removeSpecRow" aria-label="@T("Remove specification","حذف مواصفة")"><i class="ti-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- Submit -->
                        <div class="admin-form-actions"><a asp-action="ProductList" class="btn btn-default">@_localizer["Cancel"]</a><button type="submit" class="btn btn-primary">@_localizer["Update"]</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/product-editor.js" asp-append-version="true"></script>
}
