@using EcommerceWebApplication.Models.ViewModels
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EditProductViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content admin-product-editor">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4>@_localizer["Edit Product"]</h4>
                    <div class="card-header-right-icon ">
                        <ul><li> <a asp-controller="Products" asp-action="ProductList" class="btn btn-primary"><i class="ti-bar-chart-alt bg-info"></i>@_localizer["Product List"]</a></li> </ul>
                    </div><hr />
                </div>

                <div class="card-body">
                    @* @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">@TempData["Success"]</div>
                    } *@

                    <form asp-action="Edit" id="NavigationKey" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProductId" />

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>@_localizer["Product Name (AR)"] <span style="color:red">*</span></label>
                                    <input asp-for="NameArb" dir="rtl" class="form-control" placeholder="أدخل اسم المنتج" />
                                    <span asp-validation-for="NameArb" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>@_localizer["Product Name (EN)"] <span style="color:red">*</span></label>
                                    <input asp-for="Name" dir="ltr" class="form-control" placeholder="Enter Name" />
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <!-- Category & SubCategory -->
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Category"] <span style="color:red">*</span></label>
                                    <select asp-for="CategoryId" class="form-control" id="CategoryDropdown">
                                        <option value="">-- Select Category --</option>
                                        @foreach (var cat in ViewBag.Categories)
                                        {
                                            <option value="@cat.CategoryId" selected="@(cat.CategoryId == Model.CategoryId)">
                                                @cat.CName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Sub-Category"] <span style="color:red">*</span></label>
                                    <select asp-for="SubCategoryId" class="form-control" id="SubCategoryDropdown">
                                        <option value="">-- Select SubCategory --</option>
                                        @foreach (var sub in ViewBag.SubCategories)
                                        {
                                            <option value="@sub.SubCategoryId" selected="@(sub.SubCategoryId == Model.SubCategoryId)">
                                                @sub.SCName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Barcode"]</label>
                                    <input asp-for="Ds_Barcode" class="form-control" maxlength="20" placeholder="Enter Barcode" />
                                    <span asp-validation-for="Ds_Barcode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <div class="form-group">
                                    <label>@_localizer["Item Code"]</label>
                                    <input asp-for="Ds_ProdID" class="form-control" maxlength="20" placeholder="Enter Product ID" />
                                    <span asp-validation-for="Ds_ProdID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                       


                        <!-- Price, Stock, Weight -->
                        <div class="row mt-3">
                            <!-- Cost Price -->
                            @* <div class="col-md-3">
                                <label>@_localizer["Cost Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="CoastPrice"
                                       id="CoastPrice"
                                       class="form-control"
                                       maxlength="8"
                                       value="@Model.CoastPrice.ToString("F3", CultureInfo.InvariantCulture)"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div>

                            <!-- Sale Price -->
                            <div class="col-md-3">
                                <label>@_localizer["Sale Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="Price"
                                       id="Price"
                                       class="form-control"
                                       maxlength="8"
                                       value="@Model.Price.ToString("F3", CultureInfo.InvariantCulture)"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div> *@
                            <div class="col-md-3">
                                <label>@_localizer["Cost Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="CoastPriceStr"
                                       id="CoastPrice"
                                       class="form-control"
                                       maxlength="8"
                                       value="@(Model.CoastPrice.ToString("F3", CultureInfo.InvariantCulture))"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div>

                            <div class="col-md-3">
                                <label>@_localizer["Sale Price"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="PriceStr"
                                       id="Price"
                                       class="form-control"
                                       maxlength="8"
                                       value="@(Model.Price.ToString("F3", CultureInfo.InvariantCulture))"
                                       onkeypress="return ValidAmount(event, this);" />
                            </div>


                            <!-- Stock -->
                            <div class="col-md-3">
                                <label>@_localizer["Available Stock"] <span style="color:red">*</span></label>
                                <input asp-for="Stock" class="form-control" type="text" readonly onkeypress="return numeric(event)" maxlength="10" />
                            </div>

                            <div class="col-md-3">
                                <label>@_localizer["Weight (grams)"] <span style="color:red">*</span></label>
                                <input type="text"
                                       name="Weight"
                                       asp-for="Weight"
                                       class="form-control"
                                       value="@Convert.ToDecimal(Model.Weight).ToString("F2", CultureInfo.InvariantCulture)"
                                       onkeypress="return numeric(event)"
                                       maxlength="20" />
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-2">
                                    <label>@_localizer["Units"] </label>
                                    <input asp-for="Units" class="form-control" onkeypress="return numeric(event)" maxlength="8" />
                                </div>
                                <!-- Barcode -->
                                <!-- brand -->
                                <div class="col-md-2">
                                    <label>@_localizer["brand"]</label>
                                    <select asp-for="brandid" class="form-control" id="BrandDropdown">
                                        <option value="">-- Select brand --</option>
                                        @foreach (var cat in ViewBag.brand1)
                                        {
                                            <option value="@cat.BrandId">@cat.BrandNameAEn</option>
                                        }
                                    </select>
                                </div>
                                <!-- Product Name -->
                                <div class="col-md-2">
                                    <label>@_localizer["SKU ID"] </label>
                                    <input asp-for="SKUId" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Model"]</label>
                                    <input asp-for="ProductsModel" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Warranty"] </label>
                                    <input asp-for="Warranty" class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <label>@_localizer["Features"] </label>
                                    <input asp-for="Features" class="form-control" />
                                </div>


                            </div>
                        </div>

                        <div class="row mt-3">
                            <!-- Description AR -->
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>@_localizer["Description[AR]"] </label>
                                    <textarea asp-for="DescriptionArb" dir="rtl" class="form-control" rows="3"></textarea>
                                </div>
                            </div>

                            <!-- Description EN -->
                            <div class="col-md-5">
                                <div class="form-group">
                                    <label>@_localizer["Description[EN]"]</label>
                                    <textarea asp-for="Description" dir="ltr" class="form-control" rows="3"></textarea>
                                </div>
                            </div>

                            <!-- Status -->
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>@_localizer["Status"] </label>
                                    <select asp-for="IsActive" class="form-control">
                                        <option value="true" selected="@(Model.IsActive)">@_localizer["Active"]</option>
                                        <option value="false" selected="@(Model.IsActive == false)">@_localizer["Inactive"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <style>
                            .image-box {
                                position: relative;
                            }

                            .delete-image-btn {
                                position: absolute;
                                top: 5px;
                                right: 5px;
                                border-radius: 50%;
                                padding: 4px 6px;
                            }
                        </style>
                        <!-- Existing Images -->
                        <div class="form-group">
                            <label>@_localizer["Images"] <span class="text-danger">*</span></label>

                            <div>
                                @if (Model.ExistingImages != null && Model.ExistingImages.Any())
                                {
                                    foreach (var img in Model.ExistingImages)
                                    {
                                        <div style="display:inline-block; margin:5px; position:relative;">

                                            <img src="@img.Base64Image"
                                                 style="width:100px;height:100px;border:1px solid #ddd;object-fit:cover;" />

                                            <!-- Delete Button ON IMAGE -->
                                            <button type="button"
                                                    onclick="deleteImage(@img.ImageId)"
                                                    style="
                                        position:absolute;
                                        top:3px;
                                        right:3px;
                                        border:none;
                                        background:red;
                                        color:white;
                                        border-radius:50%;
                                        width:22px;
                                        height:22px;
                                        font-size:12px;
                                        cursor:pointer;">
                                                ✖
                                            </button>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">@_localizer["No images uploaded"]</span>
                                }
                            </div>
                        </div>



                        <!-- Upload New Images -->
                        <div class="form-group">
                            <label>@_localizer["Upload New Images (Optional)"]</label>
                            <input type="file" name="NewImages" class="form-control" accept="image/*" multiple />
                            <small class="form-text text-muted">@_localizer["Multiple Images"]</small>
                        </div>
                        <h5 class="mt-4 mb-2">
                            Specification
                            <button type="button" id="addSpecRow" class="btn btn-sm btn-outline-primary admin-spec-add" aria-label="Add specification">
                                <i class="fa fa-plus"></i>
                            </button>
                        </h5>

                        <!-- Heading Row -->
                        <div class="row mb-1 admin-spec-head">
                            <div class="col-md-2"><label><b>Spec Name (Ar)</b></label></div>
                            <div class="col-md-4"><label><b>Spec Value (Ar)</b></label></div>
                            <div class="col-md-2"><label><b>Spec Name (En)</b></label></div>
                            <div class="col-md-3"><label><b>Spec Value (En)</b></label></div>
                            <div class="col-md-1"></div>
                        </div>

                        <div id="specContainer">
                            @if (Model.Specifications != null && Model.Specifications.Count > 0)
                            {
                                for (int i = 0; i < Model.Specifications.Count; i++)
                                {
                                    <div class="row specRow mb-2">
                                        <div class="col-md-2">
                                            <input type="text" name="Specifications[@i].SpeciNameAr" value="@Model.Specifications[i].SpeciNameAr" class="form-control" placeholder="Arabic Name" />
                                        </div>
                                        <div class="col-md-4">
                                            <input type="text" name="Specifications[@i].SpecivalueAr" value="@Model.Specifications[i].SpecivalueAr" class="form-control" placeholder="Arabic Value" />
                                        </div>
                                        <div class="col-md-2">
                                            <input type="text" name="Specifications[@i].SpeciNameEn" value="@Model.Specifications[i].SpeciNameEn" class="form-control" placeholder="English Name" />
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" name="Specifications[@i].SpecivalueEn" value="@Model.Specifications[i].SpecivalueEn" class="form-control" placeholder="English Value" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-center">
                                            <button type="button" class="btn btn-danger removeSpecRow" aria-label="Remove specification"><i class="ti-trash"></i></button>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Default empty row if no specs -->
                                <div class="row specRow mb-2">
                                    <div class="col-md-2">
                                        <input type="text" name="Specifications[0].SpeciNameAr" class="form-control" placeholder="Arabic Name" />
                                    </div>
                                    <div class="col-md-4">
                                        <input type="text" name="Specifications[0].SpecivalueAr" class="form-control" placeholder="Arabic Value" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="Specifications[0].SpeciNameEn" class="form-control" placeholder="English Name" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="text" name="Specifications[0].SpecivalueEn" class="form-control" placeholder="English Value" />
                                    </div>
                                    <div class="col-md-1 d-flex align-items-center">
                                        <button type="button" class="btn btn-danger removeSpecRow" aria-label="Remove specification"><i class="ti-trash"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                        <!-- Submit -->
                        <div class="admin-form-actions"><a asp-action="ProductList" class="btn btn-default">@_localizer["Cancel"]</a><button type="submit" class="btn btn-primary">@_localizer["Update"]</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // ✅ Load Subcategories dynamically when Category changes
        $("#CategoryDropdown").change(function () {
            var catId = $(this).val();
            $("#SubCategoryDropdown").empty().append('<option>Loading...</option>');
            if (catId) {
                $.getJSON('/Products/GetSubCategories?categoryId=' + catId, function (data) {
                    $("#SubCategoryDropdown").empty().append('<option value="">-- Select SubCategory --</option>');
                    $.each(data, function (i, sub) {
                        $("#SubCategoryDropdown").append(
                            `<option value="${sub.subCategoryId}">${sub.scName}</option>`
                        );
                    });
                });
            }
        });
    </script>
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const costPrice = parseFloat(document.getElementById('CoastPrice').value) || 0;
            const salePrice = parseFloat(document.getElementById('Price').value) || 0;

            if (salePrice < costPrice) {
                e.preventDefault(); // prevent form submission first

                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Price',
                    text: 'Sale Price must be greater than or equal to Cost Price.',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });

                return false;
            }
        });
    </script>
    <script>
        let specIndex = $("#specContainer .specRow").length;

        // Add new spec row
        $("#addSpecRow").click(function () {
            var newRow = `
            <div class="row specRow mb-2 mt-2">
                <div class="col-md-2">
                    <input type="text" name="Specifications[${specIndex}].SpeciNameAr" class="form-control" placeholder="Arabic Name" />
                </div>
                <div class="col-md-4">
                    <input type="text" name="Specifications[${specIndex}].SpecivalueAr" class="form-control" placeholder="Arabic Value" />
                </div>
                <div class="col-md-2">
                    <input type="text" name="Specifications[${specIndex}].SpeciNameEn" class="form-control" placeholder="English Name" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="Specifications[${specIndex}].SpecivalueEn" class="form-control" placeholder="English Value" />
                </div>
                <div class="col-md-1 d-flex align-items-center">
                    <button type="button" class="btn btn-danger removeSpecRow" aria-label="Remove specification"><i class="ti-trash"></i></button>
                </div>
            </div>`;
            $("#specContainer").append(newRow);
            specIndex++;
        });

        // Remove spec row
        $(document).on('click', '.removeSpecRow', function () {
            $(this).closest('.specRow').remove();
            $("#specContainer .specRow").each(function (index) {
                $(this).find("input[name^='Specifications[']").each(function () {
                    this.name = this.name.replace(/Specifications\[\d+\]/, "Specifications[" + index + "]");
                });
            });
            specIndex = $("#specContainer .specRow").length;
        });
    </script>
    <script>
        function deleteImage(imageId) {
            if (!confirm("Are you sure you want to delete this image?"))
                return;

            $.ajax({
                url: '@Url.Action("DeleteProductImage", "Products")',
                type: 'POST',
                data: { imageId: imageId },
                success: function (res) {
                    if (res.success) {
                        location.reload(); // refresh images
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert("Error deleting image");
                }
            });
        }
    </script>


}
