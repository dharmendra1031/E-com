@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@using EcommerceWebApplication.Models.ViewModels
@model ProductViewModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content admin-product-editor">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4>@_localizer["Create New Product"]</h4>
                    <div class="card-header-right-icon ">
                        <ul>
                            <li> <a asp-controller="Products" asp-action="ProductList" class="btn btn-primary"><i class="ti-bar-chart-alt bg-info"></i>@_localizer["Product List"]</a></li>
                        </ul>
                    </div>
                    <hr />
                </div>

                <div class="card-body">
                    

                    <form asp-action="Create" id="NavigationKey" enctype="multipart/form-data" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row">
                            <!-- Category -->
                            <div class="col-md-3">
                                <label>@_localizer["Category"] <span style="color:red">*</span></label>
                                <select asp-for="CategoryId" class="form-control" id="CategoryDropdown">
                                    <option value="">-- Select Category --</option>
                                    @foreach (var cat in ViewBag.Categories)
                                    {
                                        <option value="@cat.CategoryId">@cat.CName</option>
                                    }
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>

                            <!-- SubCategory -->
                            <div class="col-md-3">
                                <label>@_localizer["Sub-Category"] <span style="color:red">*</span></label>
                                <select asp-for="SubCategoryId" class="form-control" id="SubCategoryDropdown">
                                    <option value="">-- Select --</option>
                                </select>
                                <span asp-validation-for="SubCategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-3">
                                <label>@_localizer["Barcode"]</label>
                                <input asp-for="Ds_Barcode" class="form-control" maxlength="20" placeholder="Enter Barcode" />
                                <span asp-validation-for="Ds_Barcode" class="text-danger"></span>
                            </div>

                            <!-- Product ID -->
                            <div class="col-md-3">
                                <label>@_localizer["Item Code"]</label>
                                <input asp-for="Ds_ProdID" class="form-control" maxlength="20" placeholder="Enter Item Code" />
                                
                            </div>
                          
                        </div>
                       


                        <div class="row mt-3">

                            <!-- Product Name Arabic -->
                            <div class="col-md-6">
                                <label>@_localizer["Product Name (AR)"] <span style="color:red">*</span></label>
                                <input asp-for="NameArb" dir="rtl" class="form-control" />
                                <span asp-validation-for="NameArb" class="text-danger"></span>
                            </div>
                            <!-- Product Name -->
                            <div class="col-md-6">
                                <label>@_localizer["Product Name (EN)"] <span style="color:red">*</span></label>
                                <input asp-for="Name" dir="ltr" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="row mt-3">
                            <!-- brand -->
                            <div class="col-md-4">
                                <label>@_localizer["brand"]</label>
                                <select asp-for="brandid" class="form-control" id="BrandDropdown">
                                    <option value="">-- Select brand --</option>
                                    @foreach (var cat in ViewBag.brand1)
                                    {
                                        <option value="@cat.BrandId">@cat.BrandNameAEn</option>
                                    }
                                </select>
                              
                            </div>
                            <!-- Product Name -->
                            <div class="col-md-4">
                                <label>@_localizer["SKU ID"] </label>
                                <input asp-for="SKUId" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label>@_localizer["Model"]</label>
                                <input asp-for="ProductsModel" class="form-control" />
                            </div>
                          


                         
                            <!-- Stock -->
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-2">
                                <label>@_localizer["Warranty"] (Months)</label>
                                <input asp-for="Warranty" class="form-control" onkeypress="return numeric(event)" />
                            </div>
                            <!-- Coast Price -->
                            <div class="col-md-2">
                                <label>@_localizer["Cost Price"] (KD) <span style="color:red">*</span></label>
                                <input asp-for="CoastPrice" id="CoastPrice" class="form-control" maxlength="8" onkeypress="return ValidAmount(event, this);" />
                                <span asp-validation-for="CoastPrice" class="text-danger"></span>
                            </div>

                            <!-- Sale Price -->
                            <div class="col-md-2">
                                <label>@_localizer["Sale Price"] (KD) <span style="color:red">*</span></label>
                                <input asp-for="Price" class="form-control" maxlength="8" onkeypress="return ValidAmount(event, this);" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <label>@_localizer["Stock"] <span style="color:red">*</span></label>
                                <input asp-for="Stock" class="form-control" type="text" id="Stock" onkeypress="return numeric(event)" maxlength="10" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                            <!-- Weight -->
                            <div class="col-md-2">
                                <label>@_localizer["Weight"] (Gram)</label>
                                <input asp-for="Weight" class="form-control" maxlength="20" onkeypress="return ValidAmount(event, this);"/>
                            </div>
                            <div class="col-md-2">
                                <label>@_localizer["Units"] </label>
                                <input asp-for="Units" class="form-control"type="text"value="1" onkeypress="return numeric(event)" maxlength="8" />
                            </div>
                            <!-- Barcode -->
                           

                        </div>
                        <div class="mt-3">
                            <label>@_localizer["Description[AR]"] </label>
                            <textarea asp-for="DescriptionArb" dir="rtl" data-val="false" class="form-control"></textarea>
                        </div>
                        <div class="mt-3">
                            <label>@_localizer["Description[EN]"]</label>
                            <textarea asp-for="Description" dir="ltr" data-val="false" class="form-control"></textarea>
                        </div>

                        <!-- Multiple Images -->
                        <div class="mt-3">
                            <label> @_localizer["Image"] <span style="color:red">*</span></label>
                            <input type="file" asp-for="ProductImages" accept="image/*" multiple class="form-control" id="ProductImages" />
                            <div id="imagePreview" class="d-flex flex-wrap mt-2"></div>
                            <span asp-validation-for="ProductImages" class="text-danger"></span>
                        </div>


                        <hr />
                        <h5 class="mt-4 mb-2">
                            Specification
                            <button type="button" id="addSpecRow" class="btn btn-sm btn-outline-primary admin-spec-add" aria-label="Add specification">
                                <i class="fa fa-plus"></i>
                            </button>
                        </h5>

                        <!-- Heading Row -->
                        <div class="row mb-1 admin-spec-head">
                            <div class="col-md-2"><label><b>Spec Name (Ar)</b></label></div>
                            <div class="col-md-4"><label><b>Spec Value (Ar)</b></label></div>
                            <div class="col-md-2"><label><b>Spec Name (En)</b></label></div>
                            <div class="col-md-3"><label><b>Spec Value (En)</b></label></div>
                        </div>

                        <div id="specContainer">
                            <div class="row specRow mb-2">
                                <div class="col-md-2">
                                    <input type="text" name="Specifications[0].SpeciNameAr" class="form-control" placeholder="Arabic Name" />
                                </div>
                                <div class="col-md-4">
                                    <input type="text" name="Specifications[0].SpecivalueAr" class="form-control" placeholder="Arabic Value" />
                                </div>
                                <div class="col-md-2">
                                    <input type="text" name="Specifications[0].SpeciNameEn" class="form-control" placeholder="English Name" />
                                </div>
                                <div class="col-md-4">
                                    <input type="text" name="Specifications[0].SpecivalueEn" class="form-control" placeholder="English Value" />
                                </div>
                            </div>
                        </div>

 
                        <div class="admin-form-actions"><a asp-action="ProductList" class="btn btn-default">@_localizer["Cancel"]</a><button type="submit" class="btn btn-primary">@_localizer["Save"]</button></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" /><!-- Include SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const costPrice = parseFloat(document.getElementById('CoastPrice').value) || 0;
            const salePrice = parseFloat(document.getElementById('Price').value) || 0;

            if (salePrice < costPrice) {
                e.preventDefault(); // prevent form submission first

                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Price',
                    text: 'Sale Price must be greater than or equal to Cost Price.',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });

                return false;
            }
        });
    </script>

    <script>
        // ✅ Dynamic SubCategory
        $("#CategoryDropdown").change(function () {
            var catId = $(this).val();
            $("#SubCategoryDropdown").empty().append('<option value="">Loading...</option>');
            if (catId) {
                $.getJSON('/Products/GetSubCategories?categoryId=' + catId, function (data) {
                    $("#SubCategoryDropdown").empty().append('<option value="">-- Select SubCategory --</option>');

                    $.each(data, function (i, sub) {
                        console.log(data);
                        // ✅ First store values in variables
                        let subId = sub.subCategoryId;        // ID
                        let subName = sub.scName;    // Name (make sure API returns this!)

                        // ✅ Now append
                        $("#SubCategoryDropdown").append(
                            `<option value="${subId}">${subName}</option>`
                        );
                    });

                });

            }
        });

        // ✅ Preview Multiple Images before upload
        $("#ProductImages").on("change", function (e) {
            $("#imagePreview").empty();
            var files = e.target.files;
            for (let i = 0; i < files.length; i++) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    $("#imagePreview").append(`<img src="${e.target.result}" style="width:100px;height:100px;object-fit:cover;margin:5px;border:1px solid #ddd;" />`);
                };
                reader.readAsDataURL(files[i]);
            }
        });
    </script>
    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const costPrice = parseFloat(document.getElementById('CoastPrice').value) || 0;
            const salePrice = parseFloat(document.getElementById('Price').value) || 0;

            if (salePrice < costPrice) {
                e.preventDefault(); // prevent form submission first

                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Price',
                    text: 'Sale Price must be greater than or equal to Cost Price.',
                    confirmButtonColor: '#3085d6',
                    confirmButtonText: 'OK'
                });

                return false;
            }
        });
    </script>
    <script>
             let specIndex = 1;

        $("#addSpecRow").click(function () {
            var newRow = `
            <div class="row specRow mb-2 mt-2">
                <div class="col-md-2">
                    <input type="text" name="Specifications[${specIndex}].SpeciNameAr" class="form-control" placeholder="Arabic Name" />
                </div>
                <div class="col-md-4">
                    <input type="text" name="Specifications[${specIndex}].SpecivalueAr" class="form-control" placeholder="Arabic Value" />
                </div>
                <div class="col-md-2">
                    <input type="text" name="Specifications[${specIndex}].SpeciNameEn" class="form-control" placeholder="English Name" />
                </div>
                <div class="col-md-3">
                    <input type="text" name="Specifications[${specIndex}].SpecivalueEn" class="form-control" placeholder="English Value" />
                </div>
                <div class="col-md-1 d-flex align-items-center">
                    <button type="button" class="btn btn-danger removeSpecRow" aria-label="Remove specification"><i class="ti-trash"></i></button>
                </div>
            </div>`;

            $("#specContainer").append(newRow);
            specIndex++;
        });
          // Remove spec row
        $(document).on('click', '.removeSpecRow', function () {
            $(this).closest('.specRow').remove();
            $("#specContainer .specRow").each(function (index) {
                $(this).find("input[name^='Specifications[']").each(function () {
                    this.name = this.name.replace(/Specifications\[\d+\]/, "Specifications[" + index + "]");
                });
            });
            specIndex = $("#specContainer .specRow").length;
        });
    </script>



}
