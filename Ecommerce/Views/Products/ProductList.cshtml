@using System.Globalization
@* @model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel> *@
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>
@{
    ViewData["Title"] = "Products List";
    var productJson = System.Text.Json.JsonSerializer.Serialize(Model);

}

<div id="main-content" class="admin-product-list">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <form id="filterForm" class="admin-product-filters">
                    <div class="row">
                        <div class="col-md-10 admin-filter-fields" id="NavigationKey">
                            <div class="form-group me-3" style="position:relative;">
                                <label for="name" class="me-1" style="margin-right: 5px;">@_localizer["Name"]:</label>
                                <input type="text" id="name" name="name" class="form-control" autocomplete="off" value="@ViewBag.FilterName" style="width: 150px; display: inline-block;" />
                                <ul id="suggestions" style="display:none;
                                position:absolute;
                                background:white;
                                list-style:none;
                                padding:0;
                                margin:0;
                                width:100%;  /* width same as input */
                                max-height:200px;
                                overflow-y:auto;
                                border:1px solid #ccc;
                                z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>
                            <div class="form-group me-3">
                                <label for="category" class="me-1">@_localizer["Category"]:</label>
                                <select id="category" name="category" class="form-control" style="width: 150px; display: inline-block;">
                                    <option value="" onclick="resetFilter()"></option>
                                    @foreach (var item in ViewBag.CategoryList as List<SelectListItem>)
                                    {
                                        <option value="@item.Value" selected="@(ViewBag.FilterCategory?.ToString() == item.Value)">
                                            @item.Text
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="form-group me-3">
                                <label for="price" class="me-1">@_localizer["Sale Price"]</label>
                                <input id="price" name="price" class="form-control" value="@ViewBag.FilterPrice" onkeypress="return ValidAmount(event, this);" style="width: 90px; display: inline-block;" />
                            </div>

                            <div class="form-group me-3">
                                <label for="status" class="me-1">@_localizer["Status"]:</label>
                                <select id="status" name="status" class="form-control" style="width: 150px; display: inline-block;">
                                   
                                    <option value="" selected="@(ViewBag.FilterStatus == null ? "selected" : "")"></option>
                                    <option value="1" selected="@(ViewBag.FilterStatus?.ToString() == "1")">@_localizer["Active"]</option>
                                    <option value="0" selected="@(ViewBag.FilterStatus?.ToString() == "0")">@_localizer["Inactive"]</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary me-2" onclick="submitFilter()">@_localizer["Search"]</button>
                        </div>
                        <!-- 👇 Wrapped buttons in a div with margin start -->
                        <div class="col-md-2 d-flex justify-content-end">
                            <div class="card-header-right-icon">
                                <a asp-controller="Products" asp-action="Create" class="btn btn-primary">
                                    <i class="ti-bar-chart-alt me-1"></i> @_localizer["AddProduct"]
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
                @* <div class="card-header">
                <h4>Product List</h4> 
				 <div class="card-header-right-icon ">
						<ul>
							<li> <a asp-controller="Products" asp-action="Create"><i class="ti-bar-chart-alt bg-info"></i>Add Product</a></li>
						</ul>
					</div> 
				</div> *@
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">


                            <div class="card-body admin-register-body">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <div class="admin-table-scroll"><table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center"> @_localizer["SN"]</th>
                                            <th class="text-center"> @_localizer["ID"]</th>
                                            <th class="text-center"> @_localizer["Name"]</th>
                                            <th class="text-center"> @_localizer["Category"]</th>
                                            <th class="text-center"> @_localizer["Sub-Category"]</th>
                                            <th class="text-center"> @_localizer["Sale Price"]</th>
                                            <th class="text-center"> @_localizer["Stock"]</th>
                                            <th class="text-center"> @_localizer["Status"]</th>
                                            <th class="text-center"> @_localizer["Created Date"]</th>
                                            <th class="text-center"> @_localizer["Image"]</th>
                                            <th class="text-center"> @_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.ProductId</td>
                                                <td class="text-center">@item.Name</td>
                                                <td class="text-center">@item.CategoryName</td>
                                                <td class="text-center">@item.SubCategoryName</td>
                                                <td class="text-center">@item.Price.ToString("F3",CultureInfo.InvariantCulture) KD</td>
                                                <td class="text-center">@item.Stock</td>
                                                <td class="text-center">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Inactive</span>
                                                    }
                                                </td>

                                                <td class="text-center" style="min-width:120px; white-space:nowrap;">
                                                    @(item.CreatedAt.ToString("dd-MM-yyyy") ?? "")
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.ProductImageBase64))
                                                    {
                                                        <img src="@item.ProductImageBase64" class="admin-product-thumb" loading="lazy" alt="" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>
                                             
                                                
                                             
                                                <td class="text-center">
                                                  
                                                    <a asp-action="Edit" asp-controller="Products" asp-route-id="@item.ProductId" class="btn btn-sm btn-primary me-1" aria-label="@_localizer["Edit"]">
                                                        <i class="ti-pencil"></i> 
                                                    </a>
                                                    <button class="btn btn-sm btn-danger delete-btn" type="button" aria-label="@_localizer["Delete"]" onclick="deleteproduct(@item.ProductId)">
                                                        <i class="ti-trash"></i> 
                                                    </button>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table></div>


                                <!-- ✅ Pagination (Same as UserList) -->
                                <div class="text-center">
                                    <ul class="pagination justify-content-center">

                                        <!-- First & Previous -->
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="ProductList" asp-route-page="1"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-category="@ViewBag.FilterCategory"
                                               asp-route-price="@ViewBag.FilterPrice"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="ProductList" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-category="@ViewBag.FilterCategory"
                                               asp-route-price="@ViewBag.FilterPrice"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @{
                                            int maxPagesToShow = 10; // ek time me 5 pages hi dikhaye
                                            int startPage = Math.Max(1, Model.PageNumber - 2);
                                            int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                                            // Agar last pages ke karan startPage adjust karna ho
                                            if (endPage - startPage + 1 < maxPagesToShow)
                                            {
                                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                            }

                                            // Agar 1 se pehle bhi pages hain
                                            if (startPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="ProductList" asp-route-page="1"
                                                       asp-route-name="@ViewBag.FilterName"
                                                       asp-route-category="@ViewBag.FilterCategory"
                                                       asp-route-price="@ViewBag.FilterPrice"
                                                       asp-route-status="@ViewBag.FilterStatus">1</a>
                                                </li>
                                                if (startPage > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                            }

                                            // Main visible page loop
                                            for (int i = startPage; i <= endPage; i++)
                                            {
                                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                    <a class="page-link" asp-action="ProductList" asp-route-page="@i"
                                                       asp-route-name="@ViewBag.FilterName"
                                                       asp-route-category="@ViewBag.FilterCategory"
                                                       asp-route-price="@ViewBag.FilterPrice"
                                                       asp-route-status="@ViewBag.FilterStatus">@i</a>
                                                </li>
                                            }

                                            // Agar last ke baad bhi pages hain
                                            if (endPage < Model.TotalPages)
                                            {
                                                if (endPage < Model.TotalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="ProductList" asp-route-page="@Model.TotalPages"
                                                       asp-route-name="@ViewBag.FilterName"
                                                       asp-route-category="@ViewBag.FilterCategory"
                                                       asp-route-price="@ViewBag.FilterPrice"
                                                       asp-route-status="@ViewBag.FilterStatus">@Model.TotalPages</a>
                                                </li>
                                            }
                                        }

                                        <!-- Next & Last -->
                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="ProductList" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-category="@ViewBag.FilterCategory"
                                               asp-route-price="@ViewBag.FilterPrice"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="ProductList" asp-route-page="@Model.TotalPages"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-category="@ViewBag.FilterCategory"
                                               asp-route-price="@ViewBag.FilterPrice"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

