@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.SellerCartLine>
@inject Microsoft.Extensions.Configuration.IConfiguration CheckoutConfiguration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment CheckoutEnvironment
@{ var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; }
<section class="store-cart-panel p-3 mb-3">
    <h2 class="h5">@(ar ? "سلة البائعين — معاينة" : "Seller cart — preview")</h2>
    <p class="small text-secondary">@(ar ? "الدفع للبائعين غير متاح بعد. زر الدفع أدناه للمتجر الحالي فقط." : "Seller checkout is not enabled. The checkout button below is for the current store only.")</p>
    @if (TempData["SellerCartMessage"] is string message) { <p role="alert" class="text-danger">@message</p> }
    @if (Model.Count == 0) { <p>@(ar ? "لا توجد منتجات من البائعين" : "No seller items")</p> }
    @foreach (var group in Model.GroupBy(l => new { l.VendorId, l.VendorName, l.VendorNameArb }))
    {
        <h3 class="h6 mt-3">@(ar && !string.IsNullOrWhiteSpace(group.Key.VendorNameArb) ? group.Key.VendorNameArb : group.Key.VendorName)</h3>
        <div class="table-responsive"><table class="table align-middle">
            <thead><tr><th>@(ar ? "المنتج" : "Product")</th><th>@(ar ? "السعر الحالي" : "Current price")</th><th>@(ar ? "الكمية" : "Quantity")</th><th>@(ar ? "الإجراء" : "Action")</th></tr></thead>
            <tbody>
            @foreach (var line in group)
            {
                <tr>
                    <td><a asp-controller="WebSingleProduct" asp-action="SingleProduct" asp-route-id="@line.ProductId">@(ar && !string.IsNullOrWhiteSpace(line.ProductNameArb) ? line.ProductNameArb : line.ProductName)</a></td>
                    <td>
                        @if (line.CurrentPrice.HasValue)
                        {
                            <bdi>KD @line.CurrentPrice.Value.ToString("F3", CultureInfo.InvariantCulture)</bdi>
                            @if (line.CurrentPrice.Value != line.SavedPrice) { <small class="d-block text-warning">@(ar ? "تغير السعر" : "Price changed")</small> }
                        }
                        else { <span>@(ar ? "غير متاح" : "Unavailable")</span> }
                    </td>
                    <td>
                        @if (line.AvailableQuantity < line.Quantity) { <small class="d-block text-danger">@(ar ? "الكمية غير متاحة" : "Insufficient stock")</small> }
                        <form asp-action="SetSellerQuantity" method="post" class="d-flex gap-2">
                            <input type="hidden" name="listingId" value="@line.ListingId" />
                            <input name="quantity" type="number" min="1" max="@Math.Max(1, Math.Min(line.AvailableQuantity, 1000000))" value="@line.Quantity" class="form-control" aria-label="@(ar ? "الكمية" : "Quantity")" required />
                            <button type="submit" class="btn btn-outline-primary">@(ar ? "تحديث" : "Update")</button>
                        </form>
                    </td>
                    <td><form asp-action="RemoveSellerLine" method="post"><input type="hidden" name="listingId" value="@line.ListingId" /><button type="submit" class="btn btn-outline-danger">@(ar ? "إزالة" : "Remove")</button></form></td>
                </tr>
            }
            </tbody>
        </table></div>
    }
    @if (Model.Count > 0 && Model.All(l => l.CurrentPrice.HasValue && l.AvailableQuantity >= l.Quantity))
    {
        <p class="fw-semibold">@(ar ? "المجموع التقديري للبائعين" : "Estimated seller subtotal") <bdi>KD @Model.Sum(l => l.CurrentPrice!.Value * l.Quantity).ToString("F3", CultureInfo.InvariantCulture)</bdi></p>
    }
    @if (EcommerceWebApplication.Helper.SellerCartAccess.CheckoutEnabled(CheckoutConfiguration, CheckoutEnvironment) &&
         Model.Count > 0 && Model.All(l => l.CurrentPrice == l.SavedPrice && l.AvailableQuantity >= l.Quantity))
    {
        <a class="btn btn-primary" asp-controller="WebCheckout" asp-action="Seller">@(ar ? "مراجعة طلب الاختبار" : "Review test checkout")</a>
    }
</section>
