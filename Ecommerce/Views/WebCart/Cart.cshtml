@{
    ViewData["Title"] = "Cart";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    bool unified = ViewBag.UnifiedTestCart == true;
    bool recovery = ViewBag.LegacyRecovery == true;
}
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
<div class="container py-3 py-md-4 customer-cart">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h1 class="h3 fw-bold mb-0">@_localizer["Your cart"]</h1>
        <a href="~/WebCategory/Index" class="fw-semibold text-decoration-none">@_localizer["Continue shopping"]</a>
    </div>
    @if (ViewBag.SellerCart is List<EcommerceWebApplication.Models.ViewModels.SellerCartLine> sellerCart)
    {
        <partial name="_SellerCart" model="sellerCart" />
    }
    @if (unified && ViewBag.SellerCart == null)
    {
        <p class="store-cart-panel p-3">@(ar ? "سجل الدخول لاختيار عروض البائعين." : "Sign in to select seller offers.") <a asp-controller="UserAccount" asp-action="Login" asp-route-returnUrl="/WebCart/Cart">@(ar ? "تسجيل الدخول" : "Sign in")</a></p>
    }
    @if (!unified || recovery)
    {
        @if (unified)
        {
            <p class="alert alert-warning">@(ar ? "عناصر السلة القديمة: أزلها وأعد اختيار البائع. لن يتم تعيين البائع تلقائياً." : "Old cart items: remove and reselect a seller. No seller is assigned automatically.")</p>
        }
    <div class="row g-3 g-lg-4 align-items-start">
        <section class="col-lg-8">
            <div class="store-cart-panel p-3">
                <div id="cartList" aria-busy="true" aria-live="polite">
                    <p class="mb-0">@(ar ? "جارٍ تحميل السلة…" : "Loading cart…")</p>
                </div>
                <p id="cartMessage" class="text-danger mt-2 mb-0" role="status"></p>
                <button type="button" id="retryCart" class="btn btn-outline-primary d-none">@(ar ? "إعادة المحاولة" : "Try again")</button>
            </div>
        </section>
        <aside class="col-lg-4">
            <div class="store-cart-panel p-3 p-md-4">
                <h2 class="h5 fw-bold mb-3">@_localizer["Order Summary"]</h2>
                <div class="d-flex justify-content-between gap-2 mb-3">
                    <span>@_localizer["Subtotal"]</span><strong id="cartSubtotal" dir="ltr">—</strong>
                </div>
                <p class="small text-secondary">@(ar ? "تُحسب رسوم التوصيل والضرائب عند الدفع." : "Delivery and taxes are calculated at checkout.")</p>
                @if (!unified)
                {
                    <button type="button" id="checkoutCart" class="btn btn-primary w-100" disabled>@_localizer["Check out"]</button>
                }
            </div>
        </aside>
    </div>
    }
</div>
@if (!unified || recovery)
{
<script>
(() => {
    const ar = document.documentElement.lang === "ar";
    const list = document.getElementById("cartList");
    const subtotal = document.getElementById("cartSubtotal");
    const checkout = document.getElementById("checkoutCart");
    const message = document.getElementById("cartMessage");
    const retry = document.getElementById("retryCart");
    const recovery = @(unified ? "true" : "false");
    let busy = false, loaded = false, hasItems = false;
    const failure = ar ? "تعذر تحديث السلة. حاول مرة أخرى." : "Unable to update cart. Please try again.";
    const money = value => "KD " + Number(value).toFixed(3);

    function syncControls() {
        if (checkout) checkout.disabled = busy || !loaded || !hasItems;
        list.setAttribute("aria-busy", String(busy));
        list.querySelectorAll("button").forEach(button => {
            button.disabled = busy || (button.dataset.action === "minus" && Number(button.closest("[data-quantity]").dataset.quantity) <= 1);
        });
    }
    function render(items) {
        list.replaceChildren();
        hasItems = items.length > 0;
        let total = 0, count = 0;
        for (const item of items) {
            const qty = Number(item.quantity), price = Number(item.price ?? item.unitPrice ?? 0);
            total += price * qty;
            count += qty;
            const row = document.createElement("div");
            row.className = "store-cart-row";
            row.dataset.productid = item.productId;
            row.dataset.quantity = qty;
            const product = document.createElement("a");
            product.className = "store-cart-product text-decoration-none";
            product.href = "/WebSingleProduct/SingleProduct/" + encodeURIComponent(item.productId);
            const img = document.createElement("img");
            img.src = item.imageBase64 || "/images/default-product.png";
            img.alt = "";
            img.loading = "lazy";
            const details = document.createElement("div");
            const name = document.createElement("div");
            name.className = "fw-semibold text-dark";
            name.textContent = item.productName || "";
            const unit = document.createElement("bdi");
            unit.textContent = money(price);
            details.append(name, unit);
            product.append(img, details);
            const controls = document.createElement("div");
            controls.className = "store-cart-controls";
            for (const [action, label, accessible] of [["minus","−", ar ? "تقليل الكمية" : "Decrease quantity"],["quantity",String(qty),""],["plus","+",ar ? "زيادة الكمية" : "Increase quantity"],["remove","×",ar ? "إزالة المنتج" : "Remove item"]]) {
                if (recovery && (action === "minus" || action === "plus")) continue;
                if (action === "quantity") {
                    const value = document.createElement("span");
                    value.textContent = label;
                    controls.append(value);
                } else {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = action === "remove" ? "btn btn-outline-danger" : "btn btn-outline-secondary";
                    button.dataset.action = action;
                    button.textContent = label;
                    button.setAttribute("aria-label", accessible);
                    controls.append(button);
                }
            }
            const lineTotal = document.createElement("bdi");
            lineTotal.className = "fw-bold store-cart-total";
            lineTotal.textContent = money(price * qty);
            row.append(product, controls, lineTotal);
            list.append(row);
        }
        if (!hasItems) {
            const empty = document.createElement("div");
            empty.className = "text-center py-5";
            const title = document.createElement("h2");
            title.className = "h5";
            title.textContent = ar ? "السلة فارغة" : "Your cart is empty";
            const link = document.createElement("a");
            link.href = "/WebCategory/Index";
            link.className = "btn btn-primary mt-2";
            link.textContent = ar ? "تسوق الآن" : "Start shopping";
            empty.append(title, link);
            list.append(empty);
        }
        subtotal.textContent = money(total);
        if (typeof loadCartCount === "function") loadCartCount();
        if (recovery && !hasItems) {
            location.replace(location.pathname);
            return;
        }
        loaded = true;
    }
    async function readCart() {
        const result = await $.get("/WebCart/GetCart");
        const items = result.cart || result;
        if (!Array.isArray(items)) throw new Error("Invalid cart response");
        render(items);
    }
    async function refresh() {
        if (busy) return;
        busy = true; loaded = false; message.textContent = ""; retry.classList.add("d-none");
        syncControls();
        try { await readCart(); }
        catch { list.textContent = failure; retry.classList.remove("d-none"); }
        finally { busy = false; syncControls(); }
    }
    retry.addEventListener("click", refresh);
    checkout?.addEventListener("click", () => {
        if (!checkout.disabled) location.href = "/WebCheckout/Index";
    });
    list.addEventListener("click", async event => {
        const button = event.target.closest("button[data-action]");
        if (!button || busy || button.disabled) return;
        const id = button.closest("[data-productid]").dataset.productid;
        busy = true; message.textContent = ""; syncControls();
        try {
            if (button.dataset.action === "remove") await $.post("/WebCart/RemoveFromCart", { productId: id, __RequestVerificationToken:document.querySelector("#storeCartToken input").value });
            else {
                const result = await $.post("/WebCart/AddOrUpdateCart", {productId: id, qty: button.dataset.action === "plus" ? 1 : -1, __RequestVerificationToken:document.querySelector("#storeCartToken input").value});
                if (!result.success) { message.textContent = result.message || failure; return; }
            }
            loaded = false;
            await readCart();
        } catch { loaded = false; message.textContent = failure; retry.classList.remove("d-none"); }
        finally { busy = false; syncControls(); }
    });
    refresh();
})();
</script>

}
