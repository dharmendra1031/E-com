@model List<EcommerceWebApplication.Models.ViewModels.MarketplaceFinanceRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;int page=ViewBag.Page;ViewData["Title"]=ar?"المراجعة المالية":"Marketplace finance review";}
<h2>@ViewData["Title"]</h2>
@if(TempData["SettlementMessage"] is string message){<p role="status">@message</p>}
<partial name="_MarketplaceFinanceTable" model="Model" />
@if(page>1){<a asp-action="FinanceReview" asp-route-page="@(page-1)" class="btn btn-default">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="FinanceReview" asp-route-page="@(page+1)" class="btn btn-default">@(ar?"التالي":"Next")</a>}
