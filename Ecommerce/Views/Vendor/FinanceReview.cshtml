@model List<EcommerceWebApplication.Models.ViewModels.MarketplaceFinanceRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;string T(string en,string arabic)=>ar?arabic:en;string Money(decimal? d)=>d.HasValue?"KD "+d.Value.ToString("F3",System.Globalization.CultureInfo.InvariantCulture):"—";int page=ViewBag.Page;ViewData["Title"]=T("Marketplace finance review","المراجعة المالية");}
<h2>@ViewData["Title"]</h2>
<p>@T("Merchandise calculations only. Not a payable balance; delivery, VAT, fees, refunds and payout approval remain unresolved.","حسابات البضائع فقط وليست رصيداً مستحقاً. التوصيل والضريبة والرسوم والاسترداد والتسوية قيد المراجعة.")</p>
<div class="admin-table-scroll"><table class="table"><thead><tr><th>@T("Suborder","الطلب الفرعي")</th><th>@T("Vendor","البائع")</th><th>@T("Merchandise","البضائع")</th><th>@T("Rate %","النسبة")</th><th>@T("Commission","العمولة")</th><th>@T("After commission","بعد العمولة")</th><th>@T("Review","المراجعة")</th></tr></thead><tbody>
@foreach(var row in Model){<tr><td>#@row.VendorOrderId</td><td>@row.VendorName</td><td dir="ltr">@Money(row.MerchandiseSubtotal)</td><td>@row.CommissionRatePercent</td><td dir="ltr">@Money(row.CommissionAmount)</td><td dir="ltr">@Money(row.MerchandiseAfterCommission)</td><td>@(row.ReviewState switch {"Missing policy snapshot"=>T("Missing policy snapshot","لا توجد سياسة محفوظة"),"Return review required"=>T("Return review required","يلزم مراجعة الإرجاع"),_=>T("Financial review required","يلزم المراجعة المالية")})</td></tr>}
@if(Model.Count==0){<tr><td colspan="7">@T("No paid seller orders","لا توجد طلبات مدفوعة")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="FinanceReview" asp-route-page="@(page-1)" class="btn btn-default">@T("Previous","السابق")</a>}
@if(ViewBag.HasNext==true){<a asp-action="FinanceReview" asp-route-page="@(page+1)" class="btn btn-default">@T("Next","التالي")</a>}
