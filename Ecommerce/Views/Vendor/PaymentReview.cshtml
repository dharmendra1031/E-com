@model List<EcommerceWebApplication.Models.ViewModels.MarketplacePaymentReviewRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;int page=ViewBag.Page;ViewData["Title"]=ar?"مراجعة الدفع":"Marketplace payment review";}
<h2>@ViewData["Title"]</h2>
<p>@(ar?"مراجعة فقط. تحقق من البوابة قبل أي تغيير.":"Read only. Verify gateway evidence before any financial action.")</p>
<div class="admin-table-scroll"><table class="table table-hover"><thead><tr><th>@(ar?"الطلب":"Order")</th><th>@(ar?"العميل":"Customer")</th><th>@(ar?"المبلغ":"Amount")</th><th>@(ar?"الفاتورة":"Invoice")</th><th>@(ar?"حالة المحاولة":"Attempt state")</th><th>@(ar?"التاريخ":"Date")</th></tr></thead><tbody>
@foreach(var row in Model){<tr><td>#@row.OrderId</td><td>@row.CustomerId</td><td dir="ltr">KD @row.TotalAmount.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)</td><td>@row.InvoiceId</td><td>@row.AttemptState</td><td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>}
@if(Model.Count==0){<tr><td colspan="6">@(ar?"لا توجد طلبات معلقة":"No pending orders")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="PaymentReview" asp-route-page="@(page-1)" class="btn btn-default">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="PaymentReview" asp-route-page="@(page+1)" class="btn btn-default">@(ar?"التالي":"Next")</a>}
