@model List<EcommerceWebApplication.Models.ViewModels.MarketplacePaymentReviewRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;int page=ViewBag.Page;ViewData["Title"]=ar?"مراجعة الدفع":"Marketplace payment review";}
<h2>@ViewData["Title"]</h2>
<p>@(ViewBag.CanReconcile==true ? (ar?"تحقق من الفاتورة المرتبطة في بيئة الاختبار.":"Verify an existing linked invoice in sandbox only.") : (ar?"مراجعة فقط.":"Read only."))</p>
@if(TempData["PaymentReviewMessage"] is string message){<p role="status">@message</p>}
<div class="admin-table-scroll"><table class="table table-hover"><thead><tr><th>@(ar?"الطلب":"Order")</th><th>@(ar?"العميل":"Customer")</th><th>@(ar?"المبلغ":"Amount")</th><th>@(ar?"الفاتورة":"Invoice")</th><th>@(ar?"حالة المحاولة":"Attempt state")</th><th>@(ar?"التاريخ":"Date")</th>@if(ViewBag.CanReconcile==true){<th>@(ar?"التحقق":"Verify")</th>}</tr></thead><tbody>
@foreach(var row in Model){<tr><td>#@row.OrderId</td><td>@row.CustomerId</td><td dir="ltr">KD @row.TotalAmount.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)</td><td>@row.InvoiceId</td><td>@row.AttemptState</td><td>@row.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
@if(ViewBag.CanReconcile==true){<td>@if(row.AttemptState=="Linked" && row.InvoiceId.HasValue){<form asp-action="ReconcilePayment" method="post"><input type="hidden" name="orderId" value="@row.OrderId" /><button type="submit" class="btn btn-outline-primary">@(ar?"تحقق":"Verify")</button></form>}else{<span>—</span>}</td>}
</tr>}
@if(Model.Count==0){<tr><td colspan="@(ViewBag.CanReconcile==true ? 7 : 6)">@(ar?"لا توجد طلبات معلقة":"No pending orders")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="PaymentReview" asp-route-page="@(page-1)" class="btn btn-default">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="PaymentReview" asp-route-page="@(page+1)" class="btn btn-default">@(ar?"التالي":"Next")</a>}
