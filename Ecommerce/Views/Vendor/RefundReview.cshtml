@model List<EcommerceWebApplication.Models.ViewModels.MarketplaceRefundReviewRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;string T(string en,string arabic)=>ar?arabic:en;int page=ViewBag.Page;ViewData["Title"]=T("Refund evidence review","مراجعة أدلة الاسترداد");}
<h2>@ViewData["Title"]</h2>
<p>@T("Sandbox only. Merchandise value is not an approved refund amount. No vendor settlement is posted.","اختبار فقط. قيمة البضائع ليست مبلغ استرداد معتمداً. لا يتم تسجيل تسوية للبائع.")</p>
@if(TempData["RefundMessage"] is string message){<p role="status">@message</p>}
<div class="admin-table-scroll"><table class="table"><thead><tr><th>@T("Return / order","الإرجاع / الطلب")</th><th>@T("Vendor / product","البائع / المنتج")</th><th>@T("Qty","الكمية")</th><th>@T("Merchandise value","قيمة البضائع")</th><th>@T("Invoice","الفاتورة")</th><th>@T("Refund status","حالة الاسترداد")</th><th>@T("Action","الإجراء")</th></tr></thead><tbody>
@foreach(var row in Model)
{
<tr><td>#@row.ReturnId / #@row.OrderId</td><td>@row.VendorName<div>@row.ProductName</div></td><td>@row.Quantity</td><td dir="ltr">KD @row.ReturnedMerchandiseValue.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)</td><td>@row.InvoiceId</td>
<td>@(row.GatewayRefundId.HasValue?T("Verified","تم التحقق"):row.RefundReference.HasValue?T("Verification required","يلزم التحقق"):T("Not requested","لم يطلب")) @if(row.RefundAmount.HasValue){<div><bdi>KD @row.RefundAmount.Value.ToString("F3")</bdi></div>}</td>
<td>@if(ViewBag.CanRefund==true && !row.GatewayRefundId.HasValue){
    if(row.RefundReference.HasValue){
        <form asp-action="VerifySandboxRefund" method="post"><input type="hidden" name="returnId" value="@row.ReturnId"/><button type="submit" class="btn btn-primary">@T("Verify refund","تحقق من الاسترداد")</button></form>
    }else if(row.ReturnedMerchandiseValue>0){
        <form asp-action="StartSandboxRefund" method="post"><input type="hidden" name="returnId" value="@row.ReturnId"/>
        <label>@T("Approved test amount (KD)","مبلغ الاختبار المعتمد")<input class="form-control" name="amount" type="number" min="0.001" max="@row.ReturnedMerchandiseValue.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)" step="0.001" required /></label>
        <label><input type="checkbox" name="confirmed" value="true" required/> @T("Confirm sandbox refund","تأكيد الاسترداد التجريبي")</label><button class="btn btn-primary" type="submit">@T("Request test refund","طلب استرداد تجريبي")</button></form>
    }
}</td></tr>
}
@if(Model.Count==0){<tr><td colspan="7">@T("No matching physical return evidence","لا توجد أدلة إرجاع مطابقة")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="RefundReview" asp-route-page="@(page-1)" class="btn btn-default">@T("Previous","السابق")</a>}
@if(ViewBag.HasNext==true){<a asp-action="RefundReview" asp-route-page="@(page+1)" class="btn btn-default">@T("Next","التالي")</a>}
