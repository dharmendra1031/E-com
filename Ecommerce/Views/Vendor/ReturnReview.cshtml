@model List<EcommerceWebApplication.Models.ViewModels.MarketplaceReturnRow>
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;string T(string en,string arabic)=>ar?arabic:en;int page=ViewBag.Page;ViewData["Title"]=T("Marketplace returns","إرجاع السوق");}
<h2>@ViewData["Title"]</h2>
<p>@T("Confirm receipt only for physically inspected, saleable stock. No refund is issued.","أكد الاستلام فقط للبضائع المفحوصة والقابلة للبيع. لا يتم استرداد المبلغ.")</p>
@if(TempData["ReturnMessage"] is string message){<p role="status">@message</p>}
<div class="admin-table-scroll"><table class="table"><thead><tr><th>@T("Order","الطلب")</th><th>@T("Product","المنتج")</th><th>@T("Qty","الكمية")</th><th>@T("Reason","السبب")</th><th>@T("Status","الحالة")</th><th>@T("Action","الإجراء")</th></tr></thead><tbody>
@foreach(var row in Model)
{
    <tr><td>#@row.OrderId</td><td>@(ar&&!string.IsNullOrWhiteSpace(row.ProductNameArb)?row.ProductNameArb:row.ProductName)</td><td>@row.Quantity</td><td>@row.Reason</td><td>@(row.Status switch {"Pending"=>T("Pending","قيد المراجعة"),"Approved"=>T("Approved","معتمد"),"Rejected"=>T("Rejected","مرفوض"),"Received"=>T("Received","تم الاستلام"),_=>row.Status})</td><td>
    @if(row.Status=="Pending"||row.Status=="Approved")
    {
        <form asp-action="ReviewReturn" method="post">
            <input type="hidden" name="returnId" value="@row.ReturnId" />
            <input type="hidden" name="expectedStatus" value="@row.Status" />
            @if(row.Status=="Pending"){
                <button class="btn btn-primary" name="newStatus" value="Approved">@T("Approve","اعتماد")</button>
                <button class="btn btn-default" name="newStatus" value="Rejected">@T("Reject","رفض")</button>
            }else{
                <button class="btn btn-primary" name="newStatus" value="Received">@T("Confirm saleable receipt","تأكيد استلام صالح للبيع")</button>
            }
        </form>
    }
    </td></tr>
}
@if(Model.Count==0){<tr><td colspan="6">@T("No return requests","لا توجد طلبات إرجاع")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="ReturnReview" asp-route-page="@(page-1)" class="btn btn-default">@T("Previous","السابق")</a>}
@if(ViewBag.HasNext==true){<a asp-action="ReturnReview" asp-route-page="@(page+1)" class="btn btn-default">@T("Next","التالي")</a>}
