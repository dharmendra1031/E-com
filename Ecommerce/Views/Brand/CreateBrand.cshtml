@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EcommerceWebApplication.Models.BrandModel

@{
    ViewData["Title"] = "Brand";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content admin-master-editor admin-product-editor">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">

                <!-- HEADER -->
                <div class="card-header">
                    <div class="row admin-master-heading">
                        <h4>
                            @(Model.BrandId == 0
                                                        ? _localizer["Create Brand"]
                                                        : _localizer["Update Brand"])
                        </h4>

                        <div class="card-header-right-icon">
                            <ul>
                                <li>
                                    <a asp-controller="Brand" asp-action="Index" class="btn btn-primary me-2">
                                        <i class="ti-pencil-alt bg-info"></i> @_localizer["Brand List"]
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <hr />
                </div>

                <!-- FORM BODY -->
                <div class="row">
                    <div class="basic-form" id="NavigationKey">

                        <form asp-controller="Brand" asp-action="CreateBrand" id="DealsForm" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="BrandId" />

                            <!-- Row 1 -->
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Brand Name (AR)"] <span style="color:red">*</span></label>
                                        <input asp-for="BrandNameAr" dir="rtl" class="form-control input-default" />
                                        <span asp-validation-for="BrandNameAr" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Brand Name (EN)"] <span style="color:red">*</span></label>
                                        <input asp-for="BrandNameAEn" dir="ltr" class="form-control input-default" />
                                        <span asp-validation-for="BrandNameAEn" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Description[AR]"]</label>
                                        <textarea asp-for="Discriptionar" dir="rtl" class="form-control input-flat focusOnEnter" data-val="false"></textarea>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Description[EN]"]</label>
                                        <textarea asp-for="Discriptionen" dir="ltr" class="form-control input-flat focusOnEnter" data-val="false"></textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Row 2 -->
                            <div class="row">


                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Discount (%)"]</label>
                                        <input asp-for="DiscountPersent" id="DiscPer" class="form-control input-default" onkeypress="return numeric(event)" />
                                        <span asp-validation-for="DiscountPersent" class="text-danger"></span>
                                    </div>
                                </div>
                               
                                <div class="col-md-6">
                                    <div class="form-group">

                                        <label class="fw-bold">@_localizer["Brand Logo"] <span style="color:red">*</span></label>
                                        <input type="file" id="categoryImageInput" name="Brandlogo" class="form-control input-focus" accept="image/*" />

                                        <div class="mt-2">
                                            <img id="imagePreview"
                                                 src="@(Model.BrandLogo != null ? $"data:image/jpeg;base64,{Convert.ToBase64String(Model.BrandLogo)}" : "#")"
                                                 alt="Image Preview"
                                                 style="@(Model.BrandLogo != null ? "" : "display:none;") max-width:150px; max-height:150px; border:1px solid #ddd; padding:5px; border-radius:6px;" />
                                        </div>

                                        <small id="imageError" class="text-danger" style="display:none;">
                                            @_localizer["Please select an image."]
                                        </small>

                                    </div>
                                </div>



                            </div>


                            <!-- Submit -->
                            <div class="admin-form-actions"><a asp-action="Index" class="btn btn-default">@_localizer["Cancel"]</a>
                                <button type="submit" class="btn btn-primary btn-flat">
                                    @(Model.BrandId == 0 ? _localizer["Save"] : _localizer["Update"])
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker3.min.css" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

                   $(document).ready(function () {
            $("#DealsForm").on("submit", function (e) {

                let discValue = $("#DiscPer").val().trim();
                let disc = parseFloat(discValue);
                let errorSpan = $("span[data-valmsg-for='DiscPer']");

                // Reset msg
                errorSpan.text("");

                // ❌ Reject only if > 99
                if (disc > 99) {
                    e.preventDefault();
                    errorSpan.text("Maximum allowed discount is 99.");
                    return false;
                }

                return true;
            });
        });


    </script>


    <script>
        // Brand logo - live image preview
        $("#categoryImageInput").change(function () {
            const file = this.files[0];

            if (file) {
                let reader = new FileReader();
                reader.onload = function (e) {
                    $("#imagePreview")
                        .attr("src", e.target.result)
                        .show();
                };
                reader.readAsDataURL(file);
            }
        });
    </script>




}
