@model List<EcommerceWebApplication.Models.ViewModels.BrandWiseProductsViewModel>
@{
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var isArabic = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = isArabic ? "العلامات التجارية" : "Brands";
    var brands = ViewBag.AllBrands as List<EcommerceWebApplication.Models.ViewModels.BrandWiseProductsViewModel>;
    var selectedBrandId = ViewBag.SelectedBrandId as int?;
}
<div class="container-fluid py-3 store-wide">
    <h1 class="h4 store-heading">@ViewData["Title"]</h1>
    @if (brands != null && brands.Any())
    {
        <nav class="storefront-brands mb-4" aria-label="@ViewData["Title"]">
            @foreach (var brand in brands)
            {
                <a href="@Url.Action("Index", new { brandId = brand.BrandId })" class="text-decoration-none" aria-current="@(selectedBrandId == brand.BrandId ? "true" : null)">
                    <div class="brand-tile">
                        @if (!string.IsNullOrEmpty(brand.BrandImageBase64))
                        {
                            <img src="@brand.BrandImageBase64" alt="" loading="lazy" />
                        }
                        <span>@brand.BrandName</span>
                    </div>
                </a>
            }
        </nav>
    }
    @if (Model != null && Model.Any())
    {
        foreach (var brand in Model)
        {
            <section class="mb-4">
                <h2 class="h5 store-heading">@brand.BrandName</h2>
                @await Html.PartialAsync("~/Views/WebCategory/_ProductsPartial.cshtml", brand.Products)
            </section>
        }
    }
    else
    {
        <p class="text-center py-5">@(isArabic ? "لا توجد منتجات" : "No products found")</p>
    }
</div>
