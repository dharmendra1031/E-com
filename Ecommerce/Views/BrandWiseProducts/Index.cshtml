@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.BrandWiseProductsViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Brands";
    Layout = "~/Views/Shared/_WebLayout.cshtml";

    var brands = ViewBag.AllBrands as List<EcommerceWebApplication.Models.ViewModels.BrandWiseProductsViewModel>;
    var selectedBrandId = ViewBag.SelectedBrandId as int?;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<style>
    .brand-heading {
        font-weight: 600;
        border-bottom: 2px solid #ddd;
        padding-bottom: 4px;
    }

    .product-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 14px rgba(0,0,0,.08);
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: .3s;
    }

        .product-card:hover {
            transform: translateY(-4px);
        }

    .product-link {
        text-decoration: none;
        color: inherit;
        flex-grow: 1;
    }

    /* IMAGE */
    .product-img {
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        background: #f8f9fa;
    }

        .product-img img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    /* INFO */
    .product-info {
        padding: 10px;
    }

    .product-name {
        font-size: .9rem;
        font-weight: 600;
        min-height: 2.5em;
    }

    .stock {
        font-size: .75rem;
        font-weight: 600;
        margin: 4px 0;
    }

    .in-stock {
        color: #28a745;
    }

    .out-stock {
        color: #dc3545;
    }

    .rating {
        font-size: .8rem;
        color: #f1c40f;
    }

    /* FOOTER */
    .product-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 12px;
        border-top: 1px solid #eee;
        background: #fafafa;
    }

    .price {
        font-weight: 700;
        font-size: .9rem;
    }

    .add-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: none;
        background: #3498db;
        color: #fff;
        font-size: 18px;
        cursor: pointer;
    }

        .add-btn:disabled {
            background: #aaa;
            cursor: not-allowed;
        }

    .itemdiv{
        width: 130px;
    }

    .img-size{
        padding:1rem;
        height: 80px;
        object-fit: contain;
    }

    .brandname{
        font-weight: 600;
        padding-bottom: 0.5rem;
        color: #212529;
        font-size:1rem;
    }

    .brand-heading{
        font-weight: 700;
        font-size: 1.2rem;
    }
    @@media (max-width: 768px) 
    {
        .itemdiv {
            width: 90px;
        }

        .img-size {
            padding: 0.9rem;
            height: 50px;
            object-fit: contain;
        }

        .brandname {
            font-weight: 500;
            padding-bottom: 0.5rem;
            color: #212529;
            font-size: 0.8rem;
        }

        .brand-heading {
            font-weight: 700;
            font-size: 1rem;
        }
    }

    @@media(max-width: 575px) {
        .itemdiv {
            width: 50px;
        }

        .img-size {
            padding: 0.2rem;
            height: 30px;
            object-fit: contain;
        }

        .brandname {
            font-weight: 400;
            padding-bottom: 0.5rem;
            color: #212529;
            font-size: 0.5rem;
        }

        .brand-heading {
            font-weight: 600;
            font-size: 0.9rem;
        }
    }
    
</style>
<div class="row justify-content-center mt-1 mb-1">
    <div class="container my-0 col-md-11">

        <div class="mb-1">
            <div class="d-flex flex-nowrap overflow-auto gap-2 pb-2">

                @if (brands != null && brands.Any())
                {
                    @foreach (var brand in brands)
                    {
                        bool isActive = selectedBrandId.HasValue && brand.BrandId == selectedBrandId;

                        <a href="@Url.Action("Index", new { brandId = brand.BrandId })"
                           class="text-decoration-none">

                            <div class="flex-shrink-0 text-center itemdiv">
                                <div class="card rounded-4 shadow-sm
                                @(isActive ? "border border-2 border-primary bg-primary bg-opacity-10" : "border-0")">

                                    <img src="@brand.BrandImageBase64"
                                         class="img-size"
                                         style="" />

                                    <div class="brandname">
                                        @brand.BrandName
                                    </div>
                                </div>
                            </div>
                        </a>
                    }

                }
            </div>
        </div>

       
