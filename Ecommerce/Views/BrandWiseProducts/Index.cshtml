 *@
        @foreach (var brand in Model)
        {
            <!-- BRAND HEADING -->
            <div class="row">
                <div class="col-12 text-center my-2">
                    <span class="brand-heading">@brand.BrandName</span>
                </div>
            </div>

            <!-- PRODUCTS -->
            <div class="row g-2 justify-content-center">

                @foreach (var item in brand.Products)
                {
                    <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-4 col-sm-6 col-11">
                        <div class="product-card">

                            <!-- CLICKABLE AREA -->
                            <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = item.ProductId })"
                               class="product-link">

                                <!-- IMAGE -->
                                <div class="product-img">
                                    <img src="@item.ProductImageBase64" alt="@item.Name" />
                                </div>

                                <!-- INFO -->
                                <div class="product-info">
                                    <div class="product-name">
                                        @(item.Name?.Length > 60 ? item.Name.Substring(0, 60) + "..." : item.Name)
                                    </div>

                                    <div class="stock @(item.Stock > 0 ? "in-stock" : "out-stock")">
                                        @(item.Stock > 0 ? "In Stock" : "Out of Stock")
                                    </div>

                                    <div class="rating">
                                        @{
                                            // Calculate rating (you can replace with actual rating from your model)
                                            var rating =item.Rating; // Default rating
                                            var fullStars = (int)rating;
                                            var hasHalfStar = rating - fullStars >= 0.0;

                                            for (int i = 0; i < 5; i++)
                                            {
                                                if (i < fullStars)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i == fullStars && hasHalfStar)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                </div>
                            </a>

                            <!-- FOOTER -->
                            <div class="product-footer">
                                <div class="price">
                                    KD @item.Price.ToString("F3", CultureInfo.InvariantCulture)
                                </div>

                                <button class="add-btn"
                                        data-productid="@item.ProductId"
                                        @(item.Stock <= 0 ? "disabled" : "")>
                                    +
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @* else
        {
            <div class="col-12 text-center text-muted py-5">
                <h6>@_localizer["No products found"]</h6>
            </div>
        } *@

    </div>
</div>

<script>
    $(document).on("click", ".add-to-cart", function () {

        var productId = $(this).data("productid");

        $.ajax({
            url: '/WebCart/AddOrUpdateCart',
            type: 'POST',
            data: {
                productId: productId,
                qty: 1
            },
            success: function (res) {

                if (res.notStock) {
                    Swal.fire({
                        icon: 'warning',
                        text: res.message,
                        confirmButtonText: 'OK',
                        width: 500
                    });
                    return;
                }

                if (res.success) {
                    loadCartCount();
                }
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    text: 'Something went wrong'
                });
            }
        });
    });
</script>
