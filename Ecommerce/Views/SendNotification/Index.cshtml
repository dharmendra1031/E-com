@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EcommerceWebApplication.Models.SendNotificationModel
@{
    ViewData["Title"] = "Send Notification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- Loader -->
<div id="loader" style="display:none; position:fixed; top:0; left:0;
     width:100%; height:100%; background:rgba(255,255,255,0.8);
     z-index:9999; text-align:center; padding-top:200px; font-size:24px;">
    <div class="spinner-border text-primary" role="status" style="width: 5rem; height: 5rem;">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p>Please wait, sending mail...</p>
</div>
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4> @_localizer["Send Notification"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="SaveNotification" method="post" id="NavigationKey">
                        @Html.AntiForgeryToken()

                        <!-- Hidden field for selected emails -->
                        <input type="hidden" name="UserEmails" id="UserEmails" />
                        <!-- Select All Users -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <input type="checkbox" id="selectAllUsers"
                                           style="width:20px; height:20px; margin-right:8px;"asp-for="Customertype" value="AllUsers"/>
                                    <label class="mb-0" for="selectAllUsers">
                                        @_localizer["Select All Users"] <span style="color:red;">*</span>
                                    </label>
                                </div>
                            </div>
                            <!--May be use in future-->
                            <!--<div class="col-md-3">
                                <div class="form-group">
                                    <input type="checkbox" id="selectFrequentlyreview"
                                           style="width:20px; height:20px; margin-right:8px;" asp-for="Customertype" value="Frequentlyreview" />
                                    <label class="mb-0" for="selectFrequentlyreview">
                                        @_localizer["Select Frequently review"] <span style="color:red;">*</span>
                                    </label>
                                </div>
                            </div> 
                           <div class="col-md-3">
                                <div class="form-group">
                                    <input type="checkbox" id="selectInactiveUsers"
                                           style="width:20px; height:20px; margin-right:8px;" asp-for="Customertype" value="selectInactiveUsers" />
                                    <label class="mb-0" for="selectInactiveUsers">
                                        @_localizer["Select Inactive Users"] <span style="color:red;">*</span>
                                    </label>
                                </div>
                             </div> -->

                        </div>
                        <!-- Subject -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label>@_localizer["Subject"] <span style="color:red;">*</span></label>
                                <input asp-for="EmailSubject"class="form-control"placeholder="@_localizer["Enter subject"]"/>
                                <span asp-validation-for="EmailSubject" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Body -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label>@_localizer["Body"] <span style="color:red;">*</span></label>
                                <textarea asp-for="Body" class="form-control" rows="8" placeholder="@_localizer["Enter message"]"></textarea>
                                <span asp-validation-for="Body" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Submit -->
                        <div class="row">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary"style="margin-top:12px;">
                                    @_localizer["Send"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script to push emails in hidden -->
<script>
    document.getElementById("selectAllUsers").addEventListener("change", function () {
        if (this.checked) {
            let emails = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
                                                      Model.UserEmails.Select(u => u.Email).ToList()));
            document.getElementById("UserEmails").value = emails.join(",");
        } else {
            document.getElementById("UserEmails").value = "";
        }
    });



</script>


<script>
    document.getElementById("NavigationKey").addEventListener("submit", function (e) {
      
        if ($("#NavigationKey").valid()) {
            
            Swal.fire({
                title: 'Sending...',
                text: 'Please wait, sending mail...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        } else {
           
            e.preventDefault(); 
        }
    });
</script>

