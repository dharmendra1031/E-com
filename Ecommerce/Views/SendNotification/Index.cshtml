@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EcommerceWebApplication.Models.SendNotificationModel
@{
    ViewData["Title"] = "Send Notification";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4> @_localizer["Send Notification"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="SaveNotification" method="post" id="NavigationKey">
                        @Html.AntiForgeryToken()

                        <!-- Select All Users -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <div class="form-group">
                                    <input type="checkbox" id="selectAllUsers"
                                           class="form-check-input" name="Customertype" value="AllUsers" />
                                    <label class="mb-0" for="selectAllUsers">
                                        @_localizer["Select All Users"] <span style="color:red;">*</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <!-- Subject -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label>@_localizer["Subject"] <span style="color:red;">*</span></label>
                                <input asp-for="EmailSubject"class="form-control"placeholder="@_localizer["Enter subject"]"/>
                                <span asp-validation-for="EmailSubject" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Body -->
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label>@_localizer["Body"] <span style="color:red;">*</span></label>
                                <textarea asp-for="Body" class="form-control" rows="8" placeholder="@_localizer["Enter message"]"></textarea>
                                <span asp-validation-for="Body" class="text-danger"></span>
                            </div>
                        </div>
                        <!-- Submit -->
                        <div class="row">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-primary"style="margin-top:12px;">
                                    @_localizer["Send"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("NavigationKey").addEventListener("submit", function (e) {
            if (!document.getElementById("selectAllUsers").checked ||
                !document.getElementById("EmailSubject").value.trim() ||
                !document.getElementById("Body").value.trim()) {
                e.preventDefault();
                AdminFeedback.show("warning", document.documentElement.dir === "rtl" ? "حدد المستلمين وأدخل الموضوع والرسالة." : "Select recipients and enter the subject and message.");
            }
        });
    </script>
}
