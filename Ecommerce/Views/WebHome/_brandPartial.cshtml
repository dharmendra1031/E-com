@using EcommerceWebApplication.Models.ViewModels
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{ var brands = ViewBag.Brands as List<BrandViewModel>; }
@if (brands?.Any() == true)
{
    <section class="col-12 col-md-11 px-3 px-md-0">
        <div class="store-home-section">
            <div class="store-section-heading"><h2 class="h4 mb-0">@_localizer["BRANDS WE"]</h2></div>
            <div id="brandTrack" class="store-brand-grid">
                @foreach (var brand in brands)
                {
                    <a href="@Url.Action("Index", "BrandWiseProducts", new { brandId = brand.BrandId })" class="store-brand-tile text-decoration-none">
                        @if (!string.IsNullOrEmpty(brand.BrandlogoBase64) && !brand.BrandlogoBase64.Contains("default-brand.png"))
                        {
                            <img src="@brand.BrandlogoBase64" alt="" loading="lazy" decoding="async" />
                        }
                        <span>@brand.BrandNameAEn</span>
                    </a>
                }
            </div>
        </div>
    </section>
}
