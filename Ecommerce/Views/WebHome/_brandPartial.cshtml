@using EcommerceWebApplication.Models.ViewModels
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var brands = ViewBag.Brands as List<BrandViewModel>;
}
<div class="container my-4 col-md-11">

    <!-- TITLE -->
    <div class="p-4 rounded mb-3" id="brandHeader"
         style="background: linear-gradient(to right, #14a2d7, #f9f1d7);">
        <h2 class="text-center fw-bold">
            @_localizer["BRANDS WE"] <span style="color:#0d466f;">&#10084;</span>
        </h2>
    </div>

    <!-- SLIDER -->
    <div class="position-relative">

        <!-- PREV (same as banner) -->
        <button type="button"
                class="carousel-control-prev brand-control"
                id="prevBtn">
            <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark"></span>
        </button>

        <!-- VIEWPORT -->
        <div class="overflow-hidden">
            <div class="d-flex" id="brandTrack">
                @if (brands != null && brands.Count > 0)
                {
                    foreach (var brand in brands)
                    {
                        <a href="/BrandWiseProducts/Index?brandId=@brand.BrandId"
                               class="text-decoration-none text-dark">
                        <div class="brand-item text-center">
                            <img src="@brand.BrandlogoBase64"
                                 alt="@brand.BrandNameAEn"
                                 title="@brand.BrandNameAEn" />
                        </div>
                        </a>
                    }
                }
            </div>
        </div>

        <!-- NEXT (same as banner) -->
        <button type="button"
                class="carousel-control-next brand-control"
                id="nextBtn">
            <span class="carousel-control-next-icon rounded-circle p-3 bg-dark"></span>
        </button>

    </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<style>
    .brand-item {
        min-width: 180px;
        padding: 10px;
    }

        .brand-item img {
            height: 60px;
            width: 100%;
            object-fit: contain;
        }

    #brandTrack {
        transition: transform 0.6s ease-in-out;
    }

    /* banner jaise buttons positioning */
    .brand-control {
        width: 50px;
    }

</style>
<script>
    const track = document.getElementById("brandTrack");
    const items = document.querySelectorAll(".brand-item");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");

    const itemWidth = items[0].offsetWidth;
    const totalItems = items.length;

    const viewport = document.querySelector(".overflow-hidden");
    const visibleItems = Math.floor(viewport.offsetWidth / itemWidth);

    let index = 0;
    const maxIndex = totalItems - visibleItems;

    function updateButtons() {
        prevBtn.disabled = index === 0;
        nextBtn.disabled = index === maxIndex;

        prevBtn.style.opacity = prevBtn.disabled ? "0.4" : "1";
        nextBtn.style.opacity = nextBtn.disabled ? "0.4" : "1";
    }

    function move(step) {
        index += step; // 🔥 ek-ek item

        if (index < 0) index = 0;
        if (index > maxIndex) index = maxIndex;

        track.style.transform = `translateX(-${index * itemWidth}px)`;
        updateButtons();
    }

    nextBtn.addEventListener("click", () => move(1));
    prevBtn.addEventListener("click", () => move(-1));

    // initial state
    updateButtons();

    // resize safe
    //window.addEventListener("resize", () => location.reload());
</script>
<script>

    $(document).ready(function () {

        $.ajax({
            url: '/Changecolors/GetColor',
            type: 'GET',
            success: function (res) {

                if (res.success && res.color) {

                    let dynamicColor = res.color;

                   
                    $("#brandHeader").css(
                        "background",
                        `linear-gradient(to right, ${dynamicColor}, #f9f1d7)`
                    );
                }
            }
        });

    });

</script>