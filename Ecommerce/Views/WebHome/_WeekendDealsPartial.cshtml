@using System.Globalization
@model HomeViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{ var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var summaries = ViewBag.SellerSummaries as Dictionary<int, EcommerceWebApplication.Models.ViewModels.MarketplaceOfferSummary>;
}
<div class="mb-3">
    <section class="store-home-section">
        <div class="store-section-heading">
            <h2 class="h4 mb-0">@_localizer["Weekend Deals"]</h2>
            <a href="~/Wekenddealwiseproducts/Index" class="fw-semibold text-decoration-none">@_localizer["View All"]</a>
        </div>
        <div class="store-home-grid">
            @if (Model.WeekendDeals != null && Model.WeekendDeals.Any())
            {
                foreach (var deal in Model.WeekendDeals)
                {
                    <a class="store-home-product text-decoration-none" href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = deal.ProductId })">
                        <div class="store-home-image">
                            @if (deal.ProductImagesBase64?.Any() == true)
                            {
                                <img src="@deal.ProductImagesBase64.First()" alt="" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="text-secondary small">@(ar ? "لا توجد صورة" : "No image")</span>
                            }
                            <span class="store-offer-badge" dir="ltr">@deal.DiscPer% @(ar ? "خصم" : "OFF")</span>
                        </div>
                        <div class="store-home-product-body">
                            <h3>@(ar && !string.IsNullOrWhiteSpace(deal.ProductNameAr) ? deal.ProductNameAr : deal.ProductName)</h3>
                            <div class="mt-auto">
                                <s class="small text-secondary" dir="ltr">KD @deal.ProductPrice.ToString("F3", CultureInfo.InvariantCulture)</s>
                                <div class="store-home-price" dir="ltr">KD @deal.OfferPrice.ToString("F3", CultureInfo.InvariantCulture)</div>
                                @if (summaries != null && deal.ProductId.HasValue && summaries.TryGetValue(deal.ProductId.Value, out var offer))
                                {
                                    <small class="text-secondary">@(ar ? "معاينة البائعين من" : "Seller preview from") <bdi>KD @offer.LowestPrice.ToString("F3", CultureInfo.InvariantCulture)</bdi> (@offer.SellerCount)</small>
                                }
                            </div>
                        </div>
                    </a>
                }
            }
            else
            {
                <p class="store-home-empty">@_localizer["No weekend deals available"]</p>
            }
        </div>
    </section>
    <section class="store-home-section mt-4">
        <div class="store-section-heading"><h2 class="h4 mb-0">@_localizer["In Focus"]</h2></div>
        <div id="in-focus-container" class="store-home-grid" aria-live="polite" aria-busy="true">
            @for (int i = 0; i < 4; i++)
            {
                <div class="store-home-skeleton" aria-hidden="true"></div>
            }
        </div>
    </section>
</div>
<script>
(() => {
    const container = document.getElementById("in-focus-container");
    const ar = document.documentElement.lang === "ar";
    function showMessage(text) {
        const message = document.createElement("p");
        message.className = "store-home-empty";
        message.textContent = text;
        container.replaceChildren(message);
    }
    async function loadFeatured() {
        try {
            const response = await fetch("/WebHome/GetTopRatedProducts");
            if (!response.ok) throw new Error("Unable to load featured products");
            const data = await response.json();
            if (!Array.isArray(data) || !data.length) {
                showMessage(ar ? "لا توجد منتجات مميزة" : "No featured products available");
                return;
            }
            container.replaceChildren();
            for (const item of data) {
                const card = document.createElement("a");
                card.className = "store-home-product text-decoration-none";
                card.href = "/WebSingleProduct/SingleProduct/" + encodeURIComponent(item.productId);
                const media = document.createElement("div");
                media.className = "store-home-image";
                if (item.imageUrl) {
                    const image = document.createElement("img");
                    image.src = item.imageUrl;
                    image.alt = "";
                    image.loading = "lazy";
                    image.decoding = "async";
                    media.append(image);
                } else {
                    const placeholder = document.createElement("span");
                    placeholder.className = "text-secondary small";
                    placeholder.textContent = ar ? "لا توجد صورة" : "No image";
                    media.append(placeholder);
                }
                const body = document.createElement("div");
                body.className = "store-home-product-body";
                const name = document.createElement("h3");
                name.textContent = item.name || "";
                const rating = document.createElement("div");
                rating.className = "small text-secondary";
                rating.textContent = "★ " + Number(item.averageRating).toFixed(1) + " (" + item.totalReviews + ")";
                const price = document.createElement("bdi");
                price.className = "store-home-price mt-auto";
                price.textContent = "KD " + Number(item.price).toFixed(3);
                body.append(name,rating,price);
                if (item.lowestSellerPrice != null) {
                    const seller = document.createElement("small");
                    seller.className = "text-secondary";
                    seller.textContent = (ar ? "معاينة البائعين من " : "Seller preview from ") + "KD " + Number(item.lowestSellerPrice).toFixed(3) + " (" + item.availableSellerCount + ")";
                    body.append(seller);
                }
                card.append(media,body);
                container.append(card);
            }
        } catch {
            showMessage(ar ? "تعذر تحميل المنتجات." : "Unable to load featured products.");
            const retry = document.createElement("button");
            retry.type = "button";
            retry.className = "btn btn-outline-primary";
            retry.textContent = ar ? "إعادة المحاولة" : "Try again";
            retry.addEventListener("click", () => { retry.disabled = true; container.setAttribute("aria-busy","true"); loadFeatured(); }, {once:true});
            container.append(retry);
        } finally { container.removeAttribute("aria-busy"); }
    }
    if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(entries => {
            if (entries.some(entry => entry.isIntersecting)) {
                observer.disconnect();
                loadFeatured();
            }
        }, {rootMargin:"200px"});
        observer.observe(container);
    } else loadFeatured();
})();
</script>
