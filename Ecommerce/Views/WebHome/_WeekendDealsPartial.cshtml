@using System.Globalization
@model HomeViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var targetDate = DateTime.Today.AddDays(1).AddHours(18); 
}

<div class="container my-2 col-md-11">
    <div class="row">

        <!-- LEFT SECTION: Weekend Deals -->
        <div class="col-lg-6 col-md-12 mb-4 bg-white border rounded-3 shadow-sm p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
                <h4 class="fw-bold">@_localizer["Weekend Deals"]</h4>

                <!-- TIMER BOX using Bootstrap -->
                <div class="d-flex gap-2 d-none">
                    <div class="bg-dark text-white text-center p-1 rounded" style="min-width:50px; font-size:14px;">
                        <div id="hours">00</div>
                        <small>Hrs</small>
                    </div>
                    <div class="bg-dark text-white text-center p-1 rounded" style="min-width:50px; font-size:14px;">
                        <div id="minutes">00</div>
                        <small>Min</small>
                    </div>
                    <div class="bg-dark text-white text-center p-1 rounded" style="min-width:50px; font-size:14px;">
                        <div id="seconds">00</div>
                        <small>Sec</small>
                    </div>
                </div>
            </div>

            <div class="row g-2">
                @if (Model.WeekendDeals != null && Model.WeekendDeals.Any())
                {
                    foreach (var deal in Model.WeekendDeals)
                    {
                       
                        <div class="col-6 col-xl-4">
                            <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = deal.ProductId })" class="text-decoration-none text-dark">

                            <div class="card h-100 shadow-sm position-relative overflow-hidden transition" style="font-size:0.85rem; cursor:pointer;"
                                 >
                                <span class="badge bg-danger position-absolute top-0 start-0 m-1">@deal.DiscPer% OFF</span>
                                <img src="@(deal.ProductImagesBase64 != null && deal.ProductImagesBase64.Any() ? deal.ProductImagesBase64.First() : "/images/default-product.png")"
                                     class="card-img-top" style="aspect-ratio:4/3; object-fit:contain;" alt="@deal.ProductName" loading="lazy" decoding="async" />
                                <div class="card-body p-2">
                                    <p class="card-title fw-semibold mb-1" style="font-size:0.9rem;">
                                        @(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft? deal.ProductNameAr: deal.ProductName)
                                    </p>

                                        @if (deal.ProductPrice > 0 && deal.OfferPrice > 0)
                                    {
                                        <p class="text-muted mb-1 text-decoration-line-through" style="font-size:0.8rem;">KD @deal.ProductPrice.ToString("F3", CultureInfo.InvariantCulture)</p>
                                            <p class="fw-bold mb-0" style="font-size:0.9rem;"> @deal.OfferPrice.ToString("F3", CultureInfo.InvariantCulture) KD</p>
                                    }
                                </div>
                            </div>
                            </a>
                        </div>
                       
                    }
                }
                else
                {
                    <div class="col-12 text-muted">
                        @_localizer["No weekend deals available"]
                    </div>
                }
            </div>

           @*  <div class="text-center mt-2">
                <button class="btn btn-dark btn-sm px-4" id="viewAllDeals" asp-action="Index" asp-controller="Wekenddealwiseproducts">View All</button>
            </div> *@
           <div class="text-center mt-2">
                <a href="/Wekenddealwiseproducts/Index" class="btn btn-dark btn-sm px-4">@_localizer["View All"]</a>
            </div> 
        </div>

        <!-- RIGHT SECTION: In Focus -->
        <div class="col-lg-6 col-md-12 mb-4 bg-white border rounded-3 shadow-sm p-3">
            <h4 class="fw-bold">@_localizer["In Focus"]</h4>

            <div id="in-focus-container" class="row">

                <div class="text-muted">@_localizer["Loading"]...</div>
            </div>
        </div>

    </div>
</div>

<script>
    $(document).ready(function () {
        // AJAX In Focus Products
        $.ajax({
            url: '/WebHome/GetTopRatedProducts',
            type: 'GET',
            success: function (data) {
                var container = $('#in-focus-container');
                container.empty();

                if (!data || data.length === 0) {
                    container.append('<div class="text-muted">@_localizer["No items in focus"]</div>');
                    return;
                }

                data.slice(0, 2).forEach(function (item) {
                    var html = `
                        <div class="col-6 mb-2">
                             <a href="/WebSingleProduct/SingleProduct?id=${item.productId}"
       class="text-decoration-none text-dark">
        <div class="card h-100 shadow-sm overflow-hidden transition"
             style="font-size:0.85rem; cursor:pointer;"
             >

            <img src="${item.imageUrl}"
                 class="card-img-top rounded"
                 style="aspect-ratio:4/3; object-fit:contain;" loading="lazy" decoding="async" alt="" />

            <div class="card-body p-2">
                <p class="fw-bold mb-1" style="font-size:0.9rem;">
                    ${item.name}
                </p>
                <small class="text-muted">
                    ⭐ ${item.averageRating.toFixed(1)} (${item.totalReviews} Reviews)
                </small>
            </div>
        </div>
    </a>

                        </div>
                    `;
                    container.append(html);
                });
            },
            error: function (err) {
                $('#in-focus-container').html('<div class="text-danger">Failed to load top products</div>');
                console.error(err);
            }
        });

        // Countdown Timer
        function startCountdown() {
            var target = new Date('@targetDate.ToString("yyyy-MM-ddTHH:mm:ss")').getTime();
            var interval = setInterval(function () {
                var now = new Date().getTime();
                var distance = target - now;

                if (distance < 0) {
                    clearInterval(interval);
                    $('#hours, #minutes, #seconds').text('00');
                    return;
                }

                var hours = Math.floor((distance / (1000 * 60 * 60)) % 24);
                var minutes = Math.floor((distance / (1000 * 60)) % 60);
                var seconds = Math.floor((distance / 1000) % 60);

                $('#hours').text(hours < 10 ? '0' + hours : hours);
                $('#minutes').text(minutes < 10 ? '0' + minutes : minutes);
                $('#seconds').text(seconds < 10 ? '0' + seconds : seconds);
            }, 1000);
        }

        startCountdown();
    });
</script>
