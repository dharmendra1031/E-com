@{
    var banners = ViewBag.Banners as List<EcommerceWebApplication.Models.BannerModel>;
    var arabic = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}

<section class="store-home-hero mb-3">
    <div class="store-hero-copy">
        <h1>@(arabic ? "تقنيات تناسب حياتك" : "Technology for everyday life")</h1>
        <p>@(arabic ? "اكتشف الإلكترونيات والملحقات." : "Explore electronics, networking and accessories.")</p>
        <a href="~/WebCategory/Index" class="btn btn-primary px-4">@(arabic ? "تسوق الآن" : "Shop now")</a>
    </div>
    <div id="homeBannerCarousel" class="carousel slide" data-bs-interval="false" aria-label="@(arabic ? "عروض المتجر" : "Store offers")">
        <div class="carousel-inner rounded-3">
            @if (banners != null && banners.Count > 0)
            {
                @for (int i = 0; i < banners.Count; i++)
                {
                    var banner = banners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@Url.Action("Banner", "StoreImage", new { id = banner.BannerId })" class="d-block w-100 banner-image" alt="@(arabic ? banner.TitleArabic : banner.Title)" loading="@(i == 0 ? "eager" : "lazy")" fetchpriority="@(i == 0 ? "high" : "auto")" />
                    </div>
                }
            }
            else
            {
                <!-- Fallback default images -->
                <div class="carousel-item active">
                    <img src="~/Images/new1.jpg" class="d-block w-100 banner-image" alt="" fetchpriority="high" />
                </div>
            }
        </div>

        @if (banners?.Count > 1)
        {
        <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev" aria-label="@(arabic ? "السابق" : "Previous banner")">
            <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next" aria-label="@(arabic ? "التالي" : "Next banner")">
            <span class="carousel-control-next-icon rounded-circle p-3 bg-dark"></span>
        </button>
        }
    </div>
</section>
