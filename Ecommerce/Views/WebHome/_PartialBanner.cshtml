@{
    var banners = ViewBag.Banners as dynamic;
}

<div class="col-12 col-md-11">
    <div id="homeBannerCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner shadow rounded-4">
            @if (banners != null && banners.Count > 0)
            {
                @for (int i = 0; i < banners.Count; i++)
                {
                    var banner = banners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@banner.BannerImageBase64" class="d-block w-100 banner-image" />
                    </div>
                }
            }
            else
            {
                <!-- Fallback default images -->
                <div class="carousel-item active">
                    <img src="~/images/new1.jpg" class="d-block w-100 banner-image" />
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#homeBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon rounded-circle p-3 bg-dark"></span>
        </button>
    </div>
</div>
