@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{ var categories = ViewBag.Categories as List<Category>; }
@if (categories?.Any() == true)
{
    <section class="mb-3">
        <div class="store-home-section">
            <div class="store-section-heading"><h2 class="h4 mb-0">@_localizer["All Categories"]</h2></div>
            <div id="categoryTrack" class="store-category-grid">
                @foreach (var cat in categories)
                {
                    <a href="@Url.Action("Index", "WebCategory", new { categoryId = cat.CategoryId })" class="store-category-tile text-decoration-none">
                        @if (!string.IsNullOrEmpty(cat.ImageBase64) && !cat.ImageBase64.Contains("default-category.png"))
                        {
                            <img src="@cat.ImageBase64" alt="" loading="lazy" decoding="async" />
                        }
                        <span>@cat.CName</span>
                    </a>
                }
            </div>
        </div>
    </section>
}
