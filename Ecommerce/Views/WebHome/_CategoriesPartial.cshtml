@{
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container my-4 col-md-11">


    <!-- SLIDER -->
    <div class="position-relative">

        

        <!-- VIEWPORT -->
        <div class="home-category-viewport">
            <div id="categoryTrack">

                @if (categories != null && categories.Count > 0)
                {
                    foreach (var cat in categories)
                    {
                        <div class="category-item text-center">

                            <a href="/WebCategory/Index?categoryId=@cat.CategoryId"
                               class="text-decoration-none text-dark">

                                <img src="@cat.ImageBase64"
                                     class="category-img rounded-circle p-2" alt="" loading="lazy" decoding="async" />

                                <p class="fw-bold mt-2 small">@cat.CName</p>
                            </a>

                        </div>
                    }
                }

            </div>
        </div>

        

    </div>
</div>


<style>
    #categoryTrack { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 110px), 1fr)); gap: 12px; }
    #categoryTrack .category-item { min-width: 0; padding: 8px; }
    #categoryTrack .category-img { width: min(100%, 108px); aspect-ratio: 1; object-fit: contain; border: 1px solid #e2e8f0; }
    #categoryTrack p { overflow-wrap: anywhere; color: #111; margin-block-end: 0; }
</style>
