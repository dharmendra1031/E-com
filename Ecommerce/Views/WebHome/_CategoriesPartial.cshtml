@{
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container my-4 col-md-11">


    <!-- SLIDER -->
    <div class="position-relative">

        <!-- PREV -->
        <button type="button"
                class="carousel-control-prev category-control"
                id="catPrevBtn">
            <span class="carousel-control-prev-icon rounded-circle p-3 bg-dark"></span>
        </button>

        <!-- VIEWPORT -->
        <div class="overflow-hidden">
            <div class="justify-content-center d-flex" id="categoryTrack">

                @if (categories != null && categories.Count > 0)
                {
                    foreach (var cat in categories)
                    {
                        <div class="category-item text-center">

                            <a href="/WebCategory/Index?categoryId=@cat.CategoryId"
                               class="text-decoration-none text-dark">

                                <img src="@cat.ImageBase64"
                                     class="category-img rounded-circle p-2" />

                                <p class="fw-bold mt-2 small">@cat.CName</p>
                            </a>

                        </div>
                    }
                }

            </div>
        </div>

        <!-- NEXT -->
        <button type="button"
                class="carousel-control-next category-control"
                id="catNextBtn">
            <span class="carousel-control-next-icon rounded-circle p-3 bg-dark"></span>
        </button>

    </div>
</div>


<style>
    /* .position-relative {
        width: 100%;
    } */

    .overflow-hidden {
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        scroll-behavior: smooth;
        cursor: grab;
    }

        .overflow-hidden:active {
            cursor: grabbing;
        }

    .category-item {
        min-width: 180px;
        padding: 10px;
        /* flex: 0 0 auto; */
    }

    .category-img {
        width: 140px;
        height: 140px;
        object-fit: cover;
        border: 4px solid #FFD700;
        border-top-color: transparent;
        box-sizing: border-box;
    }

    .category-control {
        width: 45px;
        display: none; /* hidden by default */
        z-index: 10;
    }

    /* Hide scrollbar */
    .overflow-hidden::-webkit-scrollbar {
        display: none;
    }

    .overflow-hidden {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style> 
