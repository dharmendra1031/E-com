@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.CategoryListViewModel>
@{
    ViewData["Title"] = "Categories List";
    var categoryJson = System.Text.Json.JsonSerializer.Serialize(Model);
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
               
                <form id="filterForm" class="form-inline mb-3" style="margin-bottom: 11px;">
                    <div class="row">
                        <div class="col-md-10" id="NavigationKey">
                            <div class="form-group me-3" style="position:relative;">
                                <label for="name" class="me-1" style="margin-right: 5px;">@_localizer["Name"]:</label>
                                <input type="text" id="name" name="name" class="form-control" autocomplete="off" value="@ViewBag.FilterName" style="width: 150px; display: inline-block;" />
                                <ul id="suggestions" style="display:none;
                                position:absolute;
                                background:white;
                                list-style:none;
                                padding:0;
                                margin:0;
                                width:100%;  /* width same as input */
                                max-height:200px;
                                overflow-y:auto;
                                border:1px solid #ccc;
                                z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>
                          

                          
                          
                            <div class="form-group me-3">
                                <label for="status" class="me-1">@_localizer["Status"]:</label>

                                <select id="status" name="status" class="form-control" style="width: 150px; display: inline-block;">
                                    <option value="" selected="@(ViewBag.FilterStatus == null ? "selected" : "")"></option>
                                    <option value="1" selected="@(ViewBag.FilterStatus?.ToString() == "1")">@_localizer["Active"]</option>
                                    <option value="0" selected="@(ViewBag.FilterStatus?.ToString() == "0")">@_localizer["Inactive"]</option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-primary me-2" onclick="submitFilter()">@_localizer["Search"]</button>
                        </div>
                        <!-- 👇 Wrapped buttons in a div with margin start -->
                        <div class="col-md-2 d-flex justify-content-end">
                            <div class="card-header-right-icon">
                                <a asp-controller="Category" asp-action="Create" class="btn btn-primary">
                                    <i class="ti-bar-chart-alt me-1"></i> @_localizer["AddCategory"]
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">


                            <div class="card-body" style="overflow-y:auto; height:70vh">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <table class="table table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white; color: #000; direction: ltr;">
                                        <tr>
                                            <th class="text-center"> @_localizer["SN"]</th>
                                            <th class="text-center"> @_localizer["ID"]</th>
                                            <th class="text-center"> @_localizer["Name"]</th>
                                            <th class="text-center"> @_localizer["Status"]</th>
                                            <th class="text-center"> @_localizer["Created Date"]</th>
                                            <th class="text-center"> @_localizer["Image"]</th>
                                            <th class="text-center"> @_localizer["Icon"]</th>
                                            <th class="text-center"> @_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.CategoryId</td>
                                                <td class="text-center">@item.CName</td>
                                              
                                                <td class="text-center">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="badge bg-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Inactive</span>
                                                    }
                                                </td>
                                                <td class="text-center">@(item.CreatedAt.ToString("dd-MM-yyyy") ?? "")</td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.CategoryImageBase64))
                                                    {
                                                        <img src="@item.CategoryImageBase64" style="width:50px;height:50px;border-radius:4px;" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.CategoryIconBase64))
                                                    {
                                                        <img src="@item.CategoryIconBase64" style="width:50px;height:50px;border-radius:4px;" />
                                                    }
                                                    else
                                                    {
                                                        <span>No Image</span>
                                                    }
                                                </td>
                                                
                                                <td class="text-center">

                                                    <a asp-action="Edit" asp-controller="Category" asp-route-id="@item.CategoryId" class="btn btn-sm btn-primary me-1">
                                                        <i class="ti-pencil"></i>
                                                    </a>
                                                    <button class="btn btn-sm btn-danger delete-btn" onclick="deletecategory(@item.CategoryId)">
                                                        <i class="ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table>


                                <!-- ✅ Pagination (Same as UserList) -->
                                <div class="text-center">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="1"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-status="@ViewBag.FilterStatus"
                                             >
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                                   asp-route-name="@ViewBag.FilterName"
                                                   asp-route-status="@ViewBag.FilterStatus">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.TotalPages)"
                                               asp-route-name="@ViewBag.FilterName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

   @*  <!-- Footer -->
    <div class="row">
        <div class="col-lg-12">
            <div class="footer">
                <p>
                    @_localizer["This dashboard was generated on"] <span id="date-time"></span>
                    <a href="#" class="page-refresh">@_localizer["Refresh Dashboard"]</a>
                </p>
            </div>
        </div>
    </div> *@
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid-theme.min.css" rel="stylesheet" />

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deletecategory(id) {
            if (!confirm("Are you sure you want to delete this Category?")) return;
            debugger;
            $.ajax({
                url: '/Category/DeleteCategory/' + id,
                type: 'POST',
                success: function () {
                    alert("Category deleted successfully!");
                    location.reload();
                },
                error: function () {
                    alert("Failed to delete Category.");
                }
            });
        }
   
        function submitFilter() {
            const name = document.getElementById('name').value.trim();
            const status = document.getElementById('status').value;

            let url = "/Category/Index?";
            const params = [];

            if (name) params.push(`name=${encodeURIComponent(name)}`);
            if (status) params.push(`status=${encodeURIComponent(status)}`);

            url += params.join("&");
            window.location.href = url;
        }

        function resetFilter() {
            window.location.href = "/Category/Index";
        }

   
                       
        $(document).ready(function () {

            function fetchCategorySuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/Category/AutoCompleteSql', // adjust URL
                    type: 'GET',
                    data: { term: query },
                    success: function(data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item) // server already returns English or Arabic
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item); // set selected value
                                        $suggestionBox.hide();
                                        $('#name').focus(); // keep focus
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            $('#name').on('input', function() {
                fetchCategorySuggestions($(this).val());
            });

            enableSuggestionNavigation('#name', '#suggestions');

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });
    </script>


   
}
