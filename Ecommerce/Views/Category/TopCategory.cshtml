@inject EcommerceWebApplication.Helper.AdminStaffAccess StaffAccess
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<EcommerceWebApplication.Models.TopCategory>

@{
    var rights = await StaffAccess.RightsAsync(User, EcommerceWebApplication.Helper.AdminStaffAccess.TopCategories, Context.RequestAborted);
    ViewData["Title"] = "Top Categories";
    var categories = ViewBag.Categories as List<SelectListItem>;
    var categoryImages = ViewBag.CategoryImages as Dictionary<int, string>;
}

<div class="row">
    <div class="col-lg-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4>@_localizer["Top-Categories"]</h4>
            </div>

            <div class="panel-body">
                <div class="row">
                    @for (int i = 0; i < 3; i++)
                    {
                        var item = Model[i];
                        var canSave = item.TopCategoryId == 0 ? rights.Create : rights.Edit;
                        var imgId = $"imgPreview_{i}";
                        var fileId = $"fileInput_{i}";
                        var selectId = $"selectCategory_{i}";
                        var formId = $"form_{i}";
                        var selectedImage = item?.TopCategoryImage != null
                        ? "data:image/png;base64," + Convert.ToBase64String(item.TopCategoryImage)
                        : "";
                        <div class="col-md-4">
                            <div class="panel panel-default admin-top-category-card">
                                <div class="panel-body">
                                    <h5 class="text-center mb-3">@_localizer["Top Category"] @(i + 1)</h5>

                                    <form asp-action="SaveOrUpdateTopCategory" asp-controller="Category" method="post" enctype="multipart/form-data" id="@formId" onsubmit="return validateTopCategoryForm(this);">
                                        <input type="hidden" name="TopCategoryId" value="@item.TopCategoryId" />

                                        <fieldset disabled="@(!canSave)">
                                        <!-- Category Dropdown -->
                                        <div class="form-group">
                                            <label class="control-label">@_localizer["Category"] <span style="color:red">*</span></label>
                                            <select name="CategoryId" id="@selectId" class="form-control category-dropdown"
                                                    data-img="@imgId" data-value="@item.CategoryId"
                                                    onchange="showCategoryImage(this, '@imgId')">
                                                <option value="">--Select--</option>
                                                @foreach (var cat in categories)
                                                {
                                                    <option value="@cat.Value">@cat.Text</option>
                                                }
                                            </select>
                                            <span class="text-danger field-validation-error" data-valmsg-for="CategoryId" style="display:none;"></span>
                                        </div>

                                        <!-- Title Arabic -->
                                        <div class="form-group">
                                            <label>@_localizer["Title (Arb)"] <span style="color:red">*</span></label>
                                            <input type="text" name="TitleArbic" dir="rtl" class="form-control input-sm" value="@item.TitleArbic" />
                                            <span class="text-danger field-validation-error" data-valmsg-for="TitleArbic" style="display:none;"></span>
                                        </div>

                                        <!-- Title English -->
                                        <div class="form-group">
                                            <label>@_localizer["Title (Eng)"] <span style="color:red">*</span></label>
                                            <input type="text" name="Title" dir="ltr" class="form-control input-sm" value="@item.Title" />
                                            <span class="text-danger field-validation-error" data-valmsg-for="Title" style="display:none;"></span>
                                        </div>

                                        <!-- SubTitle Arabic -->
                                        <div class="form-group">
                                            <label>@_localizer["Sub Title (AR)"] <span style="color:red">*</span></label>
                                            <input type="text" name="SubTitleArbic" dir="rtl" class="form-control input-sm" value="@item.SubTitleArbic" />
                                            <span class="text-danger field-validation-error" data-valmsg-for="SubTitleArbic" style="display:none;"></span>
                                        </div>

                                        <!-- SubTitle English -->
                                        <div class="form-group">
                                            <label>@_localizer["SubTitle (EN)"] <span style="color:red">*</span></label>
                                            <input type="text" name="SubTitle" dir="ltr" class="form-control input-sm" value="@item.SubTitle" />
                                            <span class="text-danger field-validation-error" data-valmsg-for="SubTitle" style="display:none;"></span>
                                        </div>

                                        <!-- Image Upload -->
                                        <div class="form-group">
                                            <label>@_localizer["Image"] <span style="color:red">*</span></label>
                                            <input type="file" name="TopCategoryImage" id="@fileId"
                                                   class="form-control input-sm"
                                                   onchange="previewUploadedImage(this, '@imgId')" />
                                            <span class="text-danger field-validation-error" data-valmsg-for="TopCategoryImage" style="display:none;"></span>
                                            <small class="text-muted d-block mt-1">
                                                @_localizer["IMG Message"]<br />
                                                @_localizer["img Message1"]
                                            </small>
                                        </div>

                                        <!-- Preview -->
                                        <div class="form-group">
                                            <label>@_localizer["Preview"]</label><br />
                                            <div style="width: 100%; height: 120px; border: 1px solid #ccc; display: flex; align-items: center; justify-content: center;">
                                                <img id="@imgId" src="@selectedImage"
                                                     style="width: 100%; height: 100%; object-fit: cover; @(string.IsNullOrEmpty(selectedImage) ? "display:none;" : "")" />
                                            </div>
                                        </div>

                                        </fieldset>
                                        @if(canSave)
                                        {
                                        <!-- Submit Button -->
                                        <div class="mt-3 d-flex align-items-center" style="gap: 8px;">
                                            <label>@_localizer["Preview"]</label><br />
                                            <button type="submit" class="btn btn-success btn-sm">
                                                @(item.TopCategoryId > 0 ? @_localizer["Update"] : @_localizer["Save"])
                                            </button>
                                        </div>
                                        }
                                    </form>

                                    @if (item.TopCategoryId > 0 && rights.Delete)
                                    {
                                        <form asp-action="DeleteTopCategory" asp-controller="Category" method="post"
                                              onsubmit="return confirm('Are you sure to delete?');" style="margin: 0;">
                                            <input type="hidden" name="TopCategoryId" value="@item.TopCategoryId" />
                                            <button type="submit" class="btn btn-danger btn-sm">@_localizer["Delete"]</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
               $(document).ready(function () {
            $('.category-dropdown').each(function () {
                const select = $(this);
                const selectedValue = select.data('value');
                const imgId = select.data('img');

                // Do not override image if already present from database
                const existingImgSrc = $('#' + imgId).attr('src');
                if (existingImgSrc && existingImgSrc.trim() !== '') {
                    select.val(selectedValue); // Set selected value but don't override image
                    return;
                }

                const images = @Html.Raw(Json.Serialize(ViewBag.CategoryImages));
                if (selectedValue && images[selectedValue]) {
                    select.val(selectedValue);
                    $('#' + imgId).attr('src', images[selectedValue]).show();
                }
            });
        });

        function showCategoryImage(selectElement, imgId) {
            const categoryId = selectElement.value;
            const images = @Html.Raw(Json.Serialize(ViewBag.CategoryImages));
            const img = document.getElementById(imgId);

            if (images[categoryId]) {
                img.src = images[categoryId];
                img.style.display = 'block';
            } else {
                img.src = "";
                img.style.display = 'none';
            }
        }

        function previewUploadedImage(input, imgId) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById(imgId);
                    img.src = e.target.result;
                    img.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
    <script>
        function validateTopCategoryForm(form) {
            let isValid = true;

            // Clear all error messages first
            form.querySelectorAll(".field-validation-error").forEach(el => {
                el.style.display = "none";
                el.innerText = "";
            });

            // Helper to show error
            function showError(name, message) {
                const errorEl = form.querySelector(`[data-valmsg-for="${name}"]`);
                if (errorEl) {
                    errorEl.innerText = message;
                    errorEl.style.display = "block";
                    isValid = false;
                }
            }

            // Get values
            const categoryId = form.querySelector("select[name='CategoryId']").value.trim();
            const titleAr = form.querySelector("input[name='TitleArbic']").value.trim();
            const titleEn = form.querySelector("input[name='Title']").value.trim();
            const subTitleAr = form.querySelector("input[name='SubTitleArbic']").value.trim();
            const subTitleEn = form.querySelector("input[name='SubTitle']").value.trim();
            const fileInput = form.querySelector("input[name='TopCategoryImage']");
            const topCategoryId = form.querySelector("input[name='TopCategoryId']").value;

            // Required validations
            if (!categoryId) showError("CategoryId", "Category is required");
            if (!titleAr) showError("TitleArbic", "Title (AR) is required");
            if (!titleEn) showError("Title", "Title (EN) is required");
            if (!subTitleAr) showError("SubTitleArbic", "SubTitle (AR) is required");
            if (!subTitleEn) showError("SubTitle", "SubTitle (EN) is required");

            // Image required only if TopCategoryId is empty (new record)
            if ((!topCategoryId || topCategoryId === "0") && (!fileInput || fileInput.files.length === 0)) {
                showError("TopCategoryImage", "Image is required");
            }

            return isValid;
        }
    </script>
}