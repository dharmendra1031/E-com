@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.CustomerGridViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    var pages = Math.Max(1, Model.TotalPages);
    string PageUrl(int page) => Url.Action("CustomerList","ManageCustomer",new {page,pageSize=Model.PageSize,status=(int?)ViewBag.FilterStatus,startDate=(string?)ViewBag.FilterStartDate,endDate=(string?)ViewBag.FilterEndDate,customerId=(int?)ViewBag.FilterCustomerId,name=(string?)ViewBag.FilterName,mobile=(string?)ViewBag.FilterMobile})!;
}
<p class="admin-muted order-result-count">@Model.TotalItems @T("customers found","عميل")</p>
<div class="admin-table-scroll"><table class="table table-hover">
<thead><tr><th>@T("ID","الرقم")</th><th>@T("Name","الاسم")</th><th>@T("Email","البريد الإلكتروني")</th><th>@T("Phone","الهاتف")</th><th>@T("Status","الحالة")</th><th>@T("Registered","تاريخ التسجيل")</th><th>@T("Action","الإجراء")</th></tr></thead>
<tbody>
@if(!Model.Items.Any()){<tr><td colspan="7" class="admin-empty-state">@T("No customers found","لا يوجد عملاء")</td></tr>}
@foreach(var item in Model.Items){
<tr><td>@item.UserId</td><td>@item.FullName</td><td><bdi>@item.Email</bdi></td><td><bdi>@item.Phone</bdi></td><td><span class="admin-status @(item.IsActive?"btn-success":"btn-danger")">@(item.IsActive?T("Active","نشط"):T("Blocked","محظور"))</span></td><td><bdi>@item.CreatedAt.ToString("dd-MM-yyyy")</bdi></td><td><button type="button" class="btn btn-primary" data-customer-id="@item.UserId">@T("View","عرض")</button></td></tr>
}
</tbody></table></div>
<nav class="order-pagination" aria-label="@T("Customer pages","صفحات العملاء")">
@if(Model.PageNumber>1){<a class="btn btn-default" href="@PageUrl(Model.PageNumber-1)" data-register-page>@T("Previous","السابق")</a>}
<span>@T("Page","صفحة") @Model.PageNumber / @pages</span>
@if(Model.PageNumber<pages){<a class="btn btn-default" href="@PageUrl(Model.PageNumber+1)" data-register-page>@T("Next","التالي")</a>}
</nav>
