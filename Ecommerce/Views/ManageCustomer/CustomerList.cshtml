@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.CustomerGridViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Customers","العملاء");
}
<div class="admin-master-register" id="masterRegister" data-register-url="@Url.Action("CustomerList","ManageCustomer")" data-suggest-url="@Url.Action("AutoCompleteSql","ManageCustomer")">
    <section class="admin-panel" id="customerRegister">
        <div class="admin-section-heading"><h2>@ViewData["Title"]</h2></div>
        <form id="masterFilters" method="get" asp-action="CustomerList" class="admin-register-filters">
            <div class="form-group"><label for="customerId">@T("Customer ID","رقم العميل")</label><input type="number" min="1" name="customerId" id="customerId" class="form-control" value="@ViewBag.FilterCustomerId" /></div>
            <div class="form-group"><label for="name">@T("Customer name","اسم العميل")</label><input type="search" name="name" id="name" class="form-control" list="masterSuggestions" autocomplete="off" value="@ViewBag.FilterName" /><datalist id="masterSuggestions"></datalist></div>
            <div class="form-group"><label for="mobile">@T("Mobile","الهاتف")</label><input type="tel" name="mobile" id="mobile" class="form-control" value="@ViewBag.FilterMobile" /></div>
            <div class="form-group"><label for="startDate">@T("From date","من تاريخ")</label><input type="date" name="startDate" id="startDate" class="form-control" value="@ViewBag.FilterStartDate" /></div>
            <div class="form-group"><label for="endDate">@T("To date","إلى تاريخ")</label><input type="date" name="endDate" id="endDate" class="form-control" value="@ViewBag.FilterEndDate" /></div>
            <div class="form-group"><label for="status">@T("Status","الحالة")</label><select id="status" name="status" class="form-control"><option value="">@T("All","الكل")</option><option value="1" selected="@(ViewBag.FilterStatus==1)">@T("Active","نشط")</option><option value="0" selected="@(ViewBag.FilterStatus==0)">@T("Blocked","محظور")</option></select></div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-primary">@T("Search","بحث")</button>
            <a asp-action="CustomerList" id="clearMasterFilters" class="btn btn-default">@T("Clear","مسح")</a>
        </form>
        <p id="masterMessage" role="status" class="admin-muted"></p>
        <div id="masterResults"><partial name="_RegisterRows" model="Model" /></div>
    </section>
    <section class="admin-panel" id="customerDetail" hidden data-details-url="@Url.Action("GetCustomerDetails","ManageCustomer")" data-items-url="@Url.Action("GetCustomerOrderItems","ManageCustomer")" data-status-url="@Url.Action("ToggleUserStatus","ManageCustomer")">
        <div class="admin-section-heading"><h2 id="customerHeading" tabindex="-1">@T("Customer details","تفاصيل العميل")</h2><button type="button" id="backCustomers" class="btn btn-default">@T("Back to customers","العودة إلى العملاء")</button></div>
        <p id="customerMessage" role="status"></p>
        <button type="button" id="retryCustomer" class="btn btn-default" hidden>@T("Retry","إعادة المحاولة")</button>
        <div id="customerContent" hidden>
            <div class="order-detail-grid">
                <section><h3>@T("Profile","الملف الشخصي")</h3>
                    <img id="customerImage" class="admin-product-thumb" alt="" hidden />
                    <dl><dt>@T("ID","الرقم")</dt><dd data-customer="customerId"></dd><dt>@T("Name","الاسم")</dt><dd data-customer="fullName"></dd><dt>@T("Email","البريد الإلكتروني")</dt><dd data-customer="email"></dd><dt>@T("Phone","الهاتف")</dt><dd data-customer="phone"></dd><dt>@T("Registered","تاريخ التسجيل")</dt><dd data-customer="registrationDate"></dd><dt>@T("Status","الحالة")</dt><dd data-customer="status"></dd></dl>
                    <div class="order-actions"><button type="button" class="btn btn-default" id="customerPassword">@T("Change password","تغيير كلمة المرور")</button><button type="button" class="btn btn-default" id="customerStatus"></button></div>
                </section>
                <section><h3>@T("Saved addresses","العناوين المحفوظة")</h3><div id="customerAddresses"></div></section>
            </div>
            <div class="admin-section-heading"><h3>@T("Store orders","طلبات المتجر")</h3><span id="customerOrderCount"></span></div>
            <div class="admin-table-scroll"><table class="table table-hover"><thead><tr><th>@T("Order","الطلب")</th><th>@T("Date","التاريخ")</th><th>@T("Status","الحالة")</th><th>@T("Payment","الدفع")</th><th>@T("Total","الإجمالي")</th><th>@T("Action","الإجراء")</th></tr></thead><tbody id="customerOrders"></tbody></table></div>
            <nav class="order-pagination" aria-label="@T("Order pages","صفحات الطلبات")"><button type="button" id="customerPrev" class="btn btn-default">@T("Previous","السابق")</button><span id="customerPage"></span><button type="button" id="customerNext" class="btn btn-default">@T("Next","التالي")</button></nav>
            <section id="customerItems" class="admin-stock-editor" hidden>
                <div class="admin-section-heading"><h3>@T("Order products","منتجات الطلب") <bdi id="customerOrderId"></bdi></h3><button type="button" id="closeCustomerItems" class="btn btn-default">@T("Close","إغلاق")</button></div>
                <p id="customerItemsMessage" role="status"></p>
                <div class="admin-table-scroll"><table class="table"><thead><tr><th>@T("Product","المنتج")</th><th>@T("Quantity","الكمية")</th><th>@T("Price","السعر")</th><th>@T("Total","الإجمالي")</th></tr></thead><tbody id="customerItemRows"></tbody></table></div>
                <nav class="order-pagination"><button type="button" id="itemsPrev" class="btn btn-default">@T("Previous","السابق")</button><span id="itemsPage"></span><button type="button" id="itemsNext" class="btn btn-default">@T("Next","التالي")</button></nav>
            </section>
        </div>
    </section>
</div>
<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <!-- Header -->
            <div class="modal-header" style="background-color: #337ab7; color: white; padding: 10px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                        style="color:#fff; font-size: 28px; font-weight: bold; opacity: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@_localizer["Change Password"]</h4>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 py-3">
                <input type="hidden" id="changePwdUserId" />
                <div class="row">
                    <!-- New Password -->
                    <div class="col-md-12 mb-3">
                        <label><strong>@_localizer["New Password"]</strong></label>
                        <div class="input-group">
                            <input type="password" id="newPassword" class="form-control" placeholder="New password" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="togglePassword('newPassword')">👁️</button>
                            </span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-12 mb-3">
                        <label><strong>@_localizer["Confirm Password"]</strong></label>
                        <div class="input-group">
                            <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm password" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="togglePassword('confirmPassword')">👁️</button>
                            </span>
                        </div>
                        <small id="pwdError" style="color: red; display: none;">
                            @_localizer["Passwords do not match"]
                        </small>
                    </div>

                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer" style="padding: 10px;">
                <button class="btn btn-default" data-dismiss="modal">
                    @_localizer["Cancel"]
                </button>
                <button class="btn btn-primary" onclick="submitChangePassword()">
                    @_localizer["Save"]
                </button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/master-register.js" asp-append-version="true"></script>
    <script src="~/js/customer-workspace.js" asp-append-version="true"></script>
    <script>
        function togglePassword(id) {
            const input = document.getElementById(id);
            input.type = input.type === "password" ? "text" : "password";
        }
        const newPwd = document.getElementById("newPassword");
        const confirmPwd = document.getElementById("confirmPassword");
        const errorMsg = document.getElementById("pwdError");

        function showChangePwdForm(userId) {
            document.getElementById("changePwdUserId").value = userId;

            newPwd.value = "";
            confirmPwd.value = "";

            confirmPwd.style.border = "";
            errorMsg.style.display = "none";

            $('#changePasswordModal')
                .one('shown.bs.modal', function () {
                    newPwd.focus();
            })
            .modal('show');
        }

        newPwd.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                confirmPwd.focus();
            }
        });
        confirmPwd.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                submitChangePassword();
            }
        });

        function validatePasswords() {
            if (!confirmPwd.value) {
                confirmPwd.style.border = "";
                errorMsg.style.display = "none";
                return;
            }

            if (newPwd.value !== confirmPwd.value) {
                confirmPwd.style.border = "2px solid red";
                errorMsg.style.display = "block";
            } else {
                confirmPwd.style.border = "2px solid green";
                errorMsg.style.display = "none";
            }
        }

        newPwd.addEventListener("input", validatePasswords);
        confirmPwd.addEventListener("input", validatePasswords);

        function submitChangePassword() {
            const userId = document.getElementById("changePwdUserId").value;
            const newPassword = document.getElementById("newPassword").value;
            const confirmPassword = document.getElementById("confirmPassword").value;
            const ar = document.documentElement.dir === "rtl";
            if (!newPassword || !confirmPassword || newPassword !== confirmPassword) {
                AdminFeedback.show("warning", ar ? "أدخل كلمتي مرور متطابقتين." : "Enter matching passwords in both fields.");
                return;
            }
            return AdminFeedback.post("/ManageCustomer/ChangePassword", {
                method:"POST",
                headers:{"Content-Type":"application/json"},
                body:JSON.stringify({userId,newPassword})
            }, () => {
                document.getElementById("newPassword").value = "";
                document.getElementById("confirmPassword").value = "";
                $("#changePasswordModal").modal("hide");
            });
        }

    </script>
}
