
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.CustomerGridViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Users with Role ID = 2";

    // Serialize model to JSON (agar jsGrid ya datatable use karna ho)
    var userJson = System.Text.Json.JsonSerializer.Serialize(Model);

}

<div id="main-content" class="admin-master-register">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-body" id="NavigationKey">


                    <form id="dateFilterForm" class="admin-register-filters admin-customer-filters" onsubmit="submitFilter(event)">

                        <div class="row">
                            <!-- ID Filter -->
                           
                            <div class="form-group" style="margin-right: 20px;">
                                <label for="customerId" style="margin-right: 5px;">@_localizer["Customer ID"]:</label>
                                <input type="text" id="customerId" name="customerId"
                                       class="form-control"
                                       style="width: 100px; display: inline-block;"
                                       onkeypress="return numeric(event)"
                                       value="@ViewBag.FilterCustomerId" />
                            </div>
                            <!-- Customer Name Filter -->
                            <div class="form-group" style="margin-right: 15px; position:relative; display:inline-block;">
                                <label for="name" style="margin-right: 5px;">@_localizer["Customer Name"]:</label>
                                <input type="text" id="name" name="name" class="form-control"
                                       style="width: 220px; display: inline-block;"
                                       autocomplete="off"
                                       value="@ViewBag.FilterName" />
                                <ul id="suggestions"
                                    style="display:none; position:absolute; background:white; list-style:none; padding:0; margin:0;
               width:100%; max-height:200px; overflow-y:auto; border:1px solid #ccc; z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>
                            <!-- Mobile Filter -->
                            <div class="form-group" style="margin-right: 15px;">
                                <label for="mobile" style="margin-right: 5px;">@_localizer["Mobile"]:</label>
                                <input type="text" id="mobile" name="mobile" class="form-control" onkeypress="return numeric(event)" style="width: 215px; display: inline-block;"
                                       value="@ViewBag.FilterMobile" />
                            </div>

                            <!-- From Date -->
                            <div class="form-group" style="margin-right: 15px;">
                                <label for="startDate" style="margin-right: 5px;">@_localizer["FromDate"]:</label>
                                <input type="text" id="startDate" name="startDate" class="form-control datepicker" style="width: 200px; display: inline-block;"
                                       placeholder="DD-MM-YYYY" value="@ViewBag.FilterStartDate" onkeypress="return numeric(event)" />
                            </div>
                        </div>
                        <div class="row" style="margin-top: 10px;">

                            <!-- To Date -->
                            <div class="form-group" style="margin-right: 15px;">
                                <label for="endDate" style="margin-right: 5px;">@_localizer["ToDate"]:</label>
                                <input type="text" id="endDate" name="endDate" class="form-control datepicker" style="width: 200px; display: inline-block;"
                                       placeholder="DD-MM-YYYY" value="@ViewBag.FilterEndDate" onkeypress="return numeric(event)" />
                            </div>
                            <!-- Status Filter -->
                            <div class="form-group" style="margin-right: 15px;">
                                <label for="Customerstatus" style="margin-right: 5px;">@_localizer["Status"]:</label>

                                <select id="Customerstatus" name="status" class="form-control" style="width: 150px; display: inline-block;">
                                    <option value="" selected="@(ViewBag.FilterStatus == null ? "selected" : "")"></option>
                                    <option value="1" selected="@(ViewBag.FilterStatus?.ToString() == "1")">@_localizer["Active"]</option>
                                    <option value="0" selected="@(ViewBag.FilterStatus?.ToString() == "0")">@_localizer["Inactive"]</option>
                                </select>

                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="glyphicon glyphicon-filter"></i> @_localizer["Search"]
                            </button>
                        </div>
                        <!-- Buttons -->
                    </form>

                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card alert p-0">
                                <div class="card-body admin-register-body">
                                    @{
                                        int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                    }
                                    <div class="admin-table-scroll"><table class="table table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="text-center"> @_localizer["SN"]</th>
                                                <th class="text-center"> @_localizer["ID"]</th>
                                                <th class="text-center"> @_localizer["Full Name"]</th>
                                                <th class="text-center"> @_localizer["Email"]</th>
                                                <th class="text-center"> @_localizer["Phone"]</th>
                                                <th class="text-center"> @_localizer["Status"]</th>
                                                <th class="text-center"> @_localizer["Created Date"]</th>
                                                <th class="text-center"> @_localizer["Action"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                @if (!Model.Items.Any())
                                {
                                    <tr><td colspan="8" class="admin-empty-state">@_localizer["No records found"]</td></tr>
                                }
                                            @foreach (var item in Model.Items)
                                            {
                                                <tr>
                                                    <td class="text-center">@serial</td>
                                                    <td class="text-center">@item.UserId</td>
                                                    <td class="text-center">@item.FullName</td>
                                                    <td class="text-center"><bdi>@item.Email</bdi></td>
                                                    <td class="text-center"><bdi>@item.Phone</bdi></td>
                                                    <td class="text-center">
                                                        @if (item.IsActive)
                                                        {
                                                            <span class="admin-status btn-success">@_localizer["Active"]</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="admin-status btn-danger">@_localizer["Inactive"]</span>
                                                        }
                                                    </td>
                                                 
                                                    <td class="text-center">@(item.CreatedAt.ToString("dd-MM-yyyy") ?? "")</td>

                                                    <td class="text-center">
                                                        <div style="display: inline-flex; gap: 3px;">
                                                            <button class="btn btn-primary" onclick="showCustomerDetails(@item.UserId)">
                                                                @_localizer["View Details"]
                                                            </button>
                                                            <button class="btn btn-warning" onclick="showChangePwdForm(@item.UserId)">
                                                                @_localizer["Change Password"]
                                                            </button>
                                                            <button class="btn btn-@(item.IsActive ? "danger" : "success")"
                                                                    onclick="toggleUserStatus(@item.UserId, @(item.IsActive.ToString().ToLower()))"
                                                                    style="width: 75px;">
                                                                @(item.IsActive? @_localizer["Block"] : @_localizer["Unblock"])
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                                serial++;
                                            }
                                        </tbody>
                                    </table></div>
                                    <!-- ✅ Pagination (Same as UserList) -->
                                    <div class="text-center">
                                        <ul class="pagination justify-content-center">
                                            <!-- First -->
                                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                                <a class="page-link" asp-action="CustomerList" asp-route-page="1"
                                                   asp-route-status="@ViewBag.FilterStatus"
                                                   asp-route-customerId="@ViewBag.FilterCustomerId"
                                                   asp-route-name="@ViewBag.FilterName"
                                                   asp-route-mobile="@ViewBag.FilterMobile"
                                                   asp-route-startDate="@ViewBag.FilterStartDate"
                                                   asp-route-endDate="@ViewBag.FilterEndDate">
                                                    @_localizer["First"]
                                                </a>
                                            </li>

                                            <!-- Previous -->
                                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                                <a class="page-link" asp-action="CustomerList" asp-route-page="@(Model.PageNumber - 1)"
                                                   asp-route-status="@ViewBag.FilterStatus"
                                                   asp-route-customerId="@ViewBag.FilterCustomerId"
                                                   asp-route-name="@ViewBag.FilterName"
                                                   asp-route-mobile="@ViewBag.FilterMobile"
                                                   asp-route-startDate="@ViewBag.FilterStartDate"
                                                   asp-route-endDate="@ViewBag.FilterEndDate">
                                                    @_localizer["Previous"]
                                                </a>
                                            </li>

                                            <!-- Page Numbers -->
                                            @{
                                                int maxPagesToShow = 10;
                                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                                int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
                                                if (endPage - startPage + 1 < maxPagesToShow)
                                                {
                                                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                                }
                                                if (startPage > 1)
                                                {
                                                    <li class="page-item">
                                                        <a class="page-link" asp-action="CustomerList" asp-route-page="1"
                                                           asp-route-status="@ViewBag.FilterStatus"
                                                           asp-route-customerId="@ViewBag.FilterCustomerId"
                                                           asp-route-name="@ViewBag.FilterName"
                                                           asp-route-mobile="@ViewBag.FilterMobile"
                                                           asp-route-startDate="@ViewBag.FilterStartDate"
                                                           asp-route-endDate="@ViewBag.FilterEndDate">1</a>
                                                    </li>
                                                    if (startPage > 2)
                                                    {
                                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    }
                                                }
                                                for (int i = startPage; i <= endPage; i++)
                                                {
                                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                        <a class="page-link" asp-action="CustomerList" asp-route-page="@i"
                                                           asp-route-status="@ViewBag.FilterStatus"
                                                           asp-route-customerId="@ViewBag.FilterCustomerId"
                                                           asp-route-name="@ViewBag.FilterName"
                                                           asp-route-mobile="@ViewBag.FilterMobile"
                                                           asp-route-startDate="@ViewBag.FilterStartDate"
                                                           asp-route-endDate="@ViewBag.FilterEndDate">@i</a>
                                                    </li>
                                                }
                                                if (endPage < Model.TotalPages)
                                                {
                                                    if (endPage < Model.TotalPages - 1)
                                                    {
                                                        <li class="page-item disabled"><span class="page-link">...</span></li>
                                                    }
                                                    <li class="page-item">
                                                        <a class="page-link" asp-action="CustomerList" asp-route-page="@Model.TotalPages"
                                                           asp-route-status="@ViewBag.FilterStatus"
                                                           asp-route-customerId="@ViewBag.FilterCustomerId"
                                                           asp-route-name="@ViewBag.FilterName"
                                                           asp-route-mobile="@ViewBag.FilterMobile"
                                                           asp-route-startDate="@ViewBag.FilterStartDate"
                                                           asp-route-endDate="@ViewBag.FilterEndDate">@Model.TotalPages</a>
                                                    </li>
                                                }
                                            }

                                            <!-- Next -->
                                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                                <a class="page-link" asp-action="CustomerList" asp-route-page="@(Model.PageNumber + 1)"
                                                   asp-route-status="@ViewBag.FilterStatus"
                                                   asp-route-customerId="@ViewBag.FilterCustomerId"
                                                   asp-route-name="@ViewBag.FilterName"
                                                   asp-route-mobile="@ViewBag.FilterMobile"
                                                   asp-route-startDate="@ViewBag.FilterStartDate"
                                                   asp-route-endDate="@ViewBag.FilterEndDate">
                                                    @_localizer["Next"]
                                                </a>
                                            </li>

                                            <!-- Last -->
                                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                                <a class="page-link" asp-action="CustomerList" asp-route-page="@Model.TotalPages"
                                                   asp-route-status="@ViewBag.FilterStatus"
                                                   asp-route-customerId="@ViewBag.FilterCustomerId"
                                                   asp-route-name="@ViewBag.FilterName"
                                                   asp-route-mobile="@ViewBag.FilterMobile"
                                                   asp-route-startDate="@ViewBag.FilterStartDate"
                                                   asp-route-endDate="@ViewBag.FilterEndDate">
                                                    @_localizer["Last"]
                                                </a>
                                            </li>
                                        </ul>
                                    </div>


                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

   
</div>


<!-- ✅ Customer Details & Orders Modal -->
<div class="modal fade" id="customerDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <!-- 🔹 Header same as Order Details -->
            <div class="modal-header" style="background-color: #337ab7; color: white; padding: 10px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                        style="color:#fff; font-size: 28px; font-weight: bold; opacity: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@_localizer["Customer Details"]</h4>
            </div>

            <div class="modal-body px-4 py-3" style="max-height: 80vh; overflow-y: auto;">

                <!-- Customer Info Row -->
                <div class="row mb-3">
                    <!-- Left Side -->
                    <div class="col-md-5">
                        <p class="mb-1"><strong>@_localizer["Customer ID"]:</strong> <span id="modalCustomerId"></span></p>
                        <p class="mb-1"><strong>@_localizer["Name"]:</strong> <span id="modalCustomerName"></span></p>
                        <p class="mb-1"><strong>@_localizer["Email"]:</strong> <span id="modalCustomerEmail"></span></p>
                        <p class="mb-1"><strong>@_localizer["Phone"]:</strong> <span id="modalCustomerPhone"></span></p>
                    </div>

                    <!-- Right Side -->
                    <div class="col-md-5">
                        <p class="mb-1"><strong>@_localizer["Status"]:</strong> <span id="status"></span></p>
                        <p class="mb-1"><strong>@_localizer["Registration Date"]:</strong> <span id="modalCustomerRegDate"></span></p>
                        <p class="mb-1"><strong>@_localizer["Address"]:</strong><br> <span id="modalCustomerAddress"></span></p>
                    </div>

                    <!-- Customer Image -->
                    <div class="col-md-2 text-center">
                        <div style="border:1px solid #ccc; padding:5px; width:120px; height:120px; margin:auto;">
                            <img id="modalCustomerImage" src="/images/default-user.png"
                                 alt="Customer Image"
                                 style="width:100%; height:100%; object-fit:cover;" />
                        </div>
                        <label class="mt-2" style="font-weight:bold; color:#000;">@_localizer["Customer Image"]</label>
                    </div>
                </div>

                <!-- 🔹 Order List Table -->
                <h5 class="mt-3"><strong>@_localizer["Order List"]</strong></h5>
                <div class="table-responsive">
                    <div style="height: 300px; overflow-y: auto; border: 1px solid #ccc; padding: 10px;">
                        <table class="table table-bordered table-sm align-middle text-center">
                            <thead class="table-light">
                                <tr>
                                    <th style="text-align:center;">@_localizer["Order ID"]</th>
                                    <th style="text-align:center;">@_localizer["Product"]</th>
                                    <th style="text-align:center;">@_localizer["Qty"]</th>
                                    <th style="text-align:center;">@_localizer["Price"]</th>
                                    <th style="text-align:center;">@_localizer["Total"]</th>
                                </tr>
                            </thead>
                            <tbody id="orderItemsBody">
                                <!-- JS will populate -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <!-- Header -->
            <div class="modal-header" style="background-color: #337ab7; color: white; padding: 10px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                        style="color:#fff; font-size: 28px; font-weight: bold; opacity: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@_localizer["Change Password"]</h4>
            </div>

            <!-- Body -->
            <div class="modal-body px-4 py-3">
                <input type="hidden" id="changePwdUserId" />
                <div class="row">
                    <!-- New Password -->
                    <div class="col-md-12 mb-3">
                        <label><strong>@_localizer["New Password"]</strong></label>
                        <div class="input-group">
                            <input type="password" id="newPassword" class="form-control" placeholder="New password" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="togglePassword('newPassword')">👁️</button>
                            </span>
                        </div>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-12 mb-3">
                        <label><strong>@_localizer["Confirm Password"]</strong></label>
                        <div class="input-group">
                            <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm password" />
                            <span class="input-group-btn">
                                <button class="btn btn-default" type="button" onclick="togglePassword('confirmPassword')">👁️</button>
                            </span>
                        </div>
                        <small id="pwdError" style="color: red; display: none;">
                            @_localizer["Passwords do not match"]
                        </small>
                    </div>

                </div>

            </div>

            <!-- Footer -->
            <div class="modal-footer" style="padding: 10px;">
                <button class="btn btn-default" data-dismiss="modal">
                    @_localizer["Cancel"]
                </button>
                <button class="btn btn-primary" onclick="submitChangePassword()">
                    @_localizer["Save"]
                </button>
            </div>

        </div>
    </div>
</div>

