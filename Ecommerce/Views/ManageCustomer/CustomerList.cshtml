    <script>
           function submitFilter(event) {
            event.preventDefault();

            const Customerstatus = document.getElementById('Customerstatus').value;
            const startDate = document.getElementById("startDate").value;
            const endDate = document.getElementById("endDate").value;
            const customerId = document.getElementById("customerId").value;
            const name = document.getElementById("name").value;
            const mobile = document.getElementById("mobile").value;

            let query = "/ManageCustomer/CustomerList";
            let params = [];

            if (startDate && endDate) {
                params.push(`startDate=${encodeURIComponent(startDate)}`);
                params.push(`endDate=${encodeURIComponent(endDate)}`);
            }

            if (Customerstatus) {
                params.push(`status=${encodeURIComponent(Customerstatus)}`);
            }

            if (customerId) {
                params.push(`customerId=${encodeURIComponent(customerId)}`);
            }

            if (name) {
                params.push(`name=${encodeURIComponent(name)}`);
            }

            if (mobile) {
                params.push(`mobile=${encodeURIComponent(mobile)}`);
            }

            if (params.length > 0) {
                query += "?" + params.join("&");
            }

            window.location.href = query;
        }

        function showCustomerDetails(userId) {
            fetch(`/ManageCustomer/GetCustomerDetails?id=${userId}`)
                .then(res => {
                    if (!res.ok) throw new Error("Network response was not ok.");
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.customer) {
                        Swal.fire("Info", "No customer data found.", "info");
                        return;
                    }

                    const c = data.customer;
                    const addresses = data.addresses || [];   // ✅ plural use karo
                    const orders = data.orderItems || [];

                    // ✅ Customer Info
                    document.getElementById("modalCustomerId").innerText = c.customerId || "-";
                    document.getElementById("modalCustomerName").innerText = c.fullName || "-";
                    document.getElementById("modalCustomerEmail").innerText = c.email || "-";
                    document.getElementById("modalCustomerPhone").innerText = c.phone || "-";
                    document.getElementById("status").innerText = c.status
                        ? "@_localizer["Active"]"
                        : "@_localizer["Inactive"]";
                    document.getElementById("modalCustomerRegDate").innerText = c.registrationDate || "-";

                    // ✅ Address Combine
                          let fullAddress = "-";

        if (addresses.length > 0) {
            fullAddress = addresses.map(addr => {
                // Fields ko comma se join karo, empty skip karte hue
                let oneAddress = [
                    addr.addressArea,
                    addr.addressBlock,
                    addr.addressStreet,
                    addr.addressHouseNo,
                    addr.addressFloor
                ]
                .filter(f => f)            // null/undefined/empty skip
                .join(", ");                // 👈 comma separated

                return `<b>${addr.title || "Address"}:</b> ${oneAddress}`;
            }).join("<br/>");               // 👈 multiple addresses alag line me
        }

        document.getElementById("modalCustomerAddress").innerHTML = fullAddress;


                    // ✅ Image
                    document.getElementById("modalCustomerImage").src = c.customerImage
                        ? c.customerImage
                        : "/images/userimage.png";

                    // ✅ Orders Table
                    let html = '';
                    if (orders.length > 0) {
                        orders.forEach(o => {
                            html += `<tr>
                                <td style="text-align:center;">${o.orderId}</td>
                                <td style="text-align:center;">${o.productName}</td>
                                <td style="text-align:center;">${o.quantity}</td>
                                <td style="text-align:center;">${o.price ? o.price.toFixed(3) : "-"}</td>
                                <td style="text-align:center;">${o.totalPrice ? o.totalPrice.toFixed(3) : "-"}</td>
                            </tr>`;
                        });
                    } else {
                        html = `<tr><td colspan="5" class="text-center">@_localizer["No orders found"]</td></tr>`;
                    }
                    document.getElementById("orderItemsBody").innerHTML = html;

                    // ✅ Show Modal
                    $('#customerDetailsModal').modal('show');
                })
                .catch(err => {
                    console.error("Error fetching customer details:", err);
                    Swal.fire("Error", "Failed to load customer data.", "error");
                });
        }
        
        function toggleUserStatus(userId, currentStatus) {
            const action = currentStatus ? "block" : "unblock";

            Swal.fire({
                title: `Are you sure you want to ${action} this Customer?`,
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: `Yes, ${action} it`,
                cancelButtonText: "Cancel"
            }).then(result => {
                if (result.isConfirmed) {
                    fetch(`/ManageCustomer/ToggleUserStatus?id=${userId}`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() // if using anti-forgery
                        }
                    })
                    .then(res => {
                        if (!res.ok) throw new Error("Failed to update Customer status.");
                        return res.json();
                    })
                           .then(data => {
            if (data.success) {
                Swal.fire({
                    icon: "success",
                    title: "Success",
                    text: `Customer ${action}ed successfully`
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: data.message || "Update failed"
                });
            }
        })
                    .catch(err => {
                        console.error(err);
                        Swal.fire("Error", "Something went wrong", "error");
                    });
                }
            });
        }

        $(document).ready(function () {

            // Fetch suggestions from server
            function fetchSuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/ManageCustomer/AutoCompleteSql', // controller
                    type: 'GET',
                    data: { term: query },
                    success: function (data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item) // server already returns English or Arabic based on input
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item); // select the suggested value
                                        $suggestionBox.hide();
                                        $('#name').focus(); // keep focus
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            // Trigger on input
            $('#name').on('input', function () {
                fetchSuggestions($(this).val());
            });

            // Enable arrow key navigation + enter selection
            enableSuggestionNavigation('#name', '#suggestions');

            // Hide suggestions if click outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });

        const newPwd = document.getElementById("newPassword");
        const confirmPwd = document.getElementById("confirmPassword");
        const errorMsg = document.getElementById("pwdError");

        function showChangePwdForm(userId) {
            document.getElementById("changePwdUserId").value = userId;

            newPwd.value = "";
            confirmPwd.value = "";

            confirmPwd.style.border = "";
            errorMsg.style.display = "none";

            $('#changePasswordModal')
                .one('shown.bs.modal', function () {
                    newPwd.focus();
            })
            .modal('show');
        }

        newPwd.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                confirmPwd.focus();
            }
        });
        confirmPwd.addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                submitChangePassword();
            }
        });

        function validatePasswords() {
            if (!confirmPwd.value) {
                confirmPwd.style.border = "";
                errorMsg.style.display = "none";
                return;
            }

            if (newPwd.value !== confirmPwd.value) {
                confirmPwd.style.border = "2px solid red";
                errorMsg.style.display = "block";
            } else {
                confirmPwd.style.border = "2px solid green";
                errorMsg.style.display = "none";
            }
        }

        newPwd.addEventListener("input", validatePasswords);
        confirmPwd.addEventListener("input", validatePasswords);

        function submitChangePassword() {
            const userId = document.getElementById("changePwdUserId").value;
            const newPassword = document.getElementById("newPassword").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (!newPassword || !confirmPassword) {
                Swal.fire("Warning", "Please fill all fields", "warning");
                return;
            }

            if (newPassword !== confirmPassword) {
                Swal.fire("Error", "Passwords do not match", "error");
                return;
            }

            fetch('/ManageCustomer/ChangePassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ userId, newPassword })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire("Success", "Password changed successfully", "success");
                    $('#changePasswordModal').modal('hide');
                } else {
                    Swal.fire("Error", data.message || "Failed to change password", "error");
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire("Error", "Something went wrong", "error");
            });
        }
    </script>

}