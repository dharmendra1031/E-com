@model EcommerceWebApplication.Models.ViewModels.VendorListingsPage
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string arabic) => ar ? arabic : en;
    
}

<div class="seller-section-heading"><h2>@T("Catalog","الكتالوج")</h2><a asp-action="Listings" asp-route-id="@Model.VendorId" class="btn btn-default">@T("Back to listings","العودة إلى العروض")</a></div>
<form asp-action="Catalog" asp-route-id="@Model.VendorId" method="get" class="seller-filters" data-seller-filter><div class="form-group">
    <label for="search">@T("Search name, SKU or barcode","بحث بالاسم أو الرمز أو الباركود")</label>
    <input id="search" name="search" value="@Model.Search" class="form-control" />
    </div><button class="btn btn-primary" type="submit">@T("Search","بحث")</button><a asp-action="Catalog" asp-route-id="@Model.VendorId" class="btn btn-default" data-seller-page>@T("Clear","مسح")</a>
</form>
<div class="table-responsive"><table class="table table-hover">
<thead><tr><th>@T("Product","المنتج")</th><th>SKU</th><th>@T("Barcode","الباركود")</th><th>@T("Action","الإجراء")</th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    <tr><td>@(ar && !string.IsNullOrWhiteSpace(row.ProductNameArb) ? row.ProductNameArb : row.ProductName)</td><td><bdi>@(row.CatalogSku ?? "—")</bdi></td><td><bdi>@(row.Barcode ?? "—")</bdi></td><td><a class="btn btn-primary" asp-action="EditListing" asp-route-id="@Model.VendorId" asp-route-productId="@row.ProductId">@T("Add product","إضافة منتج")</a></td></tr>
}
@if (Model.Rows.Count == 0) { <tr><td colspan="4">@T("No available products","لا توجد منتجات متاحة")</td></tr> }
</tbody></table></div>
<nav class="seller-pagination">
@if (Model.Page > 1) { <a asp-action="Catalog" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" data-seller-page asp-route-page="@(Model.Page-1)" class="btn btn-default">@T("Previous","السابق")</a> }
<span>@Model.Page</span>
@if (Model.HasNext) { <a asp-action="Catalog" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" data-seller-page asp-route-page="@(Model.Page+1)" class="btn btn-default">@T("Next","التالي")</a> }
</nav>
