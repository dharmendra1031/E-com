@inject Microsoft.Extensions.Configuration.IConfiguration OrderConfiguration
@model EcommerceWebApplication.Models.ViewModels.VendorPortalStore
@{
    Layout = "_VendorPortalLayout";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    ViewData["Title"] = ar ? "لوحة التحكم" : "Dashboard";
}
<div class="panel panel-default"><div class="panel-body">
    <h2>@(ar && !string.IsNullOrWhiteSpace(Model.NameArb) ? Model.NameArb : Model.Name)</h2>
    <dl>
        <dt>@(ar ? "رمز البائع" : "Vendor code")</dt><dd>@Model.Code</dd>
        <dt>@(ar ? "الحالة" : "Status")</dt><dd>@(ar ? "معتمد" : "Approved")</dd>
    </dl>
    <a asp-action="Listings" asp-route-id="@Model.VendorId" class="btn btn-primary">@(ar ? "عروض المنتجات" : "Product listings")</a>
    @if (OrderConfiguration["Marketplace:VendorOrdersEnabled"]?.Equals("true", StringComparison.OrdinalIgnoreCase) == true)
    {
        <a asp-action="Orders" asp-route-id="@Model.VendorId" class="btn btn-default">@(ar ? "الطلبات المدفوعة" : "Paid orders")</a>
    }
    <p>@(ar ? "التسويات غير مفعلة بعد." : "Settlements are not enabled yet.")</p>
</div></div>
