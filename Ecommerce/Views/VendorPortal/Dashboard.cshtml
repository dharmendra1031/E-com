@model EcommerceWebApplication.Models.ViewModels.VendorPortalStore
@{
    Layout = "_VendorPortalLayout";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en,string arabic)=>ar?arabic:en;
    ViewData["Title"] = T("Dashboard","لوحة التحكم");
}
<div class="admin-dashboard">
    <header class="admin-section-heading seller-section-heading">
        <div>
            <h1>@(ar && !string.IsNullOrWhiteSpace(Model.NameArb) ? Model.NameArb : Model.Name)</h1>
            <p class="admin-muted">@T("Vendor code","رمز البائع"): <bdi>@Model.Code</bdi> · <span class="seller-status" data-status="Approved">@T("Approved","معتمد")</span></p>
        </div>
        @if(ViewBag.CanListProducts == true)
        {
        <a asp-action="Listings" asp-route-id="@Model.VendorId" class="btn btn-primary"><i class="fa fa-cubes" aria-hidden="true"></i> @T("Manage products","إدارة المنتجات")</a>
        }
    </header>
    <div class="admin-kpi-grid">
        @if(ViewBag.CanListProducts == true)
        {
        <a class="admin-kpi" asp-action="Listings" asp-route-id="@Model.VendorId"><span class="admin-kpi-label">@T("My products","منتجاتي") <i class="fa fa-cubes" aria-hidden="true"></i></span><strong>@ViewBag.ProductCount</strong></a>
        <a class="admin-kpi" asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-filter="Approved"><span class="admin-kpi-label">@T("Approved active products","المنتجات المعتمدة النشطة") <i class="fa fa-check-circle" aria-hidden="true"></i></span><strong>@ViewBag.ApprovedCount</strong></a>
        <a class="admin-kpi" asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-filter="Pending"><span class="admin-kpi-label">@T("Pending approval","بانتظار الاعتماد") <i class="fa fa-clock-o" aria-hidden="true"></i></span><strong>@ViewBag.PendingCount</strong></a>
        @if(ViewBag.OutOfStock != null)
        {
            <a class="admin-kpi" asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-filter="OutOfStock"><span class="admin-kpi-label">@T("Approved products out of stock","المنتجات المعتمدة غير المتوفرة") <i class="fa fa-exclamation-circle" aria-hidden="true"></i></span><strong>@ViewBag.OutOfStock</strong></a>
        }
        }
        @if(ViewBag.ToPack != null)
        {
            <a class="admin-kpi" asp-action="Orders" asp-route-id="@Model.VendorId"><span class="admin-kpi-label">@T("Verified paid orders","الطلبات المدفوعة المؤكدة")</span><strong>@ViewBag.TotalOrders</strong></a>
            <a class="admin-kpi" asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="AwaitingPacking"><span class="admin-kpi-label">@T("Paid orders to pack","طلبات مدفوعة للتجهيز") <i class="fa fa-shopping-bag" aria-hidden="true"></i></span><strong>@ViewBag.ToPack</strong></a>
            <a class="admin-kpi" asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="Delivered"><span class="admin-kpi-label">@T("Delivered","تم التوصيل")</span><strong>@ViewBag.DeliveredCount</strong></a>
        }
    </div>
    <div class="seller-dashboard-sections">
        @if(ViewBag.CanListProducts == true)
        {
        <section class="admin-panel">
            <h2>@T("Products & stock","المنتجات والمخزون")</h2>
            <ul class="seller-task-list">
                <li><a asp-action="Listings" asp-route-id="@Model.VendorId"><span><i class="fa fa-list" aria-hidden="true"></i> @T("View all listings","عرض جميع المنتجات")</span><i class="fa fa-angle-double-right" aria-hidden="true"></i></a></li>
                @if(ViewBag.CanCreateListing == true)
                {
                <li><a asp-action="Catalog" asp-route-id="@Model.VendorId"><span><i class="fa fa-search" aria-hidden="true"></i> @T("Browse product catalogue","تصفح كتالوج المنتجات")</span><i class="fa fa-angle-double-right" aria-hidden="true"></i></a></li>
                }
                <li><a asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-filter="Pending"><span><i class="fa fa-clock-o" aria-hidden="true"></i> @T("Review pending listings","مراجعة المنتجات المعلقة")</span><strong>@ViewBag.PendingCount</strong></a></li>
                @if(ViewBag.OutOfStock != null)
                {
                    <li><a asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-filter="OutOfStock"><span><i class="fa fa-exclamation-circle" aria-hidden="true"></i> @T("Review out-of-stock products","مراجعة المنتجات غير المتوفرة")</span><strong>@ViewBag.OutOfStock</strong></a></li>
                }
            </ul>
        </section>
        }
        @if(ViewBag.ToPack != null)
        {
            <section class="admin-panel">
                <h2>@T("Order management","إدارة الطلبات")</h2>
                <ul class="seller-task-list">
                    <li><a asp-action="Orders" asp-route-id="@Model.VendorId"><span>@T("All verified paid orders","جميع الطلبات المدفوعة المؤكدة")</span><i class="fa fa-angle-double-right" aria-hidden="true"></i></a></li>
                    <li><a asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="AwaitingPacking"><span>@T("Awaiting packing","بانتظار التجهيز")</span><strong>@ViewBag.ToPack</strong></a></li>
                    <li><a asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="Packed"><span>@T("Packed orders","الطلبات المجهزة")</span><strong>@ViewBag.PackedCount</strong></a></li>
                    <li><a asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="HandedOver"><span>@T("Handed over","تم التسليم للناقل")</span><strong>@ViewBag.HandedOverCount</strong></a></li>
                    <li><a asp-action="Orders" asp-route-id="@Model.VendorId" asp-route-status="Delivered"><span>@T("Delivered","تم التوصيل")</span><strong>@ViewBag.DeliveredCount</strong></a></li>
                    @if(ViewBag.CanViewReturns==true){<li><a asp-action="Returns" asp-route-id="@Model.VendorId">@T("Return requests","طلبات الإرجاع")</a></li>}
                </ul>
            </section>
        }
        @if(ViewBag.CanViewFinance==true)
        {
            <section class="admin-panel"><h2>@T("Finance review","المراجعة المالية")</h2><p>@T("Commission and test settlement records; not actual payouts.","سجلات العمولة والتسوية التجريبية وليست دفعات فعلية.")</p><a class="btn btn-default" asp-action="FinanceReview" asp-route-id="@Model.VendorId">@T("View finance","عرض المالية")</a></section>
        }
    </div>
    @if(ViewBag.RecentOrders is List<EcommerceWebApplication.Models.ViewModels.VendorOrderRow> recent)
    {
        <section class="admin-panel mt-3">
            <h2>@T("Recent paid orders","الطلبات المدفوعة الأخيرة")</h2>
            <div class="table-responsive"><table class="table"><thead><tr><th>@T("Order","الطلب")</th><th>@T("Date","التاريخ")</th><th>@T("Merchandise subtotal","مجموع البضائع")</th><th>@T("Status","الحالة")</th></tr></thead><tbody>
            @foreach(var row in recent){<tr><td><a asp-action="OrderDetails" asp-route-id="@Model.VendorId" asp-route-vendorOrderId="@row.VendorOrderId">#@row.VendorOrderId</a></td><td>@row.CreatedAt.ToString("yyyy-MM-dd")</td><td dir="ltr">KD @row.MerchandiseSubtotal.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)</td><td>@(row.FulfillmentStatus switch {"AwaitingPacking"=>T("Awaiting packing","بانتظار التجهيز"),"Packed"=>T("Packed","تم التجهيز"),"HandedOver"=>T("Handed over","تم التسليم للناقل"),"Delivered"=>T("Delivered","تم التوصيل"),_=>T("Review","مراجعة")})</td></tr>}
            @if(recent.Count==0){<tr><td colspan="4">@T("No verified paid orders","لا توجد طلبات مدفوعة مؤكدة")</td></tr>}
            </tbody></table></div>
        </section>
    }
</div>
