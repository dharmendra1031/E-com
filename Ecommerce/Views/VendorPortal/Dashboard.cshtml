@model EcommerceWebApplication.Models.ViewModels.VendorPortalStore
@{
    Layout = "_VendorPortalLayout";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en,string arabic)=>ar?arabic:en;
    ViewData["Title"] = T("Dashboard","لوحة التحكم");
}
<header class="seller-section-heading">
    <div><h1>@(ar && !string.IsNullOrWhiteSpace(Model.NameArb) ? Model.NameArb : Model.Name)</h1>
        <p class="text-muted">@T("Vendor code","رمز البائع"): <bdi>@Model.Code</bdi> · @T("Approved","معتمد")</p></div>
    <a asp-action="Listings" asp-route-id="@Model.VendorId" class="btn btn-primary">@T("Manage products","إدارة المنتجات")</a>
</header>
<div class="seller-kpi-grid">
    <a class="seller-kpi" asp-action="Listings" asp-route-id="@Model.VendorId"><span>@T("My products","منتجاتي")</span><strong>@ViewBag.ProductCount</strong></a>
    <a class="seller-kpi" asp-action="Listings" asp-route-id="@Model.VendorId"><span>@T("Approved active products","المنتجات المعتمدة النشطة")</span><strong>@ViewBag.ApprovedCount</strong></a>
    <a class="seller-kpi" asp-action="Listings" asp-route-id="@Model.VendorId"><span>@T("Pending approval","بانتظار الاعتماد")</span><strong>@ViewBag.PendingCount</strong></a>
    @if(ViewBag.OutOfStock != null)
    {
        <a class="seller-kpi" asp-action="Listings" asp-route-id="@Model.VendorId"><span>@T("Approved products out of stock","المنتجات المعتمدة غير المتوفرة")</span><strong>@ViewBag.OutOfStock</strong></a>
    }
    @if(ViewBag.ToPack != null)
    {
        <a class="seller-kpi" asp-action="Orders" asp-route-id="@Model.VendorId"><span>@T("Paid orders to pack","طلبات مدفوعة للتجهيز")</span><strong>@ViewBag.ToPack</strong></a>
    }
</div>
<p class="text-muted seller-dashboard-note">@T("Select a card to open the related register. Counts reflect current store records.","اختر بطاقة لفتح السجل المرتبط بها. الأعداد حسب سجلات المتجر الحالية.")</p>
