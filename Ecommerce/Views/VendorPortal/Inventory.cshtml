@model EcommerceWebApplication.Models.ViewModels.MarketplaceStockRegister
@{ Layout="_VendorPortalLayout";var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;string T(string en,string arabic)=>ar?arabic:en;ViewData["Title"]=T("Inventory","المخزون"); }
<section class="seller-panel">
<h2>@ViewData["Title"]</h2>
<form asp-action="Inventory" asp-route-id="@Model.VendorId" method="get" class="seller-filters">
<div class="form-group"><label for="search">@T("Product or SKU","المنتج أو الرمز")</label><input id="search" name="search" maxlength="100" value="@Model.Search" class="form-control"/></div>
<button type="submit" class="btn btn-primary">@T("Search","بحث")</button><a asp-action="Inventory" asp-route-id="@Model.VendorId" class="btn btn-default">@T("Clear","مسح")</a>
</form>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>@T("Product","المنتج")</th><th>SKU</th><th>@T("On hand","المخزون الفعلي")</th><th>@T("Reserved","محجوز")</th><th>@T("Available","متاح")</th><th>@T("Action","الإجراء")</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td>@(ar&&!string.IsNullOrWhiteSpace(row.ProductNameArb)?row.ProductNameArb:row.ProductName)</td><td><bdi>@row.SellerSku</bdi></td><td>@row.OnHand</td><td>@row.Reserved</td><td>@row.Available</td><td><a asp-action="Stock" asp-route-id="@row.VendorId" asp-route-listingId="@row.ListingId" class="btn btn-default">@T("View stock","عرض المخزون")</a></td></tr>}
@if(Model.Rows.Count==0){<tr><td colspan="6">@T("No listings found","لا توجد عروض")</td></tr>}
</tbody></table></div>
<nav class="seller-pagination"><span>@T("Page","صفحة") @Model.Page</span>
@if(Model.Page>1){<a asp-action="Inventory" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)" class="btn btn-default">@T("Previous","السابق")</a>}
@if(Model.HasNext){<a asp-action="Inventory" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)" class="btn btn-default">@T("Next","التالي")</a>}
</nav></section>
