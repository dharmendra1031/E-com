@model List<EcommerceWebApplication.Models.ViewModels.MarketplaceFinanceRow>
@{Layout="_VendorPortalLayout";var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;int page=ViewBag.Page;int vendorId=ViewBag.VendorId;ViewData["Title"]=ar?"مراجعة العمولة":"Commission review";}
<h2>@ViewData["Title"]</h2>
<partial name="_MarketplaceFinanceTable" model="Model" />
@if(page>1){<a asp-action="FinanceReview" asp-route-id="@vendorId" asp-route-page="@(page-1)" class="btn btn-default">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="FinanceReview" asp-route-id="@vendorId" asp-route-page="@(page+1)" class="btn btn-default">@(ar?"التالي":"Next")</a>}
