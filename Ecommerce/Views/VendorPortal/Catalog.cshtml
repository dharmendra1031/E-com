@model EcommerceWebApplication.Models.ViewModels.VendorListingsPage
@{
    Layout = "_VendorPortalLayout";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Catalog","الكتالوج");
}
<section class="seller-panel" data-seller-workspace><p class="seller-message" role="status"></p><div data-seller-results><partial name="_CatalogRegister" model="Model" /></div></section>
