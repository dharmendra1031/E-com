@model List<EcommerceWebApplication.Models.ViewModels.VendorOrderRow>
@{ Layout="_VendorPortalLayout"; var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
   int page=ViewBag.Page; int vendorId=ViewBag.VendorId; ViewData["Title"]=ar?"الطلبات المدفوعة":"Paid orders"; }
<h2>@ViewData["Title"]</h2>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>@(ar?"الطلب":"Order")</th><th>@(ar?"التاريخ":"Date")</th><th>@(ar?"العناصر":"Items")</th><th>@(ar?"مجموع البضائع":"Merchandise subtotal")</th></tr></thead><tbody>
@foreach(var row in Model) {
<tr><td><a asp-action="OrderDetails" asp-route-id="@vendorId" asp-route-vendorOrderId="@row.VendorOrderId">#@row.VendorOrderId</a></td><td>@row.CreatedAt.ToString("yyyy-MM-dd")</td><td>@row.ItemCount</td><td dir="ltr">KD @row.MerchandiseSubtotal.ToString("F3",System.Globalization.CultureInfo.InvariantCulture)</td></tr>
}
@if(Model.Count==0){<tr><td colspan="4">@(ar?"لا توجد طلبات":"No paid orders")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="Orders" asp-route-id="@vendorId" asp-route-page="@(page-1)" class="btn btn-default">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="Orders" asp-route-id="@vendorId" asp-route-page="@(page+1)" class="btn btn-default">@(ar?"التالي":"Next")</a>}
