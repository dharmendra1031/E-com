@model EcommerceWebApplication.Models.ViewModels.ListingStockPage
@{
    var adminStock = ViewData["AdminStock"] is true;
    if (!adminStock) Layout = "_VendorPortalLayout";
    else Layout = "_Layout";
    var stockAction = adminStock ? "MarketplaceMovements" : "Stock";
    var backAction = adminStock ? "MarketplaceStock" : "Inventory";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Stock","المخزون");
}
<div class="@(adminStock ? "admin-section-heading" : "seller-section-heading")"><h2>@Model.ProductName — @ViewData["Title"]</h2><a asp-action="@backAction" asp-route-id="@(adminStock ? (int?)null : Model.VendorId)" asp-route-vendorId="@(adminStock ? Model.VendorId : (int?)null)" class="btn btn-default">@T("Back to inventory","العودة إلى المخزون")</a></div>
@if (TempData["StockError"] is string error) { <p class="alert alert-danger" role="alert">@error</p> }
@if (TempData["StockSuccess"] is string success) { <p class="alert alert-success" role="status">@success</p> }
@if (!Model.HasBalance) { <p>@T("No opening stock posted.","لم يتم تسجيل رصيد افتتاحي.")</p> }
<div class="@(adminStock ? "row" : "seller-kpi-grid")">
    <div class="@(adminStock ? "col-sm-4" : "seller-kpi")"><span>@T("On hand","المخزون الفعلي")</span><strong>@Model.OnHand</strong></div>
    <div class="@(adminStock ? "col-sm-4" : "seller-kpi")"><span>@T("Reserved","محجوز")</span><strong>@Model.Reserved</strong></div>
    <div class="@(adminStock ? "col-sm-4" : "seller-kpi")"><span>@T("Available","متاح")</span><strong>@Model.Available</strong></div>
</div>
@if (Model.CanEdit)
{
    <form asp-action="@stockAction" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" method="post" class="@(adminStock ? "admin-panel admin-stock-editor" : "seller-panel seller-editor")" data-seller-save="@(!adminStock ? "true" : null)">
        <div>
            <input asp-for="Adjustment.RequestId" type="hidden" />
            <div class="form-group">
                <label asp-for="Adjustment.Direction">@T("Stock action","إجراء المخزون")</label>
                <select asp-for="Adjustment.Direction" class="form-control">
                    <option value="Add">@T("Add stock","إضافة مخزون")</option>
                    <option value="Reduce">@T("Reduce stock","خصم مخزون")</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Adjustment.Quantity">@T("Quantity","الكمية")</label>
                <input asp-for="Adjustment.Quantity" type="number" min="1" max="1000000000" step="1" class="form-control" required />
            </div>
            <div class="form-group"><label asp-for="Adjustment.Reason">@T("Reason / reference","السبب أو المرجع")</label>
                <input asp-for="Adjustment.Reason" maxlength="200" class="form-control" required /></div>
            <button type="submit" class="btn btn-primary">@T("Save stock change","حفظ تغيير المخزون")</button>
        </div>
    </form>
}
<section class="@(adminStock ? "admin-panel" : "seller-panel")"><h3>@T("Movement history","سجل الحركات")</h3>
<div class="table-responsive"><table class="table table-hover">
<thead><tr><th>@T("Date (UTC)","التاريخ (UTC)")</th><th>@T("Stock change","تغير المخزون")</th><th>@T("Reserved change","تغير المحجوز")</th><th>@T("Source","المصدر")</th><th>@T("Reason","السبب")</th></tr></thead>
<tbody>
@if (Model.Movements.Count == 0) { <tr><td colspan="5">@T("No movements","لا توجد حركات")</td></tr> }
@foreach (var row in Model.Movements)
{
    <tr><td>@row.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@row.OnHandDelta</td><td>@row.ReservedDelta</td><td>@row.SourceType</td><td>@row.Reason</td></tr>
}
</tbody></table></div>
<nav class="@(adminStock ? "order-pagination" : "seller-pagination")">
@if (Model.Page > 1) { <a asp-action="@stockAction" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" asp-route-page="@(Model.Page-1)" class="btn btn-default">@T("Previous","السابق")</a> }
<span>@Model.Page</span>
@if (Model.HasNext) { <a asp-action="@stockAction" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" asp-route-page="@(Model.Page+1)" class="btn btn-default">@T("Next","التالي")</a> }
</nav>
</section>
