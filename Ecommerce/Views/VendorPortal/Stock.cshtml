@model EcommerceWebApplication.Models.ViewModels.ListingStockPage
@{
    Layout = "_VendorPortalLayout";
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Stock","المخزون");
}
<h2>@Model.ProductName — @ViewData["Title"]</h2>
<a asp-action="Listings" asp-route-id="@Model.VendorId" class="btn btn-default">@T("Back to listings","العودة إلى العروض")</a>
@if (!Model.HasBalance) { <p>@T("No opening stock posted.","لم يتم تسجيل رصيد افتتاحي.")</p> }
<div class="row">
    <div class="col-sm-4"><div class="panel panel-default"><div class="panel-body">@T("On hand","المخزون الفعلي") <strong>@Model.OnHand</strong></div></div></div>
    <div class="col-sm-4"><div class="panel panel-default"><div class="panel-body">@T("Reserved","محجوز") <strong>@Model.Reserved</strong></div></div></div>
    <div class="col-sm-4"><div class="panel panel-default"><div class="panel-body">@T("Available","متاح") <strong>@Model.Available</strong></div></div></div>
</div>
@if (Model.CanEdit)
{
    <form asp-action="Stock" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" method="post" class="panel panel-default">
        <div class="panel-body">
            <input asp-for="Adjustment.RequestId" type="hidden" />
            <div class="form-group">
                <label asp-for="Adjustment.Delta">@T("Quantity change (+ receipt / − adjustment)","تغيير الكمية (إضافة أو خصم)")</label>
                <input asp-for="Adjustment.Delta" type="number" min="-1000000000" max="1000000000" step="1" class="form-control" required />
            </div>
            <div class="form-group"><label asp-for="Adjustment.Reason">@T("Reason / reference","السبب أو المرجع")</label>
                <input asp-for="Adjustment.Reason" maxlength="200" class="form-control" required /></div>
            <button type="submit" class="btn btn-primary">@T("Post stock movement","ترحيل حركة المخزون")</button>
        </div>
    </form>
}
<h3>@T("Movement history","سجل الحركات")</h3>
<div class="table-responsive"><table class="table table-hover">
<thead><tr><th>@T("Date (UTC)","التاريخ (UTC)")</th><th>@T("Stock change","تغير المخزون")</th><th>@T("Reserved change","تغير المحجوز")</th><th>@T("Source","المصدر")</th><th>@T("Reason","السبب")</th></tr></thead>
<tbody>
@if (Model.Movements.Count == 0) { <tr><td colspan="5">@T("No movements","لا توجد حركات")</td></tr> }
@foreach (var row in Model.Movements)
{
    <tr><td>@row.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@row.OnHandDelta</td><td>@row.ReservedDelta</td><td>@row.SourceType</td><td>@row.Reason</td></tr>
}
</tbody></table></div>
<nav>
@if (Model.Page > 1) { <a asp-action="Stock" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" asp-route-page="@(Model.Page-1)" class="btn btn-default">@T("Previous","السابق")</a> }
<span>@Model.Page</span>
@if (Model.HasNext) { <a asp-action="Stock" asp-route-id="@Model.VendorId" asp-route-listingId="@Model.ListingId" asp-route-page="@(Model.Page+1)" class="btn btn-default">@T("Next","التالي")</a> }
</nav>
