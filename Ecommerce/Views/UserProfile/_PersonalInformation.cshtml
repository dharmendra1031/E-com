@model EcommerceWebApplication.Models.UserProfileViewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
<h2 class="h5 fw-bold mb-3">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "معلومات الحساب" : "Profile information")</h2>
<form id="profileForm">
    <div class="row g-3">
        <div class="col-12">
            <label for="profileName" class="form-label fw-semibold">@_localizer["Full Name"]</label>
            <input id="profileName" class="form-control" name="FullName" autocomplete="name" value="@Model.User?.FullName" required />
        </div>
        <div class="col-12">
            <label for="profileEmail" class="form-label fw-semibold">@_localizer["Email"]</label>
            <input id="profileEmail" class="form-control" name="Email" type="email" readonly dir="ltr" value="@Model.User?.Email" />
        </div>
        <div class="col-md-6">
            <label for="profilePhone" class="form-label fw-semibold">@_localizer["Mobile"]</label>
            <div class="input-group" dir="ltr"><span class="input-group-text">+965</span>
                <input id="profilePhone" class="form-control" name="Phone" type="tel" autocomplete="tel-national" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" required value="@(Model.User?.Phone?.Length >= 8 ? Model.User.Phone.Substring(Model.User.Phone.Length-8) : Model.User?.Phone)" />
            </div>
        </div>
        <div class="col-md-6">
            <label for="BirthDate" class="form-label fw-semibold">@_localizer["Birth Date"]</label>
            <input type="date" class="form-control" id="BirthDate" name="BirthDate" max="@DateTime.Today.ToString("yyyy-MM-dd")" value="@(Model.User?.BirthDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 text-end"><button type="submit" class="btn btn-primary">@_localizer["Save"]</button></div>
    </div>
</form>
