@model List<EcommerceWebApplication.Models.ViewModels.UserAddressViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

<div class="bg-white p-4 rounded shadow-sm">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">@_localizer["My Addresses"]</h5>
        <button class="btn btn-sm btn-primary" id="btnAddAddress">
            + @_localizer["Add New"]
        </button>
    </div>

    <!-- 🔽 FORM CONTAINER (HIDDEN) -->
    <div id="addressFormContainer" class="d-none mb-3"></div>

    @if (Model != null && Model.Any())
    {
        <div class="p-3 border rounded" style="max-height: 400px; overflow-y: auto;">
            <ul class="list-group">
                @foreach (var addr in Model)
                {
                    <li class="list-group-item mb-2">
                        <div class="d-flex justify-content-between align-items-start">

                            <div class="flex-grow-1">
                                <div class="row mb-1">
                                    <div class="col-md-3 fw-semibold">@_localizer["Title"]:</div>
                                    <div class="col-md-9">@addr.Title</div>
                                </div>

                                <div class="row mb-1">
                                    <div class="col-md-3 fw-semibold">@_localizer["House"] / @_localizer["Street"]:</div>
                                    <div class="col-md-4">@addr.HouseNo</div>
                                    <div class="col-md-5">@addr.Street</div>
                                </div>

                                <div class="row mb-1">
                                    <div class="col-md-3 fw-semibold">@_localizer["Area"] / @_localizer["Block"]:</div>
                                   
                                    <div class="col-md-5">@addr.AreaName</div>
                                    <div class="col-md-4">@addr.BlockName</div>
                                   
                                </div>

                                <div class="row mb-1">
                                    <div class="col-md-3 fw-semibold">@_localizer["Phone"]:</div>
                                    <div class="col-md-9">
                                        +965 @(addr.Phone != null && addr.Phone.Length >= 8
                                                                        ? addr.Phone.Substring(addr.Phone.Length - 8)
                                                                        : addr.Phone)
                            </div>
                        </div>

                            </div>

                            <div class="ms-3 text-nowrap">
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="editAddress(@addr.AddressId)">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="deleteAddress(@addr.AddressId)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                        </div>
                    </li>
                }
            </ul>
        </div>
    }
</div>
<script>
    function deleteAddress(id) {

        Swal.fire({
            title: 'Are you sure?',
            text: "This address will be deleted permanently!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, Delete',
            cancelButtonText: 'Cancel'
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '/UserProfile/DeleteAddress',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {

                        if (res.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: res.message,
                                timer: 1500,
                                showConfirmButton: false
                            });

                            // 🔄 reload address list
                            $("#rightContent").load("/UserProfile/ManageAddressesPartial");
                        }
                        else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: res.message
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Something went wrong!'
                        });
                    }
                });

            }
        });
    }
</script>
<script>
    $(document).ready(function () {

        // 🔹 form sirf ek baar load hoga (page load par)
        $("#addressFormContainer").load("/UserProfile/AddAddressPartial");

    });

    // 🔹 Add New Address button
    $(document).on("click", "#btnAddAddress", function () {

        $("#addressFormContainer")
            .removeClass("d-none")
            .load("/UserProfile/AddAddressPartial", function () {

                $("#AddressId").val("");
                $("#addressFormTitle").text("Add New Address");

                if ($("#addAddressForm").length) {
                    $("#addAddressForm")[0].reset();
                }
            });

        // $('html, body').animate({
        //     scrollTop: $("#addressFormContainer").offset().top - 20
        // }, 50);
    });

    // 🔹 Edit Address
    function editAddress(id) {

        $("#addressFormContainer")
            .removeClass("d-none")
            .load("/UserProfile/AddAddressPartial", function () {

                $.get("/UserProfile/GetAddressById", { id: id }, function (res) {

                    if (!res.success) {
                        Swal.fire("Error", res.message, "error");
                        return;
                    }

                    $("#AddressId").val(res.data.addressId);
                    $("input[name='Title']").val(res.data.title);
                      $("#AreaDropdown").val(res.data.area).trigger("change");

   
    setTimeout(function () {
        $("#BlockDropdown").val(res.data.block);
    }, 300);

                    $("input[name='Street']").val(res.data.street);
                    $("input[name='HouseNo']").val(res.data.houseNo);
                    $("input[name='Floor']").val(res.data.floor);
                    $("input[name='Landmark']").val(res.data.landmark);
                    $("input[name='Phone']").val(res.data.phone);

                    $("#addressFormTitle").text("Edit Address");
                });
            });

        $('html, body').animate({
            scrollTop: $("#addressFormContainer").offset().top - 20
        }, 400);
    }

    // 🔹 ADD / UPDATE Address (SINGLE SUBMIT HANDLER)
    $(document)
        .off("submit", "#addAddressForm")
        .on("submit", "#addAddressForm", function (e) {

            e.preventDefault();

            let $btn = $(this).find("button[type='submit']");
            $btn.prop("disabled", true); // double submit block

            $.ajax({
                type: "POST",
                url: "/UserProfile/AddAddress",
                data: $(this).serialize(),
                success: function (res) {

                    if (res.success) {
                        Swal.fire("Success", res.message, "success");

                        $("#addressFormContainer").addClass("d-none").html("");
                        $("#rightContent").load("/UserProfile/ManageAddressesPartial");
                    } else {
                        Swal.fire("Error", res.message, "error");
                    }
                },
                error: function () {
                    Swal.fire("Error", "Something went wrong!", "error");
                },
                complete: function () {
                    $btn.prop("disabled", false);
                }
            });
        });
</script>


