@model List<EcommerceWebApplication.Models.ViewModels.UserAddressViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{var ar=System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h2 class="h5 fw-bold mb-0">@_localizer["My Addresses"]</h2>
    <button type="button" class="btn btn-primary" id="btnAddAddress">+ @_localizer["Add New"]</button>
</div>
<div id="addressFormContainer" class="mb-3" hidden></div>
<div class="store-address-grid">
    @foreach(var addr in Model)
    {
        <article class="store-address-card">
            <h3 class="h6 fw-bold">@addr.Title</h3>
            <p class="mb-1">@addr.AreaName · @addr.BlockName</p>
            <p class="mb-1">@addr.Street @addr.HouseNo</p>
            <p dir="ltr" class="mb-2">+965 @(addr.Phone?.Length >= 8 ? addr.Phone.Substring(addr.Phone.Length-8) : addr.Phone)</p>
            <div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-primary" data-edit-address="@addr.AddressId">@(ar ? "تعديل" : "Edit")</button><button type="button" class="btn btn-outline-danger" data-remove-address="@addr.AddressId">@(ar ? "حذف" : "Remove")</button></div>
        </article>
    }
</div>
@if (!Model.Any()) { <p class="text-secondary py-3">@(ar ? "لا توجد عناوين محفوظة" : "No saved addresses yet.")</p> }
