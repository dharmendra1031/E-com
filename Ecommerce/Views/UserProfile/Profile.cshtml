<script>
    function deleteAccount() {
        if (!confirm("Are you sure you want to delete your account?")) {
            return;
        }

        fetch('/UserProfile/SoftDeleteUser', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message);

                // ✅ session clear + logout redirect
                window.location.href = '/UserAccount/Logout';
            } else {
                alert(data.message || 'Something went wrong');
            }
        })
        .catch(err => {
            console.error(err);
            alert('Server error');
        });
    }
</script>

<script>
    $(document).ready(function () {

        // ===============================
        // Load partial + set active class
        // ===============================
        function loadPartial(targetId, url) {
            $("#rightContent").load(url);

            $(".list-group .menu-item").removeClass("active");
            $(".list-group .menu-item[data-target='" + targetId + "']")
                .addClass("active");
        }

     
        loadPartial("#loadOrders", "/UserProfile/MyOrdersPartial");


        $(document).on("click", ".menu-item", function (e) {

         
            e.preventDefault();

            var targetId = $(this).data("target");

            switch (targetId) {
                case "#loadOrders":
                    loadPartial(targetId, "/UserProfile/MyOrdersPartial");
                    break;

                case "#loadProfileInfo":
                    loadPartial(targetId, "/UserProfile/PersonalInformation");
                    break;

                case "#loadAddresses":
                    loadPartial(targetId, "/UserProfile/ManageAddressesPartial");
                    break;

                case "#loadChangePassword":
                    loadPartial(targetId, "/UserProfile/ChangePasswordPartial");
                    break;
            }
        });

        $(document).on("click", "#btnAddAddress", function () {
            $("#addressFormContainer")
                .load("/UserProfile/AddAddressPartial");
        });

      
        $(document).on("submit", "#addAddressForm", function (e) {
            e.preventDefault();

            $.post("/UserProfile/AddAddress", $(this).serialize(), function (res) {

                if (res.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Success!",
                        text: res.message
                    });

                    $("#rightContent")
                        .load("/UserProfile/ManageAddressesPartial");

                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: res.message
                    });
                }
            });
        });

   
        $(document).on("submit", "#changePasswordForm", function (e) {
            e.preventDefault();

            $.post("/UserProfile/ChangePassword", $(this).serialize(), function (res) {

                if (res.success) {
                    Swal.fire({
                        icon: "success",
                        title: "Success!",
                        text: res.message
                    });

                    $("#changePasswordForm")[0].reset();

                } else {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: res.message
                    });
                }
            });
        });

    });




</script>
