@{
    ViewData["Title"] = "My Account";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var user = ViewBag.User;
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
}
<div class="container py-3 py-md-4 customer-profile">
    @Html.AntiForgeryToken()
    <h1 class="h3 fw-bold mb-3">@(ar ? "حسابي" : "My account")</h1>
    <div class="row g-3">
        <aside class="col-12 col-md-4 col-lg-3">
            <nav class="store-account-panel p-3" aria-label="@(ar ? "قائمة الحساب" : "Account menu")">
                <div id="username" class="fw-bold mb-3">@user.FullName</div>
                <div class="store-account-nav">
                    <button type="button" data-section="orders" class="btn text-start"><i class="bi bi-box-seam"></i> @(ar ? "طلباتي" : "My orders")</button>
                    <button type="button" data-section="profile" class="btn text-start"><i class="bi bi-person"></i> @(ar ? "معلومات الحساب" : "Profile information")</button>
                    <button type="button" data-section="addresses" class="btn text-start"><i class="bi bi-geo-alt"></i> @(ar ? "العناوين" : "Addresses")</button>
                    <button type="button" data-section="password" class="btn text-start"><i class="bi bi-lock"></i> @(ar ? "تغيير كلمة المرور" : "Change password")</button>
                    <a href="~/UserAccount/Logout" class="btn text-start text-danger"><i class="bi bi-power"></i> @(ar ? "تسجيل الخروج" : "Sign out")</a>
                    <button type="button" id="deleteAccount" class="btn text-start text-danger"><i class="bi bi-trash"></i> @(ar ? "حذف الحساب" : "Delete account")</button>
                </div>
            </nav>
        </aside>
        <section class="col-12 col-md-8 col-lg-9"><div class="store-account-panel p-3 p-md-4" id="rightContent" aria-live="polite"></div></section>
    </div>
</div>
<script>
(() => {
    const ar=document.documentElement.lang==="ar";
    const content=document.getElementById("rightContent"), nav=document.querySelector(".store-account-nav");
    const routes={orders:"MyOrdersPartial",profile:"PersonalInformation",addresses:"ManageAddressesPartial",password:"ChangePasswordPartial"};
    const failure=ar?"تعذر التحميل. حاول مرة أخرى.":"Unable to complete request. Try again.";
    const token=document.querySelector("[name=__RequestVerificationToken]").value;
    let request,section="orders",busy=false;
    function notify(text,success){Swal.fire({icon:success?"success":"error",text:text||failure});}
    async function load(key,page=1) {
        if(!routes[key]||busy)return;
        section=key;request?.abort();const current=new AbortController();request=current;
        nav.querySelectorAll("[data-section]").forEach(b=>b.setAttribute("aria-current",b.dataset.section===key?"true":"false"));
        content.textContent=ar?"جارٍ التحميل…":"Loading…";content.setAttribute("aria-busy","true");
        try{
            const res=await fetch("/UserProfile/"+routes[key]+(key==="orders"?"?page="+page:""),{signal:current.signal});
            if(res.redirected){location.href=res.url;return;}
            if(!res.ok)throw new Error();
            const html=await res.text();if(!current.signal.aborted)content.innerHTML=html;
        }catch(e){if(e.name!=="AbortError"){content.textContent=failure;const retry=document.createElement("button");retry.className="btn btn-outline-primary ms-2";retry.textContent=ar?"إعادة المحاولة":"Try again";retry.onclick=()=>load(key,page);content.append(retry);}}
        finally{if(request===current)content.removeAttribute("aria-busy");}
    }
    nav.addEventListener("click",e=>{const b=e.target.closest("[data-section]");if(b)load(b.dataset.section);});
    async function blocks(area,selected=""){
        const block=document.getElementById("BlockDropdown");if(!block)return;
        const areaValue=area.value;
        block.replaceChildren(new Option(ar?"اختر القطعة":"Select block",""));block.disabled=true;
        if(!areaValue)return;
        const res=await fetch("/UserProfile/GetBlocksByArea?"+new URLSearchParams({areaId:areaValue}));
        if(!res.ok)throw new Error(failure);
        const items=await res.json();
        if(area.value!==areaValue||!block.isConnected)return;
        for(const item of items)block.add(new Option(item.blockName,item.id));
        block.value=selected;block.disabled=false;
    }
    async function addressForm(id){
        const target=document.getElementById("addressFormContainer");if(!target||busy)return;
        busy=true;target.hidden=false;target.textContent=ar?"جارٍ التحميل…":"Loading…";
        try{
            const res=await fetch("/UserProfile/AddAddressPartial");if(!res.ok)throw new Error(failure);
            target.innerHTML=await res.text();
            if(id){
                const data=await $.get("/UserProfile/GetAddressById",{id});
                if(!data.success)throw new Error(data.message||failure);
                const form=target.querySelector("form");
                for(const [name,key] of Object.entries({AddressId:"addressId",Title:"title",Area:"area",Street:"street",HouseNo:"houseNo",Floor:"floor",Landmark:"landmark",Phone:"phone"}))form.elements[name].value=data.data[key]??"";
                form.elements.Phone.value=form.elements.Phone.value.slice(-8);
                await blocks(form.elements.Area,String(data.data.block||""));
            }
            target.querySelector("input:not([type=hidden])")?.focus();
        }catch(e){target.textContent=e.message||failure;}finally{busy=false;}
    }
    content.addEventListener("change",e=>{if(e.target.id==="AreaDropdown")blocks(e.target).catch(()=>notify(failure,false));});
    content.addEventListener("click",async e=>{
        const button=e.target.closest("button");if(!button||busy)return;
        if(button.dataset.orderPage){load("orders",Number(button.dataset.orderPage));return;}
        if(button.id==="btnAddAddress"){addressForm();return;}
        if(button.dataset.editAddress){addressForm(button.dataset.editAddress);return;}
        if(button.dataset.removeAddress){
            busy=true;
            try{
                const result=await Swal.fire({icon:"warning",text:ar?"حذف هذا العنوان؟":"Remove this address?",showCancelButton:true});
                if(!result.isConfirmed)return;
                const data=await $.post("/UserProfile/DeleteAddress",{id:button.dataset.removeAddress,__RequestVerificationToken:token});
                if(!data.success)throw new Error(data.message||failure);
                busy=false;load("addresses");
            }catch(e){notify(e.message||failure,false);}finally{busy=false;}
        }
    });
    content.addEventListener("submit",async e=>{
        const form=e.target;const actions={profileForm:"UpdateProfile",addAddressForm:"AddAddress",changePasswordForm:"ChangePassword"};
        const action=actions[form.id];if(!action)return;e.preventDefault();if(busy)return;
        busy=true;const button=form.querySelector("button[type=submit]");button.disabled=true;
        try{
            const data=await $.post("/UserProfile/"+action,$(form).serialize()+"&"+new URLSearchParams({__RequestVerificationToken:token}).toString());
            if(!data.success)throw new Error(data.message||failure);
            if(form.id==="profileForm")document.getElementById("username").textContent=form.elements.FullName.value;
            if(form.id==="changePasswordForm")form.reset();
            notify(data.message,true);if(form.id==="addAddressForm"){busy=false;load("addresses");}
        }catch(e){notify(e.message||failure,false);}finally{busy=false;button.disabled=false;}
    });
    document.getElementById("deleteAccount").addEventListener("click",async()=>{
        if(busy)return;busy=true;
        try{
            const result=await Swal.fire({icon:"warning",text:ar?"هل تريد حذف حسابك؟":"Delete your account?",showCancelButton:true,confirmButtonText:ar?"حذف":"Delete"});
            if(!result.isConfirmed)return;
            const data=await $.post("/UserProfile/SoftDeleteUser",{__RequestVerificationToken:document.querySelector("[name=__RequestVerificationToken]").value});
            if(!data.success)throw new Error(data.message||failure);
            location.href="/UserAccount/Logout";
        }catch(e){notify(e.message||failure,false);}finally{busy=false;}
    });
    load(new URLSearchParams(location.search).get("section")==="addresses"?"addresses":"orders");
})();
</script>
