@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var user = ViewBag.User;
}
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

<style>
    .customer-profile .leftsidebaar, .customer-profile .rightpage { min-width: 0; }
    .customer-profile #username { font-weight: 700; overflow-wrap: anywhere; }
    .customer-profile .listitem { min-height: 44px; padding: .75rem; }
    .customer-profile .menu-item { cursor: pointer; display: flex; align-items: center; }
    .customer-profile .menu-item:hover, .customer-profile .menu-item.active { background: #eaf3f9; color: #075a96; }
    .customer-profile .menu-item.active { font-weight: 600; }
    .customer-profile #rightContent { overflow-wrap: anywhere; }
    .customer-profile .partialheader { font-weight: 700; }
    .customer-profile .fontsize, .customer-profile .valuefont { font-size: .95rem; }
    @@media (max-width: 767.98px) {
        .customer-profile .leftsidebaar { padding-block-end: 12px; }
        .customer-profile .leftsidebaar .list-group { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px; }
        .customer-profile .fontsize { font-size: .875rem; }
    }
</style>

<div class="container py-3 customer-profile">
    <div class="row">

        <!-- LEFT SIDEBAR -->
        <div class="col-12 col-md-4 col-lg-3 bg-white leftsidebaar">

            <!-- Profile Card -->
            <div class="bg-white p-md-3 p-1 rounded shadow-sm mb-md-2 mb-1 d-flex align-items-center">
               @*  <img src="@(!string.IsNullOrEmpty(user.ProfileImage) ? user.ProfileImage : "https://i.pravatar.cc/50")"
                     class="profile-img me-3" /> *@

                <div>
                    <span id="username">@user.FullName</span>
                </div>
            </div>

           @*  <ul class="list-group bg-white rounded shadow-sm overflow-auto" style="">

                <li class="list-group-item  menu-item active listitem" data-target="#loadOrders">
                    <i href="#" id="loadOrders" class="text-dark text-decoration-none d-flex align-items-center fontsize">
                        <i class="bi bi-box-seam me-2 ifontsize"></i> @_localizer["My Orders"]
                    </i>
                </li>

                <li class="list-group-item  menu-item listitem" data-target="#loadProfileInfo">
                    <a href="#" id="loadProfileInfo" class="text-dark text-decoration-none d-flex align-items-center fontsize">
                        <i class="bi bi-person me-2 ifontsize"></i> @_localizer["Profile Information"]
                    </a>
                </li>

                <li class="list-group-item menu-item listitem" data-target="#loadAddresses">
                    <a href="#" id="loadAddresses" class="text-dark text-decoration-none d-flex align-items-center fontsize">
                        <i class="bi bi-geo-alt me-2 ifontsize"></i> @_localizer["Manage Addresse"]
                    </a>
                </li>

                <li class="list-group-item menu-item listitem" data-target="#loadChangePassword">
                    <a href="#" id="loadChangePassword" class="text-dark text-decoration-none d-flex align-items-center fontsize">
                        <i class="bi bi-lock me-2 ifontsize"></i> @_localizer["Change Password?"]
                    </a>
                </li>

                <li class="list-group-item text-danger fw-semibold listitem">
                    <a href="/UserAccount/Logout" class="text-danger text-decoration-none d-flex align-items-center fontsize">
                        <i class="bi bi-power me-2 ifontsize"></i> @_localizer["Logout"]
                    </a>
                </li>

            </ul> *@
            <ul class="list-group bg-white rounded shadow-sm">

                <li class="list-group-item menu-item active listitem"
                    data-target="#loadOrders">
                    <i class="bi bi-box-seam me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "طلباتي" : "My Orders")</span>
                </li>

                <li class="list-group-item menu-item listitem"
                    data-target="#loadProfileInfo">
                    <i class="bi bi-person me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "معلومات الحساب" : "Profile Information")</span>
                </li>

                <li class="list-group-item menu-item listitem"
                    data-target="#loadAddresses">
                    <i class="bi bi-geo-alt me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "إدارة العناوين" : "Manage Address")</span>
                </li>

                <li class="list-group-item menu-item listitem"
                    data-target="#loadChangePassword">
                    <i class="bi bi-lock me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تغيير كلمة المرور" : "Change Password")</span>
                </li>
                <li class="list-group-item listitem text-danger fw-semibold"
                    style="cursor:pointer;"
                    onclick="location.href='/UserAccount/Logout'">
                    <i class="bi bi-power me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تسجيل الخروج" : "Logout")</span>
                </li>

                <li class="list-group-item listitem text-danger fw-semibold"
                    style="cursor:pointer;"
                    onclick="deleteAccount()">
                    <i class="bi bi-trash me-2 ifontsize"></i>
                    <span class="fontsize">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "حذف الحساب" : "Delete Account")</span>
                </li>


            </ul>

        </div>

        <!-- ✅ RIGHT CONTENT (MOST IMPORTANT) -->
        <div class="col-12 col-md-8 col-lg-9 bg-light rightpage p-3">
            <div id="rightContent">
                <!-- partials will load here -->
                <div class="bg-white p-2 rounded shadow-sm text-muted">
                    Select an option from the left menu
                </div>
            </div>
        </div>

    </div>
</div>



<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

