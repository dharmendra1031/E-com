@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

<div class="bg-white p-4 rounded shadow-sm">
    <span class="mb-3 partialheader">@_localizer["Change Password"]</span>

    <form id="changePasswordForm">
        <div class="row g-3">
            <div class="col-md-12">
                <label class="valuefont">@_localizer["Current Password"] <span class="text-danger">*</span></label>
                <input type="password" class="form-control valuefont" name="CurrentPassword" autocomplete="current-password" required />
            </div>

            <div class="col-md-12">
                <label class="valuefont">@_localizer["New Password"] <span class="text-danger">*</span></label>
                <input type="password" class="form-control valuefont" name="NewPassword" autocomplete="new-password" minlength="8" maxlength="50" required />
            </div>

            <div class="col-md-12">
                <label class="valuefont">@_localizer["Confirm New Password"] <span class="text-danger">*</span></label>
                <input type="password" class="form-control valuefont" name="ConfirmPassword" autocomplete="new-password" minlength="8" maxlength="50" required />
            </div>

            <div class="col-12 text-end mt-2">
                <button type="submit" class="btn btn-primary valuefont">@_localizer["Update"]</button>
            </div>
        </div>
    </form>
</div>
