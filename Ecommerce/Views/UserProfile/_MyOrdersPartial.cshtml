@using System.Globalization
@model List<EcommerceWebApplication.Models.OrderprofileViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{ var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; int page = ViewBag.Page ?? 1; int pages = ViewBag.TotalPages ?? 1; }
<h2 class="h5 fw-bold mb-3">@_localizer["My Orders"]</h2>
@if (Model?.Any() == true)
{
    <div class="store-order-list">
        @foreach (var order in Model)
        {
            <article class="store-order-card">
                <div><strong>@_localizer["Order"] #@order.OrderId</strong><div class="small text-secondary" dir="ltr">@order.CreatedAt.ToString("dd-MM-yyyy")</div></div>
                <div><div class="small text-secondary">@_localizer["Status"]</div><strong>@order.OrderStatusName</strong></div>
                <div><div class="small text-secondary">@_localizer["Pay Status"]</div>@order.PaymentStatusName</div>
                <div><div class="small text-secondary">@_localizer["Total"]</div><strong dir="ltr">KD @order.TotalAmount.ToString("F3",CultureInfo.InvariantCulture)</strong></div>
                <a class="btn btn-outline-primary" href="@Url.Action("OrderInvoicePrint","Report",new { orderId=order.OrderId,format="PDF" })" target="_blank" rel="noopener">@(ar ? "الفاتورة" : "Invoice")</a>
            </article>
        }
    </div>
    @if (pages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-3">
            <button type="button" class="btn btn-outline-secondary" data-order-page="@(page-1)" disabled="@(page<=1)">@(ar ? "السابق" : "Previous")</button>
            <span>@page / @pages</span>
            <button type="button" class="btn btn-outline-secondary" data-order-page="@(page+1)" disabled="@(page>=pages)">@(ar ? "التالي" : "Next")</button>
        </div>
    }
}
else
{
    <div class="text-center py-4"><p>@_localizer["No orders found"]</p><a class="btn btn-primary" href="~/WebCategory/Index">@(ar ? "تسوق الآن" : "Start shopping")</a></div>
}
