@using System.Globalization
@model List<EcommerceWebApplication.Models.OrderprofileViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

<div class="bg-white p-4 rounded shadow-sm">
    <h5 class="mb-3">@_localizer["My Orders"]</h5>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
            <table class="table table-bordered mb-0">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th>@_localizer["Order"] #</th>
                        <th>@_localizer["Date"]</th>
                        <th>@_localizer["Status"]</th>
                        <th>@_localizer["Pay Status"]</th>
                        <th>@_localizer["Pay Type"]</th>
                        <th>@_localizer["Total"]</th>
                        <th>@_localizer["Action"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.OrderId</td>
                            <td>@order.CreatedAt.ToString("dd-MM-yyyy")</td>
                            <td>@order.OrderStatusName</td>
                            <td>@order.PaymentStatusName</td>
                            <td>@order.paytype</td>
                          @*   <td>@order.TotalAmount KD</td> *@
                            <td class="text-center">
                                @order.TotalAmount.ToString("F3", System.Globalization.CultureInfo.InvariantCulture) KD
                            </td> 
                            <td>
                                <button type="button"
                                        class="btn btn-primary btn-sm"
                                        onclick="PrintReport(@order.OrderId)">
                                    <i class="fa fa-print"></i> @_localizer["Print"]
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted">@_localizer["No orders found"].</p>
    }
</div>

<script>
    function PrintReport(orderId) {
        if (!orderId || orderId === 0) {
            alert("Invalid Order Id");
            return;
        }

        // Agar format radio button hai
        const format = document.querySelector("input[name='Format']:checked")?.value || "PDF";

        let url = "/Report/OrderInvoicePrint?OrderId=" + encodeURIComponent(orderId);

        if (format) {
            url += "&format=" + encodeURIComponent(format);
        }

        // PDF new tab me, baaki direct
        if (format.toUpperCase() === "PDF") {
            window.open(url, "_blank");
        } else {
            window.location.href = url;
        }
    }
</script>
