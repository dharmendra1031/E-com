
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.ProductStockViewModel>

@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Manage Product Stock";
    var productJson = System.Text.Json.JsonSerializer.Serialize(Model);
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <form id="filterForm" class="admin-register-filters">
                    <div class="row">
                        <div class="col-md-10 admin-filter-fields" id="NavigationKey">
                            <div class="form-group me-3" style="position:relative;">
                                <label for="name" class="me-1" style="margin-right: 5px;">@_localizer["Name"]:</label>
                                <input type="text" id="name" name="searchName" class="form-control" autocomplete="off" value="@ViewBag.searchName" style="width: 200px; display: inline-block;" />
                                <ul id="suggestions" style="display:none;
                                position:absolute;
                                background:white;
                                list-style:none;
                                padding:0;
                                margin:0;
                                width:100%;  /* width same as input */
                                max-height:200px;
                                overflow-y:auto;
                                border:1px solid #ccc;
                                z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>


                            <div class="form-group me-3">
                                <label for="status" class="me-1">@_localizer["Status"]:</label>
                                <select id="status" name="status" class="form-control" style="width: 150px; display: inline-block;">
                                    <option value="" selected="@(ViewBag.FilterStatus == null ? "selected" : "")"></option>
                                    <option value="Low" selected="@(ViewBag.FilterStatus?.ToString() == "Low")">@_localizer["Low"]</option>
                                    <option value="In" selected="@(ViewBag.FilterStatus?.ToString() == "In")">@_localizer["In"]</option>
                                    <option value="Out" selected="@(ViewBag.FilterStatus?.ToString() == "Out")">@_localizer["Out"]</option>
                                </select>
                            </div>

                            <button type="button" class="btn btn-primary me-2" onclick="submitFilter()">@_localizer["Search"]</button>
                        </div>
                    </div>
                </form>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">


                            <div class="card-body admin-register-body">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <div class="admin-table-scroll admin-order-stock-table"><table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center"> @_localizer["SN"]</th>
                                            <th class="text-center"> @_localizer["Product ID"]</th>
                                            <th class="text-center"> @_localizer["Product Name"]</th>
                                            <th class="text-center"> @_localizer["Total Stock"]</th>
                                            <th class="text-center"> @_localizer["Total sold stock"]</th>
                                            <th class="text-center"> @_localizer["Remaining Qty"]</th>
                                            <th class="text-center"> @_localizer["Status"]</th>
                                            <th class="text-center"> @_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.ProductId</td>
                                                <td class="text-center">@item.ProductName</td>
                                                <td class="text-center">@item.TotalStock</td>
                                                <td class="text-center">@item.Totalsoldstock</td>

                                                <td class="text-center">
                                                    @if (item.Status == "In")
                                                    {
                                                        <span class="badge bg-success">@item.RemainingQty</span>
                                                    }
                                                    else if (item.Status == "Low")
                                                    {
                                                        <span class="badge bg-warning text-dark">@item.RemainingQty</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">@item.RemainingQty</span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    @if (item.Status == "In")
                                                    {
                                                        <span class="badge bg-success">In</span>
                                                    }
                                                    else if (item.Status == "Low")
                                                    {
                                                        <span class="badge bg-warning text-dark">Low</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Out</span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    <button class="btn btn-sm btn-primary"
                                                            type="button" data-productid="@item.ProductId" data-productname="@item.ProductName" data-remaining="@item.RemainingQty" onclick="openAddStockModal(this.dataset.productid, this.dataset.productname, this.dataset.remaining)">
                                                        @_localizer["Add"]
                                                    </button>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table></div>


                                <!-- ✅ Pagination (Same as UserList) -->
                                @* <div class="text-center">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="1"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                                   asp-route-name="@ViewBag.SearchName"
                                                   asp-route-status="@ViewBag.FilterStatus">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.TotalPages)"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div> *@
                                <div class="text-center">
                                    <ul class="pagination justify-content-center">

                                        <!-- First & Previous -->
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="1"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @{
                                            int maxPagesToShow = 10; // ek time me 5 pages hi dikhaye
                                            int startPage = Math.Max(1, Model.PageNumber - 2);
                                            int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                                            // Agar last pages ke karan startPage adjust karna ho
                                            if (endPage - startPage + 1 < maxPagesToShow)
                                            {
                                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                            }

                                            // Agar 1 se pehle bhi pages hain
                                            if (startPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="Index" asp-route-page="1"
                                                       asp-route-name="@ViewBag.SearchName"
                                                       asp-route-status="@ViewBag.FilterStatus">1</a>
                                                </li>
                                                if (startPage > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                            }

                                            // Main visible page loop
                                            for (int i = startPage; i <= endPage; i++)
                                            {
                                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                                       asp-route-name="@ViewBag.SearchName"
                                                       asp-route-status="@ViewBag.FilterStatus">@i</a>
                                                </li>
                                            }

                                            // Agar last ke baad bhi pages hain
                                            if (endPage < Model.TotalPages)
                                            {
                                                if (endPage < Model.TotalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages"
                                                       asp-route-name="@ViewBag.SearchName"
                                                       asp-route-status="@ViewBag.FilterStatus">@Model.TotalPages</a>
                                                </li>
                                            }
                                        }

                                        <!-- Next & Last -->
                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@Model.TotalPages"
                                               asp-route-name="@ViewBag.SearchName"
                                               asp-route-status="@ViewBag.FilterStatus">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Stock Modal -->
<div class="modal fade" id="addStockModal" tabindex="-1">
    <div class="modal-dialog admin-compact-dialog">
        <div class="modal-content">
          
            <div class="modal-header" style="background-color: #337ab7; color: white; padding: 10px;">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"
                        style="color:#fff; font-size: 28px; font-weight: bold; opacity: 1;">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">@_localizer["Add Stock"]</h4>
            </div>

            <div class="modal-body" id="NavigationKey">
                <form id="addStockForm">
                    <input type="hidden" id="productId" />
                    <div class="mb-3">
                        <label>@_localizer["Product Name"]</label>
                        <input type="text" id="productName" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label>@_localizer["Remaining Qty"]</label>
                        <input type="text" id="remainingQty" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label>@_localizer["New Stock Qty"]</label>
                        <input type="text" id="newStockQty" class="form-control" onkeypress="return numeric(event)" maxlength="10" required />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
             
                <button type="button" class="btn btn-default btn-sm" data-dismiss="modal">@_localizer["Close"]</button>
                <button type="button" class="btn btn-primary" onclick="saveStock()">@_localizer["Save"]</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsgrid/1.5.3/jsgrid.min.js"></script>
    <script>
       

        function openAddStockModal(productId, productName, remainingQty) {
            $("#productId").val(productId);
            $("#productName").val(productName);
            $("#remainingQty").val(parseFloat(remainingQty));
            $("#newStockQty").val("");
            $("#addStockModal").modal("show");
        }

        async function saveStock() {
            const productId = $("#productId").val();
            const newStock = Number($("#newStockQty").val());
            if (!Number.isInteger(newStock) || newStock <= 0 || newStock > 2147483647) {
                AdminFeedback.show("warning", document.documentElement.dir === "rtl" ? "أدخل كمية مخزون صحيحة." : "Enter a valid positive stock quantity.");
                return;
            }
            await AdminFeedback.post("/ProductStock/AddStock", {
                method: "POST",
                body: new URLSearchParams({productId, newStock: String(newStock)})
            }, () => { $("#addStockModal").modal("hide"); location.reload(); });
        }

        //Filter searcg
                     function submitFilter() {
            const name = document.getElementById('name').value.trim();
            const status = document.getElementById('status').value;

            let url = "/ProductStock/Index?";
            const params = [];

            if (name) params.push(`name=${encodeURIComponent(name)}`);
            if (status) params.push(`status=${encodeURIComponent(status)}`);

            url += params.join("&");

            window.location.href = url;
        }

        function resetFilter() {
            window.location.href = "/ProductStock/Index";
        }


    </script>
    <script>
        $(document).ready(function () {

            function fetchCategorySuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/ProductStock/AutoCompleteSql',
                    type: 'GET',
                    data: { term: query },
                    success: function(data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item)
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item);
                                        $suggestionBox.hide();
                                        $('#name').focus();
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            $('#name').on('input', function() {
                fetchCategorySuggestions($(this).val());
            });

            enableSuggestionNavigation('#name', '#suggestions');

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });
    </script>
}
