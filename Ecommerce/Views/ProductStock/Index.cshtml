@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.ProductStockViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Inventory","المخزون");
}
<div class="admin-master-register" id="masterRegister" data-register-url="@Url.Action("Index","ProductStock")" data-suggest-url="@Url.Action("AutoCompleteSql","ProductStock")">
    <section class="admin-panel">
        <div class="admin-section-heading"><h2>@ViewData["Title"]</h2></div>
        <form id="masterFilters" method="get" asp-action="Index" class="admin-register-filters">
            
            <div class="form-group"><label for="name">@T("Search by name","بحث بالاسم")</label>
                <input id="name" name="name" type="search" class="form-control" list="masterSuggestions" autocomplete="off" value="@ViewBag.SearchName" />
                <datalist id="masterSuggestions"></datalist>
            </div>
            <div class="form-group"><label for="status">@T("Status","الحالة")</label>
                <select id="status" name="status" class="form-control"><option value="">@T("All","الكل")</option>
                    <option value="In" selected="@(ViewBag.FilterStatus=="In")">@T("In stock","متوفر")</option>
                    <option value="Low" selected="@(ViewBag.FilterStatus=="Low")">@T("Low stock","مخزون منخفض")</option>
                    <option value="Out" selected="@(ViewBag.FilterStatus=="Out")">@T("Out of stock","نفد المخزون")</option>
                </select></div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-primary">@T("Search","بحث")</button>
            <a asp-action="Index" id="clearMasterFilters" class="btn btn-default">@T("Clear","مسح")</a>
        </form>
        <p id="masterMessage" class="admin-muted" role="status"></p>
        <div id="masterResults"><partial name="_RegisterRows" model="Model" /></div>
    </section>
    <section class="admin-panel admin-stock-editor" id="stockEditor" hidden>
        <h3>@T("Add stock","إضافة مخزون")</h3>
        <p id="stockProduct"></p>
        <p>@T("Current available quantity","الكمية المتاحة الحالية"): <strong id="stockAvailable"></strong></p>
        <form id="stockForm" method="post" data-feedback="off" data-post-url="@Url.Action("AddStock","ProductStock")">
            <input type="hidden" name="productId" />
            <div class="form-group"><label for="newStock">@T("Quantity to add","الكمية المراد إضافتها")</label><input id="newStock" name="newStock" type="number" min="1" max="2147483647" step="1" class="form-control" required /></div>
            <div class="order-actions"><button type="submit" class="btn btn-primary">@T("Save stock","حفظ المخزون")</button><button type="button" id="cancelStock" class="btn btn-default">@T("Cancel","إلغاء")</button></div>
        </form>
    </section>
</div>
@section Scripts {
    <script src="~/js/master-register.js" asp-append-version="true"></script>
}
