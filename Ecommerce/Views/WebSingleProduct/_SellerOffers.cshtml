@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.SingleProductVM
@inject Microsoft.Extensions.Configuration.IConfiguration SellerCartConfiguration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment SellerCartEnvironment
@{
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var cartEnabled = EcommerceWebApplication.Helper.SellerCartAccess.Enabled(SellerCartConfiguration);
    var unified = EcommerceWebApplication.Helper.SellerCartAccess.CheckoutEnabled(SellerCartConfiguration, SellerCartEnvironment);
}
<section id="sellerOffers" class="store-detail-panel mt-3">
    <h2 class="h5 fw-bold">@(ar ? "عروض البائعين — معاينة" : "Seller offers — preview")</h2>
    <p class="small text-secondary">@(unified ? (ar ? "اختر البائع والكمية. اختبار فقط." : "Choose a seller and quantity. Development test only.") : (ar ? "الدفع للبائعين غير متاح بعد." : "Seller checkout is not enabled yet."))</p>
    @if (Model.LowestSellerPrice.HasValue)
    {
        <p>@(ar ? "أقل سعر للبائعين" : "Lowest available seller price") <strong dir="ltr">KD @Model.LowestSellerPrice.Value.ToString("F3", CultureInfo.InvariantCulture)</strong></p>
    }
    @if (Model.SellerOffers.Count == 0)
    {
        <p>@(ar ? "لا توجد عروض متاحة في هذه الصفحة" : "No available seller offers on this page.")</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>@(ar ? "البائع" : "Seller")</th><th>@(ar ? "السعر" : "Price")</th><th>@(ar ? "الكمية المتاحة" : "Available")</th><th>@(ar ? "اختيار للمقارنة" : "Compare")</th></tr></thead>
                <tbody>
                @foreach (var offer in Model.SellerOffers)
                {
                    var selected = offer.ListingId == Model.SelectedSellerListingId;
                    <tr class="@(selected ? "table-active" : "")">
                        <td>@(ar && !string.IsNullOrWhiteSpace(offer.VendorNameArb) ? offer.VendorNameArb : offer.VendorName)</td>
                        <td dir="ltr">KD @offer.Price.ToString("F3", CultureInfo.InvariantCulture)</td>
                        <td>@offer.AvailableQuantity</td>
                        <td>
                            @if (cartEnabled && User.IsInRole("Customer"))
                            {
                                <form asp-controller="WebCart" asp-action="SetSellerQuantity" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="listingId" value="@offer.ListingId" />
                                    <input type="number" name="quantity" value="1" min="1" max="@Math.Min(offer.AvailableQuantity,1000000)" class="form-control" aria-label="@(ar ? "الكمية" : "Quantity")" required />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@(ar ? "حفظ في سلة البائع" : "Set cart quantity")</button>
                                </form>
                            }
                            @if (unified && !User.IsInRole("Customer"))
                            {
                                <a class="btn btn-outline-primary" asp-controller="UserAccount" asp-action="Login">@(ar ? "تسجيل الدخول للشراء" : "Sign in to buy")</a>
                            }
                            @if (selected) { <strong>@(ar ? "محدد" : "Selected")</strong> }
                            else { <a class="btn btn-sm btn-outline-primary" asp-action="SingleProduct" asp-route-id="@Model.ProductId" asp-route-sellerPage="@Model.SellerPage" asp-route-listingId="@offer.ListingId" asp-fragment="sellerOffers">@(ar ? "اختيار" : "Select")</a> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <nav aria-label="@(ar ? "صفحات البائعين" : "Seller pages")">
        @if (Model.SellerPage > 1) { <a asp-action="SingleProduct" asp-route-id="@Model.ProductId" asp-route-sellerPage="@(Model.SellerPage - 1)" asp-fragment="sellerOffers" class="btn btn-sm btn-outline-secondary">@(ar ? "السابق" : "Previous")</a> }
        @if (Model.HasMoreSellers) { <a asp-action="SingleProduct" asp-route-id="@Model.ProductId" asp-route-sellerPage="@(Model.SellerPage + 1)" asp-fragment="sellerOffers" class="btn btn-sm btn-outline-secondary">@(ar ? "التالي" : "Next")</a> }
    </nav>
</section>
