@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.SingleProductVM
@{
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var maxQty = Math.Max(0, (int)Model.Stock.GetValueOrDefault());
    var image = Model.Images.FirstOrDefault()?.Base64;
}
<div class="container py-3 py-md-4 product-detail">
    <nav class="store-breadcrumb mb-3" aria-label="@(ar ? "مسار التنقل" : "Breadcrumb")">
        <a href="~/WebHome/Index">@(ar ? "الرئيسية" : "Home")</a><span>/</span>
        <a href="@Url.Action("Index", "WebCategory", new { categoryId = Model.CategoryId })">@Model.CategoryName</a><span>/</span>
        <a href="@Url.Action("Index", "WebCategory", new { categoryId = Model.CategoryId, subCategoryId = Model.SubCategoryId })">@Model.SubCategoryName</a>
    </nav>
    <div class="store-detail-panel">
        <div class="row g-3 g-lg-4">
            <div class="col-md-6">
                <div class="store-detail-gallery">
                    <div class="store-detail-main">
                        @if (image != null)
                        {
                            <button type="button" class="store-image-zoom" data-bs-toggle="modal" data-bs-target="#productImageModal" aria-label="@(ar ? "تكبير الصورة" : "Enlarge product image")">
                                <img id="mainImg" src="@image" alt="@Model.Name" fetchpriority="high" />
                                <span class="store-zoom-label"><i class="fa fa-search-plus" aria-hidden="true"></i> @(ar ? "تكبير" : "Enlarge")</span>
                            </button>
                        }
                        else
                        {
                            <span class="text-secondary">@(ar ? "لا توجد صورة" : "No image available")</span>
                        }
                    </div>
                    @if (Model.Images.Count > 1)
                    {
                        <div class="store-detail-thumbnails">
                            @for (int i = 0; i < Model.Images.Count; i++)
                            {
                                <button type="button" class="store-thumbnail" data-image="@Model.Images[i].Base64" aria-pressed="@(i == 0 ? "true" : "false")" aria-label="@(ar ? "الصورة" : "Image") @(i+1)">
                                    <img src="@Model.Images[i].Base64" alt="" loading="lazy" decoding="async" />
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-6 store-detail-info">
                @if (Model.Brand != null)
                {
                    <a href="@Url.Action("Index", "BrandWiseProducts", new { brandId = Model.Brand.BrandId })" class="store-detail-brand">
                        @if (!string.IsNullOrEmpty(Model.Brand.BrandLogoBase64))
                        {
                            <img src="@Model.Brand.BrandLogoBase64" alt="" loading="lazy" />
                        }
                        @Model.Brand.BrandName
                    </a>
                }
                <h1 class="store-detail-name">@Model.Name</h1>
                <div class="small text-secondary">
                    @if (!string.IsNullOrEmpty(Model.SKUId)) { <span dir="ltr">SKU: @Model.SKUId</span> }
                    @if (!string.IsNullOrEmpty(Model.Ds_ProdID)) { <span class="ms-2">@(ar ? "رمز المنتج:" : "Product ID:") @Model.Ds_ProdID</span> }
                </div>
                <a href="#productReviews" class="text-decoration-none small">
                    @if (Model.TotalReviews > 0)
                    {
                        <span class="store-rating" dir="ltr">★ @Model.AverageRating.ToString("F1", CultureInfo.InvariantCulture) / 5</span>
                        <span class="text-secondary">(@Model.TotalReviews @(ar ? "تقييمات" : "reviews"))</span>
                    }
                    else { <span class="text-secondary">@(ar ? "لا توجد تقييمات" : "No reviews yet")</span> }
                </a>
                <div class="fw-semibold @(maxQty > 0 ? "text-success" : "text-danger")">@(maxQty > 0 ? (ar ? "متوفر" : "In stock") : (ar ? "غير متوفر" : "Out of stock"))</div>
                <div class="store-detail-price">
                    @if (Model.IsWeekendDeal && Model.OfferPrice.HasValue)
                    {
                        <s class="text-secondary fs-6" dir="ltr">KD @Model.Price.GetValueOrDefault().ToString("F3", CultureInfo.InvariantCulture)</s>
                        <span class="badge bg-danger">@Model.DiscPer% @(ar ? "خصم" : "OFF")</span>
                        <strong dir="ltr">KD @Model.OfferPrice.Value.ToString("F3", CultureInfo.InvariantCulture)</strong>
                    }
                    else { <strong dir="ltr">KD @Model.Price.GetValueOrDefault().ToString("F3", CultureInfo.InvariantCulture)</strong> }
                </div>
                <div class="store-detail-purchase">
                    <div class="store-detail-quantity" aria-label="@(ar ? "الكمية" : "Quantity")">
                        <button type="button" class="btn btn-outline-secondary" id="qtyMinus" aria-label="@(ar ? "تقليل الكمية" : "Decrease quantity")" disabled>−</button>
                        <span id="qty" aria-live="polite">@(maxQty > 0 ? 1 : 0)</span>
                        <button type="button" class="btn btn-outline-secondary" id="qtyPlus" aria-label="@(ar ? "زيادة الكمية" : "Increase quantity")" disabled="@(maxQty <= 1)">+</button>
                    </div>
                    <button type="button" class="btn btn-primary add-to-cart-btn store-detail-add" data-productid="@Model.ProductId" data-quantity="1" id="detailAdd" disabled="@(maxQty == 0)">
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i> @(maxQty > 0 ? (ar ? "أضف للسلة" : "Add to cart") : (ar ? "غير متوفر" : "Unavailable"))
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Warranty) || !string.IsNullOrWhiteSpace(Model.ProductsModel) || Model.Weight > 0)
                {
                    <dl class="store-detail-facts mb-0">
                        @if (!string.IsNullOrWhiteSpace(Model.Warranty)) { <dt>@(ar ? "الضمان" : "Warranty")</dt><dd>@Model.Warranty</dd> }
                        @if (!string.IsNullOrWhiteSpace(Model.ProductsModel)) { <dt>@(ar ? "الموديل" : "Model")</dt><dd>@Model.ProductsModel</dd> }
                        @if (Model.Weight > 0) { <dt>@(ar ? "الوزن" : "Weight")</dt><dd>@Model.Weight @(ar ? "غرام" : "g")</dd> }
                    </dl>
                }
            </div>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <section class="store-detail-panel mt-3"><h2 class="h5 fw-bold">@(ar ? "الوصف" : "Description")</h2><div class="store-description">@Model.Description</div></section>
    }
    @if (Model.Specifications.Any())
    {
        <section class="store-detail-panel mt-3">
            <h2 class="h5 fw-bold">@(ar ? "المواصفات" : "Specifications")</h2>
            <dl class="store-specifications mb-0">
                @foreach (var spec in Model.Specifications)
                {
                    <dt>@(ar && !string.IsNullOrWhiteSpace(spec.SpeciNameAr) ? spec.SpeciNameAr : spec.SpeciNameEn)</dt>
                    <dd>@(ar && !string.IsNullOrWhiteSpace(spec.SpecivalueAr) ? spec.SpecivalueAr : spec.SpecivalueEn)</dd>
                }
            </dl>
        </section>
    }
    <section id="productReviews" class="store-detail-panel mt-3">
        <h2 class="h5 fw-bold">@(ar ? "تقييمات العملاء" : "Customer reviews") (@Model.TotalReviews)</h2>
        <div id="reviewList" aria-live="polite">
            @foreach (var review in Model.Reviews)
            {
                <article class="store-review"><strong dir="ltr">★ @review.Rating / 5</strong><p class="mb-0">@review.Comment</p></article>
            }
            @if (!Model.Reviews.Any()) { <p class="text-secondary mb-0">@(ar ? "لا توجد تقييمات بعد" : "No reviews yet")</p> }
        </div>
        @if (Model.TotalReviews > Model.Reviews.Count)
        {
            <button type="button" id="moreReviews" class="btn btn-outline-primary mt-3">@(ar ? "عرض المزيد" : "Load more reviews")</button>
            <p class="text-danger small mb-0" id="reviewError" role="status"></p>
        }
    </section>
</div>
@if (image != null)
{
    <div class="modal fade" id="productImageModal" tabindex="-1" aria-label="@(ar ? "صورة المنتج" : "Product image")">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h2 class="modal-title h6">@Model.Name</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(ar ? "إغلاق" : "Close")"></button></div>
                <div class="modal-body text-center"><img id="zoomImg" class="store-zoom-image" alt="@Model.Name" /></div>
            </div>
        </div>
    </div>
}
<script>
(() => {
    const main = document.getElementById("mainImg");
    const modal = document.getElementById("productImageModal");
    document.querySelectorAll(".store-thumbnail").forEach(button => button.addEventListener("click", () => {
        main.src = button.dataset.image;
        document.querySelectorAll(".store-thumbnail").forEach(item => item.setAttribute("aria-pressed", String(item === button)));
    }));
    modal?.addEventListener("show.bs.modal", () => document.getElementById("zoomImg").src = main.src);
    const maximum = @maxQty;
    const add = document.getElementById("detailAdd");
    const minus = document.getElementById("qtyMinus");
    const plus = document.getElementById("qtyPlus");
    const qty = document.getElementById("qty");
    let quantity = maximum > 0 ? 1 : 0;
    function setQuantity(value) {
        quantity = Math.min(maximum, Math.max(1, value));
        qty.textContent = quantity;
        add.dataset.quantity = quantity;
        minus.disabled = quantity <= 1;
        plus.disabled = quantity >= maximum;
    }
    minus.addEventListener("click", () => setQuantity(quantity - 1));
    plus.addEventListener("click", () => setQuantity(quantity + 1));
    const more = document.getElementById("moreReviews");
    let page = 2;
    more?.addEventListener("click", async () => {
        more.disabled = true;
        const error = document.getElementById("reviewError");
        error.textContent = "";
        try {
            const response = await fetch("/WebSingleProduct/Reviews/@Model.ProductId?page=" + page);
            if (!response.ok) throw new Error();
            const result = await response.json();
            for (const review of result.items) {
                const item = document.createElement("article");
                item.className = "store-review";
                const rating = document.createElement("strong");
                rating.dir = "ltr";
                rating.textContent = "★ " + review.rating + " / 5";
                const text = document.createElement("p");
                text.className = "mb-0";
                text.textContent = review.comment || "";
                item.append(rating,text);
                document.getElementById("reviewList").append(item);
            }
            page++;
            more.hidden = !result.hasMore;
        } catch { error.textContent = document.documentElement.lang === "ar" ? "تعذر التحميل. حاول مرة أخرى." : "Unable to load reviews. Try again."; }
        finally { more.disabled = false; }
    });
})();
</script>
