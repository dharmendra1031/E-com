@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Registered Customers Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert" style="min-height: calc(100vh - 160px);">
                <div class="card-header">
                    <div class="row pb-4">
                        <h4>@_localizer["Registered Customers Report"]</h4>
                    </div>
                    <hr />
                </div>

                <div class="row">
                    <div class="basic-form">
                        <form id="customerReportForm" class="p-4">
                            <div class="row g-3 mt-3">
                                <!-- From Date -->
                                <div class="col-md-3 mb-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["From"]:</label>
                                        <input type="text" name="from" id="fromDate" class="form-control" placeholder="dd-MM-yyyy" />
                                    </div>
                                </div>

                                <!-- To Date -->
                                <div class="col-md-3 mb-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["To"]:</label>
                                        <input type="text" name="to" id="toDate" class="form-control" placeholder="dd-MM-yyyy" />
                                    </div>
                                </div>

                                <!-- Status -->
                                <div class="col-md-3 mb-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Status"]:</label>
                                        <select id="isActive" name="isActive" class="form-control input-default">
                                            <option value=""></option>
                                            <option value="true">Active</option>
                                            <option value="false">Inactive</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Keyword -->
                                <div class="col-md-3 mb-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Keyword"]:</label>
                                        <input type="text" id="keyword" name="keyword" class="form-control input-default" placeholder="Name / Email / Phone" />
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-3">
                                <!-- Export Format -->
                                <div class="col-md-3" id="format">
                                    <label class="form-label d-block">@_localizer["Export"]:</label>
                                    <br>
                                    <label class="radio-inline">
                                        <input type="radio" name="format" value="PDF" checked> @_localizer["PDF"]
                                    </label>

                                    <label class="radio-inline">
                                        <input type="radio" name="format" value="XLSX"> @_localizer["Excel"]
                                    </label>

                                    
                                </div>

                                <div class="col-md-3 mb-3">
                                    <button type="button" onclick="PrintCustomerReport()" class="btn btn-primary btn-flat m-t-30">
                                        @_localizer["Generate Report"]
                                    </button>
                                </div>
                            </div>
                        </form>
