<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker3.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
@section scripts {
<script>
    function PrintCustomerReport() {
        const from = document.getElementById("fromDate").value.trim();
        const to = document.getElementById("toDate").value.trim();
        const isActive = document.getElementById("isActive").value;
        const keyword = document.getElementById("keyword").value.trim();
        const format = document.querySelector("input[name='format']:checked").value;

        const rptParameters = new URLSearchParams({
            from: from,
            to: to,
            isActive: isActive,
            keyword: keyword,
            format: format
        });

        const url = `/Report/CustomersReport?${rptParameters.toString()}`;

        if (format === "PDF") {
          
            window.open(url, "_blank");
        } else {
          
            window.location.href = url;
        }
    }
</script>
