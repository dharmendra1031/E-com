    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>
<script>
    $(function () {
        $('#fromDate').datepicker({
            format: 'dd-mm-yyyy',
            autoclose: true,
            todayHighlight: true,
            clearBtn: true
        }).on('changeDate', function (e) {
            $('#toDate').datepicker('setStartDate', e.date);
        });

        $('#toDate').datepicker({
            format: 'dd-mm-yyyy',
            autoclose: true,
            todayHighlight: true,
            clearBtn: true
        });

        const fromVal = $('#fromDate').val();
        if (fromVal) {
            const parts = fromVal.split("-");
            const formattedDate = new Date(parts[2], parts[1] - 1, parts[0]);
            $('#toDate').datepicker('setStartDate', formattedDate);
        }
    });

   

</script>
