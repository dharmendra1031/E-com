    <script>

        $(function () {

            // Start Date Picker

            $('#startDate').datepicker({

                format: 'dd-mm-yyyy',

                autoclose: true,

                todayHighlight: true,

                clearBtn: true,

                orientation: "bottom auto",

                startDate: new Date()   // ✅ only today or future dates allowed

            }).on('changeDate', function (e) {

                // StartDate select hone ke baad EndDate ki min date set ho jaye

                $('#endDate').datepicker('setStartDate', e.date);

            });

            // End Date Picker

            $('#endDate').datepicker({

                format: 'dd-mm-yyyy',

                autoclose: true,

                todayHighlight: true,

                clearBtn: true,

                orientation: "bottom auto"

            }).on('changeDate', function (e) {

                // EndDate select hone ke baad StartDate ki max date set ho jaye

                $('#startDate').datepicker('setEndDate', e.date);

            });

            // ----------- EDIT MODE FIX -----------

            const fromVal = $('#startDate').val();

            const toVal = $('#endDate').val();

            if (fromVal) {

                const fromParts = fromVal.split("-");

                if (fromParts.length === 3) {

                    const fromDate = new Date(fromParts[2], fromParts[1] - 1, fromParts[0]);

                    $('#endDate').datepicker('setStartDate', fromDate);

                }

            }

            if (toVal) {

                const toParts = toVal.split("-");

                if (toParts.length === 3) {

                    const toDate = new Date(toParts[2], toParts[1] - 1, toParts[0]);

                    $('#startDate').datepicker('setEndDate', toDate);

                }

            }

        });
    </script>


    <script>

        $(document).ready(function () {

            $("#DiscountValue").on("keypress", function (e) {

                var discountType = $("#DiscountType").val();

                        if (!discountType) {

            Swal.fire({

                icon: "warning",

                title: "Missing Discount Type",

                text: "Please select Discount Type first.",

                confirmButtonText: "OK"

            }).then(() => {

                $("#DiscountType").focus();

            });

            return false;

                        }

            });

        });

    </script>


    <script>

        function validateForm() {

            let isValid = true;

            // Discount Value check

            let discountValue = document.getElementById("DiscountValue").value.trim();

            let discountError = document.getElementById("DiscountValueError");

            if (discountValue === "") {

                discountError.innerText = "The DiscountValue field is required.";

                isValid = false;

            } else if (parseFloat(discountValue) <= 0) {

                discountError.innerText = "Discount Value must be greater than 0.";

                isValid = false;

            } else {

                discountError.innerText = "";

            }

            // Min Order Amount check

            let minOrder = document.getElementById("MinOrderAmount").value.trim();

            let minOrderError = document.getElementById("MinOrderAmountError");

            if (minOrder === "") {

                minOrderError.innerText = "The MinOrderAmount field is required.";

                isValid = false;

            } else if (parseFloat(minOrder) <= 0) {

                minOrderError.innerText = "Min Order Amount must be greater than 0.";

                isValid = false;

            } else {

                minOrderError.innerText = "";

            }

            return isValid;

        }

        // Form submit par validate call karein

        document.querySelector("form").addEventListener("submit", function (e) {

            if (!validateForm()) {

                e.preventDefault(); // ❌ stop form submit

            }

        });

        // 👉 User input par error hatao

        document.getElementById("DiscountValue").addEventListener("input", function () {

            document.getElementById("DiscountValueError").innerText = "";

        });

        document.getElementById("MinOrderAmount").addEventListener("input", function () {

            document.getElementById("MinOrderAmountError").innerText = "";

        });
    </script>

}

