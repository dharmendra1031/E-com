@using System.Globalization
@model EcommerceWebApplication.Models.Coupon
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model?.CouponId > 0 ? "Update Coupon" : "Add Coupon";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert" style="min-height: calc(100vh - 160px);">
                <div class="card-header">
                    <h4>
                        @(Model?.CouponId > 0 ? _localizer["Update Coupon"] : _localizer["Add Coupon"])
                    </h4>

                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                <a href="@Url.Action("Index", "Coupon")" class="btn btn-primary">
                                    <i class="fas fa-list"></i> @_localizer["Coupon list"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card-body">
                    <div class="basic-form">
                        <form asp-controller="Coupon" asp-action="Create" method="post" id="NavigationKey">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="CouponId" />
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Coupon Code"] <span style="color:red">*</span></label>
                                        <input asp-for="Code" class="form-control" />
                                        <span asp-validation-for="Code" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Discount Type"] <span style="color:red">*</span></label>
                                        <select asp-for="DiscountType" class="form-control" id="DiscountType">
                                            <option value=""></option>
                                            <option value="Percentage">Percentage</option>
                                            <option value="Amount">Amount</option>
                                        </select>
                                        <span asp-validation-for="DiscountType" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Discount Value"] <span style="color:red">*</span></label>
                                        <input asp-for="DiscountValue" class="form-control"
                                               id="DiscountValue"
                                               value="@(Model?.CouponId > 0 ? Convert.ToDecimal(Model.DiscountValue).ToString("F3", CultureInfo.InvariantCulture) : string.Empty)"
                                               onkeypress="return ValidAmount(event, this);" maxlength="8" />
                                        <span id="DiscountValueError" class="text-danger"></span>
                                    </div>


                                </div>

                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Min Order Amount"] <span style="color:red">*</span></label>
                                        <input asp-for="MinOrderAmount" class="form-control" type="text"
                                               value="@(Model?.CouponId > 0 ? Convert.ToDecimal(Model.MinOrderAmount).ToString("F3", CultureInfo.InvariantCulture) : string.Empty)"
                                               onkeypress="return ValidAmount(event, this);" maxlength="8" />
                                        <span id="MinOrderAmountError" class="text-danger"></span>
                                    </div>
                                </div>


                            </div>
                            <div class="row">
                               
                               
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Max No Of Users"]</label>
                                        <input asp-for="NoOfUsers" class="form-control" type="text" onkeypress="return numeric(event)" maxlength="10"/>
                                        
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Status"] <span style="color:red">*</span></label>
                                        <select asp-for="IsActive" class="form-control">
                                            <option value="True">@_localizer["Active"]</option>
                                            <option value="false">@_localizer["Inactive"]</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Valid From"] <span style="color:red">*</span></label>
                                        <input asp-for="ValidFromm" type="text" id="startDate" placeholder="dd-MM-yyyy" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="ValidFromm" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Valid To"] <span style="color:red">*</span></label>
                                        <input asp-for="ValidToo" type="text" id="endDate" placeholder="dd-MM-yyyy" class="form-control" autocomplete="off" />
                                        <span asp-validation-for="ValidToo" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>
                            
                          @*   <input asp-for="ValidFrom" type="text" id="startDate" placeholder="YYYY-MM-DD" class="form-control" autocomplete="off" />
                            <input asp-for="ValidTo" type="text" id="endDate" placeholder="YYYY-MM-DD" class="form-control" autocomplete="off" /> *@

                            <div class="row">
                               
                               
                            </div>

                            <button type="submit" class="btn btn-primary mt-3">
                                @(Model?.CouponId > 0 ? _localizer["Update"] : _localizer["Save"])
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
