
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.CouponViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Coupon List";
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert" id="NavigationKey">
                <form id="filterForm" class="form-inline mt-2" style="margin-bottom: 11px;">
                    <!-- Discount Type Filter -->
                    <label for="discountType" class="me-1">@_localizer["Discount Type"]:</label>
                    <select id="discountType" name="discountType" class="form-control" style="width: 200px; margin-right: 10px;">
                        <option value=""></option>
                        <option value="Percentage" selected="@(ViewBag.DiscountTypeFilter?.ToString() == "Percentage")">
                            Percentage
                        </option>
                        <option value="Fixed" selected="@(ViewBag.DiscountTypeFilter?.ToString() == "Fixed")">
                            Fixed
                        </option>
                    </select>

                    <!-- Status Filter -->
                    <label for="isActive" class="me-1">@_localizer["Status"]:</label>
                    <select id="isActive" name="isActive" class="form-control" style="width: 150px; margin-right: 10px;">
                        <option value=""></option>
                        <option value="true" selected="@(ViewBag.IsActiveFilter?.ToString().ToLower() == "true")">
                            @_localizer["Active"]
                        </option>
                        <option value="false" selected="@(ViewBag.IsActiveFilter?.ToString().ToLower() == "false")">
                            @_localizer["Inactive"]
                        </option>
                    </select>

                    <!-- Search Button -->

                    <div class="form-group ms-3">
                        <button type="button" class="btn btn-primary" onclick="submitFilter()">
                            @_localizer["Search"]
                        </button>
                        <a asp-controller="Coupon" asp-action="Create" class="btn btn-primary">
                            <i class="ti-bookmark-alt bg-info"></i> @_localizer["Add Coupon"]
                        </a>
                    </div>
                </form>
                @*  <div class="card-header">
                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                <a asp-action="Create" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> @_localizer["Add Coupon"]
                                </a>
                            </li>
                        </ul>
                    </div>
                </div> *@

                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">
                            <div class="card-body">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }

                                <div class="admin-table-scroll"><table class="table table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white; color: #000; ">
                                        <tr>
                                            <th class="text-center">@_localizer["SN"]</th>
                                            <th class="text-center">@_localizer["ID"]</th>
                                            <th class="text-center">@_localizer["Code"]</th>
                                            <th class="text-center">@_localizer["Discount Type"]</th>
                                            <th class="text-center">@_localizer["Discount Value"]</th>
                                            @*<th class="text-center">@_localizer["Min Order Amount"]</th>*@
                                            <th class="text-center">@_localizer["No of Users"]</th>
                                            <th class="text-center">@_localizer["No of Uses"]</th>
                                            <th class="text-center">@_localizer["Status"]</th>
                                            <th class="text-center">@_localizer["Action"]</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.CouponId</td>
                                                <td class="text-center">@item.Code</td>
                                                <td class="text-center">@item.DiscountType</td>
                                                <td class="text-center">@String.Format("{0:N3}", item.DiscountValue)</td>
                                                @*<td class="text-center">@String.Format("{0:N3}", item.MinOrderAmount)</td>*@
                                                <td class="text-center">@item.NoOfUsers</td>
                                                <td class="text-center">@item.NoOfUses</td>

                                                <td class="text-center">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="badge bg-success" style="display:inline-block;min-width:90px;">
                                                            @_localizer["Active"]
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger" style="display:inline-block;min-width:90px;">
                                                            @_localizer["Inactive"]
                                                        </span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    <a asp-action="Create" asp-controller="Coupon" asp-route-id="@item.CouponId" class="btn btn-sm btn-primary me-1">
                                                        <i class="ti-pencil"></i>
                                                    </a>
                                                
                                                    <button class="btn btn-sm btn-danger " onclick="deletecoupon(@item.CouponId)">
                                                        <i class="ti-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table></div>

                                <!-- ✅ Pagination -->
                                <div class="text-center">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="1"
                                               asp-route-discountType="@ViewBag.DiscountTypeFilter"
                                               asp-route-isActive="@ViewBag.IsActiveFilter">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-discountType="@ViewBag.DiscountTypeFilter"
                                               asp-route-isActive="@ViewBag.IsActiveFilter">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                                   asp-route-discountType="@ViewBag.DiscountTypeFilter"
                                                   asp-route-isActive="@ViewBag.IsActiveFilter">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-discountType="@ViewBag.DiscountTypeFilter"
                                               asp-route-isActive="@ViewBag.IsActiveFilter">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.TotalPages)"
                                               asp-route-discountType="@ViewBag.DiscountTypeFilter"
                                               asp-route-isActive="@ViewBag.IsActiveFilter">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>


@section Scripts {
    <script>
        function deletecoupon(id) {
            return AdminFeedback.remove("/Coupon/Delete/" + encodeURIComponent(id));
        }
    </script>
    <script>
        function submitFilter() {
            var discountType = document.getElementById("discountType").value;
            var isActive = document.getElementById("isActive").value;

            // Query string build karo
            var query = "?";
            if (discountType) query += "discountType=" + encodeURIComponent(discountType) + "&";
            if (isActive) query += "isActive=" + encodeURIComponent(isActive) + "&";

            // Agar last me & aaya to remove kar do
            if (query.endsWith("&") || query.endsWith("?")) {
                query = query.slice(0, -1);
            }

            // Redirect to Index with filters
            window.location.href = "/Coupon/Index" + query;
        }
    </script>


}