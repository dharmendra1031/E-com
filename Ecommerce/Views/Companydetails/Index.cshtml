@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@model EcommerceWebApplication.Models.CompanyDetails

@{
    ViewData["Title"] = "Companydetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4>@_localizer["Create Company"]</h4>
                </div>

                <div class="card-body">
                    <div class="basic-form">
                        <form asp-action="Create" id="NavigationKey" method="post" enctype="multipart/form-data" onsubmit="return validateEmailSubmit();">
                            @Html.AntiForgeryToken()

                            <div class="row">
                                <!-- Company Name (AR)-->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Company Name(AR)"] <span style="color:red">*</span></label>
                                        <input asp-for="CompanyNameArabic" class="form-control" />
                                        <span asp-validation-for="CompanyNameArabic" class="text-danger"></span>
                                    </div>
                                </div>
                                <!-- Company Name (EN)-->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Company Name(EN)"] <span style="color:red">*</span></label>
                                        <input asp-for="CompanyName" class="form-control" />
                                        <span asp-validation-for="CompanyName" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <!-- Address -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Address(AR)"]<span style="color:red">*</span></label>
                                        <input asp-for="AddressArabic" class="form-control" />
                                        <span asp-validation-for="AddressArabic" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Address(EN)"] <span style="color:red">*</span></label>
                                        <input asp-for="Address" class="form-control" />
                                        <span asp-validation-for="Address" class="text-danger"></span>
                                    </div>
                                </div>

                            </div>

                            <div class="row">
                                <!-- Email -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Email"] <span style="color:red">*</span></label>
                                        <input asp-for="Email" type="text" id="Email" class="form-control" oninput="validateEmailLive()" />
                                        <span id="emailError" class="text-danger"></span>
                                    </div>
                                </div>


                                <!-- Phone -->
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Phone"] <span style="color:red">*</span></label>

                                        @{
                                            string phone = Model.Phone ?? "";
                                            string prefix = "+965";
                                            string number = "";

                                            if (phone.StartsWith(prefix))
                                            {
                                                number = phone.Substring(prefix.Length);
                                            }
                                            else
                                            {
                                                number = phone;
                                            }
                                        }

                                        <div class="row">
                                            <!-- Prefix input -->
                                            <div class="col-xs-2" style="padding-right: 1px;">
                                                <input type="text" id="PhonePrefix" class="form-control" maxlength="5" value="@prefix" readonly />
                                            </div>

                                            <!-- Phone number input -->
                                            <div class="col-xs-10" style="padding-left: 1px;">
                                                <input type="text"
                                                       id="PhoneNumber"
                                                       class="form-control"
                                                       maxlength="8"
                                                       placeholder="Enter 8-digit number"
                                                       pattern="\d{8}"
                                                       title="Phone number must be exactly 8 digits"
                                                       value="@number" />
                                            </div>
                                        </div>

                                        <!-- Hidden field to bind with model.Phone -->
                                        <input asp-for="Phone" type="hidden" id="Phone" />
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div>


                            </div>
                            <!-- Logo Upload with Preview -->
                            <!-- Logo Upload with Preview -->
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Company Logo"]<span style="color:red">*</span></label>

                                        <!-- Always show input -->
                                        <input type="file" id="logoInput" name="LogoFile" class="form-control" accept="image/*" />

                                        <!-- Always show preview box (filled or empty) -->
                                        <div class="mt-2">
                                            <img id="logoPreview"
                                                 src="@(Model.Logo != null ? $"data:image/png;base64,{Convert.ToBase64String(Model.Logo)}" : "#")"
                                                 alt="Company Logo"
                                                 style="@(Model.Logo != null ? "" : "display:none;") max-width:150px; max-height:150px; border:1px solid #ccc; padding:5px; border-radius:5px;" />
                                        </div>
                                    </div>
                                </div>
                                <!-- VAT -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["VAT (%)"] <span style="color:red">*</span></label>
                                        <input asp-for="Vat" class="form-control" onkeypress="return numericvat(event, this)" maxlength="10" />
                                        <span asp-validation-for="Vat" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Delivery Charge"] <span style="color:red">*</span></label>
                                        <input asp-for="DeliveryCharge" class="form-control"
                                               value="@Model.DeliveryCharge.ToString("F3", CultureInfo.InvariantCulture)"
                                               onkeypress="return numericvat(event, this)" maxlength="10" />
                                        <span asp-validation-for="DeliveryCharge" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Quantity Limit"] <span style="color:red">*</span></label>
                                        <input asp-for="QuantityLimit" class="form-control"
                                               value="@Model.QuantityLimit.ToString("F3", CultureInfo.InvariantCulture)"
                                               onkeypress="return numericvat(event, this)" maxlength="10" />
                                        <span asp-validation-for="QuantityLimit" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Facebook -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Facebook URL"]<span style="color:red">*</span></label>
                                        <input asp-for="FacebookUrl" class="form-control" />
                                        <span asp-validation-for="FacebookUrl" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Twitter -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Twitter URL"]<span style="color:red">*</span></label>
                                        <input asp-for="TwitterUrl" class="form-control" />
                                        <span asp-validation-for="TwitterUrl" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Instagram -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Instagram URL"] <span style="color:red">*</span></label>
                                        <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/yourpage" />
                                        <span asp-validation-for="InstagramUrl" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Linkdin URL"] <span style="color:red">*</span></label>
                                        <input asp-for="LinkedInUrl" class="form-control" placeholder="https://instagram.com/yourpage" />
                                        <span asp-validation-for="LinkedInUrl" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <!-- Submit -->
                            <button type="submit" class="btn btn-primary btn-flat m-t-30">@_localizer["Update"]</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("logoInput").addEventListener("change", function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById("logoPreview");

            if (file) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = "block";
                };

                reader.readAsDataURL(file);
            } else {
                preview.src = "#";
                preview.style.display = "none";
            }
        });
    </script>

    <script>
        function validateEmailLive() {
            var email = document.getElementById("Email").value.trim();
            var errorSpan = document.getElementById("emailError");

            // Basic email format regex
            var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (email === "") {
                errorSpan.textContent = ""; // Don't show error if empty
                return;
            }

            if (!emailRegex.test(email)) {
                errorSpan.textContent = "Please enter a valid email address.";
            } else {
                errorSpan.textContent = ""; // Clear error if valid
            }
        }
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.querySelector("form");

            form.addEventListener("submit", function (e) {
                const prefix = document.getElementById("PhonePrefix").value.trim();
                const number = document.getElementById("PhoneNumber").value.trim();
                const fullPhone = prefix + number;

                // Check if number is exactly 8 digits
                if (!/^\d{8}$/.test(number)) {
                    e.preventDefault();
                    alert("Phone number must be exactly 8 digits.");
                    return false;
                }

                document.getElementById("Phone").value = fullPhone;
            });

            // Optional: prevent non-numeric input
            document.getElementById("PhoneNumber").addEventListener("keypress", function (e) {
                if (!/\d/.test(e.key)) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
