@using System.Globalization
@model EcommerceWebApplication.Models.CompanyDetails
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Companydetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en, string arabic) => ar ? arabic : en;
    var phone = Model.Phone ?? "";
    if (!phone.StartsWith("+965")) phone = "+965" + phone;
}
<section class="admin-panel company-settings">
    <form asp-action="Create" id="NavigationKey" method="post" enctype="multipart/form-data">
        <fieldset disabled="@(!User.IsInRole("Admin"))">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <section class="company-section">
            <h2>@T("Company identity", "هوية الشركة")</h2>
            <div class="company-fields company-fields-2">
                <div class="form-group">
                    <label asp-for="CompanyNameArabic">@_localizer["Company Name(AR)"] <span class="text-danger">*</span></label>
                    <input asp-for="CompanyNameArabic" class="form-control" dir="rtl" lang="ar" maxlength="200" required />
                    <span asp-validation-for="CompanyNameArabic" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CompanyName">@_localizer["Company Name(EN)"] <span class="text-danger">*</span></label>
                    <input asp-for="CompanyName" class="form-control" dir="ltr" lang="en" maxlength="200" required />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="AddressArabic">@_localizer["Address(AR)"] <span class="text-danger">*</span></label>
                    <input asp-for="AddressArabic" class="form-control" dir="rtl" lang="ar" maxlength="300" required />
                    <span asp-validation-for="AddressArabic" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address">@_localizer["Address(EN)"] <span class="text-danger">*</span></label>
                    <input asp-for="Address" class="form-control" dir="ltr" lang="en" maxlength="300" required />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email">@_localizer["Email"] <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" dir="ltr" maxlength="100" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone">@_localizer["Phone"] <span class="text-danger">*</span></label>
                    <input asp-for="Phone" value="@phone" type="tel" class="form-control" dir="ltr" maxlength="12" pattern="[+]965[0-9]{8}" required title="@T("Enter +965 followed by eight digits.", "أدخل +965 ثم ثمانية أرقام.")" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
            </div>
        </section>
        <section class="company-section">
            <h2>@T("Branding and order settings", "العلامة التجارية وإعدادات الطلب")</h2>
            <div class="company-fields company-fields-4">
                <div class="form-group">
                    <label for="logoInput">@_localizer["Company Logo"]</label>
                    <div class="company-logo-field">
                        <img id="logoPreview" src="@(Model.Logo != null ? Url.Action("CompanyLogo", "StoreImage", new { id = Model.CompanyId }) : null)" alt="@T("Company logo", "شعار الشركة")" hidden="@(Model.Logo == null)" />
                        <input type="file" id="logoInput" name="LogoFile" class="form-control" accept="image/*" />
                    </div>
                    <span class="admin-muted">@T("Leave empty to retain the current logo.", "اتركه فارغاً للاحتفاظ بالشعار الحالي.")</span>
                    @Html.ValidationMessage("LogoFile", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label asp-for="Vat">@_localizer["VAT (%)"] <span class="text-danger">*</span></label>
                    <input asp-for="Vat" class="form-control" inputmode="decimal" dir="ltr" required />
                    <span asp-validation-for="Vat" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DeliveryCharge">@_localizer["Delivery Charge"] <span class="text-danger">*</span></label>
                    <input asp-for="DeliveryCharge" asp-format="{0:F3}" class="form-control" inputmode="decimal" dir="ltr" required />
                    <span asp-validation-for="DeliveryCharge" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="QuantityLimit">@_localizer["Quantity Limit"] <span class="text-danger">*</span></label>
                    <input asp-for="QuantityLimit" type="number" step="1" class="form-control" dir="ltr" required />
                    <span asp-validation-for="QuantityLimit" class="text-danger"></span>
                </div>
            </div>
        </section>
        <section class="company-section">
            <h2>@T("Social links", "روابط التواصل الاجتماعي")</h2>
            <div class="company-fields company-fields-4">
                <div class="form-group"><label asp-for="FacebookUrl">@_localizer["Facebook URL"] <span class="text-danger">*</span></label><input asp-for="FacebookUrl" class="form-control" dir="ltr" maxlength="100" /><span asp-validation-for="FacebookUrl" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="TwitterUrl">@_localizer["Twitter URL"] <span class="text-danger">*</span></label><input asp-for="TwitterUrl" class="form-control" dir="ltr" maxlength="100" /><span asp-validation-for="TwitterUrl" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="InstagramUrl">@_localizer["Instagram URL"] <span class="text-danger">*</span></label><input asp-for="InstagramUrl" class="form-control" dir="ltr" maxlength="100" /><span asp-validation-for="InstagramUrl" class="text-danger"></span></div>
                <div class="form-group"><label asp-for="LinkedInUrl">LinkedIn URL <span class="text-danger">*</span></label><input asp-for="LinkedInUrl" class="form-control" dir="ltr" maxlength="100" /><span asp-validation-for="LinkedInUrl" class="text-danger"></span></div>
            </div>
        </section>
        </fieldset>
        @if(User.IsInRole("Admin")){<div class="company-save"><button type="submit" class="btn btn-primary" disabled="@(Model.CompanyId == 0)">@T("Save changes", "حفظ التغييرات")</button></div>
        @if (Model.CompanyId == 0)
        {
            <p role="status" class="text-danger">@T("Company profile not found.", "ملف الشركة غير موجود.")</p>
        }
        }
    </form>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById("logoInput");
            const preview = document.getElementById("logoPreview");
            const saved = preview.getAttribute("src");
            let temporary;
            input.addEventListener("change", () => {
                if (temporary) URL.revokeObjectURL(temporary);
                temporary = input.files[0] ? URL.createObjectURL(input.files[0]) : null;
                const source = temporary || saved;
                if (source) preview.src = source;
                else preview.removeAttribute("src");
                preview.hidden = !source;
            });
        })();
    </script>
}
