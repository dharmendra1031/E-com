@model IEnumerable<EcommerceWebApplication.Models.User>

<table class="table table-responsive table-hover">
    <thead class="bg-secondary text-white">
        <tr>
            <th>User ID</th>
            <th>Full Name</th>
            <th>Full Name (Arabic)</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Role ID</th>
            <th>Status</th>
            <th>Actions</th> <!-- New column for buttons -->
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.FullName</td>
                    <td>@user.FullNameArb</td>
                    <td>@user.Email</td>
                    <td>@user.Phone</td>
                    <td>@user.RoleId</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-primary me-1">
                            <i class="ti- ti-edit"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this user?');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
