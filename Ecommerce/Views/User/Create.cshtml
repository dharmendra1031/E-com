@model EcommerceWebApplication.Models.User
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">
                    <h4>@_localizer["Add User"]</h4>
                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                <a asp-controller="User" asp-action="UserList" class="btn btn-sm btn-info"><i class="ti-user bg-info"></i>@_localizer["UserList"]</a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="card-body pt-2">
                    <div class="basic-form">

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">@ViewBag.Error</div>
                        }
                        <form asp-controller="User" id="NavigationKey" asp-action="Create" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="row">

                                <!-- Full Name (Arabic) -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Full Name (AR)"] <span style="color:red">*</span></label>
                                        <input asp-for="FullNameArb" class="form-control focusOnEnter" placeholder="أدخل الاسم الكامل" />
                                        <span asp-validation-for="FullNameArb" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Full Name (English) -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Full Name"] <span style="color:red">*</span></label>
                                        <input asp-for="FullName" class="form-control focusOnEnter" placeholder="Enter full name" />
                                        <span asp-validation-for="FullName" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Phone -->
                             @*    <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Phone"] <span style="color:red">*</span></label>
                                        <input asp-for="Phone" class="form-control focusOnEnter" placeholder="Enter phone number" onkeypress="return numeric(event)" maxlength="10" />
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div> *@
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Phone"] <span style="color:red">*</span></label>

                                        @{
                                            string phone = Model?.Phone ?? "";
                                            string prefix = "+965";
                                            string number = "";

                                            if (!string.IsNullOrEmpty(phone) && phone.StartsWith("965"))
                                            {
                                                number = phone.Substring(3);
                                            }
                                            else
                                            {
                                                number = phone;
                                            }
                                        }

                                        <div class="row">
                                            <!-- Prefix -->
                                            <div class="col-xs-3" style="padding-right: 1px;">
                                                <input type="text" id="PhonePrefix" class="form-control" value="@prefix" readonly />
                                            </div>

                                            <!-- Number -->
                                            <div class="col-xs-9" style="padding-left: 1px;">
                                                <input type="text"
                                                       id="PhoneNumber"
                                                       class="form-control focusOnEnter"
                                                       maxlength="8"
                                                       placeholder="Enter 8-digit number"
                                                       value="@number" />
                                            </div>
                                        </div>

                                        <!-- Hidden -->
                                        <input asp-for="Phone" type="hidden" id="Phone" />
                                        <span asp-validation-for="Phone" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Email -->
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Email"] <span style="color:red">*</span></label>
                                        <input asp-for="Email" class="form-control focusOnEnter" placeholder="Enter email address" />
                                        <span asp-validation-for="Email" class="text-danger"></span>
                                    </div>
                                </div>
                                <!-- Password -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Password"] <span style="color:red">*</span></label>
                                        <input asp-for="PasswordHash" type="password" class="form-control focusOnEnter" placeholder="Enter password" />
                                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Role -->
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["User Role"] <span style="color:red">*</span></label>
                                        <select asp-for="RoleId" class="form-control focusOnEnter" asp-items="ViewBag.RoleList">
                                            <option value="">-- Select Role --</option>
                                        </select>
                                        <span asp-validation-for="RoleId" class="text-danger"></span>
                                    </div>
                                </div>
                                <!-- Status -->
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Status"] <span style="color:red">*</span></label>
                                        <select asp-for="IsActive" class="form-control focusOnEnter">
                                            <option value="true">@_localizer["Active"]</option>
                                            <option value="false">@_localizer["Inactive"]</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-3 focusOnEnter">@_localizer["Save"]</button>

                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.js"></script>

    <script>
        $(document).ready(function () {
            $("#FullNameArb").focus();
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>
        document.querySelector("form").addEventListener("submit", function (e) {

            var prefix = document.getElementById("PhonePrefix").value.replace("+", "");
            var number = document.getElementById("PhoneNumber").value.trim();

            // ✅ Validation
            if (!/^\d{8}$/.test(number)) {
                e.preventDefault();
                AdminFeedback.show("warning", document.documentElement.dir === "rtl" ? "يجب أن يتكون رقم الهاتف من 8 أرقام." : "Phone number must be exactly 8 digits.");
                return false;
            }

            // ✅ Combine
            document.getElementById("Phone").value = prefix + number;
        });

        // Only numbers allow
        document.getElementById("PhoneNumber").addEventListener("keypress", function (e) {
            if (!/\d/.test(e.key)) {
                e.preventDefault();
            }
        });
    </script>
}


