@model List<EcommerceWebApplication.Models.ViewModels.CategoryListViewModel>
<style>
    .category-list { display: grid; gap: 6px; margin: 0; padding: 0; }
    .category-list li { min-width: 0; }
    .category-link { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 8px; border: 1px solid transparent; border-radius: 8px; }
    .category-link:hover, .category-link.active { background: #eaf3f9; border-color: #bcd8e9; }
    .category-img { width: 40px; height: 36px; flex-shrink: 0; object-fit: contain; }
    .category-name { font-size: .875rem; font-weight: 600; line-height: 1.3; color: #111; overflow-wrap: anywhere; text-align: start; }
    @@media (max-width: 991.98px) {
        .category-list { display: flex; overflow-x: auto; padding-block-end: 4px; }
        .category-list li { flex: 0 0 112px; }
        .category-link { flex-direction: column; justify-content: center; height: 100%; text-align: center; }
        .category-name { text-align: center; font-size: .8rem; }
    }
</style>

<ul class="list-unstyled category-list">
    @foreach (var item in Model)
    {
        <li>
            <a href="#"
               class="category-link text-decoration-none"
               data-categoryid="@item.CategoryId">

                <img src="@item.CategoryImageBase64"
                     class="rounded category-img" alt="" />

                <div class="category-name"
                     title="@item.CName">
                    @item.CName
                </div>
            </a>
        </li>
    }
</ul>
