@model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>
@{
    Layout = "~/Views/Shared/_WebLayout.cshtml";
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = ar ? "نتائج البحث" : "Search results";
}
<div class="container-fluid store-wide store-search-page" data-store-search>
    <nav class="store-breadcrumb" aria-label="@(ar ? "مسار التنقل" : "Breadcrumb")">
        <a href="~/WebHome/Index">@(ar ? "الرئيسية" : "Home")</a><span aria-hidden="true">/</span><span aria-current="page">@ViewData["Title"]</span>
    </nav>
    <h1 class="catalog-title mt-3">@ViewData["Title"]</h1>
    <p id="searchPageMessage" class="small" role="status"></p>
    <div data-search-results><partial name="_SearchResults" model="Model" /></div>
</div>
<script src="~/js/store-search.js" asp-append-version="true" defer></script>
