@model List<EcommerceWebApplication.Models.ViewModels.SubCategoryListViewModel>
@{ var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; }
<div class="catalog-heading">
    <h1 id="breadcrumbTitle" class="catalog-title"></h1>
    <select class="form-select sort-select" id="sortProducts" aria-label="@(ar ? "الترتيب حسب" : "Sort by")">
        <option value="newest">@(ar ? "الأحدث" : "Sort: Newest")</option>
        <option value="low-high">@(ar ? "السعر من الأقل إلى الأعلى" : "Price: Low to high")</option>
        <option value="high-low">@(ar ? "السعر من الأعلى إلى الأقل" : "Price: High to low")</option>
    </select>
</div>
@if (Model.Any())
{
    <div class="catalog-subcategories">
        <a href="#" class="subcategory-link active" data-subid="" data-subname="" aria-current="true">@(ar ? "الكل" : "All")</a>
        @foreach (var item in Model)
        {
            <a href="#" class="subcategory-link" data-subid="@item.SubCategoryId" data-subname="@item.SCName">
                <img src="@item.SubCategoryImageBase64" alt="" loading="lazy" decoding="async" />
                <span>@item.SCName</span>
            </a>
        }
    </div>
}
