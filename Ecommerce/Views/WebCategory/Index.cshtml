@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = _localizer["SHOP"].Value;
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<style>
    .catalog-layout { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 20px; padding-block: 20px; align-items: start; }
    .catalog-sidebar { min-width: 0; padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; }
    .catalog-sidebar .category-title { font-size: 1rem; font-weight: 700; color: #111; text-align: start; }
    .catalog-main { min-width: 0; }
    #SubCategoryContainer { margin-block-end: 16px; }
    @@media (max-width: 991.98px) {
        .catalog-layout { grid-template-columns: minmax(0, 1fr); gap: 12px; padding-block: 12px; }
        .catalog-sidebar { padding: 10px; }
    }
</style>


<div class="container-fluid store-wide">
    <div class="catalog-layout">
        <!-- LEFT SIDEBAR -->
        <aside class="catalog-sidebar">
            <h6 class="mb-3 category-title">@_localizer["Top Categories"]</h6>

            <div id="categoryContainer"></div>
        </aside>
        <!-- RIGHT CONTENT -->
        <main class="catalog-main">
            <!-- HEADER -->
          
            <!-- SUB CATEGORIES -->
            <div id="SubCategoryContainer"></div>

            <!-- PRODUCTS GRID -->
            <div id="ProductContainer" aria-live="polite">
                <!-- Products grid yahan -->
            </div>
            <div class="text-center my-3">
                <button type="button" id="loadMoreProducts" class="btn btn-outline-primary px-4 py-2 d-none">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "عرض المزيد" : "Load more products")</button>
                <p id="catalogStatus" class="small text-danger mt-2" role="status"></p>
            </div>

        </main>

    </div>
</div>
<script>
    (() => {
        const categories = document.getElementById("categoryContainer");
        const subcategories = document.getElementById("SubCategoryContainer");
        const products = document.getElementById("ProductContainer");
        const arabic = document.documentElement.lang === "ar";
        const selectedCategory = "@ViewBag.SelectedCategoryId";
        const selectedSubcategory = "@ViewBag.SelectedSubCategoryId";
        let categoryId = "", subcategoryId = "";
        let categoryRequest, productRequest;
        let nextPage = 0;
        const more = document.getElementById("loadMoreProducts");
        const catalogStatus = document.getElementById("catalogStatus");

        async function getPartial(url, signal) {
            const response = await fetch(url, { signal });
            if (!response.ok) throw new Error("Unable to load catalog");
            return response.text();
        }

        function status(container, message) {
            container.textContent = message;
        }

        function setActive(container, link) {
            container.querySelectorAll("a.active").forEach(item => {
                item.classList.remove("active");
                item.removeAttribute("aria-current");
            });
            link.classList.add("active");
            link.setAttribute("aria-current", "true");
        }

        function updateUrl(mode = "push") {
            if (mode === "none") return;
            const url = new URL(location.href);
            url.searchParams.set("categoryId", categoryId);
            if (subcategoryId) url.searchParams.set("subCategoryId", subcategoryId);
            else url.searchParams.delete("subCategoryId");
            if (url.href === location.href) return;
            if (mode === "replace") history.replaceState(null, "", url);
            else history.pushState(null, "", url);
        }

        function findCategory(id) {
            return Array.from(categories.querySelectorAll(".category-link"))
                .find(item => item.dataset.categoryid === id);
        }

        function updateHeading() {
            const title = document.getElementById("breadcrumbTitle");
            if (!title) return;
            const parent = categories.querySelector(".active")?.textContent.trim() || "";
            const child = subcategories.querySelector(".active")?.dataset.subname || "";
            title.textContent = child ? parent + " / " + child : parent;
        }

        async function loadProducts(append = false) {
            if (append && (!nextPage || more.disabled)) return;
            productRequest?.abort();
            const request = new AbortController();
            productRequest = request;
            const page = append ? nextPage : 1;
            if (!append) {
                nextPage = 0;
                more.classList.add("d-none");
                status(products, arabic ? "جارٍ تحميل المنتجات…" : "Loading products…");
            }
            more.disabled = true;
            catalogStatus.textContent = "";
            const params = new URLSearchParams({ categoryId, page, sortBy: document.getElementById("sortProducts")?.value || "newest" });
            if (subcategoryId) params.set("subCategoryId", subcategoryId);
            products.setAttribute("aria-busy", "true");
            try {
                const html = await getPartial("/WebCategory/ProductPartial?" + params, request.signal);
                if (request.signal.aborted) return;
                const template = document.createElement("template");
                template.innerHTML = html;
                const incoming = template.content.querySelector(".cart-grid-container");
                if (!incoming) throw new Error("Invalid catalog response");
                if (append) {
                    const grid = products.querySelector(".store-product-grid");
                    if (!grid) throw new Error("Missing catalog grid");
                    grid.append(...incoming.querySelectorAll(".cart-item-col"));
                } else products.replaceChildren(template.content);
                nextPage = Number(incoming.dataset.nextPage) || 0;
                more.classList.toggle("d-none", !nextPage);
            } catch (error) {
                if (error.name !== "AbortError") {
                    if (append) catalogStatus.textContent = arabic ? "تعذر تحميل المزيد. حاول مرة أخرى." : "Unable to load more. Try again.";
                    else status(products, arabic ? "تعذر تحميل المنتجات." : "Unable to load products.");
                }
            } finally {
                if (productRequest === request) {
                    products.removeAttribute("aria-busy");
                    more.disabled = false;
                }
            }
        }
        more.addEventListener("click", () => loadProducts(true));

        async function selectCategory(link, initialSubcategory = "", historyMode = "push") {
            categoryRequest?.abort();
            productRequest?.abort();
            const request = new AbortController();
            categoryRequest = request;
            categoryId = link.dataset.categoryid;
            subcategoryId = "";
            setActive(categories, link);
            status(subcategories, arabic ? "جارٍ التحميل…" : "Loading…");
            products.textContent = "";
            products.removeAttribute("aria-busy");
            nextPage = 0;
            more.classList.add("d-none");
            catalogStatus.textContent = "";
            try {
                const html = await getPartial("/WebCategory/SubCategoryCardPartial?categoryId=" + encodeURIComponent(categoryId), request.signal);
                if (request.signal.aborted) return;
                subcategories.innerHTML = html;
                const sub = Array.from(subcategories.querySelectorAll(".subcategory-link")).find(item => item.dataset.subid === initialSubcategory);
                if (sub) {
                    subcategoryId = sub.dataset.subid;
                    setActive(subcategories, sub);
                }
                updateHeading();
                updateUrl(historyMode);
                await loadProducts();
            } catch (error) {
                if (error.name !== "AbortError") status(subcategories, arabic ? "تعذر التحميل." : "Unable to load categories.");
            }
        }

        categories.addEventListener("click", event => {
            const link = event.target.closest(".category-link");
            if (!link) return;
            event.preventDefault();
            selectCategory(link);
        });

        subcategories.addEventListener("click", event => {
            const link = event.target.closest(".subcategory-link");
            if (!link) return;
            event.preventDefault();
            subcategoryId = link.dataset.subid;
            setActive(subcategories, link);
            updateHeading();
            updateUrl();
            loadProducts();
        });

        subcategories.addEventListener("change", event => {
            if (event.target.id === "sortProducts" && categoryId) loadProducts();
        });

        // Header links retain normal navigation outside the catalog or when opened in a new tab.
        document.getElementById("siteHeader")?.addEventListener("click", event => {
            if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const anchor = event.target.closest("#topCategoryList a[href], #categoryDropdown a[href]");
            if (!anchor || (anchor.target && anchor.target !== "_self")) return;
            const url = new URL(anchor.href, location.href);
            if (url.origin !== location.origin || url.pathname.toLowerCase().replace(/\/$/, "") !== "/webcategory/index") return;
            const parentId = url.searchParams.get("categoryId") || anchor.closest("li.category-item")?.dataset.id;
            const childId = url.searchParams.get("subCategoryId") || "";
            const link = findCategory(parentId);
            if (!link) return;

            event.preventDefault();
            const toggle = document.querySelector("#categoryDropdown")?.parentElement.querySelector('[data-bs-toggle="dropdown"]');
            if (anchor.closest("#categoryDropdown") && toggle) {
                bootstrap.Dropdown.getInstance(toggle)?.hide();
            }
            selectCategory(link, childId);
        });

        window.addEventListener("popstate", () => {
            const params = new URLSearchParams(location.search);
            const link = findCategory(params.get("categoryId"));
            if (link) selectCategory(link, params.get("subCategoryId") || "", "none");
        });

        getPartial("/WebCategory/CategoryPartial").then(html => {
            categories.innerHTML = html;
            const links = Array.from(categories.querySelectorAll(".category-link"));
            const link = findCategory(selectedCategory) || links[0];
            if (link) selectCategory(link, selectedSubcategory, "replace");
            else status(products, arabic ? "لا توجد فئات" : "No categories found");
        }).catch(() => status(categories, arabic ? "تعذر التحميل." : "Unable to load categories."));
    })();
</script>

@if (TempData["CartMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'warning',
            text: '@TempData["CartMessage"]',
            confirmButtonText: 'OK',
            width: 500
        });
    </script>
}
