@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = _localizer["SHOP"].Value;
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<div class="container-fluid store-wide store-catalog">
    <nav class="store-breadcrumb" aria-label="@_localizer["SHOP"]"><a href="~/WebHome/Index">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "الرئيسية" : "Home")</a><span aria-hidden="true">/</span><span>@_localizer["SHOP"]</span></nav>
    <div id="SubCategoryContainer"></div>
    <div class="catalog-layout">
        <aside class="catalog-sidebar offcanvas-lg offcanvas-start" id="catalogFilterDrawer" tabindex="-1" aria-labelledby="filterDrawerTitle">
            <div class="offcanvas-header d-lg-none">
                <h2 class="offcanvas-title h5" id="filterDrawerTitle">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تصفية المنتجات" : "Filters")</h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#catalogFilterDrawer" aria-label="@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "إغلاق" : "Close")"></button>
            </div>
            <div class="offcanvas-body">
            <form id="catalogFilters" class="store-filter-panel" novalidate>
                <div class="store-filter-heading"><strong>@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تصفية المنتجات" : "Filter products")</strong></div>
                <div class="store-filter-fields">
                    <label>@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "العلامة التجارية" : "Brand")
                        <select id="filterBrand" class="form-select"><option value="">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "الكل" : "All brands")</option></select>
                    </label>
                    <label>@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "أدنى سعر (د.ك)" : "Min price (KD)")
                        <input id="minPrice" type="number" min="0" step="0.001" inputmode="decimal" class="form-control" />
                    </label>
                    <label>@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "أعلى سعر (د.ك)" : "Max price (KD)")
                        <input id="maxPrice" type="number" min="0" step="0.001" inputmode="decimal" class="form-control" />
                    </label>
                    <label>@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "التقييم" : "Rating")
                        <select id="minRating" class="form-select">
                            <option value="">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "الكل" : "Any rating")</option>
                            <option value="4">4+ ★</option><option value="3">3+ ★</option><option value="2">2+ ★</option>
                        </select>
                    </label>
                </div>
                <div class="store-filter-actions">
                    <label class="d-flex align-items-center gap-2"><input type="checkbox" id="inStock" class="form-check-input m-0" /> @(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "متوفر فقط" : "In stock only")</label>
                    <button type="submit" class="btn btn-primary">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تطبيق" : "Apply filters")</button>
                    <button type="button" id="resetFilters" class="btn btn-outline-secondary">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "إعادة تعيين" : "Reset")</button>
                </div>
                <p id="filterError" class="small text-danger mb-0" role="status"></p>
            </form>
                <details class="store-category-disclosure">
                    <summary>@_localizer["Top Categories"]</summary>
                    <div id="categoryContainer"></div>
                </details>
            </div>
        </aside>
        <main class="catalog-main">
            <div class="catalog-toolbar">
                <span id="resultCount" role="status"></span>
                <button type="button" class="btn btn-outline-primary d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#catalogFilterDrawer" aria-controls="catalogFilterDrawer"><i class="bi bi-sliders" aria-hidden="true"></i> @(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "تصفية" : "Filters")</button>
            </div>
            <div id="ProductContainer" aria-live="polite"></div>
            <div class="text-center my-3">
                <button type="button" id="loadMoreProducts" class="btn btn-outline-primary px-4 py-2 d-none">@(System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "عرض المزيد" : "Load more products")</button>
                <p id="catalogStatus" class="small text-danger mt-2" role="status"></p>
            </div>
        </main>
    </div>
</div>
<script>
    (() => {
        const categories = document.getElementById("categoryContainer");
        const subcategories = document.getElementById("SubCategoryContainer");
        const products = document.getElementById("ProductContainer");
        const arabic = document.documentElement.lang === "ar";
        const selectedCategory = "@ViewBag.SelectedCategoryId";
        const selectedSubcategory = "@ViewBag.SelectedSubCategoryId";
        let categoryId = "", subcategoryId = "";
        let categoryRequest, productRequest;
        let nextPage = 0;
        const more = document.getElementById("loadMoreProducts");
        const catalogStatus = document.getElementById("catalogStatus");
        const filterForm = document.getElementById("catalogFilters");
        const filterError = document.getElementById("filterError");
        function closeFilters() { bootstrap.Offcanvas.getInstance(document.getElementById("catalogFilterDrawer"))?.hide(); }
        const brand = document.getElementById("filterBrand");
        const minPrice = document.getElementById("minPrice");
        const maxPrice = document.getElementById("maxPrice");
        const rating = document.getElementById("minRating");
        const stock = document.getElementById("inStock");
        const resultCount = document.getElementById("resultCount");
        let filters = {};
        let brandRequest;
        function resetFilterValues() {
            filterForm.reset();
            filterError.textContent = "";
            filters = {};
            resultCount.textContent = "";
        }
        async function loadBrands() {
            brandRequest?.abort();
            const request = new AbortController();
            brandRequest = request;
            brand.replaceChildren(new Option(arabic ? "الكل" : "All brands", ""));
            brand.disabled = true;
            try {
                const params = new URLSearchParams({ categoryId });
                if (subcategoryId) params.set("subCategoryId", subcategoryId);
                const response = await fetch("/WebCategory/FilterBrands?" + params, { signal: request.signal });
                if (!response.ok) throw new Error();
                const data = await response.json();
                if (request.signal.aborted) return;
                for (const item of data) if (item.id && item.name) brand.add(new Option(item.name, item.id));
            } catch(error) {
                if (error.name !== "AbortError") catalogStatus.textContent = arabic ? "تعذر تحميل العلامات التجارية." : "Unable to load brands.";
            } finally { if (brandRequest === request) brand.disabled = false; }
        }
        filterForm.addEventListener("submit", event => {
            event.preventDefault();
            if (!categoryId || !subcategories.querySelector("#sortProducts")) return;
            if (!minPrice.checkValidity() || !maxPrice.checkValidity() ||
                (minPrice.value !== "" && maxPrice.value !== "" && Number(minPrice.value) > Number(maxPrice.value))) {
                filterError.textContent = arabic ? "تحقق من نطاق السعر." : "Enter a valid price range.";
                return;
            }
            filters = {};
            if (brand.value) filters.brandId = brand.value;
            if (minPrice.value !== "") filters.minPrice = minPrice.value;
            if (maxPrice.value !== "") filters.maxPrice = maxPrice.value;
            if (rating.value) filters.minRating = rating.value;
            if (stock.checked) filters.inStock = "true";
            filterError.textContent = "";
            closeFilters();
            loadProducts();
        });
        document.getElementById("resetFilters").addEventListener("click", () => {
            resetFilterValues();
            if (categoryId && subcategories.querySelector("#sortProducts")) loadProducts();
        });

        async function getPartial(url, signal) {
            const response = await fetch(url, { signal });
            if (!response.ok) throw new Error("Unable to load catalog");
            return response.text();
        }

        function status(container, message) {
            container.textContent = message;
        }

        function setActive(container, link) {
            container.querySelectorAll("a.active").forEach(item => {
                item.classList.remove("active");
                item.removeAttribute("aria-current");
            });
            link.classList.add("active");
            link.setAttribute("aria-current", "true");
        }

        function updateUrl(mode = "push") {
            if (mode === "none") return;
            const url = new URL(location.href);
            url.searchParams.set("categoryId", categoryId);
            if (subcategoryId) url.searchParams.set("subCategoryId", subcategoryId);
            else url.searchParams.delete("subCategoryId");
            if (url.href === location.href) return;
            if (mode === "replace") history.replaceState(null, "", url);
            else history.pushState(null, "", url);
        }

        function findCategory(id) {
            return Array.from(categories.querySelectorAll(".category-link"))
                .find(item => item.dataset.categoryid === id);
        }

        function updateHeading() {
            const title = document.getElementById("breadcrumbTitle");
            if (!title) return;
            const parent = categories.querySelector(".active")?.textContent.trim() || "";
            const child = subcategories.querySelector(".active")?.dataset.subname || "";
            title.textContent = child ? parent + " / " + child : parent;
            document.dispatchEvent(new CustomEvent("store:category", { detail: categoryId }));
        }

        async function loadProducts(append = false) {
            if (append && (!nextPage || more.disabled)) return;
            productRequest?.abort();
            const request = new AbortController();
            productRequest = request;
            const page = append ? nextPage : 1;
            if (!append) {
                nextPage = 0;
                more.classList.add("d-none");
                resultCount.textContent = "";
                status(products, arabic ? "جارٍ تحميل المنتجات…" : "Loading products…");
            }
            more.disabled = true;
            catalogStatus.textContent = "";
            const params = new URLSearchParams({ categoryId, page, sortBy: document.getElementById("sortProducts")?.value || "newest", ...filters });
            if (subcategoryId) params.set("subCategoryId", subcategoryId);
            products.setAttribute("aria-busy", "true");
            try {
                const html = await getPartial("/WebCategory/ProductPartial?" + params, request.signal);
                if (request.signal.aborted) return;
                const template = document.createElement("template");
                template.innerHTML = html;
                const incoming = template.content.querySelector(".cart-grid-container");
                if (!incoming) throw new Error("Invalid catalog response");
                if (append) {
                    const grid = products.querySelector(".store-product-grid");
                    if (!grid) throw new Error("Missing catalog grid");
                    grid.append(...incoming.querySelectorAll(".cart-item-col"));
                } else products.replaceChildren(template.content);
                nextPage = Number(incoming.dataset.nextPage) || 0;
                const total = Number(incoming.dataset.totalProducts) || 0;
                const shown = products.querySelectorAll(".cart-item-col").length;
                resultCount.textContent = arabic ? shown + " من " + total : shown + " of " + total + " products";
                more.classList.toggle("d-none", !nextPage);
            } catch (error) {
                if (error.name !== "AbortError") {
                    if (append) catalogStatus.textContent = arabic ? "تعذر تحميل المزيد. حاول مرة أخرى." : "Unable to load more. Try again.";
                    else status(products, arabic ? "تعذر تحميل المنتجات." : "Unable to load products.");
                }
            } finally {
                if (productRequest === request) {
                    products.removeAttribute("aria-busy");
                    more.disabled = false;
                }
            }
        }
        more.addEventListener("click", () => loadProducts(true));

        async function selectCategory(link, initialSubcategory = "", historyMode = "push") {
            categoryRequest?.abort();
            productRequest?.abort();
            const request = new AbortController();
            categoryRequest = request;
            categoryId = link.dataset.categoryid;
            subcategoryId = "";
            brandRequest?.abort();
            resetFilterValues();
            setActive(categories, link);
            status(subcategories, arabic ? "جارٍ التحميل…" : "Loading…");
            products.textContent = "";
            products.removeAttribute("aria-busy");
            nextPage = 0;
            more.classList.add("d-none");
            catalogStatus.textContent = "";
            try {
                const html = await getPartial("/WebCategory/SubCategoryCardPartial?categoryId=" + encodeURIComponent(categoryId), request.signal);
                if (request.signal.aborted) return;
                subcategories.innerHTML = html;
                const sub = Array.from(subcategories.querySelectorAll(".subcategory-link")).find(item => item.dataset.subid === initialSubcategory);
                if (sub) {
                    subcategoryId = sub.dataset.subid;
                    setActive(subcategories, sub);
                }
                updateHeading();
                updateUrl(historyMode);
                loadBrands();
                await loadProducts();
            } catch (error) {
                if (error.name !== "AbortError") status(subcategories, arabic ? "تعذر التحميل." : "Unable to load categories.");
            }
        }

        categories.addEventListener("click", event => {
            const link = event.target.closest(".category-link");
            if (!link) return;
            event.preventDefault();
            closeFilters();
            selectCategory(link);
        });

        subcategories.addEventListener("click", event => {
            const link = event.target.closest(".subcategory-link");
            if (!link) return;
            event.preventDefault();
            subcategoryId = link.dataset.subid;
            resetFilterValues();
            setActive(subcategories, link);
            loadBrands();
            updateHeading();
            updateUrl();
            loadProducts();
        });

        subcategories.addEventListener("change", event => {
            if (event.target.id === "sortProducts" && categoryId) loadProducts();
        });

        // Header links retain normal navigation outside the catalog or when opened in a new tab.
        document.getElementById("siteHeader")?.addEventListener("click", event => {
            if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
            const anchor = event.target.closest("#topCategoryList a[href], #categoryDropdown a[href]");
            if (!anchor || (anchor.target && anchor.target !== "_self")) return;
            const url = new URL(anchor.href, location.href);
            if (url.origin !== location.origin || url.pathname.toLowerCase().replace(/\/$/, "") !== "/webcategory/index") return;
            const parentId = url.searchParams.get("categoryId") || anchor.closest("li.category-item")?.dataset.id;
            const childId = url.searchParams.get("subCategoryId") || "";
            const link = findCategory(parentId);
            if (!link) return;

            event.preventDefault();
            const toggle = document.querySelector("#categoryDropdown")?.parentElement.querySelector('[data-bs-toggle="dropdown"]');
            if (anchor.closest("#categoryDropdown") && toggle) {
                bootstrap.Dropdown.getInstance(toggle)?.hide();
            }
            selectCategory(link, childId);
        });

        window.addEventListener("popstate", () => {
            const params = new URLSearchParams(location.search);
            const link = findCategory(params.get("categoryId"));
            if (link) selectCategory(link, params.get("subCategoryId") || "", "none");
        });

        getPartial("/WebCategory/CategoryPartial").then(html => {
            categories.innerHTML = html;
            const links = Array.from(categories.querySelectorAll(".category-link"));
            const link = findCategory(selectedCategory) || links[0];
            if (link) selectCategory(link, selectedSubcategory, "replace");
            else status(products, arabic ? "لا توجد فئات" : "No categories found");
        }).catch(() => status(categories, arabic ? "تعذر التحميل." : "Unable to load categories."));
    })();
</script>

@if (TempData["CartMessage"] != null)
{
    <script>
        Swal.fire({
            icon: 'warning',
            text: '@TempData["CartMessage"]',
            confirmButtonText: 'OK',
            width: 500
        });
    </script>
}
