@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>
@{ var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; bool preview = ViewBag.SellerPreview == true; }
<div class="cart-grid-container" data-next-page="@ViewBag.NextPage" data-total-products="@ViewBag.TotalProducts">
    <div class="store-product-grid">
        @foreach (var item in Model)
        {
            var rating = item.AverageRating ?? item.Rating;
            <article class="cart-item-col">
                <div class="cart-item-card" data-productid="@item.ProductId">
                    <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = item.ProductId })" class="product-link-area">
                        <div class="cart-image-container">
                            @if (item.ProductImageId.HasValue || !string.IsNullOrEmpty(item.ProductImageBase64))
                            {
                                <img src="@(item.ProductImageId.HasValue ? Url.Action("Product", "StoreImage", new { id = item.ProductImageId }) : item.ProductImageBase64)" alt="@item.Name" loading="lazy" decoding="async" />
                            }
                            else { <div class="image-placeholder"><i class="bi bi-image" aria-hidden="true"></i><span class="small">@(ar ? "الصورة غير متوفرة" : "Image unavailable")</span></div> }
                        </div>
                        <div class="cart-product-info">
                            @if (!string.IsNullOrWhiteSpace(item.BrandName))
                            {
                                <span class="store-card-brand">@item.BrandName</span>
                            }
                            <h2 class="product-name" title="@item.Name">@item.Name</h2>
                            <div class="rating-container">
                                @if (rating > 0)
                                {
                                    <span class="rating-stars" aria-hidden="true">★</span><span dir="ltr">@rating.ToString("F1", CultureInfo.InvariantCulture) / 5</span>
                                    @if (item.ReviewCount.HasValue) { <span class="rating-count">(@item.ReviewCount)</span> }
                                }
                                else { <span class="rating-count">@(ar ? "لا توجد تقييمات" : "No reviews yet")</span> }
                            </div>
                            @if (preview)
                            {
                                <div class="stock-status @(item.AvailableSellerCount > 0 ? "in-stock" : "out-of-stock")">@(item.AvailableSellerCount > 0 ? (ar ? "عروض متاحة" : "Seller offers available") : (ar ? "لا توجد عروض متاحة" : "No available seller offers"))</div>
                            }
                            else
                            {
                                <div class="stock-status @(item.Stock > 0 ? "in-stock" : "out-of-stock")">@(item.Stock > 0 ? (ar ? "متوفر" : "In stock") : (ar ? "غير متوفر" : "Out of stock"))</div>
                            }
                        </div>
                    </a>
                    <div class="cart-item-footer">
                        @if (preview)
                        {
                            <div>
                                @if (item.LowestSellerPrice.HasValue)
                                {
                                    <div class="small">@(ar ? "من سعر البائع" : "Seller preview from")</div>
                                    <div class="product-price" dir="ltr">KD @item.LowestSellerPrice.Value.ToString("F3", CultureInfo.InvariantCulture)</div>
                                    <small>@item.AvailableSellerCount @(ar ? "بائع" : "seller(s)")</small>
                                }
                                else { <small>@(ar ? "لا يوجد سعر بائع متاح" : "No seller price available")</small> }
                            </div>
                            <a class="btn btn-outline-primary" asp-controller="WebSingleProduct" asp-action="SingleProduct" asp-route-id="@item.ProductId" asp-fragment="sellerOffers">@(ar ? "عرض المنتج" : "View product")</a>
                        }
                        else
                        {
                            <div class="product-price" dir="ltr"><span class="currency">KD</span> @item.Price.ToString("F3", CultureInfo.InvariantCulture)</div>
                            <button type="button" class="add-to-cart-btn" data-productid="@item.ProductId" disabled="@(item.Stock <= 0)">
                                <i class="bi bi-cart-plus" aria-hidden="true"></i><span>@(item.Stock > 0 ? (ar ? "أضف للسلة" : "Add to cart") : (ar ? "غير متوفر" : "Unavailable"))</span>
                            </button>
                        }
                    </div>
                </div>
            </article>
        }
        @if (!Model.Any())
        {
            <div class="noproduct text-center py-5"><i class="bi bi-box-seam fs-2 text-secondary" aria-hidden="true"></i><h2 class="h5 mt-3">@(ar ? "لا توجد منتجات" : "No products found")</h2><p class="text-secondary">@(ar ? "جرب تغيير الفلاتر أو اختيار فئة أخرى." : "Try changing your filters or selecting another category.")</p></div>
        }
    </div>
</div>
