@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>
@{ var isArabic = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; }

<div class="cart-grid-container">
    <div class="store-product-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="cart-item-col">
                    <div class="cart-item-card" data-productid="@item.ProductId">
                        <!-- Clickable area for product details -->
                        <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = item.ProductId })"
                           class="product-link-area">
                            <!-- Image at the top -->
                            <div class="cart-image-container">
                                @if (!string.IsNullOrEmpty(item.ProductImageBase64))
                                {
                                    <img src="@item.ProductImageBase64" alt="@item.Name" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="text-secondary small">@(isArabic ? "لا توجد صورة" : "No image")</span>
                                }
                    </div>

                    <!-- Product info -->
                    <div class="cart-product-info">
                        <!-- Product Name -->
                        <h5 class="product-name">
                            @item.Name
                        </h5>

                                <!-- Stock Status -->
                                <div class="stock-status @(item.Stock > 0 ? "in-stock" : "out-of-stock")">
                                    @(item.Stock > 0 ? (isArabic ? "متوفر" : "In stock") : (isArabic ? "غير متوفر" : "Out of stock"))
                                </div>

                                <!-- Rating Stars -->
                                <div class="rating-container">
                                    <div class="rating-stars">
                                @{
                                            // Calculate rating (you can replace with actual rating from your model)
                                            var rating = item.Rating; // Default rating
                                            var fullStars = (int)rating;
                                            var hasHalfStar = rating - fullStars >= 0.5;

                                            for (int i = 0; i < 5; i++)
                                            {
                                                if (i < fullStars)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i == fullStars && hasHalfStar)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                    <span class="rating-count">(@rating.ToString("F1")/5.0)</span>
                                </div>
                            </div>
                        </a>

                        <!-- Footer with price and add button -->
                        <div class="cart-item-footer">
                            <!-- Price on the left -->
                            <div class="product-price" dir="ltr">
                                <span class="currency">KD</span> @item.Price.ToString("F3", CultureInfo.InvariantCulture)
                            </div>

                            <!-- Plus button on the right -->
                            <button type="button" class="add-to-cart-btn @(item.Stock > 0 ? "" : "disabled")"
                                    data-productid="@item.ProductId"
                                    @(item.Stock <= 0 ? "disabled" : "")>
                                <i class="fas fa-plus" aria-hidden="true"></i>
                                <span>@(item.Stock > 0 ? (isArabic ? "أضف للسلة" : "Add to cart") : (isArabic ? "غير متوفر" : "Unavailable"))</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="noproduct col-12 text-center text-muted py-5">
                <div class="display-1 mb-3">
                    <i class="fas fa-box-open"></i>
                </div>
                <span>@(isArabic ? "لا توجد منتجات" : "No products found")</span>
            </div>
        }
    </div>
</div>


