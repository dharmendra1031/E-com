@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>
@{ var isArabic = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft; }

<!-- CSS Styles for the cart grid -->
<style>
    #cart-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 0; }
    #cart-grid > .cart-item-col { width: auto; max-width: none; min-width: 0; padding: 0; margin: 0; display: flex; }
    #cart-grid .cart-item-card { display: flex; flex-direction: column; width: 100%; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #fff; transition: box-shadow .15s; }
    #cart-grid .cart-item-card:hover { box-shadow: 0 4px 14px rgba(0,0,0,.08); }
    #cart-grid .product-link-area { display: flex; flex: 1; flex-direction: column; color: #111; text-decoration: none; min-width: 0; }
    #cart-grid .cart-image-container { aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; padding: 16px; background: #f7f8fa; }
    #cart-grid .cart-image-container img { width: 100%; height: 100%; object-fit: contain; }
    #cart-grid .cart-product-info { display: flex; flex-direction: column; flex: 1; padding: 12px; gap: 8px; }
    #cart-grid .product-name { font-size: .95rem; line-height: 1.4; font-weight: 600; color: #111; overflow-wrap: anywhere; margin: 0; }
    #cart-grid .stock-status { margin-block-start: auto; font-size: .8rem; font-weight: 600; }
    #cart-grid .in-stock { color: #176b36; }
    #cart-grid .out-of-stock { color: #a51e27; }
    #cart-grid .rating-container { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; font-size: .8rem; }
    #cart-grid .rating-stars { color: #a86a00; white-space: nowrap; direction: ltr; }
    #cart-grid .rating-count { color: #475569; }
    #cart-grid .cart-item-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 12px; border-top: 1px solid #e2e8f0; }
    #cart-grid .product-price { color: #111; font-size: 1rem; font-weight: 750; white-space: nowrap; }
    #cart-grid .add-to-cart-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 44px; padding: 8px 12px; border: 0; border-radius: 8px; color: #fff; background: #075a96; font-size: .85rem; font-weight: 600; }
    #cart-grid .add-to-cart-btn:hover:not(:disabled) { background: #064574; }
    #cart-grid .add-to-cart-btn:disabled { color: #334155; background: #e2e8f0; cursor: not-allowed; }
    #cart-grid .noproduct { grid-column: 1 / -1; width: 100%; }
    @@media (max-width: 1199.98px) { #cart-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 767.98px) {
        #cart-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
        #cart-grid .cart-image-container { padding: 10px; }
        #cart-grid .cart-product-info, #cart-grid .cart-item-footer { padding: 10px; }
        #cart-grid .product-name { font-size: .875rem; }
        #cart-grid .add-to-cart-btn { width: 100%; }
    }
</style>

<div class="cart-grid-container">
    <div id="cart-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="cart-item-col">
                    <div class="cart-item-card" data-productid="@item.ProductId">
                        <!-- Clickable area for product details -->
                        <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = item.ProductId })"
                           class="product-link-area">
                            <!-- Image at the top -->
                            <div class="cart-image-container">
                                @if (!string.IsNullOrEmpty(item.ProductImageBase64))
                                {
                                    <img src="@item.ProductImageBase64" alt="@item.Name" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="text-secondary small">@(isArabic ? "لا توجد صورة" : "No image")</span>
                                }
                    </div>

                    <!-- Product info -->
                    <div class="cart-product-info">
                        <!-- Product Name -->
                        <h5 class="product-name">
                            @item.Name
                        </h5>

                                <!-- Stock Status -->
                                <div class="stock-status @(item.Stock > 0 ? "in-stock" : "out-of-stock")">
                                    @(item.Stock > 0 ? (isArabic ? "متوفر" : "In stock") : (isArabic ? "غير متوفر" : "Out of stock"))
                                </div>

                                <!-- Rating Stars -->
                                <div class="rating-container">
                                    <div class="rating-stars">
                                @{
                                            // Calculate rating (you can replace with actual rating from your model)
                                            var rating = item.Rating; // Default rating
                                            var fullStars = (int)rating;
                                            var hasHalfStar = rating - fullStars >= 0.5;

                                            for (int i = 0; i < 5; i++)
                                            {
                                                if (i < fullStars)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i == fullStars && hasHalfStar)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                    <span class="rating-count">(@rating.ToString("F1")/5.0)</span>
                                </div>
                            </div>
                        </a>

                        <!-- Footer with price and add button -->
                        <div class="cart-item-footer">
                            <!-- Price on the left -->
                            <div class="product-price" dir="ltr">
                                <span class="currency">KD</span> @item.Price.ToString("F3", CultureInfo.InvariantCulture)
                            </div>

                            <!-- Plus button on the right -->
                            <button type="button" class="add-to-cart-btn @(item.Stock > 0 ? "" : "disabled")"
                                    data-productid="@item.ProductId"
                                    @(item.Stock <= 0 ? "disabled" : "")>
                                <i class="fas fa-plus" aria-hidden="true"></i>
                                <span>@(item.Stock > 0 ? (isArabic ? "أضف للسلة" : "Add to cart") : (isArabic ? "غير متوفر" : "Unavailable"))</span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="noproduct col-12 text-center text-muted py-5">
                <div class="display-1 mb-3">
                    <i class="fas fa-box-open"></i>
                </div>
                <span>@(isArabic ? "لا توجد منتجات" : "No products found")</span>
            </div>
        }
    </div>
</div>


