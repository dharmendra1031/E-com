@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.ProductListViewModel>

<!-- CSS Styles for the cart grid -->
<style>
    /* Custom CSS for cart grid */
    .cart-grid-container {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .noproduct{
        font-size:1rem;
    }
    .cart-item-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .cart-item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

    /* Clickable area for the product link */
    .product-link-area {
        text-decoration: none;
        color: inherit;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    /* Image container - fixed height */
    .cart-image-container {
        height: 180px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background-color: #f8f9fa;
    }

    .cart-item-card img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.5s ease;
    }

    .cart-item-card:hover img {
        transform: scale(1.05);
    }

    /* Product info section */
    .cart-product-info {
        padding: 10px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .product-name {
        font-size: 1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 7px;
        line-height: 1.3;
        min-height: 3em; /* Ensures consistent height for 2 lines */
    }

    .stock-status {
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .in-stock {
        color: #28a745;
    }

    .out-of-stock {
        color: #dc3545;
    }

    /* Rating stars */
    .rating-container {
        margin-bottom: 12px;
        display: flex;
        align-items: center;
    }

    .rating-stars {
        color: #FFC107;
        margin-right: 8px;
    }

        .rating-stars i {
            margin-right: 1px;
        }

    .rating-count {
        color: #95a5a6;
        font-size: 0.85rem;
    }

    /* Footer with price and add button */
    .cart-item-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding: 12px 15px;
        border-top: 1px solid #eee;
        background-color: #f9f9f9;
    }

    .product-price {
        font-size: 1rem;
        font-weight: 800;
        color: #2c3e50;
    }

        .product-price .currency {
            font-size: 1rem;
            font-weight: 600;
        }

    .add-to-cart-btn {
        background-color: #3498db;
        color: white;
        border: none;
        width: 45px;
        height: 45px;
        border-radius: 50%;
        font-size: 1.5rem;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: all 0.3s ease;
    }

        .add-to-cart-btn:hover {
            background-color: #2980b9;
            transform: scale(1.1);
        }

        .add-to-cart-btn:active {
            transform: scale(0.95);
        }

        .add-to-cart-btn:disabled {
            background-color: #95a5a6;
            cursor: not-allowed;
            transform: none;
        }

    /* Responsive adjustments */
    @@media (max-width: 1400px) {
        .cart-image-container {
            height: 180px;
        }
    }

    @@media (max-width: 1200px) {
        .cart-image-container {
            height: 160px;
        }
    }

    @@media (max-width: 768px) {
        .cart-image-container {
            height: 140px;
        }

        .noproduct{
            font-size:0.8rem;
        }
        .product-name {
            font-size: 0.7rem;
        }

        .product-price {
            font-size: 0.8rem;
            font-weight: 550;
        }

        .stock-status {
            font-size: 0.7rem;
            font-weight: 500;
            margin-bottom: 10px;
        }
        /* Product info section */
        .cart-product-info {
            padding: 2px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        /* Rating stars */
        .rating-container {
            margin-bottom: 8px;
            display: flex;
            align-items:start;
        }

        .rating-stars {
            color: #FFC107;
            font-size:14px;
            margin-right: 1px;
        }

            .rating-stars i {
                margin-right: 0px;
            }

        .rating-count {
            color: #95a5a6;
            font-size: 0.81rem;
        }
        /* Footer with price and add button */
        .cart-item-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding: 6px 10px;
            border-top: 1px solid #eee;
            background-color: #f9f9f9;
        }

        

            .product-price .currency {
                font-size: 0.8rem;
                font-weight: 500;
            }

        .add-to-cart-btn {
            background-color: #3498db;
            color: white;
            border: none;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            font-size: 1rem;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.3s ease;
        }
    }

    @@media (max-width:450px) {
        .cart-image-container {
            height: 130px;
        }

        .noproduct {
            font-size: 0.6rem;
        }
        .product-name {
            font-size: 0.5rem;
        }

        .product-price {
            font-size: 0.7rem;
            font-weight: 500;
        }

        .stock-status {
            font-size: 0.5rem;
            font-weight: 400;
            margin-bottom: 6px;
        }
        /* Product info section */
        .cart-product-info {
            padding: 2px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        /* Rating stars */
        .rating-container {
            margin-bottom: 5px;
            display: flex;
            align-items: start;
        }

        .rating-stars {
            color: #FFC107;
            font-size: 7px;
            margin-right: 0.5px;
        }

            .rating-stars i {
                margin-right: 0px;
            }

        .rating-count {
            color: #95a5a6;
            font-size: 0.61rem;
        }
        /* Footer with price and add button */
        .cart-item-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding: 4px 7px;
            border-top: 1px solid #eee;
            background-color: #f9f9f9;
        }

            .product-price .currency {
                font-size: 0.7rem;
                font-weight: 500;
            }

        .add-to-cart-btn {
            background-color: #3498db;
            color: white;
            border: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            font-size: 0.8rem;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: all 0.3s ease;
        }
    }


    /* Grid layout - 2 items per row */
    @@media (min-width: 992px) {
        .cart-item-col {
            display: flex;
        }
        /* JavaScript will handle equal heights */
    }
</style>

<div class="cart-grid-container">
    <div class="row g-2" id="cart-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 col-6 cart-item-col">
                    <div class="cart-item-card" data-productid="@item.ProductId">
                        <!-- Clickable area for product details -->
                        <a href="@Url.Action("SingleProduct", "WebSingleProduct", new { id = item.ProductId })"
                           class="product-link-area">
                            <!-- Image at the top -->
                            <div class="cart-image-container">
                                @if (!string.IsNullOrEmpty(item.ProductImageBase64))
                                {
                                    <img src="@item.ProductImageBase64" alt="@item.Name" />
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/300x200?text=No+Image" alt="No Image" />
                                }
                    </div>

                    <!-- Product info -->
                    <div class="cart-product-info">
                        <!-- Product Name -->
                        <h5 class="product-name">
                            @(item.Name != null && item.Name.Length > 75
                                                        ? item.Name.Substring(0, 75) + "..."
                                                        : item.Name)
                        </h5>

                                <!-- Stock Status -->
                                <div class="stock-status @(item.Stock > 0 ? "in-stock" : "out-of-stock")">
                                    @(item.Stock > 0 ? "In Stock" : "Out of Stock")
                                </div>

                                <!-- Rating Stars -->
                                <div class="rating-container">
                                    <div class="rating-stars">
                                @{
                                            // Calculate rating (you can replace with actual rating from your model)
                                            var rating = item.Rating; // Default rating
                                            var fullStars = (int)rating;
                                            var hasHalfStar = rating - fullStars >= 0.0;

                                            for (int i = 0; i < 5; i++)
                                            {
                                                if (i < fullStars)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else if (i == fullStars && hasHalfStar)
                                                {
                                                    <i class="fas fa-star-half-alt"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        }
                                    </div>
                                    <span class="rating-count">(@rating.ToString("F1")/5.0)</span>
                                </div>
                            </div>
                        </a>

                        <!-- Footer with price and add button -->
                        <div class="cart-item-footer">
                            <!-- Price on the left -->
                            <div class="product-price">
                                <span class="currency">KD</span> @item.Price.ToString("F3", CultureInfo.InvariantCulture)
                            </div>

                            <!-- Plus button on the right -->
                            <button class="add-to-cart-btn @(item.Stock > 0 ? "" : "disabled")"
                                    data-productid="@item.ProductId"
                                    @(item.Stock <= 0 ? "disabled" : "")>
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="noproduct col-12 text-center text-muted py-5">
                <div class="display-1 mb-3">
                    <i class="fas fa-box-open"></i>
                </div>
                <span>No products found</span>
            </div>
        }
    </div>
</div>

<!-- JavaScript for equal heights and cart functionality -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Function to set equal heights for cart items in the same row
        function setEqualCartHeights() {
            // Only apply on larger screens where we have 2 items per row
            if (window.innerWidth >= 768) {
                const cartRows = document.querySelectorAll('.cart-item-col');

                // Reset all heights first
                cartRows.forEach(col => {
                    const card = col.querySelector('.cart-item-card');
                    if (card) {
                        card.style.height = 'auto';
                    }
                });

                // Group items by rows (2 per row)
                for (let i = 0; i < cartRows.length; i += 2) {
                    const rowItems = [cartRows[i]];
                    if (i + 1 < cartRows.length) {
                        rowItems.push(cartRows[i + 1]);
                    }

                    // Find the max height in this row
                    let maxHeight = 0;
                    rowItems.forEach(col => {
                        const card = col.querySelector('.cart-item-card');
                        if (card) {
                            const cardHeight = card.offsetHeight;
                            if (cardHeight > maxHeight) {
                                maxHeight = cardHeight;
                            }
                        }
                    });

                    // Apply the max height to all items in this row
                    rowItems.forEach(col => {
                        const card = col.querySelector('.cart-item-card');
                        if (card) {
                            card.style.height = maxHeight + 'px';
                        }
                    });
                }
            } else {
                // On mobile, reset heights to auto
                const cards = document.querySelectorAll('.cart-item-card');
                cards.forEach(card => {
                    card.style.height = 'auto';
                });
            }
        }

        // Initialize equal heights
        setEqualCartHeights();

        // Recalculate on window resize
        window.addEventListener('resize', setEqualCartHeights);

        // Add to cart button functionality
        const addToCartButtons = document.querySelectorAll('.add-to-cart-btn:not(.disabled)');
        addToCartButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const productId = this.getAttribute('data-productid');
                const card = this.closest('.cart-item-card');
                const productName = card.querySelector('.product-name').textContent.trim();
                const productPrice = card.querySelector('.product-price').textContent.trim();

                // Change button appearance temporarily
                const originalHTML = this.innerHTML;
                this.innerHTML = '<i class="fas fa-check"></i>';
                this.style.backgroundColor = '#28a745';
                this.disabled = true;

                // Show notification
                showNotification(`Added ${productName} to cart (${productPrice})`, 'success');

                // Call your add to cart function here
                addToCart(productId);

                // Reset button after 2 seconds
                setTimeout(() => {
                    this.innerHTML = originalHTML;
                    this.style.backgroundColor = '';
                    this.disabled = false;
                }, 2000);
            });
        });

        // Prevent add to cart button click from triggering the product link
        document.querySelectorAll('.product-link-area').forEach(link => {
            link.addEventListener('click', function(e) {
                // If the click originated from an add-to-cart button, don't follow the link
                if (e.target.closest('.add-to-cart-btn')) {
                    e.preventDefault();
                }
            });
        });

        // Function to show notification
        function showNotification(message, type) {
            // Remove existing notifications
            const existingNotifications = document.querySelectorAll('.cart-notification');
            existingNotifications.forEach(notification => {
                notification.remove();
            });

            // Create notification element
            const notification = document.createElement('div');
            notification.className = `cart-notification alert alert-${type} alert-dismissible fade show`;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 1050;
                min-width: 300px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            `;

            notification.innerHTML = `
                <strong>${type === 'success' ? 'Success!' : 'Notice'}</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.body.appendChild(notification);

            // Auto remove after 3 seconds
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 3000);
        }

        // Your add to cart function (replace with your actual implementation)
        @* function addToCart(productId) {
            // This is where you would make an AJAX call to add the product to cart
            console.log(`Adding product ${productId} to cart`);

            // Example AJAX call:
            /*
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ productId: productId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update cart count in UI if needed
                    updateCartCount(data.cartCount);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showNotification('Failed to add item to cart', 'danger');
            });
            */
        }

        // Function to update cart count in UI
        function updateCartCount(count) {
            const cartCountElements = document.querySelectorAll('.cart-count');
            cartCountElements.forEach(element => {
                element.textContent = count;
