@using System.Globalization
@model List<EcommerceWebApplication.Models.WeekendDealProductVM>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    var summaries = ViewBag.SellerSummaries as Dictionary<int, EcommerceWebApplication.Models.ViewModels.MarketplaceOfferSummary>;
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = "Wekenddeal";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<div class="row justify-content-center mt-3 mb-1">
    <div class="container-fluid my-4 store-wide">
        <h1 class="h4 store-heading">@_localizer["Weekend Deals"]</h1>

        @if (Model != null && Model.Any())
        {
            <div class="store-product-grid">

                @foreach (var item in Model)
                {
                    <div class="cart-item-col">
                        <div class="cart-item-card">

                            <!-- ENTIRE CARD CLICKABLE -->
                            <a href="@Url.Action("SingleProduct", "WebSingleProduct",
                                                               new { id = item.ProductId })"
                                                                                            class="product-link-area">

                                <!-- IMAGE -->
                                <img src="@(item.ProductImagesBase64?.FirstOrDefault() ?? "/images/default-product.png")"
                                     class="store-deal-image" alt="@item.ProductName" loading="lazy" />

                                <div class="cart-product-info">
                                    <h6 class="product-name">
                                        @item.ProductName
                            </h6>

                                    <!-- DEAL INFO -->
                                    <small class="text-danger fw-semibold">
                                        @item.DiscPer% @(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "خصم" : "OFF")
                                    </small>

                                    <div class="mt-2">
                                        <del class="text-muted d-block">
                                            @item.ProductPrice.ToString("F3", CultureInfo.InvariantCulture) KD
                                        </del>
                                        <span class="fw-bold text-success d-block">
                                            @item.OfferPrice.ToString("F3", CultureInfo.InvariantCulture) KD
                                        </span>
                                        @if (summaries != null && summaries.TryGetValue(item.ProductId, out var offer))
                                        {
                                            <small class="text-secondary">@(ar ? "معاينة البائعين من" : "Seller preview from") <bdi>KD @offer.LowestPrice.ToString("F3", CultureInfo.InvariantCulture)</bdi> (@offer.SellerCount)</small>
                                        }
                                    </div>


                                </div>
                            </a>

                            <!-- ADD TO CART -->
                            <div class="cart-item-footer">
                                <button type="button" class="add-to-cart-btn w-100"
                                        data-productid="@item.ProductId" disabled="@(item.Stock <= 0)">
                                    @(item.Stock <= 0 ? (CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "غير متوفر" : "Unavailable") : (CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "أضف للسلة" : "Add to cart"))
                                </button>
                            </div>

                        </div>
                    </div>
                        }
            </div>
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <h6>@_localizer["No weekend deals found"]</h6>
            </div>
        }

    </div>
</div>
