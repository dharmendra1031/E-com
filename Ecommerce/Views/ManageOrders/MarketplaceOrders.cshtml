    ViewData["Title"]=ar?"طلبات البائعين":"Vendor orders";
}
<section class="admin-panel">
    <a asp-action="PendingOrder" class="btn btn-default">@(ar?"الطلبات السابقة":"Legacy orders")</a>
    <partial name="~/Views/VendorPortal/_OrdersRegister.cshtml" model="Model" />
</section>
