@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.OrderItemViewModel>
@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Orders","الطلبات");
}
<div class="admin-orders" id="orderWorkspace" data-register-url="@Url.Action("PendingOrder","ManageOrders")">
    <section class="admin-panel" id="orderRegister">
        <div class="admin-section-heading"><h2>@T("Orders","الطلبات")</h2></div>
        <form id="orderFilters" method="get" asp-action="PendingOrder" class="admin-register-filters">
            <div class="form-group"><label for="status">@T("Order status","حالة الطلب")</label>
                <select name="status" id="status" class="form-control"><option value="">@T("All","الكل")</option>
                    @foreach(var item in (List<SelectListItem>)ViewBag.StatusList){<option value="@item.Value" selected="@item.Selected">@item.Text</option>}
                </select>
            </div>
            <div class="form-group"><label for="paymentstatus">@T("Payment status","حالة الدفع")</label>
                <select name="paymentstatus" id="paymentstatus" class="form-control"><option value="">@T("All","الكل")</option>
                    @foreach(var item in (List<SelectListItem>)ViewBag.Selectedpaymentstatus){<option value="@item.Value" selected="@item.Selected">@item.Text</option>}
                </select>
            </div>
            <div class="form-group"><label for="paymenttype">@T("Payment method","طريقة الدفع")</label>
                <select name="paymenttype" id="paymenttype" class="form-control">
                    <option value="">@T("All","الكل")</option>
                    <option value="cod" selected="@(ViewBag.CurrentPaymentType=="cod")">@T("Cash on delivery","الدفع عند الاستلام")</option>
                    <option value="online" selected="@(ViewBag.CurrentPaymentType=="online")">@T("Online","إلكتروني")</option>
                </select>
            </div>
            <div class="form-group"><label for="startDate">@T("From date","من تاريخ")</label><input type="date" name="startDate" id="startDate" class="form-control" value="@ViewBag.CurrentStartDate" /></div>
            <div class="form-group"><label for="endDate">@T("To date","إلى تاريخ")</label><input type="date" name="endDate" id="endDate" class="form-control" value="@ViewBag.CurrentEndDate" /></div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-primary">@T("Apply filters","تطبيق الفلاتر")</button>
            <a asp-action="PendingOrder" id="clearOrderFilters" class="btn btn-default">@T("Clear","مسح")</a>
        </form>
        <p id="orderRegisterMessage" role="status" class="admin-muted"></p>
        <div id="orderResults"><partial name="_OrderRegister" model="Model" /></div>
    </section>
    <section id="orderDetail" class="admin-panel" hidden>
        <div class="admin-section-heading">
            <h2 tabindex="-1" id="orderDetailHeading">@T("Order details","تفاصيل الطلب") <bdi id="detailNumber"></bdi></h2>
            <div class="order-actions"><button type="button" id="printOrder" class="btn btn-primary" disabled>@T("Print invoice","طباعة الفاتورة")</button>
                <button type="button" id="backToOrders" class="btn btn-default">@T("Back to orders","العودة إلى الطلبات")</button></div>
        </div>
        <p id="orderDetailMessage" role="status"></p>
        <button id="retryOrder" type="button" class="btn btn-default" hidden>@T("Retry","إعادة المحاولة")</button>
        <div id="orderDetailContent" hidden>
            <div class="order-detail-grid">
                <section><h3>@T("Customer","العميل")</h3><dl>
                    <dt>@T("Name","الاسم")</dt><dd data-detail="fullName"></dd>
                    <dt>@T("Phone","الهاتف")</dt><dd data-detail="phone"></dd>
                    <dt>@T("Email","البريد الإلكتروني")</dt><dd data-detail="email"></dd>
                    <dt>@T("Shareholder no.","رقم المساهم")</dt><dd data-detail="shareholderNo"></dd>
                </dl></section>
                <section><h3>@T("Order & payment","الطلب والدفع")</h3><dl>
                    <dt>@T("Order date","تاريخ الطلب")</dt><dd data-detail="createdAt"></dd>
                    <dt>@T("Order status","حالة الطلب")</dt><dd data-detail="status"></dd>
                    <dt>@T("Payment method","طريقة الدفع")</dt><dd data-detail="paymentType"></dd>
                    <dt>@T("Payment status","حالة الدفع")</dt><dd data-detail="paymentStatus"></dd>
                    <dt>@T("Coupon","القسيمة")</dt><dd data-detail="couponCode"></dd>
                </dl><div class="order-actions" id="orderStatusActions">
                    <button type="button" data-operation="order" class="btn btn-default">@T("Change order status","تغيير حالة الطلب")</button>
                    <button type="button" data-operation="payment" class="btn btn-default">@T("Change payment status","تغيير حالة الدفع")</button>
                </div></section>
                <section><h3>@T("Delivery address","عنوان التوصيل")</h3><dl>
                    <dt>@T("Area","المنطقة")</dt><dd data-detail="area"></dd>
                    <dt>@T("Block","القطعة")</dt><dd data-detail="block"></dd>
                    <dt>@T("Street","الشارع")</dt><dd data-detail="street"></dd>
                    <dt>@T("House","المنزل")</dt><dd data-detail="house"></dd>
                    <dt>@T("Floor","الطابق")</dt><dd data-detail="floor"></dd>
                    <dt>@T("Landmark","علامة مميزة")</dt><dd data-detail="landmark"></dd>
                </dl></section>
            </div>
            <form id="orderStatusForm" method="post" data-feedback="off" class="order-status-editor" hidden>
                <h3 id="orderStatusHeading"></h3>
                <p id="orderStatusMessage" role="status"></p>
                <div class="form-group"><label for="newOrderStatus">@T("New status","الحالة الجديدة")</label><select id="newOrderStatus" class="form-control" required></select></div>
                <div class="form-group" id="orderRemarkGroup"><label for="orderRemark">@T("Remark (optional)","ملاحظة (اختياري)")</label><textarea id="orderRemark" class="form-control" rows="2"></textarea></div>
                <div class="form-group"><label for="orderPassword">@T("Confirm with admin password","التأكيد بكلمة مرور المسؤول")</label><input type="password" id="orderPassword" autocomplete="current-password" class="form-control" required /></div>
                <div class="order-actions"><button type="submit" id="saveOrderStatus" class="btn btn-primary" disabled>@T("Save change","حفظ التغيير")</button><button type="button" id="cancelOrderStatus" class="btn btn-default">@T("Cancel","إلغاء")</button></div>
            </form>
            <h3>@T("Products","المنتجات")</h3>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>#</th><th>@T("Product","المنتج")</th><th>@T("Qty","الكمية")</th><th>@T("Price","السعر")</th><th>@T("Total","الإجمالي")</th></tr></thead><tbody id="orderItemsBody"></tbody></table></div>
            <dl class="order-totals">
                <dt>@T("Amount","المبلغ")</dt><dd data-money="price"></dd>
                <dt>@T("Discount","الخصم")</dt><dd data-money="discountAmount"></dd>
                <dt>@T("VAT","الضريبة") <span data-percent="vatpersent"></span></dt><dd data-money="vatAmount"></dd>
                <dt>@T("Delivery charge","رسوم التوصيل")</dt><dd data-money="deliveryCharge"></dd>
                <dt><strong>@T("Total amount","المبلغ الإجمالي")</strong></dt><dd><strong data-money="totalAmount"></strong></dd>
            </dl>
        </div>
    </section>
</div>
@section Scripts {
    <script src="~/js/order-workspace.js" asp-append-version="true"></script>
}
