@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.OrderItemViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    ViewData["Title"] = "Pending Order";

    // Convert model to JSON for jsGrid
    var orderJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    });

}

@Html.AntiForgeryToken()
<div id="main-content">
    <div class="row">
        <div class="col-lg-12">

            <div class="card alert" id="NavigationKey">
                <form id="filterForm" class="admin-register-filters">
                    <div class="form-group" style="margin-right: 15px;">
                        <label for="status" style="margin-right: 5px;">@_localizer["Order Status"]:</label>
                        <select name="status" id="status" class="form-control">
                            <option value="" onclick="resetFilter()"></option>
                            @foreach (var item in ViewBag.StatusList as List<SelectListItem>)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group" style="margin-right: 15px;">
                        <label for="paymentstatus" style="margin-right: 5px;">@_localizer["Payment"]:</label>
                        <select name="paymentstatus" id="paymentstatus" class="form-control">
                            <option value="" onclick="resetFilter()"></option>
                            @foreach (var item in ViewBag.Selectedpaymentstatus as List<SelectListItem>)
                            {
                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group" style="margin-right: 15px;">
                        <label for="paymenttype" style="margin-right: 5px;">@_localizer["Payment type"]:</label>
                        <select name="paymenttype" id="paymenttype" class="form-control">
                            <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentPaymentType) ? "selected" : "")"> </option>
                            <option value="cod" selected="@(ViewBag.CurrentPaymentType == "cod")">COD</option>
                            <option value="online" selected="@(ViewBag.CurrentPaymentType == "online")">Online</option>
                        </select>
                    </div>


                    <div class="form-group" style="margin-right: 15px;">
                        <label for="startDate" style="margin-right: 5px;">@_localizer["FromDate"]:</label>
                        <input type="text" id="startDate" name="startDate" class="form-control datepicker" placeholder="DD-MM-YYYY" value="@ViewBag.CurrentStartDate" onkeypress="return numeric(event)" />
                    </div>

                    <div class="form-group" style="margin-right: 15px;">
                        <label for="endDate" style="margin-right: 5px;">@_localizer["ToDate"]:</label>
                        <input type="text" name="endDate" id="endDate" class="form-control datepicker" placeholder="DD-MM-YYYY" value="@ViewBag.CurrentEndDate" onkeypress="return numeric(event)" />
                    </div>

                    <button type="button" class="btn btn-primary" onclick="submitFilter()">
                        @_localizer["Search"]
                    </button>
                </form>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">


                            <div class="card-body admin-register-body">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <div class="admin-table-scroll admin-order-stock-table"><table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center"> @_localizer["SN"]</th>
                                            <th class="text-center"> @_localizer["ID"]</th>
                                            <th class="text-center"> @_localizer["Customer Name"]</th>
                                            <th class="text-center"> @_localizer["Payment Type"]</th>
                                            <th class="text-center"> @_localizer["Payment Status"]</th>
                                            <th class="text-center"> @_localizer["Order Status"]</th>
                                            <th class="text-center"> @_localizer["Total Price"]</th>
                                            <th class="text-center"> @_localizer["Order Date"]</th>

                                            <th class="text-center"> @_localizer["Action"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td class="text-center">@serial</td>
                                                <td class="text-center">@item.OrderId</td>
                                                <td class="text-center">@item.FullName</td>
                                                <td class="text-center">
                                                    @{
                                                        // ✅ Default: Online = Blue, COD = Green
                                                        string btnClass1 = item.Paytype?.ToLower() == "cod"
                                                        ? "btn-success"
                                                        : "btn-info";
                                                    }

                                                    <div style="display:flex; justify-content:center; align-items:center;">
                                                        <span class="admin-status @btnClass1">
                                                            @item.Paytype
                                                        </span>
                                                    </div>
                                                </td>


                                                <td class="text-center">
                                                    @{
                                                        string btnClass = item.PaymentStatusId == 1 ? "btn-success" : "btn-danger";
                                                        bool isDisabled = item.PaymentStatusId == 3;
                                                    }
                                                    <div style="display:flex; justify-content:center; align-items:center; gap:10px;">
                                                        <span class="admin-status @btnClass">
                                                            @item.PaymentStatus
                                                        </span>
                                                        <button type="button" class="btn btn-outline-primary btn-xs edit-payment-status" aria-label="@_localizer["Payment Status"]"
                                                                data-id="@item.OrderId"
                                                                @(isDisabled ? "disabled" : "")>
                                                            <i class="fa fa-edit"></i>
                                                        </button>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    @{
                                                        string statusClass;
                                                        switch (item.OrderStatusId)
                                                        {
                                                            case 1: statusClass = "btn-warning"; break;
                                                            case 2: statusClass = "btn-info"; break;
                                                            case 3: statusClass = "btn-success"; break;
                                                            case 4: statusClass = "btn-danger"; break;
                                                            case 5: statusClass = "btn-primary"; break;
                                                            case 6: statusClass = "btn-default"; break;
                                                            default: statusClass = "btn-secondary"; break;
                                                        }
                                                    }
                                                    <div style="display:flex; justify-content:center; align-items:center; gap:10px;">
                                                        <span class="admin-status @statusClass">
                                                            @item.OrderStatus
                                                        </span>
                                                        <button type="button" class="btn btn-outline-primary btn-xs change-status-btn" aria-label="@_localizer["Order Status"]"
                                                                data-orderid="@item.OrderId"
                                                                @(item.PaymentStatusId == 3 ? "disabled" : "")>
                                                            <i class="fa fa-edit"></i>
                                                        </button>
                                                    </div>
                                                </td>

                                                <td class="text-center">@Convert.ToDecimal(item.TotalPrice).ToString("F3", CultureInfo.InvariantCulture)</td>
                                                <td class="text-center">
                                                    @{
                                                        string formattedDate = "";

                                                        if (item.Orderdate != null)
                                                        {
                                                            var date = Convert.ToDateTime(item.Orderdate);
                                                            formattedDate = date.ToString("dd-MM-yyyy");
                                                        }
                                                    }

                                                    @formattedDate
                                                </td>

                                                <td class="text-center">
                                                    <div style="display:flex; justify-content:center;">
                                                        <button class="btn btn-primary btn-info view-details-btn"
                                                                data-orderid="@item.OrderId">
                                                            @_localizer["View Details"]
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table></div>


                                <!-- ✅ Pagination (Same as UserList) -->
                                
                                   <div class="text-center">
                                    <ul class="pagination justify-content-center">

                                        <!-- First & Previous -->
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="PendingOrder" asp-route-page="1"
                                               asp-route-status="@ViewBag.CurrentStatus"
                                               asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                               asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                               asp-route-startDate="@ViewBag.CurrentStartDate"
                                               asp-route-endDate="@ViewBag.CurrentEndDate">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="PendingOrder" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-status="@ViewBag.CurrentStatus"
                                               asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                               asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                               asp-route-startDate="@ViewBag.CurrentStartDate"
                                               asp-route-endDate="@ViewBag.CurrentEndDate">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @{
                                            int maxPagesToShow = 10; // ek time me 5 pages hi dikhaye
                                            int startPage = Math.Max(1, Model.PageNumber - 2);
                                            int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);

                                            // Agar last pages ke karan startPage adjust karna ho
                                            if (endPage - startPage + 1 < maxPagesToShow)
                                            {
                                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                                            }

                                            // Agar 1 se pehle bhi pages hain
                                            if (startPage > 1)
                                            {
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="PendingOrder" asp-route-page="1"
                                                       asp-route-status="@ViewBag.CurrentStatus"
                                                       asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                                       asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                                       asp-route-startDate="@ViewBag.CurrentStartDate"
                                                       asp-route-endDate="@ViewBag.CurrentEndDate">1</a>
                                                </li>
                                                if (startPage > 2)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                            }

                                            // Main visible page loop
                                            for (int i = startPage; i <= endPage; i++)
                                            {
                                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                    <a class="page-link" asp-action="PendingOrder" asp-route-page="@i"
                                                       asp-route-status="@ViewBag.CurrentStatus"
                                                       asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                                       asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                                       asp-route-startDate="@ViewBag.CurrentStartDate"
                                                       asp-route-endDate="@ViewBag.CurrentEndDate">@i</a>
                                                </li>
                                            }

                                            // Agar last ke baad bhi pages hain
                                            if (endPage < Model.TotalPages)
                                            {
                                                if (endPage < Model.TotalPages - 1)
                                                {
                                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                                }
                                                <li class="page-item">
                                                    <a class="page-link" asp-action="PendingOrder" asp-route-page="@Model.TotalPages"
                                                       asp-route-status="@ViewBag.CurrentStatus"
                                                       asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                                       asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                                       asp-route-startDate="@ViewBag.CurrentStartDate"
                                                       asp-route-endDate="@ViewBag.CurrentEndDate">@Model.TotalPages</a>
                                                </li>
                                            }
                                        }

                                        <!-- Next & Last -->
                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="PendingOrder" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-status="@ViewBag.CurrentStatus"
                                               asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                               asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                               asp-route-startDate="@ViewBag.CurrentStartDate"
                                               asp-route-endDate="@ViewBag.CurrentEndDate">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="PendingOrder" asp-route-page="@Model.TotalPages"
                                               asp-route-status="@ViewBag.CurrentStatus"
                                               asp-route-paymentstatus="@ViewBag.CurrentPaymentStatus"
                                               asp-route-paymenttype="@ViewBag.CurrentPaymentType"
                                               asp-route-startDate="@ViewBag.CurrentStartDate"
                                               asp-route-endDate="@ViewBag.CurrentEndDate">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

  
</div>
<style>
    .custom-modal-width {
        max-width: 400px; /* or 350px, as needed */
    }
</style>
<!-- Detail model -->
