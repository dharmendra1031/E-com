    <script>
        function PrintReport() {

            const format = document.querySelector("input[name='Format']:checked")?.value || "PDF";

            const orderId = document.getElementById("OrderNumber").innerText || 0;

            // ✅ Construct URL for controller action
            let url = "/Report/OrderInvoicePrint?OrderId=" + encodeURIComponent(orderId);
            if (format) url += "&format=" + encodeURIComponent(format);

            // ✅ Open in new tab for PDF, direct download for others
            if (format.toUpperCase() === "PDF") {
                window.open(url, "_blank");
            } else {
                window.location.href = url;
            }
        }
    </script>


    <script>
        $(document).on('click', '.view-details-btn', function () {
            var orderId = $(this).data('orderid');

            $.ajax({
                url: '/ManageOrders/GetOrderDetails/' + orderId,
                type: 'GET',
                success: function (response) {
                    if (response.success && response.data) {
                        var data = response.data;
                        console.log(data);
                      $('#OrderNumber').text(data.orderId);
                      $('#shareholderNo').text(data.shareholderNo);
                      $('#modalFullName').text(data.fullName);
                      $('#modalCreatedAt').text( new Date(data.createdAt) .toLocaleDateString('en-GB', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric'
                        })
                        .replace(/\//g, '-')
                       );
                        $('#modalPaymentType').text(data.paymentType);
                        $('#modalStatus').text(data.status);
                        $('#payment').text(data.paymentStatus);
                        $('#CouponCode').text(data.couponCode && data.couponCode.trim() !== '' ? data.couponCode : 'N/A');
                        $('#DiscountAmount').text(parseFloat(data.discountAmount).toFixed(3)+ ' KD');
                        $('#modalProductPrice').text(parseFloat(data.price).toFixed(3)+ ' KD');
                        $('#modalVatpersent').text(parseFloat(data.vatpersent).toFixed(2)+ ' %');
                        $('#modalVatAmount').text(parseFloat(data.vatAmount).toFixed(3)+ ' KD');
                        $('#modalTotalAmount').text(parseFloat(data.totalAmount).toFixed(3)+ ' KD');
                      $('#deliveryCharge').text(
            data.deliveryCharge != null
                ? parseFloat(data.deliveryCharge).toFixed(3) + ' KD'
                : '__'
        );
                        // $('#DeliveryCharge').text(parseFloat('0').toFixed(3)+ ' KD');
                       $('#House').text(data.house ?? '--');

                        $('#Street').text(data.street ?? '--');
                        $('#Block').text(data.block ?? '--');
                        $('#Area').text(data.area ?? '--');
                        $('#Governorate').text(data.governorate ?? '--');
                        $('#Email').text(data.email ?? '--');
                        $('#Phone').text(data.phone ?? '--');
                        $('#Landmark').text(data.landmark ?? '--');
                        $('#Floor').text(data.floor ?? '--');

                        var itemsHtml = '';
                               let serialNo = 1; // serial number start from 1

        data.items.forEach(function (item) {
            itemsHtml += `
                <tr>
                    <td style="text-align:center">${serialNo}</td>
                    <td style="text-align:center">${item.productName}</td>
                    <td style="text-align:center">${item.quantity}</td>
                    <td style="text-align:center">${item.price.toFixed(3)}</td>
                    <td style="text-align:center">${(item.quantity * item.price).toFixed(3)}</td>
                </tr>`;
            serialNo++; // increase serial number for next row
        });

                        $('#orderItemsBody').html(itemsHtml);
                        $('#orderDetailsModal').modal('show');
                        } else {
                        alert(response.message || "No data found!");
                        }
                },
                error: function (xhr) {
                    console.error("AJAX Error:", xhr.responseText);
                    alert("Failed to load order details.");
                }
            });
        });
    </script>

    <script>
        function submitFilter() {
            const status = document.getElementById('status').value.trim();
            const startDate = document.getElementById('startDate').value.trim();
            const endDate = document.getElementById('endDate').value.trim();
            const paymentstatus = document.getElementById('paymentstatus').value.trim();
            const paymenttype = document.getElementById('paymenttype').value.trim();

            let url = "/ManageOrders/PendingOrder?";
            const params = [];

            if (status) params.push(`status=${encodeURIComponent(status)}`);
            if (paymentstatus) params.push(`paymentstatus=${encodeURIComponent(paymentstatus)}`);
            if (startDate) params.push(`startDate=${encodeURIComponent(startDate)}`);
            if (endDate) params.push(`endDate=${encodeURIComponent(endDate)}`);
            if (paymenttype) params.push(`paymenttype=${encodeURIComponent(paymenttype)}`);

            url += params.join("&");

            window.location.href = url;
        }

        function resetFilter() {
            window.location.href = "/ManageOrders/PendingOrder";
        }



    </script>

    <script>
        let selectedOrderId = null;

        $(document).on("click", ".change-status-btn", function (e) {
            e.preventDefault();

            selectedOrderId = $(this).data("orderid");

            $('#adminPassword').val('');
            $('#passwordError').hide();
            $('#passwordModal').modal('show');
        });

        // Handle admin password form submit
        $('#passwordForm').on('submit', function (e) {
            e.preventDefault();

            const password = $('#adminPassword').val();

            fetch('/ManageOrders/VerifyPassword', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({ password, orderId: Number(selectedOrderId), operation: "order" })
            })
            .then(res => res.json())
            .then(data => {
                if (data.valid) {
                    $('#adminPassword').val('');
                    $('#passwordModal').modal('hide');

                    fetch(`/ManageOrders/GetStatusList?orderId=${selectedOrderId}`)
                        .then(res => res.json())
                        .then(statusList => {
                            const $statusDropdown = $('#newStatus');
                            $statusDropdown.empty();

                            $statusDropdown.append(`<option value="">-- Select Status --</option>`);

                            statusList.forEach(item => {
                                $statusDropdown.append(new Option(item.text, item.value, false, item.selected));
                            });

                            $('#changeOrderId').val(selectedOrderId);
                            $('#remark').val('');
                            $('#statusModal').modal('show');
                        });
                } else {
                    $('#passwordError').show();
                }
            });
        });
    </script>

    <script>
        $('#statusForm').on('submit', async function (e) {
            e.preventDefault();
            const payload = {
                orderId: Number($('#changeOrderId').val()),
                currentStatus: Number($('#newStatus').val()),
                remark: $('#remark').val()
            };
            await AdminFeedback.post('/ManageOrders/UpdateOrderStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }, () => { $('#statusModal').modal('hide'); location.reload(); });
        });
    </script>

    <script>
        $(document).ready(function () {
            $('#filterForm').on('submit', function (e) {
                const startDate = new Date($('#startDate').val());
                const endDate = new Date($('#endDate').val());

                if ($('#startDate').val() && $('#endDate').val() && endDate < startDate) {
                    e.preventDefault();

                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Date Range',
                        text: 'End date must be greater than or equal to start date!',
                        confirmButtonColor: '#d33'
                    });

                    return false;
                }
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            let selectedPaymentOrderId = null;

            $(document).on("click", ".edit-payment-status", function () {
                selectedPaymentOrderId = $(this).data("id");

                $('#paymentAdminPassword').val('');
                $('#paymentPasswordError').addClass('d-none');

                $('#paymentPasswordModal').modal('show');
            });
              // Password varifying
            $('#paymentPasswordForm').on('submit', function (e) {
                e.preventDefault();

                const password = $('#paymentAdminPassword').val();

                fetch('/ManageOrders/VerifyPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                    body: JSON.stringify({ password, orderId: Number(selectedPaymentOrderId), operation: "payment" })
                })
                .then(res => res.json())
                .then(data => {
                    // Submit Payment Status binding
                    if (data.valid) {
                        $('#paymentAdminPassword').val('');
                        $('#paymentPasswordModal').modal('hide');

                        $("#paymentStatusDropdown").empty();

                        $.get("/ManageOrders/PaymentstatusList", { orderId: selectedPaymentOrderId }, function (data) {
                            $.each(data, function (i, item) {
                                var option = $("<option>").val(item.value).text(item.text);
                                if (item.selected) {
                                    option.attr("selected", "selected");
                                }
                                $("#paymentStatusDropdown").append(option);
                            });

                            $("#modalOrderId").val(selectedPaymentOrderId);
                            $("#paymentStatusModal").modal("show");
                        });

                    } else {
                        $('#paymentPasswordError').removeClass('d-none');
                    }
                });
            });



            // Submit Payment Status Update
            $("#paymentStatusForm").submit(async function (e) {
                e.preventDefault();
                await AdminFeedback.post("/ManageOrders/UpdatePaymentStatus", {
                    method: "POST",
                    body: new URLSearchParams({
                        orderId: $("#modalOrderId").val(),
                        PaymentStatus: $("#paymentStatusDropdown").val()
                    })
                }, () => { $("#paymentStatusModal").modal("hide"); location.reload(); });
            });
        });
    </script>
