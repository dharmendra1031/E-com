@model EcommerceWebApplication.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Admin Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login</title>

    <!-- Theme CSS -->
    <link href="/AdminTheame/assets/css/lib/font-awesome.min.css" rel="stylesheet" />
    <link href="/AdminTheame/assets/css/lib/themify-icons.css" rel="stylesheet" />
    <link href="/AdminTheame/assets/css/lib/bootstrap.min.css" rel="stylesheet" />
    <link href="/AdminTheame/assets/css/lib/unix.css" rel="stylesheet" />
    <link href="/AdminTheame/assets/css/style.css" rel="stylesheet" />

    <!-- ✅ No scroll, full center -->
    <style>
        html, body {
            height: 100%;
            margin: 0;
            overflow: hidden; /* ✅ Prevent scrolling */
        }

        .unix-login {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100%; /* ✅ Full height */
        }

        .login-content {
            max-width: 450px;
            width: 100%;
        }

        .login-form {
            padding: 20px !important;
        }

            .login-form .btn {
                width: 100% !important;
                margin-left: 0 !important;
            }
    </style>
    <link rel="stylesheet" href="~/css/admin-workspace.css" asp-append-version="true" />
    <partial name="_StoreTheme" />
</head>

<body class="bg-video-container admin-login">
    <video autoplay muted loop playsinline class="bg-video">
        <source src="/AdminTheame/assets/Video/LoginVdo.mp4" type="video/mp4">
    </video>
    <div class="unix-login">
        <div class="login-content">
            <!-- ✅ Logo -->
            <div class="login-logo">
                <a href="#"><span>@Model.CompanyName</span></a>
            </div>

            <div class="login-form">
                @if (!string.IsNullOrEmpty(Model.LogoBase64))
                {
                    <div class="mb-3 text-center">
                        <img src="@Model.LogoBase64"
                             style="height:80px; object-fit:contain;" />
                    </div>
                }


                <!-- ✅ Show error -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <!-- ✅ Login Form -->
                <form asp-controller="Account" asp-action="Login" method="post">
                    <div class="form-group">
                        <label>Email address</label>
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label>Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="checkbox">
                        <label>
                            <input type="checkbox" /> Remember Me
                        </label>
                        <label class="pull-right">
                            <a href="#">Forgot Password?</a>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-flat m-b-30 m-t-30 w-100">
                        Sign in
                    </button>

                    <div class="register-link m-t-15 text-center">
                        <p>Only Admin Users can login</p>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/AdminTheame/assets/js/lib/jquery.min.js"></script>
    <script src="/AdminTheame/assets/js/lib/bootstrap.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const emailInput = document.querySelector('input[name="Email"]');
            const passwordInput = document.querySelector('input[name="Password"]');
            const form = document.querySelector('form');
            const submitButton = form?.querySelector('button[type="submit"], input[type="submit"]');

            // Step 1: Email पर फोकस
            if (emailInput) {
                emailInput.focus();
            }

            // Step 2: Email → Enter → Password
            emailInput?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    passwordInput?.focus();
                }
            });

            // Step 3: Password → Enter → Submit बटन
            passwordInput?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    submitButton?.focus();
                }
            });

            // Step 4: Submit बटन → Enter → Form Submit
            submitButton?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    form?.submit();
                }
            });
        });
    </script>
</body>
</html>
