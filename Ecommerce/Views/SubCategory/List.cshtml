        function submitFilter() {
            const name = document.getElementById('name').value.trim();
            const status = document.getElementById('status').value;
            const categoryId = document.getElementById('categoryId').value;

            let url = "/SubCategory/List?";
            const params = [];

            if (name) params.push(`name=${encodeURIComponent(name)}`);
            if (status) params.push(`status=${encodeURIComponent(status)}`);
            if (categoryId) params.push(`categoryId=${encodeURIComponent(categoryId)}`);

            url += params.join("&");
            window.location.href = url;
        }

        function resetFilter() {
            window.location.href = "/Admin/SubCategory/List";
        }
    </script>








    <script>
        $(document).ready(function () {

            function fetchSubCategorySuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/SubCategory/AutoCompleteSubCategory', // adjust URL
                    type: 'GET',
                    data: { term: query },
                    success: function(data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item) // English or Arabic based on input
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item); // select value
                                        $suggestionBox.hide();
                                        $('#name').focus(); // keep focus
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            // Trigger on input
            $('#name').on('input', function() {
                fetchSubCategorySuggestions($(this).val());
            });

            // Enable arrow key navigation
            enableSuggestionNavigation('#name', '#suggestions');

            // Hide suggestions if click outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });
    </script>

