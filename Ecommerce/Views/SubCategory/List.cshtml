@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.SubCategoryListViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Subcategories","الفئات الفرعية");
}
<div class="admin-master-register" id="masterRegister" data-register-url="@Url.Action("List","SubCategory")" data-suggest-url="@Url.Action("AutoCompleteSubCategory","SubCategory")">
    <section class="admin-panel">
        <div class="admin-section-heading"><h2>@ViewData["Title"]</h2><a asp-action="CreateSubCategory" class="btn btn-primary">@T("Add subcategory","إضافة فئة فرعية")</a></div>
        <form id="masterFilters" method="get" asp-action="List" class="admin-register-filters">
            <div class="form-group"><label for="categoryId">@T("Main category","الفئة الرئيسية")</label>
                <select id="categoryId" name="categoryId" class="form-control"><option value="">@T("All","الكل")</option>
                @foreach(var category in (SelectList)ViewBag.Categories){<option value="@category.Value" selected="@(ViewBag.FilterCategoryId?.ToString()==category.Value)">@category.Text</option>}
                </select></div>
            <div class="form-group"><label for="name">@T("Search by name","بحث بالاسم")</label>
                <input id="name" name="name" type="search" class="form-control" list="masterSuggestions" autocomplete="off" value="@ViewBag.FilterName" />
                <datalist id="masterSuggestions"></datalist>
            </div>
            <div class="form-group"><label for="status">@T("Status","الحالة")</label>
                <select id="status" name="status" class="form-control"><option value="">@T("All","الكل")</option>
                    <option value="1" selected="@(ViewBag.FilterStatus?.ToString()=="1")">@T("Active","نشط")</option>
                    <option value="0" selected="@(ViewBag.FilterStatus?.ToString()=="0")">@T("Inactive","غير نشط")</option>
                </select></div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <button type="submit" class="btn btn-primary">@T("Search","بحث")</button>
            <a asp-action="List" id="clearMasterFilters" class="btn btn-default">@T("Clear","مسح")</a>
        </form>
        <p id="masterMessage" class="admin-muted" role="status"></p>
        <div id="masterResults"><partial name="_RegisterRows" model="Model" /></div>
    </section>
    
</div>
@section Scripts {
    <script src="~/js/master-register.js" asp-append-version="true"></script>
}
