@inject EcommerceWebApplication.Helper.AdminStaffAccess StaffAccess
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.SubCategoryListViewModel>
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var rights = await StaffAccess.RightsAsync(User, EcommerceWebApplication.Helper.AdminStaffAccess.Subcategories, Context.RequestAborted);
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    int serial = (Model.PageNumber-1)*Model.PageSize+1;
    int pages = Math.Max(1,Model.TotalPages);
    string PageUrl(int page) => Url.Action("List","SubCategory",new {page,pageSize=Model.PageSize,name=(string?)ViewBag.FilterName,status=(int?)ViewBag.FilterStatus,categoryId=(int?)ViewBag.FilterCategoryId})!;
}
<p class="admin-muted order-result-count">@Model.TotalItems @T("records found","سجل")</p>
<div class="admin-table-scroll"><table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th class="text-center"> @_localizer["SN"]</th>
                        <th class="text-center"> @_localizer["ID"]</th>
                        <th class="text-start"> @_localizer["Main Category"]</th>
                        <th class="text-start"> @_localizer["Name"]</th>
                        <th class="text-center"> @_localizer["Status"]</th>
                        <th class="text-center"> @_localizer["Created Date"]</th>
                        <th class="text-center"> @_localizer["Image"]</th>
                        @if(rights.Edit || rights.Delete){<th class="text-center"> @_localizer["Action"]</th>}
                    </tr>
                </thead>
                <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="@(rights.Edit || rights.Delete ? 8 : 7)" class="admin-empty-state">@_localizer["No records found"]</td></tr>
            }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center">@serial</td>
                            <td class="text-center">@item.SubCategoryId</td>
                            <td class="text-start">@item.ParentCategoryName</td>
                            <td class="text-start">@item.SCName</td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="admin-status btn-success">@T("Active","نشط")</span>
                                }
                                else
                                {
                                    <span class="admin-status btn-danger">@T("Inactive","غير نشط")</span>
                                }
                            </td>
                            <td class="text-center">@(item.CreatedAt?.ToString("dd-MM-yyyy") ?? "")</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.SubCategoryImageBase64))
                                {
                                    <img src="@item.SubCategoryImageBase64" class="admin-product-thumb" loading="lazy" alt="" />
                                }
                                else
                                {
                                    <span class="admin-muted">@T("No image","لا توجد صورة")</span>
                                }
                            </td>
                            @if(rights.Edit || rights.Delete)
{
<td class="text-center">
                                @if(rights.Edit){
<a asp-action="Edit" asp-route-id="@item.SubCategoryId" class="btn btn-sm btn-primary me-1" aria-label="@_localizer["Edit"]">
                                    <i class="ti-pencil"></i> 
                                </a>
}
                                @if(rights.Delete){
<button type="button" class="btn btn-sm btn-danger" aria-label="@_localizer["Delete"]" data-delete-url="@Url.Action("DeleteSubCategory","SubCategory",new { id=item.SubCategoryId })">
                                    <i class="ti-trash"></i> 
                                </button>
}
                            </td>
}
                        </tr>
                        serial++;
                    }
                </tbody>
            </table></div>
<nav class="order-pagination" aria-label="@T("Pages","الصفحات")">
    @if(Model.PageNumber>1){<a class="btn btn-default" href="@PageUrl(Model.PageNumber-1)" data-register-page>@T("Previous","السابق")</a>}
    <span>@T("Page","صفحة") @Model.PageNumber / @pages</span>
    @if(Model.PageNumber<pages){<a class="btn btn-default" href="@PageUrl(Model.PageNumber+1)" data-register-page>@T("Next","التالي")</a>}
</nav>
