@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
<!-- /# row -->
@{
    var orderItems = ViewBag.OrderItems as List<EcommerceWebApplication.Models.OrderItemViewModel>;
}
<style>
    .bold-text {
        font-weight: bold;
    }
</style>
<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="row">

                <div class="col-lg-3">
                    <a href="~/ManageCustomer/CustomerList" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-primary">
                                    <i class="ti-user"></i>
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Total Customers"]</div>
                                    <div class="stat-digit">@ViewBag.customerCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3">
                    <a href="~/Category/Index" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-info">
                                    <i class="ti-layout-grid2"></i> <!-- Total Categories -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text bold-text">@_localizer["Total Categories"]</div>
                                    <div class="stat-digit">@ViewBag.categoryCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3">
                    <a href="~/SubCategory/List" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-warning">
                                    <i class="ti-menu-alt"></i> <!-- Sub Categories -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text bold-text">@_localizer["Sub Categories"]</div>
                                    <div class="stat-digit">@ViewBag.SubCategoriesCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>

                <div class="col-lg-3">
                    <a href="~/Products/ProductList" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-success">
                                    <i class="ti-package"></i> <!-- Total Products -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Total Products"]</div>
                                    <div class="stat-digit">@ViewBag.ProductsCount</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="row">
                <div class="col-lg-3">
                    <a href="~/ManageOrders/PendingOrder" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-warning">
                                    <i class="ti-timer"></i> <!-- Pending Orders -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Pending Orders"]</div>
                                    <div class="stat-digit">@ViewBag.PendingOrders</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-lg-3">
                    <a href="~/ManageOrders/PendingOrder" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-primary">
                                    <i class="ti-check-box"></i> <!-- Accepted Orders -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Accepted Orders"]</div>
                                    <div class="stat-digit">@ViewBag.AcceptedOrders</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-lg-3">
                    <a href="~/ManageOrders/PendingOrder" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-success">
                                    <i class="ti-check"></i> <!-- Completed Orders -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Completed Orders"]</div>
                                    <div class="stat-digit">@ViewBag.CompletedOrders</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-lg-3">
                    <a href="~/ManageOrders/PendingOrder" class="text-decoration-none text-dark">
                        <div class="card p-0 clickable-card" style="cursor: pointer;">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-danger">
                                    <i class="ti-close"></i> <!-- Cancelled Orders -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Cancelled Orders"]</div>
                                    <div class="stat-digit">@ViewBag.CancelledOrders</div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="row">
                <div class="col-lg-3">
                    <a href="~/Areas/AreaList" class="text-decoration-none text-dark">
                        <div class="card p-0">
                            <div class="stat-widget-three">
                                <div class="stat-icon bg-info">
                                    <i class="ti-map-alt"></i> <!-- Total Area -->
                                </div>
                                <div class="stat-content">
                                    <div class="stat-text bold-text">@_localizer["Total Area"]</div>
                                    <div class="stat-digit"> @ViewBag.TotalArea </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-lg-3">
                    <div class="card p-0">
                        <div class="stat-widget-three">
                            <div class="stat-icon bg-warning">
                                <i class="ti-wallet"></i> <!-- Total Sales -->
                            </div>
                            <div class="stat-content">
                                <div class="stat-text bold-text">@_localizer["Total Sales"]</div>
                                <div class="stat-digit" id="totalSales">@Convert.ToDecimal(ViewBag.TotalSales).ToString("F3", CultureInfo.InvariantCulture)</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="card p-0">
                        <div class="stat-widget-three">
                            <div class="stat-icon @(ViewBag.LowStock > 0 ? "bg-danger" : "bg-success")">
                                <i class="ti-alert"></i>
                            </div>
                            <div class="stat-content">
                                <div class="stat-text bold-text">@_localizer["Stock Alert"]</div>
                                <div class="stat-digit">
                                    @ViewBag.LowStock
                                    @if (ViewBag.LowStock > 20)
                                    {
                                        <span style="color:red">@_localizer["(Low!)"]</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
