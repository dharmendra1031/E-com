@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var orders = ViewBag.OrderItems as List<EcommerceWebApplication.Models.OrderItemViewModel>;
    var cards = new[] {
        new { Label = ar ? "مدفوعات اليوم" : "Payments today", Value = "KD " + Convert.ToDecimal(ViewBag.TodayPayments).ToString("F3", CultureInfo.InvariantCulture), Icon = "ti-wallet", Url = "", Hint = ar ? "المدفوعات المسجلة" : "Recorded paid payments" },
        new { Label = ar ? "طلبات اليوم" : "Orders today", Value = Convert.ToString(ViewBag.TodayOrders), Icon = "ti-shopping-cart", Url = "", Hint = "" },
        new { Label = _localizer["Pending Orders"].Value, Value = Convert.ToString(ViewBag.PendingOrders), Icon = "ti-time", Url = Url.Action("PendingOrder","ManageOrders"), Hint = ar ? "تحتاج إلى متابعة" : "Requires attention" },
        new { Label = _localizer["Stock Alert"].Value, Value = Convert.ToString(ViewBag.LowStock), Icon = "ti-alert", Url = Url.Action("Index","ProductStock"), Hint = ar ? "المخزون المتاح 10 أو أقل" : "Available stock 10 or less" }
    };
    var statuses = new[] {
        new { Label = _localizer["Accepted Orders"].Value, Value = Convert.ToString(ViewBag.AcceptedOrders) },
        new { Label = _localizer["Completed Orders"].Value, Value = Convert.ToString(ViewBag.CompletedOrders) },
        new { Label = _localizer["Cancelled Orders"].Value, Value = Convert.ToString(ViewBag.CancelledOrders) }
    };
    var masters = new[] {
        new { Label = _localizer["Total Customers"].Value, Value = Convert.ToString(ViewBag.customerCount), Url = Url.Action("CustomerList","ManageCustomer") },
        new { Label = _localizer["Total Products"].Value, Value = Convert.ToString(ViewBag.ProductsCount), Url = Url.Action("ProductList","Products") },
        new { Label = _localizer["Total Categories"].Value, Value = Convert.ToString(ViewBag.categoryCount), Url = Url.Action("Index","Category") },
        new { Label = _localizer["Sub Categories"].Value, Value = Convert.ToString(ViewBag.SubCategoriesCount), Url = Url.Action("List","SubCategory") },
        new { Label = _localizer["Total Area"].Value, Value = Convert.ToString(ViewBag.TotalArea), Url = Url.Action("AreaList","Areas") }
    };
}
<div class="admin-dashboard">
    <div class="admin-section-heading">
        <div><h2>@(ar ? "نظرة عامة على الأعمال" : "Business overview")</h2><p class="admin-muted" dir="ltr">@DateTime.Today.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</p></div>
        <a class="btn btn-primary" href="@Url.Action("PendingOrder","ManageOrders")">@(ar ? "إدارة الطلبات" : "Manage orders")</a>
    </div>
    <div class="admin-kpi-grid">
        @foreach (var card in cards)
        {
            <article class="admin-kpi">
                <div class="admin-kpi-label"><span>@card.Label</span><i class="@card.Icon" aria-hidden="true"></i></div>
                <strong dir="ltr">@card.Value</strong>
                @if (!string.IsNullOrEmpty(card.Hint)) { <span class="admin-muted">@card.Hint</span> }
                @if (!string.IsNullOrEmpty(card.Url)) { <a href="@card.Url">@(ar ? "عرض التفاصيل" : "View details")</a> }
            </article>
        }
    </div>
    <section class="admin-dashboard-section">
        <h2>@(ar ? "حالة الطلبات" : "Order status")</h2>
        <div class="admin-kpi-grid">
            @foreach (var status in statuses)
            {
                <article class="admin-kpi"><span class="admin-kpi-label">@status.Label</span><strong dir="ltr">@status.Value</strong></article>
            }
            <article class="admin-kpi"><span class="admin-kpi-label">@(ar ? "إجمالي المدفوعات المسجلة" : "Total recorded payments")</span><strong id="totalSales" dir="ltr">KD @Convert.ToDecimal(ViewBag.TotalSales).ToString("F3", CultureInfo.InvariantCulture)</strong></article>
        </div>
    </section>
    <section class="admin-panel admin-dashboard-section">
        <div class="admin-section-heading"><h2>@(ar ? "أحدث الطلبات" : "Recent orders")</h2><a href="@Url.Action("PendingOrder","ManageOrders")">@(ar ? "عرض الكل" : "View all")</a></div>
        @if (orders?.Any() == true)
        {
            <div class="admin-table-scroll"><table class="table table-hover">
                <thead><tr><th>@_localizer["Order ID"]</th><th>@_localizer["Customer Name"]</th><th>@_localizer["Order Status"]</th><th>@_localizer["Payment type"]</th><th>@_localizer["Date/Time"]</th><th>@_localizer["Total Price"]</th></tr></thead>
                <tbody>
                    @foreach (var item in orders)
                    {
                        <tr><td>#@item.OrderId</td><td>@item.FullName</td><td>@item.OrderStatus</td><td>@item.Paytype</td><td><bdi>@item.CreatedAt.ToString("dd-MM-yyyy HH:mm")</bdi></td><td><bdi>KD @Convert.ToDecimal(item.TotalPrice).ToString("F3", CultureInfo.InvariantCulture)</bdi></td></tr>
                    }
                </tbody>
            </table></div>
        }
        else { <p class="admin-muted">@(ar ? "لا توجد طلبات" : "No orders yet")</p> }
    </section>
    <section class="admin-dashboard-section">
        <h2>@(ar ? "البيانات الأساسية" : "Master data")</h2>
        <div class="admin-kpi-grid">
            @foreach (var item in masters)
            {
                <a class="admin-kpi" href="@item.Url"><span class="admin-kpi-label">@item.Label</span><strong dir="ltr">@item.Value</strong></a>
            }
        </div>
    </section>
</div>
