@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var orders = ViewBag.OrderItems as List<EcommerceWebApplication.Models.OrderItemViewModel>;
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    var money = Convert.ToDecimal(ViewBag.TodayPayments).ToString("F3",CultureInfo.InvariantCulture);
    var totalPayments = Convert.ToDecimal(ViewBag.TotalSales).ToString("F3",CultureInfo.InvariantCulture);
    var metrics = new[] {
        new { Label = ar ? "مدفوعات اليوم" : "Payments today", Value = "KD " + money, Href = "", Detail = ar ? "المدفوعات المسجلة كمدفوعة" : "Recorded paid payments" },
        new { Label = ar ? "طلبات اليوم" : "Orders today", Value = Convert.ToString(ViewBag.TodayOrders), Href = Url.Action("PendingOrder","ManageOrders",new {startDate=DateTime.Today.ToString("dd-MM-yyyy"),endDate=DateTime.Today.ToString("dd-MM-yyyy")}), Detail = "" },
        new { Label = _localizer["Pending Orders"].Value, Value = Convert.ToString(ViewBag.PendingOrders), Href = Url.Action("PendingOrder","ManageOrders",new {status=1}), Detail = ar ? "تحتاج إلى متابعة" : "Requires attention" },
        new { Label = _localizer["Stock Alert"].Value, Value = Convert.ToString(ViewBag.LowStock), Href = Url.Action("Index","ProductStock"), Detail = ar ? "المخزون المتاح 10 أو أقل" : "Available stock 10 or less" }
    };
    var statusCards = new[] {
        new {Label = _localizer["Accepted Orders"].Value, Value = Convert.ToString(ViewBag.AcceptedOrders), Status = 2},
        new {Label = _localizer["Completed Orders"].Value, Value = Convert.ToString(ViewBag.CompletedOrders), Status = 5},
        new {Label = _localizer["Cancelled Orders"].Value, Value = Convert.ToString(ViewBag.CancelledOrders), Status = 4}
    };
    var masters = new[] {
        new {Label = _localizer["Total Customers"].Value, Value = Convert.ToString(ViewBag.customerCount), Href = Url.Action("CustomerList","ManageCustomer")},
        new {Label = _localizer["Total Products"].Value, Value = Convert.ToString(ViewBag.ProductsCount), Href = Url.Action("ProductList","Products")},
        new {Label = _localizer["Total Categories"].Value, Value = Convert.ToString(ViewBag.categoryCount), Href = Url.Action("Index","Category")},
        new {Label = _localizer["Sub Categories"].Value, Value = Convert.ToString(ViewBag.SubCategoriesCount), Href = Url.Action("List","SubCategory")},
        new {Label = _localizer["Total Area"].Value, Value = Convert.ToString(ViewBag.TotalArea), Href = Url.Action("AreaList","Areas")}
    };
}
<style>
    .admin-overview { color:#111; min-width:0; }
    .admin-overview h1,.admin-overview h2 { color:#111; font-weight:700; }
    .admin-overview .overview-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr)); gap:12px; }
    .admin-overview .overview-card { display:flex; flex-direction:column; gap:8px; padding:16px; background:#fff; border:1px solid #dce3e9; border-radius:10px; min-width:0; color:#111; text-decoration:none; overflow-wrap:anywhere; }
    .admin-overview a.overview-card:hover { border-color:#075a96; }
    .admin-overview .overview-value { font-size:clamp(1.25rem,2.2vw,1.75rem); font-weight:700; color:#111; }
    .admin-overview .overview-label { color:#334155; font-size:.9rem; font-weight:600; }
    .admin-overview .overview-detail { color:#475569; font-size:.8rem; }
    .admin-overview .overview-section { margin-block:20px; }
    .admin-overview .overview-table { border:1px solid #dce3e9; background:#fff; border-radius:10px; padding:16px; }
    .admin-overview th { font-weight:600; color:#111; background:#f6f8fb; }
    .admin-overview td { color:#111; vertical-align:middle; }
    .admin-overview .overview-heading { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; margin-block-end:12px; }
</style>
<div class="main-content admin-overview">
    <div class="overview-heading">
        <div><h1 class="h4 mb-1">@(ar ? "نظرة عامة على الأعمال" : "Business overview")</h1><div class="text-muted small" dir="ltr">@DateTime.Today.ToString("dd MMM yyyy",CultureInfo.InvariantCulture)</div></div>
        <a class="btn btn-primary" href="@Url.Action("PendingOrder","ManageOrders")">@(ar ? "إدارة الطلبات" : "Manage orders")</a>
    </div>
    <div class="overview-grid">
        @foreach(var m in metrics)
        {
            @if(!string.IsNullOrEmpty(m.Href))
            {
                <a class="overview-card" href="@m.Href"><span class="overview-label">@m.Label</span><strong class="overview-value" dir="ltr">@m.Value</strong><span class="overview-detail">@m.Detail</span></a>
            }
            else
            {
                <div class="overview-card"><span class="overview-label">@m.Label</span><strong class="overview-value" dir="ltr">@m.Value</strong><span class="overview-detail">@m.Detail</span></div>
            }
        }
    </div>
    <section class="overview-section">
        <h2 class="h5">@(ar ? "حالة الطلبات" : "Order status")</h2>
        <div class="overview-grid">
            @foreach(var m in statusCards)
            {
                <a class="overview-card" href="@Url.Action("PendingOrder","ManageOrders",new {status=m.Status})"><span class="overview-label">@m.Label</span><strong class="overview-value">@m.Value</strong></a>
            }
            <div class="overview-card"><span class="overview-label">@(ar ? "إجمالي المدفوعات المسجلة" : "Total recorded payments")</span><strong class="overview-value" dir="ltr">KD @totalPayments</strong></div>
        </div>
    </section>
    <section class="overview-section overview-table">
        <div class="overview-heading"><h2 class="h5 mb-0">@(ar ? "أحدث الطلبات" : "Recent orders")</h2><a href="@Url.Action("PendingOrder","ManageOrders")">@(ar ? "عرض الكل" : "View all")</a></div>
        @if(orders?.Any()==true)
        {
            <div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>@_localizer["Order ID"]</th><th>@_localizer["Customer Name"]</th><th>@_localizer["Order Status"]</th><th>@_localizer["Payment type"]</th><th>@_localizer["Date/Time"]</th><th>@_localizer["Total Price"]</th></tr></thead>
            <tbody>@foreach(var o in orders)
            {
                <tr><td>#@o.OrderId</td><td>@o.FullName</td><td>@o.OrderStatus</td><td>@o.Paytype</td><td dir="ltr">@o.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td><td dir="ltr">KD @Convert.ToDecimal(o.TotalPrice).ToString("F3",CultureInfo.InvariantCulture)</td></tr>
            }</tbody></table></div>
        }
        else { <p class="text-muted mb-0">@(ar ? "لا توجد طلبات" : "No orders yet")</p> }
    </section>
    <section class="overview-section">
        <h2 class="h5">@(ar ? "البيانات الأساسية" : "Master data")</h2>
        <div class="overview-grid">@foreach(var m in masters)
        {
            <a class="overview-card" href="@m.Href"><span class="overview-label">@m.Label</span><strong class="overview-value">@m.Value</strong></a>
        }</div>
    </section>
</div>
