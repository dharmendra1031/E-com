@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.RegisterViewModals
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = _localizer["Create Account"].Value;
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<div class="container store-auth">
    <div class="store-auth-card store-auth-narrow my-4">
        <h1 class="h3 fw-bold mb-2">@_localizer["Create Account"]</h1>
        <p class="text-secondary mb-4">@(ar ? "أنشئ حسابك وتحقق من بريدك الإلكتروني." : "Create your account and verify your email address.")</p>
        <form asp-action="Register" method="post" id="registerForm">
            <div asp-validation-summary="All" class="text-danger small" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3"><label asp-for="FullName" class="form-label">@_localizer["Full Name"]</label><input asp-for="FullName" autocomplete="name" class="form-control" required /></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@_localizer["Email"]</label>
                <div class="input-group"><input asp-for="Email" type="email" autocomplete="email" class="form-control" dir="ltr" required /><button type="button" id="sendOtpBtn" class="btn btn-outline-primary">@_localizer["Send OTP"]</button></div>
                <p id="verifyState" class="small mt-1 mb-0" role="status">@(ar ? "تحقق من بريدك الإلكتروني للمتابعة." : "Verify your email to continue.")</p>
            </div>
            <div class="mb-3"><label asp-for="BirthDate" class="form-label">@_localizer["Birth Date"]</label><input asp-for="BirthDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" value="@(Model.BirthDate == default ? "" : Model.BirthDate.ToString("yyyy-MM-dd"))" required /></div>
            <div class="mb-3"><label asp-for="Phone" class="form-label">@_localizer["Phone"]</label><div class="input-group" dir="ltr"><span class="input-group-text">+965</span><input asp-for="Phone" type="tel" autocomplete="tel-national" inputmode="numeric" maxlength="8" pattern="[569][0-9]{7}" class="form-control" required /></div></div>
            <div class="mb-3"><label asp-for="Password" class="form-label">@_localizer["Password"]</label><div class="input-group"><input asp-for="Password" type="password" autocomplete="new-password" minlength="8" maxlength="50" class="form-control" required /><button type="button" class="btn btn-outline-secondary" data-password-toggle="Password">@(ar ? "إظهار" : "Show")</button></div><p class="small text-secondary mt-1">@(ar ? "من 8 إلى 50 حرفًا." : "Use 8–50 characters.")</p></div>
            <div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">@_localizer["Confirm Password"]</label><div class="input-group"><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" class="form-control" required /><button type="button" class="btn btn-outline-secondary" data-password-toggle="ConfirmPassword">@(ar ? "إظهار" : "Show")</button></div></div>
            <button type="submit" id="createAccount" class="btn btn-primary w-100 store-auth-submit">@_localizer["Create"]</button>
        </form>
        <div class="border-top pt-3 mt-4 text-center"><a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@_localizer["Already have an account? Login Here"]</a></div>
    </div>
</div>
<div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpTitle">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title h5" id="otpTitle">@(ar ? "التحقق من البريد الإلكتروني" : "Email verification")</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(ar ? "إغلاق" : "Close")"></button></div>
        <form id="verifyForm" class="modal-body store-auth">
            <p id="otpEmail" class="small text-secondary" dir="auto"></p>
            <label for="otpInput" class="form-label">@_localizer["Enter OTP"]</label>
            <input id="otpInput" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" class="form-control store-otp" dir="ltr" required />
            <p id="otpMessage" class="text-danger small mt-2" role="status"></p>
            <button type="submit" id="verifyOtpBtn" class="btn btn-primary w-100">@_localizer["Verify OTP"]</button>
            <button type="button" id="registerResend" class="btn btn-link w-100 mt-2">@_localizer["Resend OTP"]</button>
        </form>
    </div></div>
</div>
<script>
(() => {
    const ar=document.documentElement.lang==="ar";
    const email=document.getElementById("Email"), send=document.getElementById("sendOtpBtn"), state=document.getElementById("verifyState");
    const modal=document.getElementById("otpModal"), otp=document.getElementById("otpInput"), message=document.getElementById("otpMessage");
    const verify=document.getElementById("verifyOtpBtn"), resend=document.getElementById("registerResend"), create=document.getElementById("createAccount");
    const password=document.getElementById("Password"), confirm=document.getElementById("ConfirmPassword");
    const resendLabel=resend.textContent.trim();
    let verified="", sentEmail="", pending=false, deadline=0, timer;
    const fallback=ar?"تعذر إكمال الطلب. حاول مرة أخرى.":"Unable to complete request. Try again.";
    function controls() {
        const seconds=Math.max(0,Math.ceil((deadline-Date.now())/1000));
        send.disabled=pending||!email.value||!email.checkValidity()||(email.value.trim()===sentEmail&&seconds>0)||email.value.trim()===verified;
        resend.disabled=pending||seconds>0; verify.disabled=pending; create.disabled=pending;
        resend.textContent=resendLabel+(seconds?" ("+seconds+"s)":"");
        if(!seconds)clearInterval(timer);
    }
    async function post(action,data) {
        pending=true;controls();
        try {
            const response=await fetch("/UserAccount/"+action,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});
            const result=await response.json();
            if(!response.ok||!result.success)throw new Error(result.message||fallback);
            return result;
        } finally {pending=false;controls();}
    }
    async function sendCode() {
        if(pending||!email.value||!email.checkValidity())return;
        sentEmail=email.value.trim();email.readOnly=true;message.textContent="";state.textContent="";
        try {
            await post("SendOtp",{email:sentEmail});
            otp.value="";document.getElementById("otpEmail").textContent=sentEmail;
            bootstrap.Modal.getOrCreateInstance(modal).show();
            clearInterval(timer);deadline=Date.now()+120000;controls();timer=setInterval(controls,1000);
        } catch(error){state.textContent=error.message||fallback;message.textContent=error.message||fallback;}
        finally{email.readOnly=false;controls();}
    }
    send.addEventListener("click",sendCode);resend.addEventListener("click",sendCode);
    email.addEventListener("input",()=>{if(email.value.trim()!==verified){verified="";state.classList.remove("text-success");state.textContent=ar?"تحقق من بريدك الإلكتروني للمتابعة.":"Verify your email to continue.";}controls();});
    otp.addEventListener("input",()=>otp.value=otp.value.replace(/[^0-9]/g,"").slice(0,6));
    modal.addEventListener("shown.bs.modal",()=>otp.focus());
    modal.addEventListener("hide.bs.modal",e=>{if(pending)e.preventDefault();});
    document.getElementById("verifyForm").addEventListener("submit",async e=>{
        e.preventDefault();if(pending)return;
        message.textContent="";
        try {
            await post("VerifyOtpRegister",{email:sentEmail,otp:otp.value});
            verified=sentEmail;state.classList.add("text-success");state.textContent=ar?"تم التحقق من البريد الإلكتروني":"Email verified";
            bootstrap.Modal.getInstance(modal).hide();controls();
        } catch(error){message.textContent=error.message||fallback;}
    });
    document.getElementById("registerForm").addEventListener("submit",e=>{
        if(pending||verified!==email.value.trim()){e.preventDefault();state.textContent=ar?"تحقق من بريدك الإلكتروني أولاً.":"Verify your email first.";send.focus();return;}
        if(password.value!==confirm.value){e.preventDefault();confirm.setCustomValidity(ar?"كلمات المرور غير متطابقة":"Passwords do not match");confirm.reportValidity();return;}
        create.disabled=true;
    });
    confirm.addEventListener("input",()=>confirm.setCustomValidity(""));password.addEventListener("input",()=>confirm.setCustomValidity(""));
    controls();
})();
</script>
