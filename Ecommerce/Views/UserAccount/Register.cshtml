@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.RegisterViewModals
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var culture = CultureInfo.CurrentCulture;
    bool isArabic = culture.TextInfo.IsRightToLeft;
}
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}

<!-- Flatpickr CSS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
<script src="~/js/navigation.js"></script>
<div class="container store-auth">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">

            <div class="store-auth-card text-center my-3 my-md-5" id="NavigationKey">
                <h2 class="fw-semibold mb-4">@_localizer["Create Account"]</h2>

                <form id="registerForm" method="post" onsubmit="return validateFormJS();">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <!-- Full Name -->
                    <div class="form-floating mb-3">
                        <input id="FullName" name="FullName"
                               class="form-control form-control-lg bg-white rounded-3"
                               placeholder="@_localizer["Full Name"]" />
                        <label for="FullName">@_localizer["Full Name"]</label>
                        @if (isArabic)
                        {
                            <span id="fullNameError" class="text-danger d-none">الاسم الكامل مطلوب</span>
                        }
                        else
                        {
                            <span id="fullNameError" class="text-danger d-none">Full Name is required</span>
                        }
                      
                    </div>

                    <!-- Email -->
                    @*  <div class="form-floating mb-3">
                        <input id="Email" name="Email"
                               class="form-control form-control-lg bg-white rounded-3"
                               placeholder="@_localizer["Email"]" />
                        <label for="Email">@_localizer["Email"]</label>
       
                        @if (isArabic)
                        {
                            <span id="emailError" class="text-danger d-none">مطلوب بريد إلكتروني صالح</span>
                        }
                        else
                        {
                            <span id="emailError" class="text-danger d-none">Valid Email is required</span>
                        }
                    </div> *@
                    <div class="mb-3">

                        <!-- SEND OTP BUTTON (FULL WIDTH TOP) -->
                       

                        <!-- EMAIL INPUT -->
                        <div class="form-floating">
                            <input id="Email" name="Email"
                                   class="form-control form-control-lg bg-white rounded-3"
                                   placeholder="@_localizer["Email"]" />
                            <label for="Email">@_localizer["Email"]</label>
                        </div>

                        <!-- ERROR MESSAGE -->
                        @if (isArabic)
                        {
                            <span id="emailError" class="text-danger d-none">مطلوب بريد إلكتروني صالح</span>
                        }
                        else
                        {
                            <span id="emailError" class="text-danger d-none">Valid Email is required</span>
                        }
                        <div class="d-grid mb-2">
                            <button type="button"
                                    id="sendOtpBtn"
                                    class="btn btn-outline-primary rounded-3 py-2"
                                    style="font-size:14px;"
                                    disabled>
                                @_localizer["Send OTP"]
                            </button>
                        </div>

                    </div>

                    <!-- Birth Date -->
                    <div class="form-floating mb-3 position-relative">
                        <input type="hidden" id="BirthDate" name="BirthDate" />
                        <input type="text" id="BirthDate_Display"
                               class="form-control form-control-lg bg-white rounded-3 ps-3"
                               placeholder="DD-MM-YYYY" maxlength="10" />
                        <label for="BirthDate_Display">@_localizer["Birth Date"]</label>
                        @if (isArabic)
                        {
                            <span id="dobError" class="text-danger d-none">الرجاء إدخال تاريخ الميلاد</span>
                        }
                        else
                        {
                            <span id="dobError" class="text-danger d-none">Please enter Birth Date</span>
                        }
                       
                        <span id="calendarIcon" class="position-absolute top-50 end-0 translate-middle-y me-3 text-secondary" style="cursor:pointer;">
                            <i class="fa-solid fa-calendar"></i>
                        </span>
                    </div>

                    <!-- Phone -->
                    <div class="form-floating mb-3">
                        <input id="Phone" name="Phone"
                               class="form-control form-control-lg bg-white rounded-3"
                               placeholder="Phone" maxlength="8" onkeypress="return numericOnly(event)" />
                        <label for="Phone">@_localizer["Phone"]</label>
                      
                        @if (isArabic)
                        {
                            <span id="phoneError" class="text-danger d-none">الهاتف مطلوب </span>
                        }
                        else
                        {
                            <span id="phoneError" class="text-danger d-none">Phone is required </span>
                        }
                    </div>

                    <!-- Password -->
                    <div class="form-floating mb-3">
                        <input id="Password" name="Password"
                               type="password"
                               class="form-control form-control-lg bg-white rounded-3"
                               placeholder="@_localizer["Password"]" />
                        <label for="Password">@_localizer["Password"]</label>
                        
                        @if (isArabic)
                        {
                            <span id="passwordError" class="text-danger d-none">كلمة المرور مطلوبة</span>
                        }
                        else
                        {
                            <span id="passwordError" class="text-danger d-none">Password is required</span>
                        }
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-floating mb-3">
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword"
                               class="form-control form-control-lg bg-white rounded-3"
                               placeholder="@_localizer["Confirm Password"]" />
                        <label for="ConfirmPassword">@_localizer["Confirm Password"]</label>
                  

                        @if (isArabic)
                        {
                            <span id="confirmPasswordError" class="text-danger d-none">كلمات المرور غير متطابقة</span>
                        }
                        else
                        {
                            <span id="confirmPasswordError" class="text-danger d-none">Passwords do not match</span>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold rounded-3">@_localizer["Create"]</button>
                </form>


                <div class="mt-3 text-center">
                    <p>@_localizer["Already have an account? Login Here"] <a asp-action="Login">@_localizer["Login"]</a></p>
                </div>
                <div class="d-flex justify-content-center gap-3 mt-4">
                    @if (Model.CompanyDetails != null && Model.CompanyDetails.Any())
                    {
                        var company = Model.CompanyDetails.First(); // agar ek hi company use karna ho

                        @* Facebook *@
                        @if (!string.IsNullOrEmpty(company.FacebookUrl))
                        {
                            <a href="@company.FacebookUrl" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        }

                        @* Instagram *@
                        @if (!string.IsNullOrEmpty(company.InstagramUrl))
                        {
                            <a href="@company.InstagramUrl" class="btn btn-danger rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-instagram"></i>
                            </a>
                        }

                        @* Twitter *@
                        @if (!string.IsNullOrEmpty(company.TwitterUrl))
                        {
                            <a href="@company.TwitterUrl" class="btn btn-info rounded-circle text-white d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-twitter"></i>
                            </a>
                        }

                        @* LinkedIn *@
                        @if (!string.IsNullOrEmpty(company.LinkedInUrl))
                        {
                            <a href="@company.LinkedInUrl" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="otpModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content p-4 rounded-4">
            <h5 class="text-center mb-3">Email Verification</h5>

            <input type="text" id="otpInput" maxlength="6"
                   class="form-control form-control-lg text-center mb-3"
                   placeholder="Enter 6-digit OTP" />

            <button type="button" id="verifyOtpBtn"
                    class="btn btn-success w-100">
                Verify OTP
            </button>

            <span id="otpMessage" class="text-danger mt-2 d-block text-center"></span>
        </div>
    </div>
</div>




<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const displayInput = document.getElementById("BirthDate_Display");
        const hiddenInput = document.getElementById("BirthDate");
        const calendarIcon = document.getElementById("calendarIcon");

        const fp = flatpickr(displayInput, {
            dateFormat: "d-m-Y",
            allowInput: true,
            maxDate: "today",
            yearSelectorType: "dropdown",
            disableMobile: true,
            onChange: function (selectedDates) {
                if (selectedDates.length > 0) {
                    hiddenInput.value = selectedDates[0].toISOString().split('T')[0]; // yyyy-MM-dd
                }
            }
        });

        calendarIcon.addEventListener("click", function () { fp.open(); });

        // Allow only numbers and dash in DOB input
        displayInput.addEventListener("input", function () {
            this.value = this.value.replace(/[^0-9\-]/g, "");
        });
    });

    // ---------- Numeric Only ----------
    function numericOnly(e) {
        const char = String.fromCharCode(e.which || e.keyCode);
        if ([8,46,37,39,9].includes(e.keyCode)) return true;
        return /[0-9]/.test(char);
    }

    let emailVerified = false;
    let emailValid = false; // New flag to track email format validation

    document.getElementById("Email").addEventListener("input", function () {
        const email = this.value.trim();
        const btn = document.getElementById("sendOtpBtn");
        const error = document.getElementById("emailError");
        
      
        const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        
        // Check email format only, not OTP verification
        if (emailPattern.test(email)) {
            emailValid = true;
            btn.disabled = false;
            error.classList.add("d-none");
        } else {
            emailValid = false;
            btn.disabled = true;
            if (email.length > 0)
                error.classList.remove("d-none");
            else
                error.classList.add("d-none");
        }
    });

    // 📤 SEND OTP
    document.getElementById("sendOtpBtn").addEventListener("click", function () {
        const email = document.getElementById("Email").value.trim();
        if (!email) return;

        // ✅ Validate email format before sending
        const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        if (!emailPattern.test(email)) {
            alert("Please enter a valid email address");
            return;
        }

        // Disable button to prevent multiple clicks
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Sending...';

        console.log("Sending OTP to:", email); // Debug log

        // ✅ Ensure correct URL path
        fetch("/UserAccount/SendOtp", {
            method: "POST",
            headers: { 
                "Content-Type": "application/json",
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ email: email })
        })
        .then(res => {
            console.log("Response status:", res.status); // Debug log
            if (!res.ok) {
                throw new Error(`HTTP error! status: ${res.status}`);
            }
            return res.json();
        })
        .then(data => {
            console.log("Response data:", data); // Debug log
            if (data.success) {
                document.getElementById("otpMessage").innerText = "";
                const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                otpModal.show();
                
                // Focus on OTP input
                setTimeout(() => {
                    document.getElementById("otpInput").focus();
                }, 500);
            } else {
                // ✅ Use SweetAlert2 instead of alert for better UX
                Swal.fire({
                    icon: 'error',
                    title: 'Failed to Send OTP',
                    text: data.emailExistsMsg || 'Please try again',
                    confirmButtonColor: '#f59e0b'
                });
            }
        })
        .catch(error => {
            console.error("Error sending OTP:", error);
            // ✅ Use SweetAlert2 for error
            Swal.fire({
                icon: 'error',
                text: 'Email already exists.',
                confirmButtonColor: '#f59e0b'
            });
        })
        .finally(() => {
            // Re-enable button
            btn.disabled = false;
            btn.innerHTML = '@_localizer["Send OTP"]';
        });
    });

    // 🔐 VERIFY OTP
    document.getElementById("verifyOtpBtn").addEventListener("click", function () {
        const email = document.getElementById("Email").value.trim();
        const otp = document.getElementById("otpInput").value.trim();
        const msg = document.getElementById("otpMessage");

        if (otp.length !== 6) {
            msg.classList.remove("text-success");
            msg.classList.add("text-danger");
            msg.innerText = "Enter valid 6-digit OTP";
            return;
        }

        // Show loading
        const btn = this;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Verifying...';

        fetch("/UserAccount/VerifyOtpRegister", {
            method: "POST",
            headers: { 
                "Content-Type": "application/json",
                "RequestVerificationToken": document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify({ email: email, otp: otp })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                emailVerified = true;
                
                msg.classList.remove("text-danger");
                msg.classList.add("text-success");
                msg.innerText = data.message;
                
                document.getElementById("Email").readOnly = true;
                document.getElementById("sendOtpBtn").style.display = "none";
                
                setTimeout(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('otpModal'));
                    modal.hide();
                    
                    // Reset button text
                    btn.innerHTML = 'Verify OTP';
                    btn.disabled = false;
                    
                    // Clear OTP input
                    document.getElementById("otpInput").value = '';
                    
                    // Show success message
                    Swal.fire({
                        icon: 'success',
                        title: 'Email Verified!',
                        text: 'Your email has been successfully verified.',
                        confirmButtonColor: '#10b981'
                    });
                }, 1200);
            } else {
                msg.classList.remove("text-success");
                msg.classList.add("text-danger");
                msg.innerText = data.message;
                
                // Re-enable button on failure
                btn.disabled = false;
                btn.innerHTML = 'Verify OTP';
            }
        })
        .catch(() => {
            msg.classList.remove("text-success");
            msg.classList.add("text-danger");
            msg.innerText = "Verification failed";
            
            btn.disabled = false;
            btn.innerHTML = 'Verify OTP';
        });
    });

    // ---------- JS Validation ----------
    function validateFormJS() {
        let isValid = true;

        // Full Name
        const fullName = document.getElementById("FullName").value.trim();
        document.getElementById("fullNameError").classList.toggle("d-none", fullName !== "");
        if (!fullName) isValid = false;

        // Email - Check format and verification
        const email = document.getElementById("Email").value.trim();
        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        
        // First check format
        if (!email || !emailRegex.test(email)) {
            document.getElementById("emailError").classList.remove("d-none");
            isValid = false;
        } else if (!emailVerified) {
            // Show specific error for OTP verification
            Swal.fire({
                icon: 'warning',
                title: 'Email Not Verified',
                text: 'Please verify your email using OTP before creating account',
                confirmButtonColor: '#f59e0b'
            });
            return false; // Stop submission
        } else {
            document.getElementById("emailError").classList.add("d-none");
        }

        // DOB
        const dob = document.getElementById("BirthDate_Display").value.trim();
        document.getElementById("dobError").classList.toggle("d-none", dob !== "");
        if (!dob) isValid = false;

        // Phone
        const phone = document.getElementById("Phone").value.trim();
        document.getElementById("phoneError").classList.toggle("d-none", phone.length === 8);
        if (!phone || phone.length !== 8) isValid = false;

        // Password
        const password = document.getElementById("Password").value;
        document.getElementById("passwordError").classList.toggle("d-none", password !== "");
        if (!password) isValid = false;

        // Confirm Password
        const confirmPassword = document.getElementById("ConfirmPassword").value;
        const confirmPasswordMatches = confirmPassword === password && confirmPassword !== "";
        document.getElementById("confirmPasswordError").classList.toggle("d-none", confirmPasswordMatches);
        if (!confirmPasswordMatches) isValid = false;

        return isValid; // Only submit if true
    }

    // ✅ Remove duplicate form submit handler - keep only one
    // Either use onsubmit attribute OR addEventListener, not both
    // I'm keeping the onsubmit attribute and removing the addEventListener
    
    // Optional: Hide error on typing (improved version)
    ["FullName", "BirthDate_Display", "Phone", "Password", "ConfirmPassword"].forEach(id => {
        document.getElementById(id).addEventListener("input", function() {
            const errorId = id.toLowerCase() + "Error";
            const errorElement = document.getElementById(errorId);
            if (errorElement) {
                errorElement.classList.add("d-none");
            }
        });
    });

    // ✅ OTP input auto focus and enter key support
    document.getElementById("otpInput")?.addEventListener("keyup", function(e) {
        if (e.key === "Enter") {
            document.getElementById("verifyOtpBtn").click();
        }
    });

    // ✅ Auto-advance OTP input (optional feature)
    document.getElementById("otpInput")?.addEventListener("input", function(e) {
        if (this.value.length === 6) {
            document.getElementById("verifyOtpBtn").click();
        }
    });
</script>