@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.LoginViewModals
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
    var ar = CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    ViewData["Title"] = _localizer["Login"].Value;
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<div class="container store-auth">
    <div class="store-auth-card store-auth-narrow my-4">
        <h1 class="h3 fw-bold mb-2">@_localizer["Login"]</h1>
        <p class="text-secondary mb-4">@(ar ? "سجّل الدخول لإدارة طلباتك ومتابعة التسوق." : "Sign in to manage your orders and continue shopping.")</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@_localizer["Email"]</label>
                <input asp-for="Email" type="email" autocomplete="email" class="form-control" dir="ltr" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@_localizer["Password"]</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" autocomplete="current-password" class="form-control" required />
                    <button type="button" class="btn btn-outline-secondary" data-password-toggle="Password">@(ar ? "إظهار" : "Show")</button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="text-end mb-3"><button type="button" class="btn btn-link p-0" data-bs-toggle="modal" data-bs-target="#forgotPasswordModal">@_localizer["Forgot Password"]?</button></div>
            <button type="submit" class="btn btn-primary w-100 store-auth-submit">@_localizer["SignIn"]</button>
        </form>
        <div class="border-top mt-4 pt-3 text-center">
            @_localizer["Don't have an account"]? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">@_localizer["Create Account"]</a>
        </div>
    </div>
</div>
<div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-labelledby="resetTitle">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5" id="resetTitle">@_localizer["Reset Password"]</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@(ar ? "إغلاق" : "Close")"></button></div>
            <div class="modal-body store-auth">
                <p id="resetProgress" class="small fw-semibold text-primary"></p>
                <p id="resetMessage" class="small text-danger" role="status"></p>
                <form id="stepEmail">
                    <label for="fpEmail" class="form-label">@_localizer["Email"]</label>
                    <input type="email" id="fpEmail" autocomplete="email" class="form-control" required dir="ltr" />
                    <button type="submit" class="btn btn-primary w-100 mt-3">@_localizer["Send OTP"]</button>
                </form>
                <form id="stepOtp" hidden>
                    <p id="otpDestination" class="small text-secondary" dir="auto"></p>
                    <label for="fpOtp" class="form-label">@_localizer["Enter OTP"]</label>
                    <input id="fpOtp" class="form-control store-otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" required dir="ltr" />
                    <button type="submit" class="btn btn-primary w-100 mt-3">@_localizer["Verify OTP"]</button>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
                        <button type="button" class="btn btn-link p-0" id="resetBack">@(ar ? "تغيير البريد الإلكتروني" : "Change email")</button>
                        <button type="button" class="btn btn-link p-0" id="resendOtpBtn">@_localizer["Resend OTP"]</button>
                    </div>
                </form>
                <form id="stepReset" hidden>
                    <label for="fpNewPwd" class="form-label">@_localizer["New Password"]</label>
                    <div class="input-group mb-2"><input type="password" id="fpNewPwd" autocomplete="new-password" minlength="8" maxlength="50" required class="form-control" /><button type="button" class="btn btn-outline-secondary" data-password-toggle="fpNewPwd">@(ar ? "إظهار" : "Show")</button></div>
                    <p class="small text-secondary">@(ar ? "من 8 إلى 50 حرفًا." : "Use 8–50 characters.")</p>
                    <label for="fpConfirmPwd" class="form-label">@_localizer["Confirm Password"]</label>
                    <div class="input-group"><input type="password" id="fpConfirmPwd" autocomplete="new-password" required class="form-control" /><button type="button" class="btn btn-outline-secondary" data-password-toggle="fpConfirmPwd">@(ar ? "إظهار" : "Show")</button></div>
                    <button type="submit" class="btn btn-primary w-100 mt-3">@_localizer["Reset Password"]</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
(() => {
    const ar = document.documentElement.lang === "ar";
    const modal = document.getElementById("forgotPasswordModal");
    const forms = ["stepEmail","stepOtp","stepReset"].map(id=>document.getElementById(id));
    const email = document.getElementById("fpEmail");
    const otp = document.getElementById("fpOtp");
    const password = document.getElementById("fpNewPwd");
    const confirm = document.getElementById("fpConfirmPwd");
    const message = document.getElementById("resetMessage");
    const resend = document.getElementById("resendOtpBtn");
    const back = document.getElementById("resetBack");
    const resendLabel = resend.textContent.trim();
    let pending = false, timer, deadline = 0;
    const fallback = ar ? "تعذر إكمال الطلب. حاول مرة أخرى." : "Unable to complete request. Try again.";
    function step(n) {
        forms.forEach((form,i)=>form.hidden = i !== n);
        document.getElementById("resetProgress").textContent = (ar ? "الخطوة " : "Step ") + (n+1) + " / 3";
        message.textContent = "";
        forms[n].querySelector("input").focus();
    }
    function tick() {
        const seconds = Math.max(0, Math.ceil((deadline-Date.now())/1000));
        resend.disabled = pending || seconds > 0;
        resend.textContent = resendLabel + (seconds ? " ("+seconds+"s)" : "");
        if (!seconds) clearInterval(timer);
    }
    function busy(value) {
        pending=value;
        forms.forEach(form=>form.querySelectorAll("button[type=submit]").forEach(b=>b.disabled=value));
        back.disabled=value;
        tick();
    }
    async function post(action,data) {
        busy(true); message.textContent="";
        try {
            const res=await fetch("/UserAccount/"+action,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(data)});
            const result=await res.json();
            if(!res.ok||!result.success) throw new Error(result.message||fallback);
            return result;
        } catch(error) { message.textContent=error.message||fallback; return null; }
        finally { busy(false); }
    }
    async function send() {
        if(pending || !email.checkValidity()) return;
        const result=await post("SendOtp",{email:email.value.trim(),fp:"fp"});
        if(!result)return;
        otp.value="";
        document.getElementById("otpDestination").textContent=email.value.trim();
        step(1);
        clearInterval(timer); deadline=Date.now()+120000; tick(); timer=setInterval(tick,1000);
    }
    forms[0].addEventListener("submit",e=>{e.preventDefault();send();});
    resend.addEventListener("click",send);
    back.addEventListener("click",()=>{clearInterval(timer);deadline=0;step(0);});
    forms[1].addEventListener("submit",async e=>{
        e.preventDefault();if(pending)return;
        if(await post("VerifyOtpRegister",{email:email.value.trim(),otp:otp.value.trim()})){clearInterval(timer);step(2);}
    });
    forms[2].addEventListener("submit",async e=>{
        e.preventDefault();if(pending)return;
        if(password.value!==confirm.value){message.textContent=ar?"كلمات المرور غير متطابقة":"Passwords do not match";confirm.focus();return;}
        const result=await post("ResetPassword",{email:email.value.trim(),newPassword:password.value});
        if(result)location.href=result.redirectUrl||"/WebHome/Index";
    });
    otp.addEventListener("input",()=>otp.value=otp.value.replace(/[^0-9]/g,"").slice(0,6));
    modal.addEventListener("shown.bs.modal",()=>{forms.forEach(f=>f.reset());email.value=document.getElementById("Email").value;step(0);});
    modal.addEventListener("hide.bs.modal",e=>{if(pending)e.preventDefault();});
    modal.addEventListener("hidden.bs.modal",()=>{clearInterval(timer);deadline=0;forms.forEach(f=>f.reset());});
})();
</script>
