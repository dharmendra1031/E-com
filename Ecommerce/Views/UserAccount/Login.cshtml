@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.LoginViewModals
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
@{
    var culture = CultureInfo.CurrentCulture;
    bool isArabic = culture.TextInfo.IsRightToLeft;
}
<div class="container store-auth">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 col-xl-5">

            <div class="store-auth-card text-center my-3 my-md-5">
                <a asp-controller="WebCheckout"
                   asp-action="Index"
                   asp-route-Usertype="Guest"
                   class="btn btn-outline-secondary btn-lg w-100 fw-semibold rounded-3 mb-4 d-none">
                    @_localizer["Continue Without Login"]
                </a>

                <h2 class="fw-semibold mb-4">@_localizer["Login"]</h2>

                <form asp-action="Login" method="post" id="NavigationKey">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="text-danger text-center fw-normal">
                          @Html.ValidationSummary(false, "", new { @class = "mb-0 list-unstyled fw-normal" })
                        </div>
                    }


                    <input type="hidden" asp-for="ReturnUrl" />
                    <!-- Email -->
                    <div class="form-floating mb-3">
                        <input asp-for="Email"
                               class="form-control form-control-lg bg-white rounded-3"
                               id="Email"
                               placeholder="@_localizer["Email"]">
                        <label asp-for="Email">@_localizer["Email"]</label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="form-floating mb-4">
                        <input asp-for="Password"
                               class="form-control form-control-lg bg-white rounded-3"
                               type="password"
                               id="Password"
                               placeholder="@_localizer["Password"]">
                        <label asp-for="Password">@_localizer["Password"]</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>


                    <!-- Submit Button -->
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 fw-semibold rounded-3">
                        @_localizer["SignIn"]
                    </button>
                </form>

                <div class="mt-3 text-center">
                    <p>
                        <a href="javascript:void(0);" class="text-decoration-none" onclick="openForgotModal()">
                            @_localizer["Forgot Password"] ?
                        </a>
                    </p>
                </div>
                <div class="mt-3 text-center">
                    <p>
                        @_localizer["Don't have an account"]?<a class="text-decoration-none" asp-action="Register"
                                                 asp-route-returnUrl="@Model.ReturnUrl">
                            @_localizer["Create Account"]
                        </a>
                    </p>
                </div>

                <div class="d-flex justify-content-center gap-3 mt-4">
                    @if (Model.CompanyDetails != null && Model.CompanyDetails.Any())
                    {
                        var company = Model.CompanyDetails.First(); // agar ek hi company use karna ho

                        @* Facebook *@
                        @if (!string.IsNullOrEmpty(company.FacebookUrl))
                        {
                            <a href="@company.FacebookUrl" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        }

                        @* Instagram *@
                        @if (!string.IsNullOrEmpty(company.InstagramUrl))
                        {
                            <a href="@company.InstagramUrl" class="btn btn-danger rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-instagram"></i>
                            </a>
                        }

                        @* Twitter *@
                        @if (!string.IsNullOrEmpty(company.TwitterUrl))
                        {
                            <a href="@company.TwitterUrl" class="btn btn-info rounded-circle text-white d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-twitter"></i>
                            </a>
                        }

                        @* LinkedIn *@
                        @if (!string.IsNullOrEmpty(company.LinkedInUrl))
                        {
                            <a href="@company.LinkedInUrl" class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center"
                               style="width:44px; height:44px;">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                        }
                    }
                </div>

            </div>

        </div>
    </div>
</div>
<div class="modal fade" id="forgotPasswordModal" tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <!-- Header -->
            <div class="modal-header justify-content-between" style="background-color:#337ab7;color:#fff;">
                <h4 class="modal-title">@_localizer["Reset Password"]</h4>
                <button type="button" class="close btn btn-sm border-0 bg-transparent text-white" data-bs-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>

            <div class="modal-body px-4 py-3">

                <!-- STEP 1: EMAIL -->
                <div id="stepEmail">
                    <label><strong>@_localizer["Recover via"]</strong></label>
                    <div class="mb-3">
                        <label class="me-3">
                            <input type="radio" name="fpMethod" value="email" checked onchange="toggleRecoveryMode()"> 
                            @_localizer["Email"]
                        </label>

                        <label>
                            <input type="radio" name="fpMethod" value="mobile" onchange="toggleRecoveryMode()"> 
                            @_localizer["Mobile"]
                        </label>
                    </div>

                    <!-- Email -->
                    <div id="emailBox">
                        <input type="email" id="fpEmail" class="form-control" placeholder="Enter registered email" />
                    </div>

                    <!-- Mobile -->
                    <div id="mobileBox" style="display:none;">
                        <input type="tel" id="fpMobileNo" class="form-control" placeholder="Enter registered mobile number" />
                    </div>

                    <button class="btn btn-primary mt-3 w-100" onclick="sendOtp()">
                        @_localizer["Send OTP"]
                    </button>
                </div>

                <!-- STEP 2: OTP -->
                <div id="stepOtp" style="display:none;">
                    <label><strong>@_localizer["Enter OTP"]</strong></label>
                    <input type="text" id="fpOtp" class="form-control" />
                    <div class="d-flex justify-content-between mt-2">
                        <small id="otpTimer" style="color:#666;"></small>
                        <a href="javascript:void(0);" id="resendOtpBtn"
                           style="display:none; cursor:pointer;"
                           onclick="resendOtp()">
                            @_localizer["Resend OTP"]
                        </a>
                    </div>
                    <button class="btn btn-primary mt-3 w-100" onclick="verifyOtp()">
                        @_localizer["Verify OTP"]
                    </button>
                </div>

                <!-- STEP 3: RESET PASSWORD -->
                <div id="stepReset" style="display:none;">
                    <label><strong>@_localizer["New Password"]</strong></label>
                    <div class="input-group mb-2">
                        <input type="password" id="fpNewPwd" class="form-control" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" onclick="togglePassword('fpNewPwd', this)">
                                <i class="fa fa-eye"></i>
                            </button>
                        </span>
                    </div>

                    <label><strong>@_localizer["Confirm Password"]</strong></label>
                    <div class="input-group">
                        <input type="password" id="fpConfirmPwd" class="form-control" />
                        <span class="input-group-btn">
                            <button class="btn btn-default" type="button" onclick="togglePassword('fpConfirmPwd', this)">
                                <i class="fa fa-eye"></i>
                            </button>
                        </span>
                    </div>

                    <button class="btn btn-success mt-3 w-100" onclick="resetPassword()">
                        @_localizer["Reset Password"]
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    const fpEmail = document.getElementById("fpEmail");
    const fpOtp = document.getElementById("fpOtp");
    const fpNewPwd = document.getElementById("fpNewPwd");
    const fpConfirmPwd = document.getElementById("fpConfirmPwd");

    function openForgotModal() {
        // reset steps
        document.getElementById("stepEmail").style.display = "block";
        document.getElementById("stepOtp").style.display = "none";
        document.getElementById("stepReset").style.display = "none";

        // clear values
        fpEmail.value = "";
        fpOtp.value = "";
        fpNewPwd.value = "";
        fpConfirmPwd.value = "";

        clearInterval(otpInterval);
        document.getElementById("otpTimer").innerText = "";
        document.getElementById("resendOtpBtn").style.display = "none";

        $('#forgotPasswordModal')
            .one('shown.bs.modal', function () {
                fpEmail.focus(); // focus email first
            })
            .modal('show');
    }

    function sendOtp() {
        const email = fpEmail.value.trim();
        const mobile = document.getElementById("fpMobileNo").value.trim();

        if (!email && !mobile) {
            Swal.fire("Warning", "Enter email or mobile number", "warning");
            return;
        }

        // if (email && !/^\S+\S+\.\S+$/.test(email)) {
        //     Swal.fire("Error", "Invalid email format", "error");
        //     return;
        // }

        // if (mobile && !/^[0-9]{8,15}$/.test(mobile)) {
        //     Swal.fire("Error", "Invalid mobile number", "error");
        //     return;
        // }

        fetch('/UserAccount/SendOtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email: email || null,
                mobile: mobile || null,
                fp: 'fp' // forgot password
            })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire("Success", data.message, "success");

                document.getElementById("stepEmail").style.display = "none";
                document.getElementById("stepOtp").style.display = "block";

                startOtpTimer();
                setTimeout(() => fpOtp.focus(), 300);
            } else {
                Swal.fire("Error", data.message, "error");
            }
        });
    }

    function resendOtp() {
        sendOtp(); // reuse same function
    }

    function verifyOtp() {
        const email = fpEmail.value;
        const otp = fpOtp.value;

        if (!otp) {
            Swal.fire("Warning", "Enter OTP", "warning");
            fpOtp.focus();
            return;
        }

        fetch('/UserAccount/VerifyOtpRegister', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, otp: otp })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                Swal.fire("Success", data.message, "success");

                document.getElementById("stepOtp").style.display = "none";
                document.getElementById("stepReset").style.display = "block";

                setTimeout(() => fpNewPwd.focus(), 300); // focus new password
            } else {
                Swal.fire("Error", data.message, "error");
                fpOtp.focus();
            }
        });
    }

    function resetPassword() {
        const email = fpEmail.value;
        const pwd = fpNewPwd.value;
        const confirm = fpConfirmPwd.value;

        if (!pwd || !confirm) {
            Swal.fire("Warning", "Fill all fields", "warning");
            return;
        }

        if (pwd !== confirm) {
            Swal.fire("Error", "Passwords do not match", "error");
            fpConfirmPwd.focus();
            return;
        }

        fetch('/UserAccount/ResetPassword', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, newPassword: pwd })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Swal.fire("Success", "Password reset successful", "success");
                // $('#forgotPasswordModal').modal('hide');
                Swal.fire("Success", "Password reset successful", "success")
                .then(() => {
                    window.location.href = data.redirectUrl; // auto redirect
                });
            } else {
                Swal.fire("Error", data.message, "error");
            }
        });
    }

    // Email → Send OTP
    fpEmail.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            sendOtp();
        }
    });

    // OTP → Verify
    fpOtp.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            verifyOtp();
        }
    });

    // New Password → Move to Confirm
    fpNewPwd.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            fpConfirmPwd.focus();
        }
    });

    // Confirm Password → Submit
    fpConfirmPwd.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {
            e.preventDefault();
            resetPassword();
        }
    });

    // let otpInterval;
    // let otpTimeLeft = 120;
     
    // function startOtpTimer() {
    //     otpTimeLeft = 120;

    //     document.getElementById("resendOtpBtn").style.display = "none";

    //     otpInterval = setInterval(() => {
    //         document.getElementById("otpTimer").innerText =
    //             `Resend in ${otpTimeLeft}s`;

    //         otpTimeLeft--;

    //         if (otpTimeLeft < 0) {
    //             clearInterval(otpInterval);
    //             document.getElementById("otpTimer").innerText = "";
    //             document.getElementById("resendOtpBtn").style.display = "inline";
    //         }
    //     }, 1000);
    // }
        let otpInterval;
    let otpTimeLeft = 119; // 1:59 se start

    function startOtpTimer() {
        otpTimeLeft = 119;

        document.getElementById("resendOtpBtn").style.display = "none";

        otpInterval = setInterval(() => {

            let minutes = Math.floor(otpTimeLeft / 60);
            let seconds = otpTimeLeft % 60;

            let formattedTime =
                `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;

            document.getElementById("otpTimer").innerText =
                `Resend in ${formattedTime}`;

            otpTimeLeft--;

            if (otpTimeLeft < 0) {
                clearInterval(otpInterval);
                document.getElementById("otpTimer").innerText = "";
                document.getElementById("resendOtpBtn").style.display = "inline";
            }

        }, 1000);
    }

    function togglePassword(id, btn) {
        const input = document.getElementById(id);
        const icon = btn.querySelector("i");

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }

    $('#forgotPasswordModal').on('hidden.bs.modal', function () {
        clearInterval(otpInterval);
    });

function toggleRecoveryMode() {
    const method = document.querySelector('input[name="fpMethod"]:checked').value;

    if (method === "email") {
        document.getElementById("emailBox").style.display = "block";
        document.getElementById("mobileBox").style.display = "none";
    } else {
        document.getElementById("emailBox").style.display = "none";
        document.getElementById("mobileBox").style.display = "block";
    }
}
</script>