@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.ViewModels.WekendDealsViewModel>

@{
    ViewData["Title"] = "Weekend Deals List";
}

<div id="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">

                <!-- HEADER + ADD BUTTON -->
                <form id="filterForm" class="form-inline mb-3" style="margin-bottom: 11px;">
                    <div class="row">
                        <div class="col-md-6" id="NavigationKey">
                            <div class="form-group me-3" style="margin-right: 20px; position:relative;">
                                <label for="name" class="me-1" style="margin-right: 5px;">@_localizer["Name"]:</label>
                                <input type="text"
                                       id="name"
                                       name="name"
                                       class="form-control"
                                       autocomplete="off"
                                       value="@ViewBag.FilterName" />
                                <ul id="suggestions" style="display:none;
                                position:absolute;
                                background:white;
                                list-style:none;
                                padding:0;
                                margin:0;
                                width:100%;  /* width same as input */
                                max-height:200px;
                                overflow-y:auto;
                                border:1px solid #ccc;
                                z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>


                            @*<div class="form-group me-3">
                                <label for="status" class="me-1">@_localizer["Status"]:</label>
 
                                <select id="status" name="status" class="form-control" style="width: 150px; display: inline-block;">
                                    <option value="" selected="@(ViewBag.FilterStatus == null ? "selected" : "")"></option>
                                    <option value="1" selected="@(ViewBag.FilterStatus?.ToString() == "1")">@_localizer["Active"]</option>
                                    <option value="0" selected="@(ViewBag.FilterStatus?.ToString() == "0")">@_localizer["Inactive"]</option>
                                </select> 
                            </div>*@
                            <div class="form-group ms-3">
                                <button type="submit" class="btn btn-primary me-2" onclick="submitFilter()">@_localizer["Search"]</button>
                            </div>
                        </div>
                        <div class="col-md-6 d-flex justify-content-end">
                            <div class="card-header-right-icon">
                                <a asp-controller="WekendDeals" asp-action="CreateDeals" class="btn btn-primary">
                                    <i class="ti-bar-chart-alt me-1"></i> @_localizer["Add Wekend Deals"]
                                </a>
                            </div>
                        </div>

                    </div>
                </form>

                <!-- TABLE -->
                <div class="card-body" style="overflow-y:auto; height:70vh">
                    @{
                        int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                    }
                    <table class="table table-hover">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white;">
                            <tr>
                                <th class="text-center">@_localizer["SN"]</th>
                                <th class="text-center">@_localizer["ID"]</th>
                                <th class="text-center">@_localizer["Name"]</th>
                                <th class="text-center">@_localizer["Max Quantity"]</th>
                                <th class="text-center">@_localizer["Discount %"]</th>
                                <th class="text-center">@_localizer["From Date"]</th>
                                <th class="text-center">@_localizer["To Date"]</th>
                             
                                <th class="text-center">@_localizer["Action"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">@serial</td>
                                    <td class="text-center">@item.WdId</td>

                                    <td class="text-center">@item.WdNameEn</td>
                                    <td class="text-center">@item.MaxQuantity</td>
                                    <td class="text-center">@item.DiscPer %</td>
                                    <td class="text-center">@(item.FromDate?.ToString("dd-MM-yyyy") ?? "")</td>
                                    <td class="text-center">@(item.ToDate?.ToString("dd-MM-yyyy") ?? "")</td>

                                 
                               

                                    <td class="text-center">

                                        <a asp-action="CreateDeals" asp-controller="WekendDeals" asp-route-id="@item.WdId" class="btn btn-sm btn-primary me-1">
                                            <i class="ti-pencil"></i>
                                        </a>

                                        <button class="btn btn-sm btn-danger" onclick="deleteDeal(@item.WdId)">
                                            <i class="ti-trash"></i>
                                        </button>

                                    </td>
                                </tr>
                                serial++;
                            }
                        </tbody>
                    </table>

                    <!-- PAGINATION -->
                    <div class="text-center">
                        <ul class="pagination justify-content-center">

                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="WekendDealsList" asp-route-page="1" asp-route-name="@ViewBag.FilterName">@_localizer["First"]</a>
                            </li>

                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="WekendDealsList" asp-route-page="@(Model.PageNumber - 1)" asp-route-name="@ViewBag.FilterName">
                                    @_localizer["Previous"]
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="WekendDealsList" asp-route-page="@i" asp-route-name="@ViewBag.FilterName">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="WekendDealsList" asp-route-page="@(Model.PageNumber + 1)" asp-route-name="@ViewBag.FilterName">
                                    @_localizer["Next"]
                                </a>
                            </li>

                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="WekendDealsList" asp-route-page="@Model.TotalPages" asp-route-name="@ViewBag.FilterName">
                                    @_localizer["Last"]
                                </a>
                            </li>

                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function deleteDeal(id) {
            if (!confirm("Are you sure you want to delete this Weekend Deal?")) return;

            $.ajax({
                url: '/WekendDeals/Delete/' + id,
                type: 'POST',
                success: function () {
                    alert("Weekend Deal deleted successfully!");
                    location.reload();
                },
                error: function () {
                    alert("Failed to delete Weekend Deal.");
                }
            });
        }


           $(document).ready(function () {

            function fetchCategorySuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/WekendDeals/AutoCompletedeal',
                    type: 'GET',
                    data: { term: query },
                    success: function(data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item)
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item);
                                        $suggestionBox.hide();
                                        $('#name').focus();
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            $('#name').on('input', function() {
                fetchCategorySuggestions($(this).val());
            });

            enableSuggestionNavigation('#name', '#suggestions');

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });
    </script>
}
