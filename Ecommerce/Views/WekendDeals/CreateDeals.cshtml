                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Deal Name (EN)"] <span style="color:red">*</span></label>
                                        <input asp-for="WdNameEn" class="form-control input-default" />
                                        <span asp-validation-for="WdNameEn" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>



                            <!-- Row 2 -->
                            <div class="row">
                                @*  <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Select Product"] <span style="color:red">*</span></label>
                                        <select asp-for="ProductId" class="form-control input-default"
                                                asp-items="@(new SelectList(ViewBag.Products, "Value", "Text"))">
                                            <option value=""></option>
                                        </select>
                                        <span asp-validation-for="ProductId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Price"] <span style="color:red">*</span></label>
                                        <input  id="DiscPer" class="form-control input-default"readonly
                                               onkeypress="return ValidAmount(event, this);" maxlength="8" />
                                        <span asp-validation-for="DiscPer" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Discount (%)"] <span style="color:red">*</span></label>
                                        <input asp-for="DiscPer" id="DiscPer" class="form-control input-default"
                                               onkeypress="return ValidAmount(event, this);" maxlength="8" />
                                        <span asp-validation-for="DiscPer" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Discount Price"] <span style="color:red">*</span></label>
                                        <input  id="DiscPer" class="form-control input-default"readonly
                                               onkeypress="return ValidAmount(event, this);" maxlength="8" />
                                        <span asp-validation-for="DiscPer" class="text-danger"></span>
                                    </div>
                                </div> *@
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="fw-bold">@_localizer["Select Product"] <span style="color:red">*</span></label>
                                        <select asp-for="ProductId" class="form-control input-default" id="ProductId"
                                                asp-items="@(new SelectList(ViewBag.Products, "Value", "Text"))">
                                            <option value=""></option>
                                        </select>
                                        <span asp-validation-for="ProductId" class="text-danger"></span>
