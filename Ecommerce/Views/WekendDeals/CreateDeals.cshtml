<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker3.min.css" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        // PAGE LOAD → Discount textbox default me empty
        $(document).ready(function () {
            let disc = $("#DiscPer").val();

            if (disc == "0" || disc == "0.00" || disc == "0.0") {
                $("#DiscPer").val("");
            }
        });

        // PRODUCT SELECT → Load Price
        $("#ProductId").change(function () {
            var productId = $(this).val();

            if (productId) {
                $.ajax({
                    url: '/WekendDeals/GetProductPrice',
                    type: 'GET',
                    data: { id: productId },
                    success: function (price) {

                        $("#Price").val(price);

                        // Discount empty → discount price = original price
                        if ($("#DiscPer").val().trim() === "") {
                            $("#DiscountPrice").val(price);
                        } else {
                            calculateDiscount();
                        }
                    }
                });
            } else {
                $("#Price").val('');
                $("#DiscountPrice").val('');
            }
        });

        // DISCOUNT INPUT → Validation + auto calculate
        $("#DiscPer").on("input", function () {
            let disc = $(this).val();
            let price = parseFloat($("#Price").val());

            // empty → discount price = original price
            if (disc === "" || disc === null) {
                $("#DiscountPrice").val(price ? price.toFixed(2) : "");
                return;
            }

            // > 100 not allowed
            if (parseFloat(disc) > 100) {
                $(this).val("");
                $("#DiscountPrice").val(price ? price.toFixed(2) : "");
                return;
            }

            calculateDiscount();
        });

        // CALCULATE DISCOUNT
        function calculateDiscount() {
            var price = parseFloat($("#Price").val());
            var disc = parseFloat($("#DiscPer").val());

            if (!isNaN(price) && !isNaN(disc)) {
                var discountAmount = (price * disc) / 100;
                var discountedPrice = price - discountAmount;
                $("#DiscountPrice").val(discountedPrice.toFixed(2));
            }
        }

        // FINAL SUBMIT VALIDATION → Discount > 0 required
               $(document).ready(function () {
            $("#DealsForm").on("submit", function (e) {
                let discValue = $("#DiscPer").val().trim();
                let disc = parseFloat(discValue);
                let errorSpan = $("span[data-valmsg-for='DiscPer']");

                errorSpan.text("");
                errorSpan.removeClass("field-validation-valid")
                         .addClass("field-validation-error");

                if (discValue === "" || isNaN(disc) || disc <= 0) {
                    e.preventDefault();
                    errorSpan.text("Discount must be greater than 0.");
                    return false;
                }

                return true;
            });
        });

    </script>




    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>

    <script>

        $(function () {

            // Start Date Picker

            $('#startDate').datepicker({

                format: 'dd-mm-yyyy',

                autoclose: true,

                todayHighlight: true,

                clearBtn: true,

                orientation: "bottom auto",

                startDate: new Date()   // ✅ only today or future dates allowed

            }).on('changeDate', function (e) {

                // StartDate select hone ke baad EndDate ki min date set ho jaye

                $('#endDate').datepicker('setStartDate', e.date);

            });

            // End Date Picker

            $('#endDate').datepicker({

                format: 'dd-mm-yyyy',

                autoclose: true,

                todayHighlight: true,

                clearBtn: true,

                orientation: "bottom auto"

            }).on('changeDate', function (e) {

                // EndDate select hone ke baad StartDate ki max date set ho jaye

                $('#startDate').datepicker('setEndDate', e.date);

            });

            // ----------- EDIT MODE FIX -----------

            const fromVal = $('#startDate').val();

            const toVal = $('#endDate').val();

            if (fromVal) {

                const fromParts = fromVal.split("-");

                if (fromParts.length === 3) {

                    const fromDate = new Date(fromParts[2], fromParts[1] - 1, fromParts[0]);

                    $('#endDate').datepicker('setStartDate', fromDate);

                }

            }

            if (toVal) {

                const toParts = toVal.split("-");

                if (toParts.length === 3) {

                    const toDate = new Date(toParts[2], toParts[1] - 1, toParts[0]);

                    $('#startDate').datepicker('setEndDate', toDate);

                }

            }

        });
    </script>
    <script>
        $("#DealsForm").on("submit", function (e) {

            let disc = parseFloat($("#DiscPer").val());
            let errorSpan = $("span[data-valmsg-for='DiscPer']");


            errorSpan.text("");

            if (disc === 0 || disc < 0 || isNaN(disc)) {
                e.preventDefault();


                errorSpan.text("Discount must be greater than 0.");

                return false;
            }

            return true;
        });
    </script>



}
