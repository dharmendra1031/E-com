@model EcommerceWebApplication.Models.ViewModels.VendorListingsPage
@{
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    string T(string en, string arabic) => ar ? arabic : en;
    string Status(string status) => status switch { "Approved" => T("Approved","معتمد"), "Inactive" => T("Inactive","غير نشط"), _ => T("Pending","قيد المراجعة") };
}
<h2>@Model.VendorName — @T("Listings", "العروض")</h2>
<a asp-action="@(Model.IsAdmin ? "Index" : "Dashboard")" asp-route-id="@Model.VendorId" class="btn btn-default">@T("Back","رجوع")</a>
@if (Model.CanEdit)
{
    <a asp-action="Catalog" asp-route-id="@Model.VendorId" class="btn btn-primary">@T("Add from catalog","إضافة من الكتالوج")</a>
}
<form asp-action="Listings" asp-route-id="@Model.VendorId" method="get" class="form-inline">
    <label for="search">@T("Search","بحث")</label>
    <input id="search" name="search" value="@Model.Search" class="form-control" />
    <button class="btn btn-primary" type="submit">@T("Search","بحث")</button>
</form>
<div class="table-responsive">
<table class="table table-hover">
<thead><tr><th>@T("Product","المنتج")</th><th>SKU</th><th>@T("Price","السعر")</th><th>@T("Status","الحالة")</th><th>@T("Action","الإجراء")</th></tr></thead>
<tbody>
@if (Model.Rows.Count == 0) { <tr><td colspan="5">@T("No listings","لا توجد عروض")</td></tr> }
@foreach (var row in Model.Rows)
{
    <tr><td>@(ar ? row.ProductNameArb : row.ProductName) @if (!row.ProductActive) { <span> (@T("Product inactive","المنتج غير نشط"))</span> }</td>
        <td>@row.SellerSku</td><td>@row.Price.ToString("F3")</td><td>@Status(row.Status)</td>
        <td>
        @if (Model.CanEdit && row.ProductActive)
        {
            <a asp-action="EditListing" asp-route-id="@Model.VendorId" asp-route-listingId="@row.ListingId" class="btn btn-sm btn-primary">@T("Edit","تعديل")</a>
        }
        @if (Model.IsAdmin)
        {
            <form asp-action="ChangeListingStatus" asp-route-id="@Model.VendorId" method="post">
                <input type="hidden" name="listingId" value="@row.ListingId" />
                <input type="hidden" name="version" value="@Convert.ToBase64String(row.RowVersion)" />
                @if (row.Status != "Approved" && row.ProductActive) { <button type="submit" name="status" value="Approved" class="btn btn-sm btn-primary">@T("Approve","اعتماد")</button> }
                @if (row.Status != "Inactive") { <button type="submit" name="status" value="Inactive" class="btn btn-sm btn-default">@T("Deactivate","إلغاء التنشيط")</button> }
            </form>
        }
        </td></tr>
}
</tbody></table>
</div>
<nav>
@if (Model.Page > 1) { <a asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)" class="btn btn-default">@T("Previous","السابق")</a> }
<span>@Model.Page</span>
@if (Model.HasNext) { <a asp-action="Listings" asp-route-id="@Model.VendorId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)" class="btn btn-default">@T("Next","التالي")</a> }
</nav>
<p>@T("Listing approval does not enable customer sales yet.","اعتماد العرض لا يتيح البيع للعملاء بعد.")</p>
