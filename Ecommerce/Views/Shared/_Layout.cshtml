    <script>

        async function loadNotificationCount() {
            try {
                const countRes = await fetch('/api/EcommerceApi/GetNotificationCount');
                const countData = await countRes.json();
                document.getElementById('notificationCountBadge').innerText =
                    countData.unseenCount > 0 ? countData.unseenCount : '';
            } catch (err) {
                console.error('Error loading notification count:', err);
            }
        }


        async function loadNotifications() {
            try {
                const res = await fetch('/api/EcommerceApi/GetNewOrders');
                const data = await res.json();

                const list = document.getElementById('notificationList');
                list.innerHTML = ''; // Clear existing items

                if (data.length === 0) {
                    list.innerHTML = '<li class="text-center">No new notifications</li>';
                    return;
                }

                data.forEach(order => {
                    const li = document.createElement('li');
                    li.innerHTML = `

                        <a href="#">
                            <img class="pull-left m-r-10 avatar-img" src="assets/images/avatar/3.jpg" alt="" />
                            <div class="notification-content">
                                      <small class="notification-timestamp pull-right">
                                     ${new Date(order.createdAt).toLocaleTimeString('en-US', {
                                       hour: 'numeric',
                                       minute: '2-digit',
                                       hour12: true
                                       })}
                                      </small>
    
                                <div class="notification-heading">Order #${order.orderId}</div>
                                <div class="notification-text">
                                  New Order Received from ${order.fullName}
                                </div>
                                 <div class="notification-text" style="display: flex; justify-content: space-between;">
                                <span class="notification-heading">Total Amount: ${order.totalAmount.toFixed(3)} KD</span>
                                <span style="color: ${order.paymentMode === 'cod' ? 'crimson' : 'green'}; font-weight: bold;">
                                  ${order.paymentType}
                                </span>
                                </div>


                            </div>
                        </a>
                    `;
                    list.appendChild(li);
                });

        const seeAll = document.createElement('li');
        seeAll.classList.add('text-center');
        seeAll.style.cssText = `
            background-color: #f8f9fa;
            padding: 10px;
            cursor: pointer;
            border-top: 1px solid #ddd;
            font-weight: bold;
            transition: background-color 0.2s ease;
        `;
        seeAll.innerText = 'See All';

        // Hover effect (optional, looks nice)
        seeAll.addEventListener('mouseenter', () => {
            seeAll.style.backgroundColor = '#e9ecef';
        });
        seeAll.addEventListener('mouseleave', () => {
            seeAll.style.backgroundColor = '#f8f9fa';
        });

        // Make the entire <li> clickable
        seeAll.addEventListener('click', () => {
            window.location.href = '/ManageOrders/PendingOrder';
        });

        list.appendChild(seeAll);


            } catch (err) {
                console.error('Error loading notifications:', err);
            }
        }


        document.addEventListener('DOMContentLoaded', () => {
            loadNotificationCount();
            loadNotifications();
        });
               

            // ⏱️ Set interval to refresh every 15 seconds
            setInterval(() => {
                loadNotificationCount();
                //loadNotifications();
            }, 5000); // 15000 milliseconds = 15 seconds


               document.getElementById('notificationDropdown').addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
                loadNotifications();
                // Mark all as seen but don't reload notification list immediately
                const seenResponse = await fetch('/api/EcommerceApi/MarkNotificationsAsSeen', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
                });
                if (!seenResponse.ok) throw new Error('Notification update failed');
                document.getElementById('notificationCountBadge').innerText = '';
                // Dropdown content should remain visible — so no loadNotifications() here
            } catch (err) {
                console.error('Error marking notifications as seen:', err);
            }
        });

        // When dropdown closes (click outside)
        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('notificationDropdown');
            if (dropdown.classList.contains('show') && !dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
                // Reload notifications when dropdown is closed
                loadNotifications();
            }
        });

       
    </script>
    }


