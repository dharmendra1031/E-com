    <script>
        $(document).ready(function () {
            let layoutDir = document.documentElement.dir || "ltr";

            // Set direction
            document.body.setAttribute("dir", layoutDir);

            // Apply CSS
            const rtlLink = document.getElementById("rtlStyles");
            if (layoutDir === "rtl") {
                rtlLink.setAttribute("href", "/AdminTheame/assets/css/rtl.css");
            } else {
                rtlLink.setAttribute("href", "");
            }
        });
        // 🟢 Helper: Get cookie value
        // function getCookie(name) {
        // 	let match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        // 	return match ? match[2] : null;
        // }
        function getCookie(name) {
            let value = `; ${document.cookie}`;
            let parts = value.split(`; ${name}=`);
            return parts.length === 2 ? parts.pop().split(';').shift() : null;
        }

        // 🟢 On page load, set direction from cookie
        document.addEventListener("DOMContentLoaded", function () {
            let layoutDir = document.documentElement.dir || "ltr";
            document.body.setAttribute("dir", layoutDir);

            if (layoutDir === 'rtl') {
                document.getElementById("rtlStyles").setAttribute("href", "/AdminTheame/assets/css/rtl.css");
            }

            // 🔒 Prevent duplicate click handlers
            const toggleButton = document.querySelector(".toggleRTL");
            if (toggleButton) {
                toggleButton.addEventListener("click", manageLayoutDirection, { once: true }); // ❗Run only once
            }
        });

        // 🔄 Toggle between RTL and LTR
        function manageLayoutDirection() {
                let cultureText = document.querySelector(".toggleRTL .user-avatar")?.innerText.trim().toLowerCase() || "en";
            let newCulture = (cultureText === "ar" || cultureText === "ar-kw") ? "en" : "ar";
            let newDirection = newCulture.startsWith("ar") ? "rtl" : "ltr";

            // Set cookie only — server will handle layout + reload
            document.cookie = "LayoutDirection=" + newDirection + "; path=/";

            // Redirect to change culture and re-render correctly
            let returnUrl = window.location.pathname + window.location.search;
            window.location.href = `/Home/SetLanguage?culture=${newCulture}&returnUrl=${encodeURIComponent(returnUrl)}`;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const current = location.pathname.replace(/\/$/, "").toLowerCase();
            document.querySelectorAll(".sidebar a[href]").forEach(link => {
                if (link.getAttribute("href").startsWith("javascript:")) return;
                if (new URL(link.href, location.origin).pathname.replace(/\/$/, "").toLowerCase() === current) {
                    link.setAttribute("aria-current","page");
                    link.parentElement.classList.add("active");
                }
            });
        });

        // Sidebar active  end 

    </script>
   
    <script>
        $(document).ready(function () {
            $(".sidebar-sub-toggle > a").click(function (e) {
                e.preventDefault();

                var $parent = $(this).parent("li");
                var $submenu = $parent.find("ul.sidebar-submenu").first();

             
                $(".sidebar-submenu").not($submenu).slideUp(200);
                $(".sidebar-sub-toggle").not($parent).removeClass("active");

             
                $submenu.slideToggle(200);
                $parent.toggleClass("active");
            });
        });
    </script>

