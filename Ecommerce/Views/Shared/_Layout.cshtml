    <script>
           function enableSuggestionNavigation(inputSelector, suggestionBoxSelector, nextInputSelector) {
            let selectedIndex = -1;

            const $input = $(inputSelector);
            const $suggestionBox = $(suggestionBoxSelector);

            $input.on('keydown', function (e) {
                const items = $suggestionBox.find('li');
                if (items.length === 0) return;

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedIndex = (selectedIndex + 1) % items.length;
                    items.removeClass('selected').css('background-color', '');
                    items.eq(selectedIndex).addClass('selected').css('background-color', 'var(--theme-tint)');
                    scrollIntoView(items.eq(selectedIndex), $suggestionBox);
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedIndex = (selectedIndex - 1 + items.length) % items.length;
                    items.removeClass('selected').css('background-color', '');
                    items.eq(selectedIndex).addClass('selected').css('background-color', 'var(--theme-tint)');
                    scrollIntoView(items.eq(selectedIndex), $suggestionBox);
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedIndex >= 0) {
                        $input.val(items.eq(selectedIndex).text());
                    }
                    $suggestionBox.hide();
                    if (nextInputSelector) $(nextInputSelector).focus();
                }
            });

            // Ensure selected item is visible when navigating
            function scrollIntoView($item, $container) {
                const itemTop = $item.position().top;
                const itemBottom = itemTop + $item.outerHeight();
                const containerScrollTop = $container.scrollTop();
                const containerHeight = $container.height();

                if (itemBottom > containerHeight) {
                    $container.scrollTop(containerScrollTop + (itemBottom - containerHeight));
                } else if (itemTop < 0) {
                    $container.scrollTop(containerScrollTop + itemTop);
                }
            }
        }
    </script>
    <script>
        window.onload = function () {
            const form = document.querySelector("#NavigationKey");
            if (!form) return;

            const getFocusables = () => Array.from(
                form.querySelectorAll("input, select, textarea, button[type='submit'], input[type='submit']")
            ).filter(el =>
                !el.disabled &&
                !el.readOnly &&
                el.type !== "hidden" &&
                el.offsetParent !== null
            );

            let focusables = getFocusables();


            if (focusables.length > 0) {
                setTimeout(() => {
                    focusables[0].focus();
                    focusables[0].scrollIntoView({ behavior: "smooth", block: "center" });
                }, 100);
            }

            focusables.forEach((el, index) => {
                el.addEventListener("keydown", function (e) {
                            if (el.tagName.toLowerCase() === "textarea") {
            if (e.key === "Enter" && e.shiftKey) {
                // Allow new line inside textarea
                return; // Do nothing, normal newline
            }
        }

                    const goNext = () => {
                        if (index + 1 < focusables.length) {
                            // Next focusable
                            focusables[index + 1].focus();
                            focusables[index + 1].scrollIntoView({ behavior: "smooth", block: "center" });
                        } else {

                            if (el.tagName.toLowerCase() === "button" || el.type === "submit") {
                                el.click();
                            }
                        }
                        e.preventDefault();
                    };

                    const goPrev = () => {
                        if (index - 1 >= 0) {
                            focusables[index - 1].focus();
                            focusables[index - 1].scrollIntoView({ behavior: "smooth", block: "center" });
                            e.preventDefault();
                        }
                    };

                    if (e.key === "ArrowRight" || e.key === "Enter") {
                        goNext();
                    } else if (e.key === "ArrowLeft") {
                        goPrev();
                    }
                });
            });


            form.addEventListener("submit", function () {
                setTimeout(() => {
                    focusables = getFocusables();
                    if (focusables.length > 0) {
                        focusables[0].focus();
                    }
                }, 100);
            });
        };
    </script>

 
