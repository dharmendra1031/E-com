@inject Microsoft.Extensions.Configuration.IConfiguration PortalConfiguration
@inject EcommerceWebApplication.Data.EcommerceDbContext BrandingDb
@inject EcommerceWebApplication.Helper.VendorPortalAccess PortalAccess
@using EcommerceWebApplication.Models
@using EcommerceWebApplication.Helper

@{
    Layout = null;
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
    var branding = await EcommerceWebApplication.Helper.CompanyBranding.ReadAsync(BrandingDb, ar);
    string T(string en,string arabic) => ar ? arabic : en;
    var signedIn = User.Identity?.IsAuthenticated == true && User.Identity.AuthenticationType == EcommerceWebApplication.Helper.VendorPortalAuth.Scheme;
    var hasStore = signedIn && int.TryParse(ViewContext.RouteData.Values["id"]?.ToString(), out _);
    var storeId = ViewContext.RouteData.Values["id"];
    var vendorId = int.TryParse(storeId?.ToString(), out var parsedId) ? parsedId : 0;
    var actorId = VendorPortalAuth.TryGetUserId(User, out var parsedUser) ? parsedUser : 0;
    async Task<bool> Can(string code) => hasStore && await PortalAccess.CanAsync(vendorId, actorId, code, Context.RequestAborted);
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool Enabled(string key) => PortalConfiguration[key]?.Equals("true",StringComparison.OrdinalIgnoreCase)==true;
    var returnUrl = Context.Request.PathBase.ToString()+Context.Request.Path.ToString()+Context.Request.QueryString.ToString();
}
<!DOCTYPE html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @branding.Name — @T("Vendor Portal","بوابة البائع")</title>
    <link rel="stylesheet" href="~/AdminTheame/assets/css/lib/bootstrap.min.css" />
    <link rel="stylesheet" href="~/AdminTheame/assets/css/lib/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/admin-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/vendor-portal.css" asp-append-version="true" />
    <partial name="_StoreTheme" />
</head>
<body class="admin-workspace seller-workspace" dir="@(ar ? "rtl" : "ltr")">
    <a class="sr-only sr-only-focusable" href="#seller-main">@T("Skip to content","انتقل إلى المحتوى")</a>
    <header class="seller-header">
        <div class="seller-header-row">
            <a class="seller-brand" asp-controller="VendorPortal" asp-action="Index">
                @if (branding.HasLogo)
                {
                    <img src="@Url.Action("CompanyLogo","StoreImage",new { id=branding.CompanyId })" alt="" />
                }
                <span class="seller-brand-name"><strong>@branding.Name</strong><small>@T("Seller center","مركز البائع")</small></span>
            </a>
            <div class="seller-header-actions">
                @if(signedIn)
                {
                    <span class="seller-user"><span class="admin-user-icon"><i class="fa fa-user" aria-hidden="true"></i></span><span>@User.Identity?.Name</span></span>
                }
                <a asp-controller="Home" asp-action="SetLanguage" asp-route-culture="@(ar ? "en" : "ar")" asp-route-returnUrl="@returnUrl" class="btn btn-default"><i class="fa fa-globe" aria-hidden="true"></i> @(ar ? "English" : "العربية")</a>
                @if(signedIn)
                {
                    <a asp-controller="VendorPortal" asp-action="Index" class="btn btn-default">@T("My stores","متاجري")</a>
                    <form asp-controller="VendorPortal" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-default"><i class="fa fa-sign-out" aria-hidden="true"></i> @T("Sign out","تسجيل الخروج")</button>
                    </form>
                }
            </div>
        </div>
    </header>
    <div class="seller-shell @(hasStore ? "seller-shell-store" : "")">
        @if(hasStore)
        {
            <aside class="sidebar seller-sidebar">
                <nav class="nano-content" aria-label="@T("Store navigation","قائمة المتجر")">
                    <ul>
                        <li class="label">@T("Workspace","مساحة العمل")</li>
                        @if(await Can(VendorPermissionPages.Dashboard))
                        {
                        <li class="@(action=="Dashboard"?"active":"")">
                            <a asp-controller="VendorPortal" asp-action="Dashboard" asp-route-id="@storeId" aria-current="@(action=="Dashboard"?"page":null)"><i class="fa fa-dashboard" aria-hidden="true"></i><span>@T("Overview","نظرة عامة")</span></a>
                        </li>
                        }
                        @if(await Can(VendorPermissionPages.Listings))
                        {
                        <li class="@(action is "Listings" or "Catalog" or "EditListing"?"active":"")">
                            <a asp-controller="VendorPortal" asp-action="Listings" asp-route-id="@storeId" aria-current="@(action is "Listings" or "Catalog" or "EditListing"?"page":null)"><i class="fa fa-cubes" aria-hidden="true"></i><span>@T("Products","المنتجات")</span></a>
                        </li>
                        }
                        @if(Enabled("Marketplace:VendorInventoryEnabled") && await Can(VendorPermissionPages.Listings) && await Can(VendorPermissionPages.Stock))
                        {
                            <li class="@(action is "Inventory" or "Stock"?"active":"")">
                                <a asp-action="Inventory" asp-controller="VendorPortal" asp-route-id="@storeId"><i class="fa fa-cubes" aria-hidden="true"></i><span>@T("Inventory","المخزون")</span></a>
                            </li>
                        }
                        @if(Enabled("Marketplace:VendorOrdersEnabled") && await Can(VendorPermissionPages.Orders))
                        {
                            <li class="@(action is "Orders" or "OrderDetails"?"active":"")">
                                <a asp-controller="VendorPortal" asp-action="Orders" asp-route-id="@storeId" aria-current="@(action is "Orders" or "OrderDetails"?"page":null)"><i class="fa fa-shopping-bag" aria-hidden="true"></i><span>@T("Orders","الطلبات")</span></a>
                            </li>
                        }
                        @if(Enabled("Marketplace:VendorOrdersEnabled") && Enabled("Marketplace:ReturnWorkflowEnabled") && await Can(VendorPermissionPages.Orders))
                        {
                            <li class="@(action=="Returns"?"active":"")">
                                <a asp-action="Returns" asp-controller="VendorPortal" asp-route-id="@storeId"><i class="fa fa-undo" aria-hidden="true"></i><span>@T("Returns","المرتجعات")</span></a>
                            </li>
                        }
                        @if(Enabled("Marketplace:FinancePreviewEnabled") && await Can(VendorPermissionPages.Finance))
                        {
                            <li class="label">@T("Finance","المالية")</li>
                            <li class="@(action=="FinanceReview"?"active":"")">
                                <a asp-controller="VendorPortal" asp-action="FinanceReview" asp-route-id="@storeId" aria-current="@(action=="FinanceReview"?"page":null)"><i class="fa fa-money" aria-hidden="true"></i><span>@T("Commission & settlement","العمولة والتسوية")</span></a>
                            </li>
                            <li class="@(action=="Reports"?"active":"")">
                                <a asp-controller="VendorPortal" asp-action="Reports" asp-route-id="@storeId"><i class="fa fa-bar-chart" aria-hidden="true"></i><span>@T("Sales reports","تقارير المبيعات")</span></a>
                            </li>
                        }
                        @if(await Can(VendorPermissionPages.Dashboard))
                        {
                            <li class="label">@T("Store","المتجر")</li>
                            <li class="@(action=="StoreProfile"?"active":"")">
                                <a asp-controller="VendorPortal" asp-action="StoreProfile" asp-route-id="@storeId"><i class="fa fa-info-circle" aria-hidden="true"></i><span>@T("Store profile","ملف المتجر")</span></a>
                            </li>
                        }
                    </ul>
                </nav>
            </aside>
        }
        <main id="seller-main" class="seller-main">@RenderBody()</main>
    </div>
    <script src="~/js/vendor-workspace.js" asp-append-version="true" defer></script>
</body>
</html>
