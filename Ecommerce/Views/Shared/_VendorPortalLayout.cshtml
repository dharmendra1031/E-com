@{
    Layout = null;
    var ar = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}
<!DOCTYPE html>
<html lang="@(ar ? "ar" : "en")" dir="@(ar ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — @(ar ? "بوابة البائع" : "Vendor Portal")</title>
    <link rel="stylesheet" href="~/AdminTheame/assets/css/lib/bootstrap.min.css" />
</head>
<body>
    <header class="container">
        <div class="page-header">
            <h1>@(ar ? "بوابة البائع" : "Vendor Portal")</h1>
            @if (User.Identity?.AuthenticationType == EcommerceWebApplication.Helper.VendorPortalAuth.Scheme)
            {
                <nav aria-label="@(ar ? "القائمة" : "Navigation")">
                    <a asp-controller="VendorPortal" asp-action="Index" class="btn btn-default">@(ar ? "المتاجر" : "My stores")</a>
                    <form asp-controller="VendorPortal" asp-action="Logout" method="post" class="form-inline">
                        <button type="submit" class="btn btn-default">@(ar ? "تسجيل الخروج" : "Sign out")</button>
                    </form>
                </nav>
            }
        </div>
    </header>
    <main class="container">@RenderBody()</main>
</body>
</html>
