@model EcommerceWebApplication.Models.CompanyDetails
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@if (Model != null)
{
    <div class="container-fluid">
        <div class="row align-items-center">

            <div class="col-12 d-flex justify-content-between align-items-center flex-wrap">

                <a href="#" class="text-white text-decoration-none small">
                    <i class="fas fa-sitemap me-1"></i> @Model.CompanyName
                </a>

                <div class="d-flex align-items-center gap-3">

                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <a href="tel:@Model.Phone"
                           class="text-white text-decoration-none small d-none d-md-block">
                            <i class="fas fa-phone-alt me-1"></i>@Model.Phone
                        </a>
                    }

                    <a href="#" class="text-white text-decoration-none small d-none d-md-block">
                        <i class="fas fa-exchange-alt me-1"></i> @_localizer["Easy Exchange"]
                    </a>

                    <a href="#" class="text-white text-decoration-none small d-none d-sm-block">
                        <i class="fas fa-headset me-1"></i>@_localizer["Chat Support"]
                    </a>
                   

                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <a href="#" class="text-white text-decoration-none small d-none d-lg-block">
                            <i class="fas fa-map-marker-alt me-1"></i> @Model.Address
                        </a>
                    }

                    @if (!string.IsNullOrEmpty(Model.InstagramUrl))
                    {
                        <a href="@Model.InstagramUrl"
                           target="_blank"
                           class="text-white text-decoration-none small">
                            <i class="fas fa-mobile-alt me-1"></i> @_localizer["Download Our App"]
                        </a>
                    }

                    <div class="dropdown">
                        <a class="text-white text-decoration-none small dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown">
                            <i class="fas fa-share-alt me-1"></i> @_localizer["Follow"]
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end bg-primary">
                            @if (!string.IsNullOrEmpty(Model.FacebookUrl))
                            {
                                <li>
                                    <a class="dropdown-item text-white small"
                                       href="@Model.FacebookUrl"
                                       target="_blank">
                                        <i class="fab fa-facebook-f me-2"></i>@_localizer["Facebook"]
                                    </a>
                                </li>
                            }

                            @if (!string.IsNullOrEmpty(Model.TwitterUrl))
                            {
                                <li>
                                    <a class="dropdown-item text-white small"
                                       href="@Model.TwitterUrl"
                                       target="_blank">
                                        <i class="fab fa-twitter me-2"></i>@_localizer["Twitter URL"]
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                </div>
            </div>

        </div>
    </div>
}
