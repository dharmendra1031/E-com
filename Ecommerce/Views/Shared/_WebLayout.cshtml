	@* 	background-color:#14a2d7; *@

	<script>
						$(document).ready(function () {

				//  CATEGORIES BIND
			$.ajax({
				url: '/WebCategory/GetCategories',
				type: 'GET',
				success: function (data) {

					var dropdown = $('#categoryDropdown');
					dropdown.empty();

					$.each(data, function (index, item) {

						dropdown.append(
							'<li class="position-relative category-item" data-id="' + item.categoryId + '">' +
								'<a class="dropdown-item d-flex justify-content-between align-items-center" ' +
								'href="/WebCategory/Index?categoryId=' + item.categoryId + '">' +
									'<span>' + item.cName + '</span>' +
									'<span>›</span>' +
								'</a>' +
								'<ul class="submenu list-unstyled bg-white shadow"></ul>' +
							'</li>'
						);
					});
				}
			});

				//  SUBCATEGORIES BIND
		
			$(document).on('mouseenter', '.category-item', function () {

				var categoryId = $(this).data('id');
				var submenu = $(this).find('.submenu');

				if (submenu.children().length > 0) {
					submenu.show();
					return;
				}

				$.ajax({
					url: '/WebCategory/GetSubCategoriesByCategoryId',
					type: 'GET',
					data: { id: categoryId },
					success: function (subData) {

						submenu.empty();

						if (subData.length === 0) {
							submenu.append('<li class="dropdown-item text-muted">No Subcategory</li>');
						} else {
							$.each(subData, function (i, sub) {
									var imageTag = sub.imageBase64
		? '<img src="' + sub.imageBase64 + '" class="me-2 category-menu-icon" />'
		: '';

								submenu.append(
									'<li>' +
										'<a class="dropdown-item" ' +
										'href="/WebCategory/Index?subCategoryId=' + sub.subCategoryId + '">' +
											imageTag +
										sub.scName +
										'</a>' +
									'</li>'
								);
							});
						}

						submenu.show();
					}
				});

			});

			// Hide submenu on mouse leave
			$(document).on('mouseleave', '.category-item', function () {
				$(this).find('.submenu').hide();
			});


		
			//  CATEGORIES BIND NAV
		
			$.ajax({
				url: '/WebCategory/GetNavSubCategories',
				type: 'GET',
				success: function (data) {

					var topList = $('#topCategoryList');
					topList.empty();

					if (data.length === 0) {
						topList.append(
							'<li class="nav-item p-1 text-muted">No Subcategory</li>'
						);
						return;
					}

					$.each(data, function (index, item) {

							var imageTag = item.imageBase64
		? '<img src="' + item.imageBase64 + '" class="me-2 category-menu-icon" />'
		: '';

						topList.append(
							'<li class="nav-item">' +
								'<a class="nav-link text-secondary fw-semibold py-1 px-3" ' +
								'href="/WebCategory/Index?categoryId=' + item.categoryId + '">' +
								imageTag +
								item.cName +
								'</a>' +
							'</li>'
						);
					});
				}
			});

		});
	</script>
	<script>
		function adjustPageContent() {
			const header = document.getElementById("siteHeader");
			const pageContent = document.getElementById("pageContent");

			if (!header || !pageContent) return;

			const headerHeight = header.offsetHeight;
			pageContent.style.paddingTop = getComputedStyle(header).position === "fixed" ? headerHeight + "px" : "0px";

				 document.documentElement.style.setProperty(
			"--header-height",
			headerHeight + "px"
			);
		}

		// Page load
		window.addEventListener("load", adjustPageContent);

		// Window resize (mobile rotate, responsive)
		window.addEventListener("resize", adjustPageContent);
        if (typeof ResizeObserver !== "undefined") {
            const siteHeader = document.getElementById("siteHeader");
            if (siteHeader) new ResizeObserver(adjustPageContent).observe(siteHeader);
        }

		// If fonts/images load later
		setTimeout(adjustPageContent, 300);
	</script>


	<script>
				window.onload = function () {
				const form = document.querySelector("#NavigationKey");
		if (!form) return;

				const getFocusables = () => Array.from(
		form.querySelectorAll("input, select, textarea, button[type='submit'], input[type='submit']")
				).filter(el =>
		!el.disabled &&
		!el.readOnly &&
		el.type !== "hidden" &&
		el.offsetParent !== null
		);

		let focusables = getFocusables();


				if (focusables.length > 0) {
			setTimeout(() => {
				focusables[0].focus();
				focusables[0].scrollIntoView({ behavior: "smooth", block: "center" });
			}, 100);
				}

				focusables.forEach((el, index) => {
			el.addEventListener("keydown", function (e) {
				if (el.tagName.toLowerCase() === "textarea") {
					if (e.key === "Enter" && e.shiftKey) {
						// Allow new line inside textarea
						return; // Do nothing, normal newline
					}
				}

				const goNext = () => {
					if (index + 1 < focusables.length) {
						// Next focusable
						focusables[index + 1].focus();
						focusables[index + 1].scrollIntoView({ behavior: "smooth", block: "center" });
					} else {

						if (el.tagName.toLowerCase() === "button" || el.type === "submit") {
							el.click();
						}
					}
					e.preventDefault();
				};

				const goPrev = () => {
					if (index - 1 >= 0) {
						focusables[index - 1].focus();
						focusables[index - 1].scrollIntoView({ behavior: "smooth", block: "center" });
						e.preventDefault();
					}
				};

				if (e.key === "ArrowRight" || e.key === "Enter") {
					goNext();
				} else if (e.key === "ArrowLeft") {
					goPrev();
				}
			});
				});


		form.addEventListener("submit", function () {
			setTimeout(() => {
				focusables = getFocusables();
				if (focusables.length > 0) {
					focusables[0].focus();
				}
			}, 100);
				});
			};








		document.addEventListener("DOMContentLoaded", function () {

			fetch('/WebHome/GetCompanyDetailsJson')
				.then(res => res.json())
				.then(data => {
					if (!data) return;
					document.getElementById('hcompanyLogo').src = data.logo;
					document.getElementById('fcompanyLogo').src = data.logo;
					document.getElementById('companyName').innerText = data.companyName;
					document.getElementById('companyAddress').innerText = data.address;
