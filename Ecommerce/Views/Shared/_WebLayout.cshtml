<script>
    $(document).on("click", ".add-to-cart-btn", function () {
        const button = $(this);
        if (button.prop("disabled")) return;
        const arabic = document.documentElement.lang === "ar";
        button.prop("disabled", true);
        $.post('/WebCart/AddOrUpdateCart', { productId: button.data("productid"), qty: 1 })
            .done(function (res) {
                if (res.success) {
                    loadCartCount();
                    Swal.fire({ toast: true, position: 'bottom-end', icon: 'success',
                        text: arabic ? 'تمت الإضافة إلى السلة' : 'Added to cart', showConfirmButton: false, timer: 1800 });
                } else {
                    Swal.fire({ icon: 'warning', text: res.message || (arabic ? 'تعذرت الإضافة' : 'Unable to add item') });
                }
            })
            .fail(function () {
                Swal.fire({ icon: 'error', text: arabic ? 'حدث خطأ. حاول مرة أخرى.' : 'Something went wrong. Please try again.' });
            })
            .always(function () { button.prop("disabled", false); });
    });
</script>
