	<script>
		$(document).ready(function () {

			let timer;
			$('#searchInput').on('keyup', function () {
				clearTimeout(timer);
				let term = $(this).val().trim();

				timer = setTimeout(function () {

					if (!term) {
						$('#searchDropdown').addClass('d-none').empty();
						return;
					}

					$.ajax({
						url: '/WebHome/search',
						type: 'GET',
						data: { term: term, lang: document.documentElement.lang },
						success: function (data) {

							let dropdown = $('#searchDropdown');
							dropdown.empty();

							if (!data || data.length === 0) {
								dropdown
									.removeClass('d-none')
									.html('<div class="list-group-item text-muted small">No products found</div>');
								return;
							}

							data.forEach(p => {
								dropdown.append(`
									<a href="/WebSingleProduct/SingleProduct/${p.productId}"
									   class="list-group-item list-group-item-action d-flex gap-2 align-items-start">
										<img src="${p.imageBase64 || '/images/default-product.png'}"
											 class="rounded"
											 width="50" height="50" />
										<div class="flex-grow-1">
											<div class="fw-semibold small text-dark">${p.name}</div>
											<div class="small text-dark">KD ${Number(p.price).toFixed(3)}</div>
											<div class="small text-dark">⭐ ${p.averageRating.toFixed(2)}</div>
										</div>
									</a>
								`);
							});

							dropdown.removeClass('d-none');
						}
					});

				}, 150); // 100ms delay for fast response
			});

			// CLICK OUTSIDE TO HIDE
			$(document).on('click', function (e) {
				if (!$(e.target).closest('#searchForm').length) {
					$('#searchDropdown').addClass('d-none');
				}
			});

		});

		document.addEventListener("DOMContentLoaded", function () {

			fetch('/WebHome/GetCompanyDetails')
