	<!-- SEARCH JS -->
	<script>
        (() => {
            const input = document.getElementById("searchInput");
            const results = document.getElementById("searchDropdown");
            const search = document.getElementById("searchForm");
            const arabic = document.documentElement.lang === "ar";
            let timer, request;
            function hide() { results.classList.add("d-none"); }
            function message(text) {
                results.replaceChildren();
                const item = document.createElement("div");
                item.className = "list-group-item text-muted small";
                item.textContent = text;
                results.append(item);
                if (search.contains(document.activeElement)) results.classList.remove("d-none");
            }
            input.addEventListener("input", () => {
                clearTimeout(timer);
                request?.abort();
                const term = input.value.trim();
                if (!term) { results.replaceChildren(); hide(); return; }
                message(arabic ? "جارٍ البحث…" : "Searching…");
                timer = setTimeout(async () => {
                    const current = new AbortController();
                    request = current;
                    try {
                        const response = await fetch("/WebHome/search?" + new URLSearchParams({ term, lang: document.documentElement.lang }), { signal: current.signal });
                        if (!response.ok) throw new Error("Search failed");
                        const data = await response.json();
                        if (current.signal.aborted) return;
                        if (!Array.isArray(data) || !data.length) {
                            message(arabic ? "لا توجد منتجات" : "No products found");
                            return;
                        }
                        results.replaceChildren();
                        for (const product of data.slice(0, 12)) {
                            const link = document.createElement("a");
                            link.className = "list-group-item list-group-item-action store-search-result";
                            link.href = "/WebSingleProduct/SingleProduct/" + encodeURIComponent(product.productId);
                            const image = document.createElement("img");
                            image.src = product.imageBase64 || "/images/default-product.png";
                            image.alt = "";
                            const details = document.createElement("div");
                            const name = document.createElement("div");
                            name.className = "fw-semibold";
                            name.textContent = product.name || "";
                            const price = document.createElement("bdi");
                            price.textContent = "KD " + Number(product.price).toFixed(3);
                            details.append(name, price);
                            link.append(image, details);
                            results.append(link);
                        }
                        if (search.contains(document.activeElement)) results.classList.remove("d-none");
                    } catch (error) {
                        if (error.name !== "AbortError") message(arabic ? "تعذر البحث. حاول مرة أخرى." : "Unable to search. Try again.");
                    }
                }, 250);
            });
            input.addEventListener("focus", () => {
                if (input.value.trim() && results.childElementCount) results.classList.remove("d-none");
            });
            search.addEventListener("keydown", event => {
                if (event.key === "Escape") { input.focus(); hide(); }
            });
            document.addEventListener("click", event => { if (!search.contains(event.target)) hide(); });
        })();

