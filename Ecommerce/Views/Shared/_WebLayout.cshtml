<script>
    $(document).on("click", ".add-to-cart-btn", function () {
        const button = $(this);
        if (button.prop("disabled")) return;
        const arabic = document.documentElement.lang === "ar";
        button.prop("disabled", true);
        $.post('/WebCart/AddOrUpdateCart', { productId: button.data("productid"), qty: Number(button.attr("data-quantity") || 1) })
            .done(function (res) {
                if (res.success) {
                    loadCartCount();
                    Swal.fire({ toast: true, position: 'bottom-end', icon: 'success',
                        text: arabic ? 'تمت الإضافة إلى السلة' : 'Added to cart', showConfirmButton: false, timer: 1800 });
                } else {
                    Swal.fire({ icon: 'warning', text: res.message || (arabic ? 'تعذرت الإضافة' : 'Unable to add item') });
                }
            })
            .fail(function () {
                Swal.fire({ icon: 'error', text: arabic ? 'حدث خطأ. حاول مرة أخرى.' : 'Something went wrong. Please try again.' });
            })
            .always(function () { button.prop("disabled", false); });
    });
</script>
<script>
    document.addEventListener("click", event => {
        const button = event.target.closest("[data-password-toggle]");
        if (!button) return;
        const input = document.getElementById(button.dataset.passwordToggle);
        if (!input) return;
        const show = input.type === "password";
        input.type = show ? "text" : "password";
        button.textContent = document.documentElement.lang === "ar" ? (show ? "إخفاء" : "إظهار") : (show ? "Hide" : "Show");
        button.setAttribute("aria-pressed", String(show));
    });
</script>
