	var direction = culture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
	var layoutDirection = direction;
	var rtlCssPath = "/AdminTheame/assets/css/rtl.css";
	//var rtlCssHref = layoutDirection == "rtl" ? rtlCssPath : "";
	var rtlCssHref = direction == "rtl" ? rtlCssPath : "";
	var lang = culture.TextInfo.IsRightToLeft ? "ar" : "en";
}
