@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer
@{
	var culture = System.Globalization.CultureInfo.CurrentCulture;
	var direction = culture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
	var layoutDirection = direction;
	var rtlCssPath = "/AdminTheame/assets/css/rtl.css";
	//var rtlCssHref = layoutDirection == "rtl" ? rtlCssPath : "";
	var rtlCssHref = direction == "rtl" ? rtlCssPath : "";
	var lang = culture.TextInfo.IsRightToLeft ? "ar" : "en";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" dir="@layoutDirection">
<head>
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewBag.Title</title>

	<!-- Bootstrap 5 -->
	<link href="@(direction == "rtl" ? "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" : "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
	


	@* <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> *@
	<!-- jQuery UI CSS -->
	<link rel="stylesheet"
		  href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
	<!-- jQuery UI JS -->
	<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

	<!-- Font Awesome -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="~/js/navigation.js"></script>
	@if (direction == "rtl")
	{
		<link rel="stylesheet" href="@rtlCssHref" />
	}
	<style>
		/*  .page-content {
					margin-top: auto; /* total height of all headers */
		}

		*/
		/* ===== FIXED HEADER ===== */
		/* .fixed-header {
					position: fixed ;
					top: 0;
					left: 0;
					width: 100%;
					z-index: 1050;
				} */
		.fixed-header {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 1050;
		}

		.page-content {
			/* JS se set hoga */
		}

		.offcanvas {
			position: fixed !important;
		}

		@@media(min-width: 768px) {
			.fixed-header {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				z-index: 1050;
			}

			.page-content {
				/* JS se set hoga */
			}

			.offcanvas.offcanvas-start {
				display: none;
			}
		}

		@@media(max-width: 768px) {
			.fixed-header {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				z-index: 1050;
			}

			.page-content {
				/* JS se set hoga */
			}

			.offcanvas.offcanvas-start {
				top: var(--header-height);
				height: calc(100vh - var(--header-height));
			}
		}

		/* Top white bar */
		.top-bar-1 {
			background-color: #fff;
			color: #14a2d7;
			font-size: 24px;
			height: 50px;
		}

		/* Company details bar */
		/*   .header-top {
					background-color: #14a2d7;
					color: #fff;
					font-size: 0.875rem;
					height: 25px;
				} */

		.header-top {
			background-color: #14a2d7;
			color: #fff;
			font-size: 17px;
			min-height: 28px;
			display: flex;
			align-items: center; /* 🔥 vertical center */
			line-height: 1;
		}
		/* Main navbar */
	/* 	.main-header {
			background-color: #14a2d7;
			color: #fff;
		} */


		/* Page content ko header ke niche lana */


	/* 	header, footer {
			background-color: #14a2d7;
			color: #fff;
		} */

		.search-box {
			border-radius: 50px;
			padding-inline-start: 45px;
		}

		.category-btn {
			background: #fcb034;
			border-radius: 7px;
			font-weight: 600;
		}

		.footer-bottom {
			background: #064b7c;
			padding: 10px 0;
			text-align: center;
			color: #fff;
		}

		.category-item {
			position: relative;
		}

		.submenu {
			position: absolute;
			top: 0;
			inset-inline-start: 100%;
			min-width: 200px;
			display: none;
			z-index: 1055;
		}


	</style>
	<style>
		html, body {
			overflow-x: hidden;
		}

		.category-scroll {
			overflow-x: auto;
			overflow-y: hidden;
			white-space: nowrap;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			cursor: grab;
		}

			.category-scroll:active {
				cursor: grabbing;
			}

			.category-scroll::-webkit-scrollbar {
				display: none;
			}

		.category-menu-icon {
			width: 30px !important;
			height: 30px !important;
			object-fit: contain;
		}
	</style>


<style>
        .header-actions { min-width: 0; }
        .header-user-name { display: inline-block; max-width: 90px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; vertical-align: middle; }
        .category-scroll { min-width: 0; }
        #mobileSearchPopup { position: fixed !important; inset-inline: 12px; top: var(--header-height, 120px); width: auto; max-width: 480px; margin-inline: auto; z-index: 1055; }
        #searchDropdown { max-width: 100%; }
        #siteHeader .toggleRTL { white-space: nowrap; }
        @@media (max-width: 767.98px) {
            #siteHeader #hcompanyLogo { max-width: 80px !important; max-height: 44px !important; }
            #siteHeader .header-actions { gap: 6px !important; }
            #siteHeader .header-user-name { max-width: 48px; }
            #siteHeader .category-menu-icon { width: 24px !important; height: 24px !important; }
        }
    </style>
</head>

