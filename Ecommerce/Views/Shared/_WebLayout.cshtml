			function loadCartCount() {
		$.ajax({
		url: '/WebCart/GetCart',
		method: 'GET',
		success: function (data) {
		let totalCount = 0;

		if (data && data.length > 0) {
		$.each(data, function (index, item) {
		totalCount += parseInt(item.quantity);
		});
		}

		$('#cartCount').text(totalCount);
		},
		error: function () {
		$('#cartCount').text('0');
		}
		});
		}

	</script>


