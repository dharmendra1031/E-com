    <script>
    (() => {
        const dropdown = document.getElementById("categoryDropdown");
        const topList = document.getElementById("topCategoryList");
        const ar = document.documentElement.lang === "ar";
        const url = (categoryId, subCategoryId) => "/WebCategory/Index?" + new URLSearchParams(
            subCategoryId ? {categoryId, subCategoryId} : {categoryId});
        function categoryLink(label, href, classes, imageUrl) {
            const link = document.createElement("a");
            link.className = classes;
            link.href = href;
            if (imageUrl) {
                const image = document.createElement("img");
                image.src = imageUrl;
                image.alt = "";
                image.loading = "lazy";
                image.className = "me-2 category-menu-icon";
                link.append(image);
            }
            const text = document.createElement("span");
            text.textContent = label || "";
            link.append(text);
            return link;
        }
        function emptyMessage(container, text) {
            const item = document.createElement("li");
            item.className = "dropdown-item text-muted small";
            item.textContent = text;
            container.replaceChildren(item);
        }
        async function loadCategories() {
            try {
                const response = await fetch("/WebCategory/GetNavSubCategories");
                if (!response.ok) throw new Error();
                const data = await response.json();
                dropdown.replaceChildren();
                topList.replaceChildren();
                if (!data.length) {
                    emptyMessage(dropdown, ar ? "لا توجد فئات" : "No categories");
                    document.dispatchEvent(new CustomEvent("store:categories-ready", { detail: [] }));
                    return;
                }
                for (const item of data) {
                    const row = document.createElement("li");
                    row.className = "position-relative category-item";
                    row.dataset.id = item.categoryId;
                    const link = categoryLink(item.cName, url(item.categoryId), "dropdown-item d-flex justify-content-between align-items-center");
                    const arrow = document.createElement("span");
                    arrow.textContent = ar ? "‹" : "›";
                    arrow.setAttribute("aria-hidden", "true");
                    link.append(arrow);
                    const submenu = document.createElement("ul");
                    submenu.className = "submenu list-unstyled bg-white shadow";
                    row.append(link, submenu);
                    dropdown.append(row);
                    const nav = document.createElement("li");
                    nav.className = "nav-item";
                    nav.append(categoryLink(item.cName, url(item.categoryId), "nav-link text-secondary fw-semibold py-1 px-3", item.imageBase64));
                    topList.append(nav);
                    let pending = false, loaded = false, hovered = false;
                    row.addEventListener("mouseenter", async () => {
                        if (!matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                        hovered = true;
                        if (loaded) { submenu.style.display = "block"; return; }
                        if (pending) return;
                        pending = true;
                        try {
                            const response = await fetch("/WebCategory/GetSubCategoriesByCategoryId?" + new URLSearchParams({id:item.categoryId}));
                            if (!response.ok) throw new Error("GetSubCategoriesByCategoryId HTTP " + response.status);
                            const children = await response.json();
                            if (!Array.isArray(children)) throw new Error("Invalid subcategory response");
                            submenu.replaceChildren();
                            for (const child of children) {
                                const li = document.createElement("li");
                                li.append(categoryLink(child.scName, url(item.categoryId, child.subCategoryId), "dropdown-item", child.imageBase64));
                                submenu.append(li);
                            }
                            if (!children.length) emptyMessage(submenu, ar ? "لا توجد فئات فرعية" : "No subcategories");
                            loaded = true;
                            if (hovered) submenu.style.display = "block";
                        } catch (error) {
                            console.error("Catalog submenu:", error);
                            emptyMessage(submenu, ar ? "تعذر التحميل" : "Unable to load");
                            if (hovered) submenu.style.display = "block";
                        } finally { pending = false; }
                    });
                    row.addEventListener("mouseleave", () => { hovered = false; submenu.style.display = "none"; });
                }
                document.dispatchEvent(new CustomEvent("store:categories-ready", { detail: data }));
            } catch {
                document.dispatchEvent(new Event("store:categories-error"));
                emptyMessage(dropdown, ar ? "تعذر تحميل الفئات" : "Unable to load categories");
                emptyMessage(topList, ar ? "تعذر تحميل الفئات" : "Unable to load categories");
            }
        }
        const scroll = document.getElementById("categoryScroll");
        let activeId = new URLSearchParams(location.search).get("categoryId");
        function highlight() {
            for (const link of topList.querySelectorAll("a")) {
                const active = new URL(link.href).searchParams.get("categoryId") === activeId;
                if (active) link.setAttribute("aria-current","page"); else link.removeAttribute("aria-current");
            }
        }
        document.addEventListener("store:category", event => { activeId = event.detail; highlight(); });
        const previous = document.getElementById("navPrevious"), next = document.getElementById("navNext");
        function syncArrows() {
            const overflow = Math.max(0, scroll.scrollWidth - scroll.clientWidth);
            const offset = Math.abs(scroll.scrollLeft);
            previous.disabled = offset < 2;
            next.disabled = offset >= overflow - 2;
        }
        function move(direction) { scroll.scrollBy({left:direction * (ar ? -1 : 1) * Math.max(120, scroll.clientWidth * .65), behavior:"auto"}); }
        previous.addEventListener("click", () => move(-1));
        next.addEventListener("click", () => move(1));
        scroll.addEventListener("scroll", syncArrows, {passive:true});
        window.addEventListener("resize", syncArrows);
        loadCategories().then(() => { highlight(); syncArrows(); });
    })();
    </script>
	<script>
		function adjustPageContent() {
			const header = document.getElementById("siteHeader");
			const pageContent = document.getElementById("pageContent");

			if (!header || !pageContent) return;

			const headerHeight = header.offsetHeight;
			pageContent.style.paddingTop = getComputedStyle(header).position === "fixed" ? headerHeight + "px" : "0px";

				 document.documentElement.style.setProperty(
			"--header-height",
			headerHeight + "px"
			);
		}

		// Page load
		window.addEventListener("load", adjustPageContent);

		// Window resize (mobile rotate, responsive)
		window.addEventListener("resize", adjustPageContent);
        if (typeof ResizeObserver !== "undefined") {
            const siteHeader = document.getElementById("siteHeader");
            if (siteHeader) new ResizeObserver(adjustPageContent).observe(siteHeader);
        }

		// If fonts/images load later
		setTimeout(adjustPageContent, 300);
	</script>


	<script>
				window.onload = function () {
				const form = document.querySelector("#NavigationKey");
		if (!form) return;

				const getFocusables = () => Array.from(
		form.querySelectorAll("input, select, textarea, button[type='submit'], input[type='submit']")
				).filter(el =>
		!el.disabled &&
		!el.readOnly &&
		el.type !== "hidden" &&
		el.offsetParent !== null
		);

		let focusables = getFocusables();


				if (focusables.length > 0) {
			setTimeout(() => {
				focusables[0].focus();
				focusables[0].scrollIntoView({ behavior: "smooth", block: "center" });
			}, 100);
				}

				focusables.forEach((el, index) => {
			el.addEventListener("keydown", function (e) {
				if (el.tagName.toLowerCase() === "textarea") {
					if (e.key === "Enter" && e.shiftKey) {
						// Allow new line inside textarea
						return; // Do nothing, normal newline
					}
				}

				const goNext = () => {
					if (index + 1 < focusables.length) {
						// Next focusable
						focusables[index + 1].focus();
						focusables[index + 1].scrollIntoView({ behavior: "smooth", block: "center" });
					} else {

						if (el.tagName.toLowerCase() === "button" || el.type === "submit") {
							el.click();
						}
					}
					e.preventDefault();
				};

				const goPrev = () => {
					if (index - 1 >= 0) {
						focusables[index - 1].focus();
						focusables[index - 1].scrollIntoView({ behavior: "smooth", block: "center" });
						e.preventDefault();
					}
				};

				if (e.key === "ArrowRight" || e.key === "Enter") {
					goNext();
				} else if (e.key === "ArrowLeft") {
					goPrev();
				}
			});
				});


		form.addEventListener("submit", function () {
			setTimeout(() => {
				focusables = getFocusables();
				if (focusables.length > 0) {
					focusables[0].focus();
				}
			}, 100);
				});
			};








		document.addEventListener("DOMContentLoaded", function () {

            function setSocialLink(id, value) {
                if (typeof value !== "string" || !value.trim()) return;
                try {
                    const raw = value.trim();
                    const url = new URL(/^[a-z][a-z0-9+.-]*:/i.test(raw) ? raw : "https://" + raw);
                    if (url.protocol !== "https:" && url.protocol !== "http:") return;
                    if (!url.hostname.includes(".")) return;
                    const link = document.getElementById(id);
                    link.href = url.href;
                    link.classList.remove("d-none");
                } catch { /* Invalid configured link stays hidden. */ }
            }
			fetch('/WebHome/GetCompanyDetailsJson')
				.then(res => res.json())
				.then(data => {
					if (!data) return;
					if (data.logo) {
                        document.getElementById('hcompanyLogo').src = data.logo;
                        document.getElementById('fcompanyLogo').src = data.logo;
                    }
					document.getElementById('companyName').innerText = data.companyName;
					document.getElementById('companyAddress').innerText = data.address;
					document.getElementById('companyPhone').innerText = data.phone;
					document.getElementById('companyEmail').innerText = data.email;

					setSocialLink('fbLink', data.facebook);
					setSocialLink('twLink', data.twitter);
					setSocialLink('igLink', data.instagram);
					setSocialLink('lnLink', data.linkedIn);
				})
				.catch(err => console.error("Company load error", err));

		});
