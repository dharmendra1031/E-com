@model EcommerceWebApplication.Helper.StoreTheme
@inject EcommerceWebApplication.Helper.AdminStaffAccess StaffAccess
@{
    var canEdit=(await StaffAccess.RightsAsync(User,EcommerceWebApplication.Helper.AdminStaffAccess.Theme,Context.RequestAborted)).Edit;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var ar = System.Globalization.CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;
    string T(string en,string arabic) => ar ? arabic : en;
    ViewData["Title"] = T("Theme color","لون الواجهة");
    string? logoUrl = ViewBag.CompanyLogoUrl as string;
    var colors = new[] { "#6E7F80", "#837E7C", "#C0C6C7", "#3A5F0B", "#829F82", "#16E2F5", "#12E193", "#C2E5D3", "#81D8D0", "#8E7618", "#F5DEB3", "#5E7D7E", "#1569C7", "#387C44", "#8FB31D", "#AF9B60", "#F3E5AB", "#9F8C76", "#DF73D4", "#E3735E", "#FBBBB9", "#997070", "#064b7c", "#190ECE" };
}
<section class="admin-panel theme-settings">
    <div class="admin-section-heading"><h2>@T("Project theme","لون المشروع")</h2></div>
    <p>@T("Choose the shared accent color for the customer website, admin panel and vendor portal. Content surfaces stay white and text stays readable.","اختر اللون المشترك لموقع العملاء ولوحة الإدارة وبوابة البائع. تبقى الخلفيات بيضاء والنصوص واضحة.")</p>
    <form id="themeForm" method="post" asp-action="SaveUpdate" data-feedback="off" data-read-url="@Url.Action("GetColor")">
        <fieldset disabled="@(!canEdit)">
        <section class="theme-logo-section" aria-labelledby="logoThemeTitle">
            <h3 id="logoThemeTitle">@T("Match company logo", "مطابقة شعار الشركة")</h3>
            @if (logoUrl != null)
            {
                <div class="theme-logo-row">
                    <img id="themeCompanyLogo" src="@logoUrl" alt="@T("Saved company logo", "شعار الشركة المحفوظ")" />
                    <button type="button" id="matchLogoColor" class="btn btn-primary">@T("Match logo colors", "مطابقة ألوان الشعار")</button>
                </div>
                <div id="logoPalette" class="theme-swatches" aria-label="@T("Suggested logo colors", "ألوان الشعار المقترحة")" hidden></div>
                <p id="logoColorMessage" role="status" class="admin-muted"></p>
            }
            else
            {
                <p>@T("Save your company logo first to get matching colors.", "احفظ شعار الشركة أولاً للحصول على الألوان المطابقة.") <a asp-controller="Companydetails" asp-action="Index">@T("Company settings", "إعدادات الشركة")</a></p>
            }
        </section>
        <h3 class="theme-preset-title">@T("Preset colors", "الألوان الجاهزة")</h3>
        <div class="theme-swatches" aria-label="@T("Preset colors","الألوان الجاهزة")">
            @foreach(var color in colors)
            {
                <button type="button" class="theme-swatch" style="background:@color" data-color="@color" title="@color" aria-label="@color" aria-pressed="@(color.Equals(Model.Primary,StringComparison.OrdinalIgnoreCase)?"true":"false")"></button>
            }
        </div>
        <div class="admin-register-filters theme-inputs">
            <div class="form-group"><label for="colorPicker">@T("Custom color","لون مخصص")</label><input type="color" id="colorPicker" class="form-control" value="@Model.Primary" /></div>
            <div class="form-group"><label for="selectedColor">@T("Hex color","رمز اللون")</label><input type="text" id="selectedColor" name="Colorcode" class="form-control" value="@Model.Primary" maxlength="7" pattern="#[0-9a-fA-F]{6}" required dir="ltr" /></div>
            <div class="form-group"><label>@T("Preview","معاينة")</label><div id="themePreview" class="theme-preview" style="background:@Model.Primary;color:@Model.Foreground">@T("Selected color","اللون المحدد")</div></div>
        </div>
        </fieldset>
        @if(canEdit){<div class="admin-form-actions"><button type="submit" class="btn btn-primary">@T("Save color","حفظ اللون")</button></div>
        <p id="themeMessage" role="status"></p>
        }
    </form>
</section>
@section Scripts {
    @if(canEdit){<script src="~/js/theme-settings.js" asp-append-version="true"></script>}
}
