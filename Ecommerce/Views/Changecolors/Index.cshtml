            </div>

            <!-- 🔸 Hidden Color Picker -->
            <div class="mt-3" id="pickerDiv" style="display:none;">
                <input type="color" id="colorPicker" />
            </div>

            <div class="row mt-4 align-items-center">
                <form id="colorForm" class="d-flex flex-wrap w-100" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <!-- 🔸 Textbox -->
                    <div class="col-md-4">
                        <input type="text" id="selectedColor" asp-for="Colorcode"
                               class="form-control" placeholder="Selected Color Code" />

                        <small id="colorError" style="color:red; display:none;">
                            @_localizer["Please select a color first"]
                        </small>
                    </div>

                    <!-- 🔸 Color Preview Box -->
                    <div class="col-md-2 d-flex align-items-center">
                        <div id="previewBox" style="width:40px; height:40px; border:1px solid #ccc; border-radius:5px;"></div>
                    </div>

                    <!-- 🔸 Button -->
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100"> @_localizer["Submit"]</button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>

    //  open picker
    function openPicker() {
        document.getElementById("pickerDiv").style.display = "block";
    }

    //  preview update function
    function updatePreview(color) {
        $("#previewBox").css("background", color);
    }

    //  FORM SUBMIT
    $("#colorForm").submit(async function (e) {
        e.preventDefault();
        const color = $("#selectedColor").val().trim();
        if (!/^#[0-9a-f]{6}$/i.test(color)) {
            AdminFeedback.show("warning", document.documentElement.dir === "rtl" ? "أدخل رمز لون صحيحاً." : "Enter a valid six-digit hexadecimal color.");
            return;
        }
        $("#colorError").hide();
        await AdminFeedback.post('@Url.Action("SaveUpdate","Changecolors")', {
            method: "POST",
            body: new URLSearchParams(new FormData(this))
        });
    });

    //  PAGE LOAD
    $(document).ready(function () {

        $.ajax({
            url: '/Changecolors/GetColor',
            type: 'GET',
            success: function (res) {
                if (res.success && res.color) {

                    $("#selectedColor").val(res.color);
                    updatePreview(res.color); // 🔥 preview set

                    $(".color-box").each(function () {
                        if ($(this).data("color") == res.color) {
                            $(".color-box").removeClass("selected");
                            $(this).addClass("selected");
                        }
                    });
                }
            }
        });

    });


    // COLOR BOX CLICK (ONLY ONE HANDLER - FINAL)
    $(document).on("click", ".color-box", function () {

        $(".color-box").removeClass("selected");
        $(this).addClass("selected");

        let color = $(this).data("color");
        if (!color) return;

        $("#selectedColor").val(color);
        updatePreview(color);
    });


    //  COLOR PICKER
    $("#colorPicker").on("input", function () {

        let color = this.value;

        $("#selectedColor").val(color);
        updatePreview(color);

        $(".color-box").removeClass("selected");
    });


    //  TEXTBOX MANUAL CHANGE
    $("#selectedColor").on("input", function () {
        updatePreview($(this).val());
    });

</script>