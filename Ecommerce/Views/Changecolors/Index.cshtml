                <!-- 🔸 Add Color -->
                <div class="color-item">
                    <div class="color-box d-flex align-items-center justify-content-center"
                         style="background:#f1f1f1;"
                         onclick="openPicker()">
                        <i class="ti-plus"></i>
                    </div>
