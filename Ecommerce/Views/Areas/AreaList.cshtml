@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@model EcommerceWebApplication.Models.ViewModels.PagedResult<EcommerceWebApplication.Models.Area>

@{
    ViewData["Title"] = "Area List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="main-content">
    <div class="row">
        <div class="col-lg-12">
            <div class="card alert">
                <div class="card-header">

                    <div class="card-header-right-icon">
                        <ul>
                            <li>
                                <a asp-action="Create" class="btn btn-success">
                                    <i class="ti-plus bg-success"></i> @_localizer["Add New Area"]
                                </a>
                            </li>
                        </ul>
                    </div>
                    <hr />
                </div>

                <div class="card-body">
                    <form method="get" asp-action="AreaList" class="mb-3">
                        <div class="row">
                            <div class="col-md-4">
                                <label for="name" class="me-1" style="margin-right: 5px;">@_localizer["Name"]:</label>
                                <input type="text" id="name" name="name" class="form-control" autocomplete="off" value="@ViewBag.FilterName" style="width: 300px; display: inline-block;" />
                                <ul id="suggestions" style="display:none;
                                position:absolute;
                                background:white;
                                list-style:none;
                                padding:0;
                                margin:0;
                                width:100%;  /* width same as input */
                                max-height:200px;
                                overflow-y:auto;
                                border:1px solid #ccc;
                                z-index:1000;">
                                    <!-- Suggestions dynamically appended here -->
                                </ul>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary">@_localizer["Filter"]</button>
                            </div>
                        </div>
                    </form>

                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card alert">


                            <div class="card-body" style="overflow-y:auto; height:70vh">
                                @{
                                    int serial = ((Model.PageNumber - 1) * Model.PageSize) + 1;
                                }
                                <table class="table table-hover">
                                    <thead class="table-light" style="position: sticky; top: 0; z-index: 1; background-color: white; color: #000; direction: ltr;">
                                        <tr>
                                            <th>@_localizer["SN"]</th>
                                            <th>@_localizer["ID"]</th>

                                            <th>@_localizer["Area Name (AR)"]</th>
                                            <th>@_localizer["Area Name (EN)"]</th>
                                            <th>@_localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Items)
                                        {
                                            <tr>
                                                <td>@serial</td>
                                                <td>@item.Id</td>
                                                <td>@item.AreaNameArb</td>
                                                <td>@item.AreaName</td>
                                                <td>
                                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                                        <i class="ti-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="deleteArea(@item.Id)">
                                                        <i class="ti-trash"></i>
                                                    </button>
                                                </td>

                                            </tr>
                                            serial++;
                                        }
                                    </tbody>
                                </table>


                                <!-- ✅ Pagination (Same as UserList) -->
                                <div class="text-center">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="AreaList" asp-route-page="1"
                                               asp-route-name="@ViewBag.FilterName">
                                                @_localizer["First"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="AreaList" asp-route-page="@(Model.PageNumber - 1)"
                                               asp-route-name="@ViewBag.FilterName">
                                                @_localizer["Previous"]
                                            </a>
                                        </li>

                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                                <a class="page-link" asp-action="AreaList" asp-route-page="@i"
                                                   asp-route-name="@ViewBag.FilterName">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="AreaList" asp-route-page="@(Model.PageNumber + 1)"
                                               asp-route-name="@ViewBag.FilterName">
                                                @_localizer["Next"]
                                            </a>
                                        </li>

                                        <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="AreaList" asp-route-page="@(Model.TotalPages)"
                                               asp-route-name="@ViewBag.FilterName">
                                                @_localizer["Last"]
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function deleteArea(id) {
            const ar = document.documentElement.dir === "rtl";
            return AdminFeedback.confirmPost('@Url.Action("DeleteArea", "Areas")',
                {method:"POST", body:new URLSearchParams({id:String(id)})},
                ar ? "هل أنت متأكد من حذف هذا السجل؟" : "Are you sure you want to delete this record?",
                () => location.reload());
        }
    </script>
    <script>
        $(document).ready(function () {

            function fetchCategorySuggestions(query) {
                if (!query || query.length < 2) {
                    $('#suggestions').hide();
                    return;
                }

                $.ajax({
                    url: '/Areas/AutoCompleteArea',
                    type: 'GET',
                    data: { term: query },
                    success: function(data) {
                        let $suggestionBox = $('#suggestions');
                        $suggestionBox.empty();

                        if (data && data.length > 0) {
                            data.forEach(function(item) {
                                $('<li></li>')
                                    .text(item)
                                    .css({ padding:'5px', cursor:'pointer', borderBottom:'1px solid #ddd' })
                                    .on('click', function() {
                                        $('#name').val(item);
                                        $suggestionBox.hide();
                                        $('#name').focus();
                                    })
                                    .appendTo($suggestionBox);
                            });
                            $suggestionBox.show();
                        } else {
                            $suggestionBox.hide();
                        }
                    }
                });
            }

            $('#name').on('input', function() {
                fetchCategorySuggestions($(this).val());
            });

            enableSuggestionNavigation('#name', '#suggestions');

            $(document).on('click', function(e) {
                if (!$(e.target).closest('#name, #suggestions').length) {
                    $('#suggestions').hide();
                }
            });
        });
    </script>
}
