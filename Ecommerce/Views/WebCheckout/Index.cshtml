@using System.Globalization
@model EcommerceWebApplication.Models.ViewModels.CheckoutviewModel
@inject Microsoft.AspNetCore.Mvc.Localization.IHtmlLocalizer<EcommerceWebApplication.Controllers.HomeController> _localizer

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_WebLayout.cshtml";
}
<style>
    .form-label.required::after {
        content: " *";
        color: red;
        font-weight: bold;
    }
</style>
<style>
    .is-invalid {
        border: 2px solid red !important;
    }
    .customer-checkout .checkout-product { min-width: 0; overflow-wrap: anywhere; }
    .customer-checkout .checkout-product img { flex-shrink: 0; object-fit: contain; }
    .customer-checkout .checkout-summary > .d-flex { gap: 12px; }
    .customer-checkout input, .customer-checkout select, .customer-checkout button { min-height: 44px; }
    .customer-checkout input[type="radio"], .customer-checkout input[type="checkbox"] { min-height: 0; }
</style>
<div class="container my-3 my-lg-5 customer-checkout">
    <div class="row g-4">

        <!-- LEFT : BILLING -->
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">@_localizer["Checkout"]</h3>
                @if (Model.UserId == null)
                {
                    <a href="/UserAccount/Login" class="btn btn-sm btn-outline-dark">
                        @_localizer["Login"]
                    </a>
                }
            </div>

            <h5 class="mb-3"> @_localizer["Billing Details"]</h5>

            @if (Model.UserId != null)
            {
                <!-- ✅ USER LOGGED IN → READONLY DETAILS -->
                <input class="form-control mb-3"
                       placeholder="@_localizer["Full Name"]"
                       value="@Model.FullName"
                       readonly />

                <input class="form-control mb-3"
                       placeholder="@_localizer["Email"]"
                       value="@Model.Email"
                       readonly />

                <input class="form-control mb-3"
                       placeholder="@_localizer["Mobile No"]"
                       value="@(string.IsNullOrEmpty(Model.Phone) || Model.Phone.Length <= 4
                               ? ""
                               : Model.Phone.Substring(4))"
                       readonly />
                <div class="mb-3">
                    <label class="form-label"> @_localizer["Select Saved Address"]</label>

                    <!-- Dropdown -->
                    <!-- ADDRESS DROPDOWN -->
                    <select id="addressDropdown" class="form-select" aria-label="@_localizer["Select Saved Address"]">
                        <option value=""> @_localizer["Select Address"]</option>

                        @foreach (var addr in Model.AddressList)
                        {
                            if (addr.AddressId == Model.SelectedAddressId)
                            {
                                <option value="@addr.AddressId" selected>
                                    @addr.Title
                                </option>
                            }
                            else
                            {
                                <option value="@addr.AddressId">
                                    @addr.Title
                                </option>
                            }
                        }
                    </select>


                    <div class="text-muted mb-3" id="addressText">
                        <strong> @_localizer["Address"]:</strong> --
                    </div>



                    <!-- Button (address ke niche) -->
                    <button class="btn btn-outline-primary" onclick="openAddressModal()">
                         @_localizer["Add New Address"]
                    </button>

                </div>

            }
            else
            {
                <!-- ❌ USER NOT LOGGED IN → NEW ADDRESS FORM -->
                <form id="guestAddressForm" onsubmit="return false;">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Full Name"]</label>
                            <input id="fullName" autocomplete="name" class="form-control" placeholder="@_localizer["Full Name"]">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Email"]</label>
                            <input id="email" type="email" autocomplete="email" class="form-control" placeholder="@_localizer["Email"]">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Mobile No"]</label>
                            <input id="mobile" type="tel" inputmode="numeric" autocomplete="tel-national" class="form-control" maxlength="8" pattern="[0-9]{8}">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Area"]</label>
                            <select class="form-control" id="ddlArea"></select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Block"]</label>
                            <select class="form-control" id="ddlBlock"></select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required"> @_localizer["Street"]</label>
                            <input id="street" class="form-control">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label> @_localizer["House No"]</label>
                            <input id="houseNo" class="form-control">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label> @_localizer["Floor"]</label>
                            <input id="floor" class="form-control">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>@_localizer["Apartment No"]</label>
                            <input id="apartmentNo" class="form-control">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>@_localizer["Shareholder No"]</label>
                            <input id="shareholderNo" class="form-control">
                        </div>

                        <div class="col-12 mb-3">
                            <label> @_localizer["NoInstruction"]</label>
                            <textarea id="instruction" class="form-control"></textarea>
                        </div>
                    </div>
                </form>



            }



            <h5 class="mb-3 mt-4">@_localizer["Payment Method"]</h5>

            <div class="form-check">
                <input class="form-check-input" type="radio" checked>
                <label class="form-check-label fw-semibold">
                    @_localizer["Online Payment"]
                </label>
            </div>
        </div>

        <!-- RIGHT : ORDER SUMMARY -->
        <div class="col-lg-6">
            <div class="border rounded p-3 p-lg-4 checkout-summary">

                <h5 class="mb-4">@_localizer["Order Summary"]</h5>

                <!-- ITEM -->
                @foreach (var item in Model.CartItems)
                {
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3 checkout-line">
                        <div class="d-flex gap-2 checkout-product">
                            <img src="@(item.ImageUrl ?? "https://via.placeholder.com/45")"
                                 class="rounded"
                                 width="45" height="45">
                            <div>
                                <div class="fw-semibold">
                                    @item.ProductName
                                x @item.Quantity
                            </div>

                            </div>
                        </div>
                        <div class="fw-semibold text-nowrap" dir="ltr">
                            @item.TotalPrice?.ToString("F3", CultureInfo.InvariantCulture) KD
                        </div>
                    </div>
                                }

                <hr>

                <!-- COUPON -->
                <div class="input-group mb-3">
                    <input type="text" id="couponCode" class="form-control" placeholder="@(CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "أدخل رمز الخصم" : "Enter coupon code")">
                    <button class="btn btn-primary" id="applyCouponBtn">@_localizer["Apply"]</button>
                </div>

                <!-- TOTALS -->
                <div class="d-flex justify-content-between mb-2">
                    <span>@_localizer["Subtotal"]:</span>
                    <span id="subtotalAmount">@Model.CartTotal?.ToString("F3", CultureInfo.InvariantCulture) KD</span>
                </div>

                <div class="d-flex justify-content-between mb-2 text-success d-none" id="discountRow">
                    <span>@_localizer["Coupon Discount"]:</span>
                    <span>- <span id="discountAmount">0.000</span> KD</span>
                </div>

                <div class="d-flex justify-content-between fw-bold">
                    <span>@_localizer["Total After Discount"]:</span>
                    <span id="finalAmount">@Model.CartTotal?.ToString("F3", CultureInfo.InvariantCulture) KD</span>
                </div>

                <div class="d-flex justify-content-between text-primary mb-2">
                    <span>@_localizer["VAT"] (@Model.VatPercentage?.ToString("0.##", CultureInfo.InvariantCulture)%):</span>
                    <span id="vatAmount" dir="ltr">—</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span>@_localizer["DeliveryCharge"]:</span>
                    <span>+ @Model.DeliveryCharge?.ToString("F3", CultureInfo.InvariantCulture)  KD</span>
                </div>

                <hr>


                <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                    <span>@_localizer["Total"]:</span>
                    <span id="grandTotal"> 0.000 KD</span>
                </div>

                <button class="btn btn-primary w-100 py-2 fw-semibold" id="payNowBtn">
                    @_localizer["Pay Online"]
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Modal of Address -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header">
                <h5 class="modal-title">@_localizer["Add New Address"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <div class="row g-3">

                    <div class="col-md-3">
                        <label class="form-label">@_localizer["Title"]</label>
                        <input class="form-control" name="Title">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label required">@_localizer["Area"]</label>
                        <select class="form-control required-field" name="Area" id="modalArea">
                            <option value="">Select Area</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label required">@_localizer["Block"]</label>
                        <select class="form-control required-field" name="Block" id="modalBlock">
                            <option value="">Select Block</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label required">@_localizer["Street"]</label>
                        <input class="form-control required-field" name="Street">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@_localizer["HouseNo"]</label>
                        <input class="form-control" name="HouseNo">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">@_localizer["Floor"]</label>
                        <input class="form-control" name="Floor">
                    </div>

                   @*  <div class="col-md-3">
                        <label class="form-label required">@_localizer["Phone"]</label>
                        <input class="form-control required-field" name="Phone" maxlength="8" inputmode="numeric" pattern="[0-9]{8}" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div> *@
                    <div class="col-md-4">
                        <label class="form-label required">@_localizer["Phone"]</label>

                        <div class="input-group">
                            <span class="input-group-text">+965</span>

                            <input class="form-control required-field"
                                   name="Phone"
                                   maxlength="8"
                                   inputmode="numeric"
                                   pattern="[0-9]{8}"
                                   placeholder="Enter phone"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@_localizer["Landmark"]</label>
                        <input class="form-control" name="Landmark">
                    </div>

                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="saveAddressBtn">
                    @_localizer["Save Address"]
                </button>
            </div>

        </div>
    </div>
</div>
<script>
    const checkoutArabic = document.documentElement.lang === "ar";
    const checkoutError = checkoutArabic ? "حدث خطأ. حاول مرة أخرى." : "Something went wrong. Please try again.";
    const subtotal = @(Model.CartTotal.GetValueOrDefault().ToString(CultureInfo.InvariantCulture));
    const vatRate = @(Model.VatPercentage.GetValueOrDefault().ToString(CultureInfo.InvariantCulture));
    const delivery = @(Model.DeliveryCharge.GetValueOrDefault().ToString(CultureInfo.InvariantCulture));
    let couponPending = false;
    let orderPending = false;
    function syncPaymentButton() {
        $('#payNowBtn').prop('disabled', couponPending || orderPending || @(!Model.CartItems.Any() ? "true" : "false"));
    }
    function calculateFinalTotal() {
        const discount = Number($('#discountAmount').text()) || 0;
        const afterDiscount = Math.max(subtotal - discount, 0);
        const vatAmount = afterDiscount * vatRate / 100;
        $('#vatAmount').text('KD ' + vatAmount.toFixed(3));
        $('#grandTotal').text('KD ' + (afterDiscount + vatAmount + delivery).toFixed(3));
    }
    $('#applyCouponBtn').on('click', async function () {
        if (couponPending || orderPending) return;
        const code = $('#couponCode').val().trim();
        if (!code) {
            Swal.fire({icon:'warning',text:checkoutArabic ? 'أدخل رمز الخصم' : 'Enter coupon code'});
            return;
        }
        couponPending = true;
        $(this).prop('disabled', true);
        syncPaymentButton();
        try {
            const res = await $.ajax({url:'/WebCheckout/ApplyCoupon',type:'POST',contentType:'application/json',
                data:JSON.stringify({code,orderAmount:subtotal})});
            if (res.success) {
                $('#discountAmount').text(Number(res.discountApplied).toFixed(3));
                $('#finalAmount').text(Number(res.finalAmount).toFixed(3) + ' KD');
                $('#discountRow').removeClass('d-none');
                calculateFinalTotal();
            } else {
                Swal.fire({icon:'warning',text:res.message || checkoutError});
            }
        } catch { Swal.fire({icon:'error',text:checkoutError}); }
        finally { couponPending = false; $(this).prop('disabled', false); syncPaymentButton(); }
    });
    calculateFinalTotal();
    syncPaymentButton();

    const savedAddresses = document.getElementById("addressDropdown");
    const addressText = document.getElementById("addressText");
    let addressRequest;
    async function showSelectedAddress(id) {
        if (!addressText) return;
        addressRequest?.abort();
        const request = new AbortController();
        addressRequest = request;
        addressText.textContent = id ? (checkoutArabic ? "جارٍ تحميل العنوان…" : "Loading address…") : "—";
        if (!id) return;
        try {
            const response = await fetch("/WebCheckout/GetAddressById/" + encodeURIComponent(id), {signal:request.signal});
            if (!response.ok) throw new Error("Address unavailable");
            const address = await response.json();
            if (!request.signal.aborted) addressText.textContent = address ?
                [checkoutArabic ? address.areaNameArb || address.areaName : address.areaName,
                 checkoutArabic ? address.blockNameArb || address.blockName : address.blockName,
                 address.street,address.houseNo].filter(Boolean).join(", ") : "—";
        } catch(error) {
            if (error.name !== "AbortError") addressText.textContent = checkoutError;
        }
    }
    savedAddresses?.addEventListener("change", () => showSelectedAddress(savedAddresses.value));
    if (savedAddresses?.value) showSelectedAddress(savedAddresses.value);

    let areaData;
    async function getAreaData() {
        if (!areaData) areaData = fetch('/WebCheckout/GetAreaBlockData')
            .then(response => { if (!response.ok) throw new Error("Address data unavailable"); return response.json(); })
            .catch(error => { areaData = null; throw error; });
        return areaData;
    }
    async function setupAreaFields(area, block) {
        const selectArea = checkoutArabic ? "اختر المنطقة" : "Select area";
        const selectBlock = checkoutArabic ? "اختر القطعة" : "Select block";
        area.disabled = true;
        block.disabled = true;
        try {
            const data = await getAreaData();
            area.replaceChildren(new Option(selectArea, ""));
            block.replaceChildren(new Option(selectBlock, ""));
            for (const a of data.areas) area.add(new Option(checkoutArabic ? a.areaNameArb || a.areaName : a.areaName, a.id));
            area.onchange = () => {
                block.replaceChildren(new Option(selectBlock, ""));
                for (const b of data.blocks.filter(b => String(b.areaId) === area.value))
                    block.add(new Option(checkoutArabic ? b.blockNameArb || b.blockName : b.blockName, b.id));
                block.disabled = !area.value;
            };
            area.disabled = false;
        } catch { Swal.fire({icon:"error",text:checkoutError}); }
    }
    const guestArea = document.getElementById("ddlArea");
    if (guestArea) setupAreaFields(guestArea, document.getElementById("ddlBlock"));

    function openAddressModal() {
        const modal = document.getElementById("addAddressModal");
        bootstrap.Modal.getOrCreateInstance(modal).show();
        const area = document.getElementById("modalArea");
        if (area.options.length <= 1) setupAreaFields(area, document.getElementById("modalBlock"));
    }
    document.getElementById("saveAddressBtn").addEventListener("click", async function () {
        const modal = document.getElementById("addAddressModal");
        const fields = [...modal.querySelectorAll(".required-field")];
        let valid = true;
        for (const field of fields) {
            const invalid = !field.value.trim() || !field.checkValidity();
            field.classList.toggle("is-invalid", invalid);
            if (invalid) valid = false;
        }
        if (!valid) { modal.querySelector(".is-invalid")?.focus(); return; }
        this.disabled = true;
        const formData = {};
        for (const field of modal.querySelectorAll("input[name], select[name]")) formData[field.name] = field.value;
        try {
            const response = await fetch('/WebCheckout/AddAddress', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(formData)});
            const result = await response.json();
            if (!response.ok || !result.success || !result.addressId) throw new Error(result.message || checkoutError);
            savedAddresses.add(new Option(result.title || formData.Title || (checkoutArabic ? "عنوان جديد" : "New address"), result.addressId));
            savedAddresses.value = String(result.addressId);
            showSelectedAddress(savedAddresses.value);
            bootstrap.Modal.getInstance(modal).hide();
            Swal.fire({toast:true,position:"bottom-end",icon:"success",text:checkoutArabic ? "تم حفظ العنوان" : "Address saved",showConfirmButton:false,timer:1800});
        } catch(error) { Swal.fire({icon:"error",text:error.message || checkoutError}); }
        finally { this.disabled = false; }
    });
</script>
<script>
    const isGuestUser = @(Model.UserId == null ? "true" : "false");
</script>

<script>
    function validateGuestForm() {
        let isValid = true;

        // remove old errors
        document.querySelectorAll('#guestAddressForm .is-invalid')
            .forEach(el => el.classList.remove('is-invalid'));

        // required fields list
        const requiredFields = [
            'fullName',
            'email',
            'mobile',
            'ddlArea',
            'ddlBlock',
            'street'
        ];

        requiredFields.forEach(id => {
            const field = document.getElementById(id);
            if (!field || !field.value || field.value.trim() === '') {
                field?.classList.add('is-invalid');
                isValid = false;
            }
        });

        // mobile length check
        const mobile = document.getElementById('mobile');
        if (mobile && !/^[0-9]{8}$/.test(mobile.value)) {
            mobile.classList.add('is-invalid');
            isValid = false;
        }

        const email = document.getElementById('email');
        if (email && !email.checkValidity()) { email.classList.add('is-invalid'); isValid = false; }
        if (!isValid) document.querySelector('#guestAddressForm .is-invalid')?.focus();
        return isValid;
    }
</script>
<script>
    $('#payNowBtn').click(function () {
        if (orderPending || couponPending) return;
        let items = [];

        @foreach (var item in Model.CartItems)
        {
                    <text>
                        items.push({
                            productId: @item.ProductId,
                            quantity: @item.Quantity,
                            price: @item.Price.ToString(CultureInfo.InvariantCulture)
                        });
                    </text>
        }

        // 🔹 COMMON DATA (DTO MATCH)
        let orderData = {
            paymentMethod: "Online",
            items: items
        };

        // 🔹 CASE 1: GUEST USER
        if (isGuestUser) {

            if (!validateGuestForm()) {
                alert('Please fill all required billing details');
                return;
            }

            // 🔹 DIRECT DTO FIELDS
            orderData.fullName = $('#fullName').val();
            orderData.email = $('#email').val();
            orderData.mobile = $('#mobile').val();
            orderData.areaId = parseInt($('#ddlArea').val());
            orderData.blockId = parseInt($('#ddlBlock').val());
            orderData.street = $('#street').val();
            orderData.houseNo = $('#houseNo').val();
            orderData.floor = $('#floor').val();
            orderData.apartmentNo = $('#apartmentNo').val();
            orderData.shareholderNo = $('#shareholderNo').val();
            orderData.instruction = $('#instruction').val();

            // Guest ke liye addressId nahi
            orderData.deliveryAddress = 0;

        }
        else {
            // 🔹 CASE 2: LOGGED-IN USER
            let addressId = $('#addressDropdown').val();
            if (!addressId) {
                alert('Please select delivery address');
                return;
            }

            orderData.deliveryAddress = parseInt(addressId);
        }

        // Prevent duplicate clicks while the server processes the order.
        orderPending = true;
        syncPaymentButton();
        $('#applyCouponBtn').prop('disabled', true);
        $.ajax({
            url: '/WebCheckout/PlaceOrder',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(orderData),
              success: function (res) {
        Swal.fire({
            icon: 'success',
            title: checkoutArabic ? 'تم تسجيل الطلب' : 'Order received',
            text: (checkoutArabic ? 'رقم الطلب: ' : 'Order number: ') + res.orderId,
            confirmButtonText: 'OK',
             width: '500px',
              Height: '500px'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/WebHome/Index';
            }
        });
    },
               error: function (err) {
        let msg = err.responseJSON?.message || 'Something went wrong';

        Swal.fire({
            icon: 'error',
            title: checkoutArabic ? 'تعذر تسجيل الطلب' : 'Unable to place order',
            text: msg,
            confirmButtonText: 'OK',
            width: '500px'
        });
    },
    complete: function (xhr) {
        if (xhr.status < 200 || xhr.status >= 300) {
            orderPending = false;
            syncPaymentButton();
            $('#applyCouponBtn').prop('disabled', false);
        }
    }
        });
    });
</script>




