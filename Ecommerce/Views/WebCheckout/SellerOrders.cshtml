@using System.Globalization
@model List<EcommerceWebApplication.Models.ViewModels.SellerOrderReceipt>
@{Layout="~/Views/Shared/_WebLayout.cshtml";var ar=CultureInfo.CurrentCulture.TextInfo.IsRightToLeft;int page=ViewBag.Page;ViewData["Title"]=ar?"طلباتي من البائعين":"My seller orders";}
<div class="container py-3"><div class="store-cart-panel p-3">
<h1 class="h4">@ViewData["Title"]</h1>
<p class="small">@(ar?"طلبات الاختبار فقط":"Development test orders only")</p>
<div class="table-responsive"><table class="table"><thead><tr><th>@(ar?"الطلب":"Order")</th><th>@(ar?"التاريخ":"Date")</th><th>@(ar?"الإجمالي":"Total")</th><th>@(ar?"الحالة":"Status")</th></tr></thead><tbody>
@foreach(var row in Model){
<tr><td><a asp-action="SellerReceipt" asp-route-requestId="@row.RequestId">#@row.OrderId</a></td><td>@row.CreatedAt.ToString("yyyy-MM-dd")</td><td dir="ltr">KD @row.Total.ToString("F3",CultureInfo.InvariantCulture)</td><td>@(row.ReservationState=="Released"?(ar?"تم تحرير الحجز":"Reservation released"):row.PaymentStatus==1&&row.AttemptState=="Paid"&&row.ReservationState=="Consumed"?(ar?"تم التحقق من الدفع":"Payment verified"):(ar?"قيد المراجعة أو الدفع":"Pending payment or review"))</td></tr>
}
@if(Model.Count==0){<tr><td colspan="4">@(ar?"لا توجد طلبات":"No seller orders")</td></tr>}
</tbody></table></div>
@if(page>1){<a asp-action="SellerOrders" asp-route-page="@(page-1)" class="btn btn-outline-secondary">@(ar?"السابق":"Previous")</a>}
@if(ViewBag.HasNext==true){<a asp-action="SellerOrders" asp-route-page="@(page+1)" class="btn btn-outline-secondary">@(ar?"التالي":"Next")</a>}
<a asp-controller="WebCart" asp-action="Cart" class="btn btn-outline-primary">@(ar?"السلة":"Cart")</a>
</div></div>
